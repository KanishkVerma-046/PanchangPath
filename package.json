{
  "name": "panchang-path",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild-sitemap.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=panchangpath --branch=main",
    "test:audit": "node --test scripts/audit/test/*.test.mjs",
    "audit:crawl": "node scripts/audit/crawl.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.0.3",
    "astronomy-engine": "^2.1.19",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "playwright": "^1.61.1",
    "wrangler": "^4.106.0"
  }
}
