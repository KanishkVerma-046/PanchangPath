---
// KolamAccent.astro — tiny geometric dot-flower (South Indian kolam style),
// used as a small flourish beside section headings. Not a bullet/icon
// replacement — one per section heading at most.
interface Props {
  size?: number;
  class?: string;
}
const { size = 22, class: className = '' } = Astro.props;

const cx = size / 2;
const cy = size / 2;
const TAU = Math.PI * 2;
const dotCount = 8;
const dots = Array.from({ length: dotCount }, (_, i) => {
  const a = TAU * (i / dotCount) - Math.PI / 2;
  const r = size * 0.36;
  return { x: cx + r * Math.cos(a), y: cy + r * Math.sin(a) };
});
---

<svg
  class={`kolam-accent ${className}`}
  width={size}
  height={size}
  viewBox={`0 0 ${size} ${size}`}
  fill="none"
  aria-hidden="true"
>
  <circle cx={cx} cy={cy} r={size * 0.36} stroke="currentColor" stroke-width="1" opacity="0.55" />
  {dots.map((d) => <circle cx={d.x} cy={d.y} r={size * 0.05} fill="currentColor" />)}
  <circle cx={cx} cy={cy} r={size * 0.07} fill="currentColor" />
</svg>

<style>
  .kolam-accent { color: var(--color-gold); flex-shrink: 0; }
</style>
