---
// Header.astro — sticky top header with clock, search, lang/region picker, theme switcher, mobile drawer
import LocationPicker from './LocationPicker.astro';
import LanguagePicker from './LanguagePicker.astro';
import DeepamFlame from './motifs/DeepamFlame.astro';
import { getUpcomingMajorFestivals, getFestivalSlug } from '../lib/festivals';

// Next 3 upcoming major festivals, computed at build time (astro build runs
// `new Date()` once, server-side) so the Festivals dropdown/drawer/search
// always point at what's actually coming up instead of hardcoded past-dated
// slugs (e.g. "Diwali 2025" showing on an August 2026 build). See
// getUpcomingMajorFestivals in src/lib/festivals.ts for the major-festival
// tier definition and the "fewer than 3 remain" fallback behavior.
const upcomingFestivals = getUpcomingMajorFestivals(3).map(f => ({
  label: `${f.name} ${f.date.slice(0, 4)}`,
  labelHi: `${f.nameHi} ${f.date.slice(0, 4)}`,
  url: `/festivals/${getFestivalSlug(f)}`,
}));
---

<!-- HEADER -->
<header id="site-header">
  <!-- Top bar -->
  <div id="header-top">
    <div class="header-container">

      <!-- LEFT: Logo -->
      <a href="/" class="logo-link" aria-label="PanchangPath पंचांग पथ - Home">
        <span class="logo-om">🕉️</span>
        <span class="logo-text-group">
          <span class="logo-text">PanchangPath</span>
          <span class="logo-text-hi">पंचांग पथ</span>
        </span>
      </a>

      <!-- CENTER: Live clock + search -->
      <div class="header-center">
        <!-- Live clock (links to sunrise page) -->
        <a href="/" class="clock-widget" id="clock-link" title="Today's Panchang">
          <span class="clock-time" id="live-time">00:00:00</span>
          <span class="clock-sep">|</span>
          <span class="clock-date" id="live-date">—</span>
        </a>

        <!-- Search bar -->
        <div class="search-wrap">
          <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input
            id="search-input"
            class="search-input"
            type="search"
            placeholder="Search panchang, festivals, muhurta…"
            aria-label="Search"
            autocomplete="off"
          />
          <button class="mic-btn" id="mic-btn" title="Voice search" aria-label="Voice search">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="2" width="6" height="11" rx="3"/>
              <path d="M5 10a7 7 0 0 0 14 0"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="8" y1="22" x2="16" y2="22"/>
            </svg>
          </button>
          <!-- Search results dropdown -->
          <div id="search-dropdown" class="search-dropdown" hidden></div>
        </div>
      </div>

      <!-- RIGHT: Controls -->
      <div class="header-right">
        <!-- Language / Region picker -->
        <LanguagePicker />

        <!-- Dark mode -->
        <button id="dark-toggle" class="hdr-icon-btn" title="Toggle dark mode" aria-label="Toggle dark mode">
          <svg id="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none">
            <circle cx="12" cy="12" r="5"/>
            <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </svg>
          <svg id="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
          </svg>
        </button>

        <!-- Location picker -->
        <LocationPicker />

        <!-- Hamburger (mobile) -->
        <button id="hamburger" class="hdr-icon-btn hamburger-btn" aria-label="Open menu" aria-expanded="false">
          <svg id="hamburger-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
          <svg id="close-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="display:none">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Live status strip: Tithi · Nakshatra · City -->
  <a href="/" class="status-strip" id="status-strip" title="Today's Panchang — Tithi &amp; Nakshatra shown here are live, current-moment values (may briefly differ from the homepage summary card's sunrise-anchored figures right at a boundary crossing)">
    <div class="header-container status-strip-inner">
      <DeepamFlame size={13} class="status-flame" />
      <span class="status-item status-item-strong" id="status-tithi">—</span>
      <span class="status-dot">·</span>
      <span class="status-item" id="status-nakshatra">—</span>
      <span class="status-dot">·</span>
      <span class="status-item" id="status-city">—</span>
      <span class="status-dot">·</span>
      <span class="status-item status-item-muted" data-hi="लाइव">Live</span>
    </div>
  </a>

  <!-- Desktop nav categories -->
  <nav id="desktop-nav" aria-label="Main navigation">
    <div class="header-container">
      <ul class="desktop-nav-list">
        <li class="nav-item has-dropdown">
          <a href="/" class="nav-cat"><span class="nav-label" data-hi="पंचांग">Panchang</span> <span class="nav-caret">▾</span></a>
          <div class="nav-dropdown">
            <a href="/" class="dd-link" data-hi="आज का पंचांग">Today's Panchang</a>
            <a href="/calendar" class="dd-link" data-hi="मासिक कैलेंडर">Monthly Calendar</a>
            <a href="/sunrise-sunset" class="dd-link" data-hi="सूर्योदय और सूर्यास्त">Sunrise &amp; Sunset</a>
            <a href="/moonrise-moonset" class="dd-link" data-hi="चंद्रोदय और चंद्रास्त">Moonrise &amp; Moonset</a>
            <a href="/muhurta/rahu-kala" class="dd-link" data-hi="राहु काल">Rahu Kalam</a>
            <a href="/events" class="dd-link" data-hi="ग्रह घटनाएं">Planetary Events</a>
            <div class="dd-divider"></div>
