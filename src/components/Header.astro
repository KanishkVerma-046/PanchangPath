  const dropdown = document.getElementById('search-dropdown');

  searchInput?.addEventListener('input', () => {
    const q = searchInput.value.trim().toLowerCase();
    if (!q || !dropdown) { dropdown && (dropdown.hidden = true); return; }
    const matches = searchItems.filter(i => i.label.toLowerCase().includes(q));
    if (!matches.length) { dropdown.hidden = true; return; }
    dropdown.innerHTML = matches.map(i =>
      `<a href="${i.url}" style="display:block;padding:8px 14px;font-size:13px;color:var(--color-body-text);text-decoration:none;transition:background 0.1s;" onmouseover="this.style.background='var(--color-canvas-soft-2)'" onmouseout="this.style.background=''">${i.label}</a>`
    ).join('');
    dropdown.hidden = false;
  });

  document.addEventListener('click', (e) => {
    if (!searchInput?.contains(e.target as Node) && !dropdown?.contains(e.target as Node)) {
      if (dropdown) dropdown.hidden = true;
    }
  });

  // ── Mobile drawer search (same searchItems, own input + dropdown) ──
  const drawerSearchInput = document.getElementById('drawer-search-input') as HTMLInputElement | null;
  const drawerDropdown = document.getElementById('drawer-search-dropdown');

  drawerSearchInput?.addEventListener('input', () => {
    const q = drawerSearchInput.value.trim().toLowerCase();
    if (!q || !drawerDropdown) { drawerDropdown && (drawerDropdown.hidden = true); return; }
    const matches = searchItems.filter(i => i.label.toLowerCase().includes(q));
    if (!matches.length) { drawerDropdown.hidden = true; return; }
    drawerDropdown.innerHTML = matches.map(i =>
      `<a href="${i.url}" class="drawer-search-result">${i.label}</a>`
    ).join('');
    drawerDropdown.hidden = false;
  });

  document.addEventListener('click', (e) => {
    if (!drawerSearchInput?.contains(e.target as Node) && !drawerDropdown?.contains(e.target as Node)) {
      if (drawerDropdown) drawerDropdown.hidden = true;
    }
  });

  // Apply stored language now that searchInput/drawerSearchInput exist
  if (localStorage.getItem('pp-lang') === 'hi') applyHeaderLang(true);
</script>
