<!-- Overlay for mobile drawer -->
<div id="drawer-overlay" class="drawer-overlay" aria-hidden="true" inert></div>

<!-- Mobile slide-out drawer -->
<aside id="mobile-drawer" class="mobile-drawer" aria-label="Mobile navigation" aria-hidden="true" inert>
