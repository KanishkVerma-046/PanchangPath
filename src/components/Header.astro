        </button>
        <div class="drawer-sub" id="m-panchang">
          <a href="/" class="drawer-link" data-hi="आज का पंचांग">Today's Panchang</a>
          <a href="/calendar" class="drawer-link" data-hi="मासिक कैलेंडर">Monthly Calendar</a>
