<script>
  import { sunTrueLongitude, moonLongitude, lahiriAyanamsha, TITHIS, NAKSHATRAS } from '../lib/panchang';
  import { formatDateHi } from '../lib/date-i18n';
  import { getUpcomingMajorFestivals, getFestivalSlug } from '../lib/festivals';

  // Next 3 upcoming major festivals for the search index — same helper/tier
  // definition as the dropdown/drawer above (which are computed server-side
  // at build time in the frontmatter); this client <script> can't read those
  // frontmatter variables directly (see CLAUDE.md's Critical Gotchas), so it
  // recomputes via the same shared src/lib/festivals.ts helper instead of
  // duplicating a hardcoded list. Runs against the visitor's own clock rather
  // than the build clock, which — for a manually-deployed static site — is if
  // anything more current than a build-time snapshot, not less.
  const upcomingFestivalSearchItems = getUpcomingMajorFestivals(3).map(f => ({
    label: `${f.name} ${f.date.slice(0, 4)}`,
    url: `/festivals/${getFestivalSlug(f)}`,
  }));

  // Tracks the header's current language so the live clock/status strip
  // (updated on a setInterval, independent of applyHeaderLang's [data-hi]
  // pass) can render Hindi content too.
  let isHindi = false;

  // ── Live clock ──
  function updateClock() {
    const now = new Date();
    const timeEl = document.getElementById('live-time');
    const dateEl = document.getElementById('live-date');
    if (!timeEl || !dateEl) return;

    const h = String(now.getHours()).padStart(2, '0');
    const m = String(now.getMinutes()).padStart(2, '0');
    const s = String(now.getSeconds()).padStart(2, '0');
    timeEl.textContent = `${h}:${m}:${s}`;

    dateEl.textContent = formatDateHi(now, isHindi, { weekday: 'short', month: 'short' });
  }
  let lastClockSecond = -1;
  function clockTick() {
    const nowSecond = Math.floor(Date.now() / 1000);
    if (nowSecond !== lastClockSecond) {
      lastClockSecond = nowSecond;
      updateClock();
    }
    requestAnimationFrame(clockTick);
  }
  requestAnimationFrame(clockTick);

  // ── Live status strip (Tithi · Nakshatra · City) ──
  // Sun/Moon longitude + Lahiri ayanamsha now imported from src/lib/panchang.ts
  // (astronomy-engine backed, shared with the rest of the site) instead of being
  // duplicated inline — client <script> tags without define:vars/is:inline ARE
  // processed by Vite and can import local TS modules; see CLAUDE.md's Critical
  // Gotchas for the corrected note on this.
  function stripToRad(d: number) { return d * Math.PI / 180; }
  function stripNorm360(a: number) { return ((a % 360) + 360) % 360; }

  function stripJulianDay(year: number, month: number, day: number, hour = 0): number {
    if (month <= 2) { year -= 1; month += 12; }
    const A = Math.floor(year / 100);
    const B = 2 - A + Math.floor(A / 4);
    return Math.floor(365.25 * (year + 4716)) + Math.floor(30.6001 * (month + 1)) + day + hour / 24 + B - 1524.5;
  }

  function updateStatusStrip() {
    const loc = (window as any).__initLoc || { lat: 28.6139, lng: 77.2090, tzOffset: 5.5, name: 'New Delhi' };
    const now = new Date();
    // Tithi/Nakshatra here are instant-based (Sun/Moon ecliptic longitude at this real
    // moment) — unlike sunrise/Lagna elsewhere on the site, no location offset belongs
    // in this calculation at all; the previous formula (`now.getHours() - loc.tzOffset`)
    // silently assumed the visitor's own browser clock was already reading in the
    // *selected location's* timezone, which is never true — Date getters always reflect
    // the visitor's own device, regardless of which city is picked. Confirmed live: the
    // same real instant produced a full Tithi apart between an Asia/Kolkata and an
    // America/Los_Angeles browser. Julian Day is a UTC-referenced quantity by definition
    // (same convention as astro-core.ts/panchang.ts), so read it straight from the
    // instant's own UTC getters — timezone-independent by construction, no offset to add
    // or get wrong, same "absolute instant, not host-local" proof pattern as the daily
    // Rashifal IST fix, just with the correct target offset (none) for what this
    // computation actually represents.
    const jd = stripJulianDay(now.getUTCFullYear(), now.getUTCMonth() + 1, now.getUTCDate(), now.getUTCHours() + now.getUTCMinutes() / 60 + now.getUTCSeconds() / 3600);
    const sunLon = sunTrueLongitude(jd);
    const moonLon = moonLongitude(jd);
    const ayanamsha = lahiriAyanamsha(jd);
    const moonSidereal = stripNorm360(moonLon - ayanamsha);
    const elongation = stripNorm360(moonLon - sunLon);
    const tithiIdx = Math.floor(elongation / 12) % 30;
    const paksha = tithiIdx < 15 ? 'Shukla' : 'Krishna';
    const pakshaHi = tithiIdx < 15 ? 'शुक्ल' : 'कृष्ण';
    const nakIdx = Math.floor(moonSidereal / (360 / 27)) % 27;

    const tithiEl = document.getElementById('status-tithi');
    const nakEl = document.getElementById('status-nakshatra');
    const cityEl = document.getElementById('status-city');
    if (tithiEl) {
      tithiEl.textContent = isHindi
        ? `${pakshaHi} ${TITHIS[tithiIdx].nameHi}`
        : `${paksha} ${TITHIS[tithiIdx].name}`;
    }
    if (nakEl) {
      nakEl.textContent = isHindi
        ? `${NAKSHATRAS[nakIdx].nameHi} नक्षत्र`
        : `${NAKSHATRAS[nakIdx].name} Nakshatra`;
    }
    if (cityEl) cityEl.textContent = isHindi ? (loc.nameHi || loc.name) : loc.name;
  }
  updateStatusStrip();
  setInterval(updateStatusStrip, 60000);
  window.addEventListener('locationchange', updateStatusStrip);

  // ── Dark mode ──
  const html = document.documentElement;
  const darkToggle = document.getElementById('dark-toggle');
  const mDarkToggle = document.getElementById('m-dark-toggle');
  const iconSun = document.getElementById('icon-sun');
  const iconMoon = document.getElementById('icon-moon');
  const mIconSun = document.getElementById('m-icon-sun');
  const mIconMoon = document.getElementById('m-icon-moon');

  function applyDark(isDark: boolean) {
    if (isDark) {
      html.classList.remove('light');
      html.classList.add('dark');
      html.setAttribute('data-theme', 'dark');
    } else {
      html.classList.remove('dark');
      html.classList.add('light');
      html.removeAttribute('data-theme');
    }
    if (iconSun) iconSun.style.display = isDark ? 'block' : 'none';
    if (iconMoon) iconMoon.style.display = isDark ? 'none' : 'block';
    if (mIconSun) mIconSun.style.display = isDark ? 'block' : 'none';
    if (mIconMoon) mIconMoon.style.display = isDark ? 'none' : 'block';
    localStorage.setItem('dark', String(isDark));
  }

  applyDark(localStorage.getItem('dark') === 'true');

  darkToggle?.addEventListener('click', () => applyDark(!html.classList.contains('dark')));
  mDarkToggle?.addEventListener('click', () => applyDark(!html.classList.contains('dark')));

  // ── Language switching: nav labels + search placeholder ──
  // LanguagePicker.astro dispatches 'langchange' on <document>; this toggles
  // every [data-hi] element between its English textContent and Hindi label,
  // and swaps the search placeholder. Runs on every page since Header.astro
  // is included everywhere.
  function applyHeaderLang(hindi: boolean) {
    isHindi = hindi;
    updateClock();
    updateStatusStrip();
    document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
      if (!el.dataset.en) el.dataset.en = el.textContent || '';
      el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
      el.lang = hindi ? 'hi' : 'en';
    });
    // Looked up directly (not via the outer searchInput/drawerSearchInput consts
    // declared further down this script) because LanguagePicker.astro's replay
    // shim can invoke this function synchronously, from inside the addEventListener
    // call below, for returning visitors with a saved Hindi preference — i.e.
    // before those consts have been initialized. Referencing them here would
    // throw "Cannot access ... before initialization" (TDZ) and abort this
    // function partway through, silently skipping everything after it.
    const si = document.getElementById('search-input') as HTMLInputElement | null;
    if (si) si.placeholder = hindi ? 'पंचांग, त्योहार, मुहूर्त खोजें…' : 'Search panchang, festivals, muhurta…';
    const dsi = document.getElementById('drawer-search-input') as HTMLInputElement | null;
    if (dsi) dsi.placeholder = hindi ? 'खोजें…' : 'Search…';
    const clockLink = document.getElementById('clock-link');
    if (clockLink) clockLink.title = hindi ? 'आज का पंचांग' : "Today's Panchang";
    const statusStrip = document.getElementById('status-strip');
    if (statusStrip) statusStrip.title = hindi ? 'आज का पंचांग' : "Today's Panchang";
  }
  document.addEventListener('langchange', (e: Event) => {
    const evt = e as CustomEvent;
    applyHeaderLang(evt.detail.langCode === 'hi');
  });

  // ── Mobile drawer ──
  const hamburger = document.getElementById('hamburger');
  const drawer = document.getElementById('mobile-drawer');
  const overlay = document.getElementById('drawer-overlay');
  const drawerClose = document.getElementById('drawer-close');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  function openDrawer() {
    drawer?.classList.add('open');
    overlay?.classList.add('open');
    drawer?.setAttribute('aria-hidden', 'false');
    overlay?.setAttribute('aria-hidden', 'false');
    drawer?.removeAttribute('inert');
    overlay?.removeAttribute('inert');
    hamburger?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    if (hamburgerIcon) hamburgerIcon.style.display = 'none';
    if (closeIcon) closeIcon.style.display = 'block';
  }
  function closeDrawer() {
    drawer?.classList.remove('open');
    overlay?.classList.remove('open');
    drawer?.setAttribute('aria-hidden', 'true');
    overlay?.setAttribute('aria-hidden', 'true');
    drawer?.setAttribute('inert', '');
    overlay?.setAttribute('inert', '');
    hamburger?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    if (hamburgerIcon) hamburgerIcon.style.display = 'block';
    if (closeIcon) closeIcon.style.display = 'none';
    const dsi = document.getElementById('drawer-search-input') as HTMLInputElement | null;
    const dsd = document.getElementById('drawer-search-dropdown');
    if (dsi) dsi.value = '';
    if (dsd) dsd.hidden = true;
  }

  hamburger?.addEventListener('click', openDrawer);
  drawerClose?.addEventListener('click', closeDrawer);
  overlay?.addEventListener('click', closeDrawer);

  // Keyboard: Escape closes drawer
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDrawer();
  });

  // ── Drawer accordion ──
  document.querySelectorAll<HTMLButtonElement>('.drawer-cat').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.dataset.target;
      if (!targetId) return;
      const sub = document.getElementById(targetId);
      const isOpen = sub?.classList.contains('open');
      // close all
      document.querySelectorAll('.drawer-sub').forEach(s => s.classList.remove('open'));
      document.querySelectorAll('.drawer-cat').forEach(b => b.setAttribute('aria-expanded', 'false'));
      // toggle clicked
      if (!isOpen) {
        sub?.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });

  // ── Voice search ──
  const micBtn = document.getElementById('mic-btn');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;

  if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
    const SR = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
    const recog = new SR();
    recog.lang = 'en-IN';
    recog.interimResults = false;

    micBtn?.addEventListener('click', () => {
      micBtn.classList.add('listening');
      recog.start();
    });
    recog.onresult = (e: any) => {
      if (searchInput) searchInput.value = e.results[0][0].transcript;
      micBtn?.classList.remove('listening');
    };
    recog.onerror = () => micBtn?.classList.remove('listening');
    recog.onend = () => micBtn?.classList.remove('listening');
  } else {
    micBtn?.setAttribute('title', 'Voice search not supported in this browser');
  }

