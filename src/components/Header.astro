          <a href="/jyotish" class="nav-cat"><span class="nav-label" data-hi="ज्योतिष">Jyotish</span> <span class="nav-caret">▾</span></a>
          <div class="nav-dropdown" style="min-width:220px;">
            <a href="/jyotish/kundali" class="dd-link" data-hi="कुंडली जनरेटर">Kundali Generator</a>
            <a href="/jyotish/janma-kundali" class="dd-link" data-hi="जन्म कुंडली">Janma Kundali</a>
