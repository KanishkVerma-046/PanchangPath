            <a href="/panchang/malayalam" class="dd-link" data-hi="मलयालम पंचांगम">Malayalam Panchangam</a>
            <a href="/panchang/bengali" class="dd-link" data-hi="बंगाली पंजिका">Bengali Panjika</a>
