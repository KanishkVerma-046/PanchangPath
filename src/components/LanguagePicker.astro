---
interface LangOption {
  code: string;
  nativeName: string;
  label: string;   // short pill label
  name: string;    // English name
}

const LANGS: LangOption[] = [
  { code: 'en', nativeName: 'English', label: 'EN',  name: 'English' },
  { code: 'hi', nativeName: 'हिन्दी',  label: 'हिं', name: 'Hindi' },
];

// ── Hindi language toggle: re-enabled site-wide 2026-08-29 ──
// Was disabled 2026-08-15 (Task 0) pending translation coverage; see the matching
// flag + comment in src/layouts/Layout.astro's <head> shim for the full history.
// To disable again, flip both flags back to false together. While false, the
// pill+dropdown below renders `hidden` (not clickable/visible) and the script
// never resolves to 'hi', regardless of what's stored in localStorage.
const HINDI_ENABLED = true;
---

<!-- Language picker pill + dropdown -->
<div class="lng-root" id="lng-root" hidden={!HINDI_ENABLED}>
  <button class="lng-pill" id="lng-pill" aria-haspopup="listbox" aria-expanded="false" title="Change language">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
      <circle cx="12" cy="12" r="10"/>
      <line x1="2" y1="12" x2="22" y2="12"/>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
    </svg>
    <span id="lng-label" class="lng-label-txt">EN</span>
    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </button>

  <div class="lng-dropdown" id="lng-dropdown" role="listbox" aria-label="Select language" hidden>
    <!-- Interface section -->
    <p class="lng-section-head" data-hi="इंटरफ़ेस">Interface</p>
    {LANGS.map(l => (
      <button class="lng-opt" data-code={l.code} role="option">
        <span class="lng-opt-native">{l.nativeName}</span>
        <span class="lng-opt-name">{l.name}</span>
        <svg class="lng-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </button>
    ))}
  </div>
</div>

<div class="lng-backdrop" id="lng-backdrop" hidden></div>

<script define:vars={{ LANGS, HINDI_ENABLED }}>
// Reliable langchange delivery: consuming pages (index.astro, calendar.astro,
// festivals, rashifal, events, prashnavali, etc.) register a plain
// document.addEventListener('langchange', ...) listener, but heavier pages
// with async import chains (e.g. astro-core.ts) may not have registered that
// listener yet by the time a stored Hindi preference needs to be broadcast on
// load. A fixed setTimeout delay races that registration and can lose the
// event. This shim caches the most recently dispatched 'langchange' event and
// replays it to any listener the moment it's added, however late — so no
// consuming page needs to change how it subscribes.
(function setupLangChangeReplay() {
  let lastLangEvent = null;
  const nativeAddEventListener = document.addEventListener.bind(document);
  const nativeDispatchEvent = document.dispatchEvent.bind(document);

  document.addEventListener = function (type, listener, options) {
    nativeAddEventListener(type, listener, options);
    if (type === 'langchange' && lastLangEvent) {
      if (typeof listener === 'function') {
        listener(lastLangEvent);
      } else if (listener && typeof listener.handleEvent === 'function') {
        listener.handleEvent(lastLangEvent);
      }
    }
  };

  document.dispatchEvent = function (event) {
    if (event && event.type === 'langchange') lastLangEvent = event;
    return nativeDispatchEvent(event);
  };
})();

// Layout.astro's <head> shim already forces localStorage.getItem('pp-lang') to
// 'en' while HINDI_ENABLED is false, but currentLang is pinned here too as a
// second, independent guard so this component never resolves to 'hi' even if
// that shim is ever bypassed.
let currentLang = HINDI_ENABLED ? (localStorage.getItem('pp-lang') || 'en') : 'en';

function getLang(code) {
  return LANGS.find(l => l.code === code) || LANGS[0];
}

function updatePill() {
  const lang = getLang(currentLang);
  const label = document.getElementById('lng-label');
  if (label) label.textContent = lang.label;

  // Single global source of truth for the current language, read by
  // components (e.g. KundaliWidget.astro) that can't rely on catching the
  // langchange event.
  document.documentElement.dataset.lang = currentLang;

  // Update checked state
  document.querySelectorAll('.lng-opt').forEach(btn => {
    const isActive = btn.getAttribute('data-code') === currentLang;
    btn.classList.toggle('lng-opt-active', isActive);
  });
}

function openDropdown() {
  const dd = document.getElementById('lng-dropdown');
  const pill = document.getElementById('lng-pill');
  const backdrop = document.getElementById('lng-backdrop');
  if (!dd) return;

  const pillRect = pill ? pill.getBoundingClientRect() : null;
  if (pillRect) {
    dd.style.top = (pillRect.bottom + 6) + 'px';
    const rightEdge = window.innerWidth - pillRect.right;
    dd.style.right = Math.max(8, rightEdge) + 'px';
    dd.style.left = 'auto';
  }

  dd.hidden = false;
  if (backdrop) backdrop.hidden = false;
  pill?.setAttribute('aria-expanded', 'true');
}

function closeDropdown() {
  const dd = document.getElementById('lng-dropdown');
  const pill = document.getElementById('lng-pill');
  const backdrop = document.getElementById('lng-backdrop');
  if (dd) dd.hidden = true;
  if (backdrop) backdrop.hidden = true;
  pill?.setAttribute('aria-expanded', 'false');
}

function selectLang(code) {
  if (!HINDI_ENABLED) code = 'en';
  currentLang = code;
  localStorage.setItem('pp-lang', code);
  updatePill();
  closeDropdown();

  // Notify the page (index.astro listens)
  document.dispatchEvent(new CustomEvent('langchange', { detail: { langCode: code } }));
}

// Wire up
document.getElementById('lng-pill')?.addEventListener('click', () => {
  const dd = document.getElementById('lng-dropdown');
  dd?.hidden ? openDropdown() : closeDropdown();
});

document.getElementById('lng-backdrop')?.addEventListener('click', closeDropdown);

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeDropdown();
});

document.querySelectorAll('.lng-opt').forEach(btn => {
  btn.addEventListener('click', () => selectLang(btn.getAttribute('data-code') || 'en'));
});

// Init
updatePill();

// Broadcast the stored preference immediately. The replay shim above
// guarantees any page whose listener registers later (e.g. after awaiting
// heavy astro-core imports) still receives it, so no arbitrary delay is
// needed here.
if (currentLang !== 'en') {
  document.dispatchEvent(new CustomEvent('langchange', { detail: { langCode: currentLang } }));
}
</script>

<style>
/* ── Pill ── */
.lng-root { position: relative; flex-shrink: 0; }
.lng-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 30px;
  padding: 0 9px;
  background: var(--color-canvas-soft-2);
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-pill);
  font-family: var(--font-sans);
  font-size: 12px;
  font-weight: 600;
  color: var(--color-ink);
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.12s, border-color 0.12s, color 0.12s;
}
.lng-pill:hover { background: var(--color-canvas-soft); border-color: var(--color-saffron); color: var(--color-saffron-deep); }
.lng-pill[aria-expanded="true"] { border-color: var(--color-saffron); background: var(--color-saffron-soft); color: var(--color-saffron-deep); }
.lng-pill svg:first-child { color: var(--color-mute); flex-shrink: 0; }
.lng-label-txt { min-width: 18px; text-align: center; font-family: sans-serif; }

/* ── Backdrop ── */
.lng-backdrop { position: fixed; inset: 0; z-index: 199; }

/* ── Dropdown ── */
.lng-dropdown {
  position: fixed;
  z-index: 200;
  width: 220px;
  background: var(--color-canvas);
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-modal);
  overflow: hidden;
  max-height: 70vh;
  overflow-y: auto;
  animation: lng-in 160ms var(--ease-out) both;
  overscroll-behavior: contain;
  transform-origin: top right;
}
@keyframes lng-in {
  from { opacity: 0; transform: translateY(-8px) scale(0.97); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* ── Section head ──
   Purely decorative label, no click handler. It doesn't geometrically
   overlap the option rows below it at rest, but WebKit was observed
   intermittently treating it as intercepting taps aimed at the nearby
   option during the dropdown's slide-in animation (sticky elements can
   get their own compositing layer that paints above DOM-later siblings
   mid-transition). pointer-events:none removes it from hit-testing
   entirely, so it can never block a tap regardless of the transient
   stacking/animation state. */
.lng-section-head {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--color-mute);
  font-family: var(--font-mono);
  padding: 8px 12px 4px;
  margin: 0;
  position: sticky;
  top: 0;
  background: var(--color-canvas);
  pointer-events: none;
}

/* ── Options ── */
.lng-opt {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
  font-family: var(--font-sans);
  transition: background 0.08s;
}
.lng-opt:hover { background: var(--color-canvas-soft); }
.lng-opt-active { background: var(--color-saffron-soft); }
.lng-opt-active .lng-opt-native { color: var(--color-saffron-deep); }
.lng-opt-native {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-ink);
  min-width: 42px;
  font-family: sans-serif;
}
.lng-opt-name {
  font-size: 12px;
  color: var(--color-body-text);
  flex: 1;
}
.lng-check {
  color: var(--color-saffron);
  flex-shrink: 0;
  opacity: 0;
}
.lng-opt-active .lng-check { opacity: 1; }

/* ── Mobile: icon-only pill ──
   Padding/height bumped slightly above the desktop pill (30px) to keep
   the tap target closer to the 44px guideline now that the "EN" text
   label (which used to pad out the hit area) is hidden — there's ~13px
   of spare room in the icon row at 360px to spend on this safely. */
@media (max-width: 480px) {
  .lng-pill { padding: 0 10px; height: 38px; }
  .lng-label-txt { display: none; }
}

/* ── Mobile: bottom sheet ── */
@media (max-width: 600px) {
  .lng-dropdown {
    position: fixed !important;
    top: auto !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    animation: lng-sheet-in 0.2s cubic-bezier(0.4,0,0.2,1) both;
  }
  @keyframes lng-sheet-in {
    from { transform: translateY(100%); }
    to   { transform: translateY(0); }
  }
}
</style>
