---
import type { PlanetaryEvent } from '../lib/planetaryEvents';
import { formatCountdownLabel, formatEventDateTime } from '../lib/planetaryEvents';

interface Props {
  events: PlanetaryEvent[];
  today: Date;
  limit?: number;
}

const { events, today, limit = 8 } = Astro.props;
const displayed = events.slice(0, limit);

function typeLabel(type: string): string {
  switch (type) {
    case 'sign_transit':     return 'Transit';
    case 'retrograde_start': return 'Retrograde';
    case 'direct_start':     return 'Direct';
    case 'conjunction':      return 'Conjunction';
    case 'opposition':       return 'Opposition';
    case 'solar_eclipse':    return 'Solar Eclipse';
    case 'lunar_eclipse':    return 'Lunar Eclipse';
    case 'solstice_equinox': return 'Solstice / Equinox';
    default:                 return 'Event';
  }
}

function typeLabelHi(type: string): string {
  switch (type) {
    case 'sign_transit':     return 'गोचर';
    case 'retrograde_start': return 'वक्री';
    case 'direct_start':     return 'मार्गी';
    case 'conjunction':      return 'युति';
    case 'opposition':       return 'प्रतियुति';
    case 'solar_eclipse':    return 'सूर्य ग्रहण';
    case 'lunar_eclipse':    return 'चंद्र ग्रहण';
    case 'solstice_equinox': return 'अयनांत / विषुव';
    default:                 return 'घटना';
  }
}

function typeClass(type: string): string {
  switch (type) {
    case 'sign_transit':      return 'pef-tag-transit';
    case 'retrograde_start':  return 'pef-tag-retro';
    case 'direct_start':      return 'pef-tag-direct';
    case 'conjunction':       return 'pef-tag-aspect';
    case 'opposition':        return 'pef-tag-aspect';
    case 'solar_eclipse':
    case 'lunar_eclipse':     return 'pef-tag-eclipse';
    case 'solstice_equinox':  return 'pef-tag-season';
    default:                  return '';
  }
}
---

<section class="pef-section">
  <div class="pef-container">

    <!-- Header -->
    <div class="pef-header">
      <div>
        <p class="caption-mono" data-hi="आगामी" style="color:var(--color-mute);margin:0 0 6px;">Upcoming</p>
        <h2 class="pef-title">
          <span class="en-text">Planetary Events</span>&nbsp;
          <span class="hi-text" style="display:none">ग्रह घटनाएँ</span>
        </h2>
      </div>
      <a href="/events" class="pef-more-link">
        <span class="en-text">All events →</span>&nbsp;
        <span class="hi-text" style="display:none">सभी घटनाएँ →</span>
      </a>
    </div>

    <!-- Event list -->
    <ul class="pef-list" role="list">
      {displayed.map((ev, idx) => {
        const countdown = formatCountdownLabel(ev.daysAway);
        const datetime  = formatEventDateTime(ev);
        const isToday   = ev.daysAway === 0;
        const isSoon    = ev.daysAway <= 7;

        return (
          <li class="pef-row-li">
            <a
              href={`/events/${ev.id}`}
              class={`pef-row ${isToday ? 'pef-today' : ''}`}
              data-event-id={ev.id}
            >
              <!-- Timeline connector -->
              <div class="pef-timeline">
                <div class="pef-dot-wrap">
                  <span class="pef-icon" style={`color:${ev.badgeColor}`} aria-hidden="true">
                    {ev.icon}
                  </span>
                </div>
                {idx < displayed.length - 1 && <div class="pef-line" aria-hidden="true"></div>}
              </div>

              <!-- Content -->
              <div class="pef-content">
                <div class="pef-meta">
                  <span class={`pef-tag ${typeClass(ev.type)}`} data-hi={typeLabelHi(ev.type)}>
                    {typeLabel(ev.type)}
                  </span>
                  <span class={`pef-countdown ${isToday ? 'pef-now' : isSoon ? 'pef-soon' : ''}`}>
                    {isToday && <span class="pef-pulse" aria-hidden="true"></span>}
                    <span class="pef-countdown-text">{countdown}</span>
                  </span>
                </div>

                <p class="pef-name">
                  <span class="en-text">{ev.title}</span>&nbsp;
                  <span class="hi-text" style="display:none">{ev.titleHi}</span>
                </p>
                <p class="pef-datetime">{datetime}</p>
                <p class="pef-desc" data-hi={ev.descriptionHi}>{ev.description}</p>
              </div>

              <!-- Arrow -->
              <span class="pef-arrow" aria-hidden="true">›</span>
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Footer link -->
    <a href="/events" class="pef-view-all">
      <span class="en-text">View all upcoming planetary events</span>
      <span class="hi-text">सभी ग्रह घटनाएँ देखें</span>
      <span class="pef-arrow-sm">→</span>
    </a>

  </div>
</section>

<script define:vars={{ eventsData: displayed.map(ev => ({ id: ev.id, dateISO: ev.dateISO, timeUTC: ev.timeUTC })) }}>
  // ── Scroll-in reveal: slide-up + fade-in, staggered 60ms per row ──
  (function () {
    const rows = Array.from(document.querySelectorAll('.pef-row'));
    if (!rows.length) return;
    rows.forEach((el, i) => { el.dataset.revealIndex = String(i); });

    const observer = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        const idx = Number(el.dataset.revealIndex || '0');
        el.style.transitionDelay = (idx * 60) + 'ms';
        el.classList.add('pef-visible');
        obs.unobserve(el);
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

    rows.forEach((el) => observer.observe(el));
  })();

  // ── Live Hindi-aware countdown ──
  // Mirrors the formatCountdown() pattern in events/index.astro and events/[id].astro
  // so this homepage widget's countdown badges also flip to Hindi on langchange
  // instead of staying frozen in whatever language the page built in.
  function formatCountdown(daysAway, hindi) {
    if (!hindi) {
      if (daysAway === 0) return 'Today';
      if (daysAway === 1) return 'Tomorrow';
      if (daysAway < 7)   return `${daysAway} Days`;
      if (daysAway < 30)  return `${Math.floor(daysAway / 7)}w ${daysAway % 7}d`;
      const months = Math.floor(daysAway / 30);
      const rem = daysAway % 30;
      return rem > 0 ? `${months}m ${rem}d` : `${months} Month${months > 1 ? 's' : ''}`;
    }
    if (daysAway === 0) return 'आज';
    if (daysAway === 1) return 'कल';
    if (daysAway < 7)   return `${daysAway} दिन`;
    if (daysAway < 30)  return `${Math.floor(daysAway / 7)} सप्ताह ${daysAway % 7} दिन`;
    const months = Math.floor(daysAway / 30);
    const rem = daysAway % 30;
    return rem > 0 ? `${months} माह ${rem} दिन` : `${months} माह`;
  }

  const byId = {};
  for (const ev of eventsData) byId[ev.id] = ev;
  let pefHindi = localStorage.getItem('pp-lang') === 'hi';

  function pefUpdateRows() {
    document.querySelectorAll('.pef-row[data-event-id]').forEach((row) => {
      const ev = byId[row.dataset.eventId];
      if (!ev) return;
      const eventMs = Date.parse(ev.dateISO + 'T00:00:00Z') + ev.timeUTC * 3600 * 1000;
      const daysAway = Math.round((eventMs - Date.now()) / 86400000);
      const text = row.querySelector('.pef-countdown-text');
      if (text) text.textContent = formatCountdown(daysAway, pefHindi);
    });
  }
  pefUpdateRows();
  document.addEventListener('langchange', (e) => {
    pefHindi = e.detail.langCode === 'hi';
    pefUpdateRows();
  });
</script>

<style>
.pef-section {
  padding: 48px 0;
  border-top: 1px solid var(--color-hairline);
}
.pef-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ── Header ── */
.pef-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 24px;
  gap: 12px;
}
.pef-title {
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.6px;
  color: var(--color-ink);
  margin: 0;
}
.pef-more-link {
  font-size: 13px;
  font-weight: 500;
  color: var(--color-saffron-deep);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
}
.pef-more-link:hover { text-decoration: underline; }

/* ── List ── */
.pef-list {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin: 0;
  padding: 0;
  list-style: none;
  border: 1px solid var(--color-hairline);
  border-radius: 12px;
  box-shadow: var(--shadow-elevation);
  overflow: hidden;
}
.pef-row-li { list-style: none; }

/* ── Row ── */
.pef-row {
  display: flex;
  align-items: flex-start;
  gap: 0;
  padding: 0;
  text-decoration: none;
  color: inherit;
  border-bottom: 1px solid var(--color-hairline);
  transition: background 0.15s, opacity 0.5s ease, translate 0.5s ease;
  position: relative;
  opacity: 0;
  translate: 0 18px;
}
.pef-row.pef-visible {
  opacity: 1;
  translate: 0 0;
}
@media (prefers-reduced-motion: reduce) {
  .pef-row { opacity: 1; translate: 0 0; transition: background 0.15s; }
}
.pef-row-li:last-child .pef-row { border-bottom: none; }
.pef-row:hover { background: var(--color-canvas-soft); }
.pef-row.pef-today { background: rgba(255, 153, 51, 0.05); }
.pef-row.pef-today:hover { background: rgba(255, 153, 51, 0.09); }

/* ── Timeline column ── */
.pef-timeline {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 52px;
  flex-shrink: 0;
  padding-top: 16px;
}
.pef-dot-wrap {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--color-canvas-soft);
  border: 1px solid var(--color-hairline);
  flex-shrink: 0;
}
.pef-icon {
  font-size: 16px;
  line-height: 1;
  display: block;
}
.pef-line {
  width: 1px;
  flex: 1;
  min-height: 12px;
  background: var(--color-hairline);
  margin-top: 4px;
  margin-bottom: -1px;
}

/* ── Content column ── */
.pef-content {
  flex: 1;
  min-width: 0;
  padding: 14px 8px 14px 4px;
}

/* Meta row */
.pef-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 5px;
  flex-wrap: wrap;
}

/* Type tag */
.pef-tag {
  display: inline-block;
  font-size: 9.5px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 2px 7px;
  border-radius: 4px;
}
.pef-tag-transit  { background: rgba(255,153,51,0.12); color: #c05c00; }
.pef-tag-retro    { background: rgba(220,38,38,0.10);  color: #b91c1c; }
.pef-tag-direct   { background: rgba(21,128,61,0.10);  color: #15803d; }
.pef-tag-aspect   { background: rgba(124,58,237,0.10); color: #6d28d9; }
.pef-tag-eclipse  { background: rgba(30,27,75,0.12);   color: #312e81; }
.pef-tag-season   { background: rgba(14,165,233,0.10); color: #0369a1; }
html.dark .pef-tag-transit  { background: rgba(255,153,51,0.18); color: #fb923c; }
html.dark .pef-tag-retro    { background: rgba(220,38,38,0.18);  color: #fca5a5; }
html.dark .pef-tag-direct   { background: rgba(21,128,61,0.18);  color: #86efac; }
html.dark .pef-tag-aspect   { background: rgba(167,139,250,0.18);color: #c4b5fd; }
html.dark .pef-tag-eclipse  { background: rgba(99,102,241,0.18); color: #a5b4fc; }
html.dark .pef-tag-season   { background: rgba(56,189,248,0.18); color: #7dd3fc; }

/* Countdown */
.pef-countdown {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 10.5px;
  font-weight: 700;
  font-family: var(--font-mono, monospace);
  color: var(--color-mute);
  letter-spacing: 0.03em;
}
.pef-now  { color: var(--color-saffron-deep); }
.pef-soon { color: #b45309; }
.pef-pulse {
  display: inline-block;
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--color-saffron);
  animation: pef-blink 1.4s ease-in-out infinite;
}
@keyframes pef-blink { 0%,100%{opacity:1} 50%{opacity:0.3} }

/* Event name */
.pef-name {
  font-size: 14px;
  font-weight: 700;
  color: var(--color-ink);
  margin: 0 0 3px;
  line-height: 1.3;
}
.pef-row:hover .pef-name { color: var(--color-saffron-deep); }

/* Date/time */
.pef-datetime {
  font-size: 11px;
  font-family: var(--font-mono, monospace);
  color: var(--color-mute);
  margin: 0 0 4px;
}

/* Short description */
.pef-desc {
  font-size: 12px;
  color: var(--color-body-text);
  margin: 0;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
@media (min-width: 640px) {
  .pef-desc { -webkit-line-clamp: 2; }
}

/* Arrow */
.pef-arrow {
  font-size: 20px;
  color: var(--color-hairline);
  padding: 16px 16px 16px 8px;
  align-self: center;
  flex-shrink: 0;
  transition: color 0.15s;
}
.pef-row:hover .pef-arrow { color: var(--color-saffron); }

/* ── View all footer ── */
.pef-view-all {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 16px;
  padding: 11px 0;
  font-size: 13px;
  font-weight: 600;
  color: var(--color-saffron-deep);
  text-decoration: none;
  border: 1px solid var(--color-hairline);
  border-radius: 8px;
  background: var(--color-canvas-soft);
  transition: border-color 0.15s, background 0.15s;
}
.pef-view-all:hover {
  border-color: var(--color-saffron);
  background: var(--color-saffron-soft);
}
.pef-arrow-sm { font-size: 15px; }
</style>
