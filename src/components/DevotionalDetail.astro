---
import type { DevotionalItem, CategoryMeta } from '../lib/devotional/types';
import BreadcrumbSchema from './seo/BreadcrumbSchema.astro';

interface RelatedLink {
  label: string;
  labelHi?: string;
  href: string;
}

interface Props {
  item: DevotionalItem;
  category: CategoryMeta;
  prev: DevotionalItem | null;
  next: DevotionalItem | null;
  lyricsLabel?: string;
  meaningLabel?: string;
  benefitsLabel?: string;
  relatedLinks?: RelatedLink[];
}

const {
  item, category, prev, next,
  lyricsLabel = 'Lyrics (Devanagari)',
  meaningLabel = 'Meaning',
  benefitsLabel = 'When & Why It Is Recited',
  relatedLinks = [],
} = Astro.props;

// UI-chrome Hindi translations. Covers the default section labels plus every
// lyricsLabel/meaningLabel/benefitsLabel override passed by the per-category
// [slug].astro pages (see durga-saptashati, yantra, puja-vidhi, namavali,
// vrat-katha, sundarkand). Falls back to the English string if unmapped.
const LABEL_HI: Record<string, string> = {
  'Lyrics (Devanagari)': 'बोल (देवनागरी)',
  'Meaning': 'अर्थ',
  'When & Why It Is Recited': 'कब और क्यों पढ़ा जाता है',
  'Sanskrit Text (Devanagari)': 'संस्कृत पाठ (देवनागरी)',
  'Chapter Summary': 'अध्याय सारांश',
  'Significance': 'महत्व',
  'Associated Mantra': 'संबंधित मंत्र',
  'Structure & Presiding Deity': 'संरचना और अधिष्ठाता देवता',
  'Installation & Puja Vidhi': 'स्थापना और पूजा विधि',
  'Samagri (Materials Needed)': 'सामग्री (आवश्यक वस्तुएं)',
  'Step-by-Step Vidhi': 'चरणबद्ध विधि',
  'Auspicious Timing & Mantras': 'शुभ समय और मंत्र',
  '108 Names (Devanagari)': '108 नाम (देवनागरी)',
  'About This Namavali': 'इस नामावली के बारे में',
  'Archana & Recitation Guide': 'अर्चना और पाठ मार्गदर्शिका',
  'Katha (Story)': 'कथा',
  'How the Vrat Is Observed': 'व्रत कैसे रखा जाता है',
  'Full Text (Awadhi / Sanskrit, Devanagari)': 'पूर्ण पाठ (अवधी / संस्कृत, देवनागरी)',
  'Summary': 'सारांश',
};
const lyricsLabelHi = LABEL_HI[lyricsLabel] ?? lyricsLabel;
const meaningLabelHi = LABEL_HI[meaningLabel] ?? meaningLabel;
const benefitsLabelHi = LABEL_HI[benefitsLabel] ?? benefitsLabel;

// UI-chrome Hindi translations for the category blurb shown in the sidebar.
const DESC_HI: Record<string, string> = {
  'aarti': 'पूजा के दौरान देवताओं की आरती में गाए जाने वाले भक्ति गीत, हिंदी बोल, लिप्यंतरण और अर्थ सहित।',
  'chalisa': 'देवता के गुणों और कार्यों की स्तुति में चालीस दोहों वाले भक्ति स्तोत्र, आशीर्वाद और सुरक्षा हेतु पाठ किए जाते हैं।',
  'stotram': 'ऋषियों द्वारा रचित संस्कृत स्तुति गीत, आध्यात्मिक पुण्य और ईश्वरीय कृपा हेतु पाठ किए जाते हैं।',
  'ashtakam': 'एक ही देवता को समर्पित आठ श्लोकों वाले संस्कृत स्तोत्र, अपनी संक्षिप्त भक्ति शक्ति के लिए विशेष।',
  'mantra': 'शब्दार्थ अनुवाद, अर्थ और जप विधि सहित पवित्र वैदिक मंत्र।',
  'yantra': 'पूजा हेतु पवित्र ज्यामितीय आकृतियां, प्रत्येक यंत्र की स्थापना, पूजा विधि और लाभ सहित।',
  'namavali': 'अर्चना और जप हेतु देवताओं की 108 (अष्टोत्तरशतनामावली) और 1000 नाम (सहस्रनामावली) की सूचियां।',
  'durga-saptashati': 'देवी माहात्म्य के सभी 13 अध्याय — देवी दुर्गा की असुरों पर विजय की गाथा।',
  'sundarkand': 'रामचरितमानस का पांचवां सोपान, हनुमान जी की लंका यात्रा का वर्णन — साहस और सुरक्षा हेतु पाठ किया जाता है।',
  'nama-ramayanam': 'श्री राम के नामों और महिमा के माध्यम से पूर्णतः वर्णित रामायण की कथा, भक्ति गीत के रूप में गाई जाती है।',
  'vrat-katha': 'व्रत के दौरान सुनाई जाने वाली पारंपरिक कथाएं, जो व्रत की उत्पत्ति और महत्व को समझाती हैं।',
  'puja-vidhi': 'प्रमुख त्योहारों के दौरान सही ढंग से पूजा करने हेतु चरणबद्ध विधि मार्गदर्शिका।',
};
const backToCategoryHi = `← ${category.labelHi} पर वापस`;
---

<BreadcrumbSchema items={[
  { name: 'Home', url: '/' },
  { name: 'Devotional', url: '/devotional' },
  { name: category.label, url: category.url },
  { name: item.title, url: `${category.url}/${item.slug}` },
]} />

<!-- ── Hero ── -->
<section class="dv-hero" style={`background:${category.gradient}`}>
  <div class="dv-hero-inner">
    <span class="dv-icon" aria-hidden="true">{item.icon}</span>
    <div class="dv-hero-text">
      <div class="dv-breadcrumb">
        <a href="/" data-hi="होम">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/devotional" data-hi="भक्ति पुस्तकालय">Devotional</a>
        <span aria-hidden="true">›</span>
        <a href={category.url} data-hi={category.labelHi}>{category.label}</a>
        <span aria-hidden="true">›</span>
        <span class="en-text">{item.title}</span><span class="hi-text" style="display:none">{item.titleHi}</span>
      </div>
      <h1 class="dv-heading">
        <span class="en-text">{item.title}</span><span class="hi-text" style="display:none">{item.titleHi}</span>
      </h1>
      {item.deity && (
        <span class="dv-deity-badge">
          ✦ <span class="en-text">{item.deity}</span><span class="hi-text" style="display:none">{item.deityHi ?? item.deity}</span>
        </span>
      )}
    </div>
  </div>
</section>

<!-- ── Main content ── -->
<div class="dv-wrapper">
  <div class="dv-grid">

    <article class="dv-main">

      <!-- Lyrics -->
      <div class="dv-section">
        <div class="dv-section-header">
          <h2 class="dv-section-title" data-hi={lyricsLabelHi}>{lyricsLabel}</h2>
          {item.transliteration && (
            <button id="dv-translit-toggle" class="dv-toggle-btn" type="button">Show Transliteration</button>
          )}
        </div>
        <div class="dv-lyrics-card">
          <pre class="dv-lyrics-hi" id="dv-lyrics-hi">{item.lyricsHi}</pre>
          {item.transliteration && (
            <pre class="dv-lyrics-translit" id="dv-lyrics-translit" hidden>{item.transliteration}</pre>
          )}
        </div>
      </div>

      {item.meaning && (
        <div class="dv-section">
          <h2 class="dv-section-title" data-hi={meaningLabelHi}>{meaningLabel}</h2>
          <p class="dv-body" data-hi={item.meaningHi}>{item.meaning}</p>
        </div>
      )}

      {item.benefits && (
        <div class="dv-section">
          <h2 class="dv-section-title" data-hi={benefitsLabelHi}>{benefitsLabel}</h2>
          <p class="dv-body" data-hi={item.benefitsHi}>{item.benefits}</p>
        </div>
      )}

    </article>

    <!-- Sidebar -->
    <aside class="dv-sidebar">
      <div class="dv-side-card">
        <h3 class="dv-side-title" data-hi={category.labelHi}>{category.label}</h3>
        <p class="dv-side-body" data-hi={DESC_HI[category.id]}>{category.description}</p>
        <a href={category.url} class="dv-side-btn" data-hi={backToCategoryHi}>← Back to {category.label}</a>
      </div>
      {relatedLinks.length > 0 && (
        <div class="dv-side-card">
          <h3 class="dv-side-title" data-hi="संबंधित">Related</h3>
          {relatedLinks.map(link => (
            <a href={link.href} class="dv-side-btn" style="margin-bottom:8px" data-hi={link.labelHi ?? link.label}>{link.label} →</a>
          ))}
        </div>
      )}
      <div class="dv-side-card">
        <h3 class="dv-side-title" data-hi="भक्ति पुस्तकालय">Devotional Library</h3>
        <p class="dv-side-body" data-hi="आरती, चालीसा, स्तोत्र, मंत्र, व्रत कथा और बहुत कुछ देखें।">Explore aartis, chalisas, stotrams, mantras, vrat kathas and more.</p>
        <a href="/devotional" class="dv-side-btn" data-hi="पूरी लाइब्रेरी देखें →">View Full Library →</a>
      </div>
    </aside>

  </div>

  <!-- Prev / Next navigation -->
  <nav class="dv-nav" aria-label={`${category.label} navigation`}>
    {prev ? (
      <a href={`${category.url}/${prev.slug}`} class="dv-nav-btn dv-nav-prev">
        <span class="dv-nav-arrow">←</span>
        <div class="dv-nav-meta">
          <span class="dv-nav-label" data-hi="पिछला">Previous</span>
          <span class="dv-nav-name en-text">{prev.title}</span>
          <span class="dv-nav-name hi-text" style="display:none">{prev.titleHi}</span>
        </div>
      </a>
    ) : <div></div>}
    {next && (
      <a href={`${category.url}/${next.slug}`} class="dv-nav-btn dv-nav-next">
        <div class="dv-nav-meta">
          <span class="dv-nav-label" data-hi="अगला">Next</span>
          <span class="dv-nav-name en-text">{next.title}</span>
          <span class="dv-nav-name hi-text" style="display:none">{next.titleHi}</span>
        </div>
        <span class="dv-nav-arrow">→</span>
      </a>
    )}
  </nav>
</div>

<script>
  const toggleBtn = document.getElementById('dv-translit-toggle');
  const hiBlock = document.getElementById('dv-lyrics-hi');
  const translitBlock = document.getElementById('dv-lyrics-translit');
  let showingTranslit = false;
  let isHindiLang = false;

  function updateToggleBtnText() {
    if (!toggleBtn) return;
    if (showingTranslit) {
      toggleBtn.textContent = isHindiLang ? 'देवनागरी दिखाएं' : 'Show Devanagari';
    } else {
      toggleBtn.textContent = isHindiLang ? 'लिप्यंतरण दिखाएं' : 'Show Transliteration';
    }
  }

  toggleBtn?.addEventListener('click', () => {
    showingTranslit = !showingTranslit;
    if (hiBlock) hiBlock.hidden = showingTranslit;
    if (translitBlock) translitBlock.hidden = !showingTranslit;
    updateToggleBtnText();
  });

  function applyPageLang(hindi: boolean) {
    isHindiLang = hindi;
    document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
      if (!el.dataset.en) el.dataset.en = el.textContent || '';
      el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
    });
    document.querySelectorAll<HTMLElement>('.en-text').forEach(el => { el.style.display = hindi ? 'none' : ''; });
    document.querySelectorAll<HTMLElement>('.hi-text').forEach(el => { el.style.display = hindi ? '' : 'none'; });
    updateToggleBtnText();
  }
  document.addEventListener('langchange', (e: Event) => {
    applyPageLang((e as CustomEvent).detail.langCode === 'hi');
  });
  if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>

<style>
.dv-hero { padding: 48px 0 40px; position: relative; overflow: hidden; }
.dv-hero::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.22) 100%);
  pointer-events: none;
}
.dv-hero-inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 28px; position: relative; z-index: 1; }
.dv-icon { font-size: 64px; filter: drop-shadow(0 4px 16px rgba(0,0,0,0.22)); flex-shrink: 0; line-height: 1; }
.dv-hero-text { flex: 1; min-width: 0; }
.dv-breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 12px; color: rgba(255,255,255,0.75); margin-bottom: 10px; }
.dv-breadcrumb a { color: rgba(255,255,255,0.75); text-decoration: none; }
.dv-breadcrumb a:hover { color: #fff; }
.dv-heading { font-size: 30px; font-weight: 800; letter-spacing: -1px; color: #fff; margin: 0 0 12px; text-shadow: 0 2px 12px rgba(0,0,0,0.2); line-height: 1.2; }
@media (max-width: 640px) { .dv-heading { font-size: 22px; } .dv-icon { font-size: 48px; } }
.dv-deity-badge {
  display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600;
  background: rgba(255,255,255,0.22); color: #fff; -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.3);
}

.dv-wrapper { max-width: 1200px; margin: 0 auto; padding: 40px 24px 60px; }
.dv-grid { display: grid; grid-template-columns: 1fr 300px; gap: 32px; align-items: start; }
@media (max-width: 768px) { .dv-grid { grid-template-columns: 1fr; } }

.dv-section { margin-bottom: 32px; }
.dv-section-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-bottom: 10px; border-bottom: 1px solid var(--color-hairline); margin-bottom: 14px; }
.dv-section-title { font-size: 15px; font-weight: 700; color: var(--color-ink); margin: 0; }
.dv-toggle-btn {
  padding: 5px 12px; border-radius: 999px; font-size: 11.5px; font-weight: 600;
  background: var(--color-canvas-soft-2); border: 1px solid var(--color-hairline); color: var(--color-ink); cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
}
.dv-toggle-btn:hover { background: var(--color-saffron-soft); border-color: var(--color-saffron); }

.dv-lyrics-card { border: 1px solid var(--color-hairline); border-radius: 10px; box-shadow: var(--shadow-elevation); padding: 24px; background: var(--color-canvas-soft); }
.dv-lyrics-hi, .dv-lyrics-translit {
  font-family: var(--font-sans); white-space: pre-line; font-size: 16px; line-height: 2.1; color: var(--color-ink); margin: 0;
}
.dv-lyrics-translit { font-style: italic; color: var(--color-body-text); }

.dv-body { font-size: 16px; line-height: 1.75; color: var(--color-body-text); margin: 0; }

.dv-sidebar { position: sticky; top: 90px; }
.dv-side-card { border: 1px solid var(--color-hairline); border-radius: 10px; box-shadow: var(--shadow-elevation); padding: 18px; margin-bottom: 16px; }
.dv-side-title { font-size: 13px; font-weight: 700; color: var(--color-ink); margin: 0 0 8px; }
.dv-side-body { font-size: 14px; color: var(--color-body-text); margin: 0 0 14px; line-height: 1.6; }
.dv-side-btn {
  display: block; text-align: center; padding: 8px 16px; background: var(--color-canvas-soft); border: 1px solid var(--color-hairline);
  border-radius: 6px; font-size: 12.5px; font-weight: 500; color: var(--color-ink); text-decoration: none; transition: background 0.15s;
}
.dv-side-btn:hover { background: var(--color-saffron-soft); border-color: var(--color-saffron); }

.dv-nav { display: flex; justify-content: space-between; gap: 16px; margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--color-hairline); }
.dv-nav-btn { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border: 1px solid var(--color-hairline); border-radius: 8px; text-decoration: none; color: var(--color-ink); transition: border-color 0.15s, background 0.15s; max-width: 260px; }
.dv-nav-btn:hover { border-color: var(--color-saffron); background: var(--color-saffron-soft); }
.dv-nav-next { text-align: right; margin-left: auto; }
.dv-nav-arrow { font-size: 18px; color: var(--color-saffron); flex-shrink: 0; }
.dv-nav-meta { display: flex; flex-direction: column; gap: 2px; }
.dv-nav-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-mute); font-weight: 600; }
.dv-nav-name { font-size: 13px; font-weight: 600; line-height: 1.3; }
</style>
