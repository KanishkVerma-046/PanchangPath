---
import type { DevotionalItem, CategoryMeta } from '../lib/devotional/types';

interface Props {
  item: DevotionalItem;
  category: CategoryMeta;
  prev: DevotionalItem | null;
  next: DevotionalItem | null;
  lyricsLabel?: string;
  meaningLabel?: string;
  benefitsLabel?: string;
}

const {
  item, category, prev, next,
  lyricsLabel = 'Lyrics (Devanagari)',
  meaningLabel = 'Meaning',
  benefitsLabel = 'When & Why It Is Recited',
} = Astro.props;
---

<!-- ── Hero ── -->
<section class="dv-hero" style={`background:${category.gradient}`}>
  <div class="dv-hero-inner">
    <span class="dv-icon" aria-hidden="true">{item.icon}</span>
    <div class="dv-hero-text">
      <div class="dv-breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/devotional">Devotional</a>
        <span aria-hidden="true">›</span>
        <a href={category.url}>{category.label}</a>
        <span aria-hidden="true">›</span>
        <span>{item.title}</span>
      </div>
      <h1 class="dv-heading en-text">{item.title}</h1>
      <h1 class="dv-heading hi-text">{item.titleHi}</h1>
      {item.deity && (
        <span class="dv-deity-badge">✦ {item.deity}</span>
      )}
    </div>
  </div>
</section>

<!-- ── Main content ── -->
<div class="dv-wrapper">
  <div class="dv-grid">

    <article class="dv-main">

      <!-- Lyrics -->
      <div class="dv-section">
        <div class="dv-section-header">
          <h2 class="dv-section-title">{lyricsLabel}</h2>
          {item.transliteration && (
            <button id="dv-translit-toggle" class="dv-toggle-btn" type="button">Show Transliteration</button>
          )}
        </div>
        <div class="dv-lyrics-card">
          <pre class="dv-lyrics-hi" id="dv-lyrics-hi">{item.lyricsHi}</pre>
          {item.transliteration && (
            <pre class="dv-lyrics-translit" id="dv-lyrics-translit" hidden>{item.transliteration}</pre>
          )}
        </div>
      </div>

      {item.meaning && (
        <div class="dv-section">
          <h2 class="dv-section-title">{meaningLabel}</h2>
          <p class="dv-body">{item.meaning}</p>
        </div>
      )}

      {item.benefits && (
        <div class="dv-section">
          <h2 class="dv-section-title">{benefitsLabel}</h2>
          <p class="dv-body">{item.benefits}</p>
        </div>
      )}

    </article>

    <!-- Sidebar -->
    <aside class="dv-sidebar">
      <div class="dv-side-card">
        <h3 class="dv-side-title">{category.label}</h3>
        <p class="dv-side-body">{category.description}</p>
        <a href={category.url} class="dv-side-btn">← Back to {category.label}</a>
      </div>
      <div class="dv-side-card">
        <h3 class="dv-side-title">Devotional Library</h3>
        <p class="dv-side-body">Explore aartis, chalisas, stotrams, mantras, vrat kathas and more.</p>
        <a href="/devotional" class="dv-side-btn">View Full Library →</a>
      </div>
    </aside>

  </div>

  <!-- Prev / Next navigation -->
  <nav class="dv-nav" aria-label={`${category.label} navigation`}>
    {prev ? (
      <a href={`${category.url}/${prev.slug}`} class="dv-nav-btn dv-nav-prev">
        <span class="dv-nav-arrow">←</span>
        <div class="dv-nav-meta">
          <span class="dv-nav-label">Previous</span>
          <span class="dv-nav-name en-text">{prev.title}</span>
        </div>
      </a>
    ) : <div></div>}
    {next && (
      <a href={`${category.url}/${next.slug}`} class="dv-nav-btn dv-nav-next">
        <div class="dv-nav-meta">
          <span class="dv-nav-label">Next</span>
          <span class="dv-nav-name en-text">{next.title}</span>
        </div>
        <span class="dv-nav-arrow">→</span>
      </a>
    )}
  </nav>
</div>

<script>
  const toggleBtn = document.getElementById('dv-translit-toggle');
  const hiBlock = document.getElementById('dv-lyrics-hi');
  const translitBlock = document.getElementById('dv-lyrics-translit');
  let showingTranslit = false;
  toggleBtn?.addEventListener('click', () => {
    showingTranslit = !showingTranslit;
    if (hiBlock) hiBlock.hidden = showingTranslit;
    if (translitBlock) translitBlock.hidden = !showingTranslit;
    toggleBtn.textContent = showingTranslit ? 'Show Devanagari' : 'Show Transliteration';
  });
</script>

<style>
.dv-hero { padding: 48px 0 40px; position: relative; overflow: hidden; }
.dv-hero::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.22) 100%);
  pointer-events: none;
}
.dv-hero-inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; gap: 28px; position: relative; z-index: 1; }
.dv-icon { font-size: 64px; filter: drop-shadow(0 4px 16px rgba(0,0,0,0.22)); flex-shrink: 0; line-height: 1; }
.dv-hero-text { flex: 1; min-width: 0; }
.dv-breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 12px; color: rgba(255,255,255,0.75); margin-bottom: 10px; }
.dv-breadcrumb a { color: rgba(255,255,255,0.75); text-decoration: none; }
.dv-breadcrumb a:hover { color: #fff; }
.dv-heading { font-size: 30px; font-weight: 800; letter-spacing: -1px; color: #fff; margin: 0 0 12px; text-shadow: 0 2px 12px rgba(0,0,0,0.2); line-height: 1.2; }
@media (max-width: 640px) { .dv-heading { font-size: 22px; } .dv-icon { font-size: 48px; } }
.dv-deity-badge {
  display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 600;
  background: rgba(255,255,255,0.22); color: #fff; backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.3);
}

.dv-wrapper { max-width: 1200px; margin: 0 auto; padding: 40px 24px 60px; }
.dv-grid { display: grid; grid-template-columns: 1fr 300px; gap: 32px; align-items: start; }
@media (max-width: 768px) { .dv-grid { grid-template-columns: 1fr; } }

.dv-section { margin-bottom: 32px; }
.dv-section-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-bottom: 10px; border-bottom: 1px solid var(--color-hairline); margin-bottom: 14px; }
.dv-section-title { font-size: 15px; font-weight: 700; color: var(--color-ink); margin: 0; }
.dv-toggle-btn {
  padding: 5px 12px; border-radius: 999px; font-size: 11.5px; font-weight: 600;
  background: var(--color-canvas-soft-2); border: 1px solid var(--color-hairline); color: var(--color-ink); cursor: pointer;
  transition: background 0.15s, border-color 0.15s;
}
.dv-toggle-btn:hover { background: var(--color-saffron-soft); border-color: var(--color-saffron); }

.dv-lyrics-card { border: 1px solid var(--color-hairline); border-radius: 10px; padding: 24px; background: var(--color-canvas-soft); }
.dv-lyrics-hi, .dv-lyrics-translit {
  font-family: var(--font-sans); white-space: pre-line; font-size: 16px; line-height: 2.1; color: var(--color-ink); margin: 0;
}
.dv-lyrics-translit { font-style: italic; color: var(--color-body-text); }

.dv-body { font-size: 14.5px; line-height: 1.75; color: var(--color-body-text); margin: 0; }

.dv-sidebar { position: sticky; top: 90px; }
.dv-side-card { border: 1px solid var(--color-hairline); border-radius: 10px; padding: 18px; margin-bottom: 16px; }
.dv-side-title { font-size: 13px; font-weight: 700; color: var(--color-ink); margin: 0 0 8px; }
.dv-side-body { font-size: 12.5px; color: var(--color-body-text); margin: 0 0 14px; line-height: 1.6; }
.dv-side-btn {
  display: block; text-align: center; padding: 8px 16px; background: var(--color-canvas-soft); border: 1px solid var(--color-hairline);
  border-radius: 6px; font-size: 12.5px; font-weight: 500; color: var(--color-ink); text-decoration: none; transition: background 0.15s;
}
.dv-side-btn:hover { background: var(--color-saffron-soft); border-color: var(--color-saffron); }

.dv-nav { display: flex; justify-content: space-between; gap: 16px; margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--color-hairline); }
.dv-nav-btn { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border: 1px solid var(--color-hairline); border-radius: 8px; text-decoration: none; color: var(--color-ink); transition: border-color 0.15s, background 0.15s; max-width: 260px; }
.dv-nav-btn:hover { border-color: var(--color-saffron); background: var(--color-saffron-soft); }
.dv-nav-next { text-align: right; margin-left: auto; }
.dv-nav-arrow { font-size: 18px; color: var(--color-saffron); flex-shrink: 0; }
.dv-nav-meta { display: flex; flex-direction: column; gap: 2px; }
.dv-nav-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-mute); font-weight: 600; }
.dv-nav-name { font-size: 13px; font-weight: 600; line-height: 1.3; }
</style>
