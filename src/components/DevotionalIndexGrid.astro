---
import type { DevotionalItem, CategoryMeta } from '../lib/devotional/types';

interface Props {
  category: CategoryMeta;
  items: DevotionalItem[];
}

const { category, items } = Astro.props;

// UI-chrome Hindi translations for the category blurb shown in this shared grid.
// (Item content itself — titleHi etc. — is out of scope and already bilingual.)
const DESC_HI: Record<string, string> = {
  'aarti': 'पूजा के दौरान देवताओं की आरती में गाए जाने वाले भक्ति गीत, हिंदी बोल, लिप्यंतरण और अर्थ सहित।',
  'chalisa': 'देवता के गुणों और कार्यों की स्तुति में चालीस दोहों वाले भक्ति स्तोत्र, आशीर्वाद और सुरक्षा हेतु पाठ किए जाते हैं।',
  'stotram': 'ऋषियों द्वारा रचित संस्कृत स्तुति गीत, आध्यात्मिक पुण्य और ईश्वरीय कृपा हेतु पाठ किए जाते हैं।',
  'ashtakam': 'एक ही देवता को समर्पित आठ श्लोकों वाले संस्कृत स्तोत्र, अपनी संक्षिप्त भक्ति शक्ति के लिए विशेष।',
  'mantra': 'शब्दार्थ अनुवाद, अर्थ और जप विधि सहित पवित्र वैदिक मंत्र।',
  'yantra': 'पूजा हेतु पवित्र ज्यामितीय आकृतियां, प्रत्येक यंत्र की स्थापना, पूजा विधि और लाभ सहित।',
  'namavali': 'अर्चना और जप हेतु देवताओं की 108 (अष्टोत्तरशतनामावली) और 1000 नाम (सहस्रनामावली) की सूचियां।',
  'durga-saptashati': 'देवी माहात्म्य के सभी 13 अध्याय — देवी दुर्गा की असुरों पर विजय की गाथा।',
  'sundarkand': 'रामचरितमानस का पांचवां सोपान, हनुमान जी की लंका यात्रा का वर्णन — साहस और सुरक्षा हेतु पाठ किया जाता है।',
  'nama-ramayanam': 'श्री राम के नामों और महिमा के माध्यम से पूर्णतः वर्णित रामायण की कथा, भक्ति गीत के रूप में गाई जाती है।',
  'vrat-katha': 'व्रत के दौरान सुनाई जाने वाली पारंपरिक कथाएं, जो व्रत की उत्पत्ति और महत्व को समझाती हैं।',
  'puja-vidhi': 'प्रमुख त्योहारों के दौरान सही ढंग से पूजा करने हेतु चरणबद्ध विधि मार्गदर्शिका।',
};
---

<!-- Hero -->
<section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:48px 0 40px;position:relative;overflow:hidden;">
  <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.5;pointer-events:none;"></div>
  <div class="container" style="position:relative;">
    <div class="dv-breadcrumb reveal">
      <a href="/" data-hi="होम">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/devotional" data-hi="भक्ति पुस्तकालय">Devotional</a>
      <span aria-hidden="true">›</span>
      <span data-hi={category.labelHi}>{category.label}</span>
    </div>
    <p class="eyebrow reveal" style="transition-delay:40ms;">{category.icon} {category.labelHi.toUpperCase()}</p>
    <h1 class="reveal" data-hi={category.labelHi} style="font-size:34px;font-weight:600;letter-spacing:-1.4px;color:var(--color-ink);margin:0 0 12px;transition-delay:80ms;">{category.label}</h1>
    <p class="reveal" data-hi={DESC_HI[category.id]} style="font-size:16px;color:var(--color-body-text);margin:0;max-width:640px;line-height:1.6;transition-delay:120ms;">{category.description}</p>
  </div>
</section>

<!-- Grid -->
<section style="padding:36px 0 48px;">
  <div class="container">
    <div class="dv-idx-grid">
      {items.map((item, i) => (
        <a href={`${category.url}/${item.slug}`} class="dv-idx-card card reveal" style={`transition-delay:${Math.min(i, 8) * 40}ms;`}>
          <span class="dv-idx-icon">{item.icon}</span>
          <div>
            <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 4px;"><span class="en-text">{item.title}</span><span class="hi-text" style="display:none">{item.titleHi}</span></h3>
            <p style="font-size:13px;color:var(--color-mute);margin:0;font-family:var(--font-sans);"><span class="en-text">{item.titleHi}</span><span class="hi-text" style="display:none">{item.title}</span></p>
            {item.deity && (
              <p style="font-size:11.5px;color:var(--color-saffron-deep);margin:4px 0 0;font-weight:600;">
                <span class="en-text">{item.deity}</span><span class="hi-text" style="display:none">{item.deityHi ?? item.deity}</span>
              </p>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  function applyPageLang(hindi: boolean) {
    document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
      if (!el.dataset.en) el.dataset.en = el.textContent || '';
      el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
    });
    document.querySelectorAll<HTMLElement>('.en-text').forEach(el => { el.style.display = hindi ? 'none' : ''; });
    document.querySelectorAll<HTMLElement>('.hi-text').forEach(el => { el.style.display = hindi ? '' : 'none'; });
  }
  document.addEventListener('langchange', (e: Event) => {
    applyPageLang((e as CustomEvent).detail.langCode === 'hi');
  });
  if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>

<style>
  .dv-breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--color-mute); }
  .dv-breadcrumb a { color: var(--color-mute); text-decoration: none; transition: color 160ms var(--ease-out); }
  .dv-breadcrumb a:hover { color: var(--color-ink); }
  .dv-idx-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .dv-idx-card { display: flex; align-items: flex-start; gap: 12px; padding: 18px; text-decoration: none; min-width: 0; }
  .dv-idx-card > div { min-width: 0; }
  .dv-idx-icon { font-size: 26px; line-height: 1; flex-shrink: 0; }
  @media (max-width: 900px) { .dv-idx-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) { .dv-idx-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
