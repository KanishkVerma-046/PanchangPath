---
import type { DevotionalItem, CategoryMeta } from '../lib/devotional/types';

interface Props {
  category: CategoryMeta;
  items: DevotionalItem[];
}

const { category, items } = Astro.props;
---

<!-- Hero -->
<section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:48px 0 40px;position:relative;overflow:hidden;">
  <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.5;pointer-events:none;"></div>
  <div class="container" style="position:relative;">
    <div class="dv-breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/devotional">Devotional</a>
      <span aria-hidden="true">›</span>
      <span>{category.label}</span>
    </div>
    <p class="caption-mono" style="color:var(--color-mute);margin:8px 0;">{category.labelHi.toUpperCase()} · {category.icon}</p>
    <h1 style="font-size:34px;font-weight:600;letter-spacing:-1.4px;color:var(--color-ink);margin:0 0 12px;">{category.label}</h1>
    <p style="font-size:16px;color:var(--color-body-text);margin:0;max-width:640px;line-height:1.6;">{category.description}</p>
  </div>
</section>

<!-- Grid -->
<section style="padding:36px 0 48px;">
  <div class="container">
    <div class="dv-idx-grid">
      {items.map((item) => (
        <a href={`${category.url}/${item.slug}`} class="dv-idx-card card">
          <span class="dv-idx-icon">{item.icon}</span>
          <div>
            <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">{item.title}</h3>
            <p style="font-size:13px;color:var(--color-mute);margin:0;font-family:var(--font-sans);" class="hi-text">{item.titleHi}</p>
            {item.deity && <p style="font-size:11.5px;color:var(--color-saffron-deep);margin:4px 0 0;font-weight:600;">{item.deity}</p>}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .dv-breadcrumb { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--color-mute); }
  .dv-breadcrumb a { color: var(--color-mute); text-decoration: none; }
  .dv-breadcrumb a:hover { color: var(--color-ink); }
  .dv-idx-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .dv-idx-card { display: flex; align-items: flex-start; gap: 12px; padding: 18px; text-decoration: none; min-width: 0; }
  .dv-idx-card > div { min-width: 0; }
  .dv-idx-icon { font-size: 26px; line-height: 1; flex-shrink: 0; }
  @media (max-width: 900px) { .dv-idx-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) { .dv-idx-grid { grid-template-columns: repeat(2, 1fr); } }
</style>
