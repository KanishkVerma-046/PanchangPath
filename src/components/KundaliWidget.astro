---
import { calculateKundali, RASHIS, GRAHA_META, jdFull, drawNorthDiamond } from '../lib/kundali';
import { getDefaultLocation } from '../lib/locations';
import { PLANET_ICONS } from '../lib/icons/planets';
import PlanetIcon from './icons/PlanetIcon.astro';

const loc  = getDefaultLocation();
const now  = new Date();
const init = calculateKundali(now, loc.lat, loc.lng, loc.tzOffset);
// Default chart style is North (matches the "active" tab below); the client <script> calls
// this exact same drawNorthDiamond()/drawSouthGrid() pair on tab switch / location change, so
// the prerendered chart and the hydrated one are always built from identical code.
const initChartSvg = drawNorthDiamond(init);
---

<!-- ─── Lagna Kundali Widget ─── -->
<section class="kw-section" id="kundali-widget-root">
  <p class="eyebrow reveal">Live Birth Chart</p>
  <div class="kw-card bezel-outer reveal">
   <div class="bezel-inner">

    <!-- Header row -->
    <div class="kw-header">
      <div>
        <h2 class="kw-title" data-hi="लग्न कुंडली">Lagna Kundali</h2>
        <p class="kw-subtitle" id="kw-subtitle">
          {loc.name} · <span id="kw-timestamp"></span>
          <span class="kw-live-tag"><span class="en-text">Live position</span><span class="hi-text" style="display:none">लाइव स्थिति</span></span>
        </p>
      </div>
      <div class="kw-tabs" role="group" aria-label="Chart style">
        <button class="kw-tab active" data-style="north" data-hi="उत्तर">North</button>
        <button class="kw-tab"        data-style="south" data-hi="दक्षिण">South</button>
      </div>
    </div>

    <!-- Content: chart + table -->
    <div class="kw-body">

      <!-- Chart panel -->
      <div class="kw-chart-panel">
        <div class="kw-chart-container" id="kw-chart-container" set:html={initChartSvg}>
        </div>
        <!-- Lagna info under chart -->
        <div class="kw-lagna-row">
          <span class="kw-lagna-label" data-hi="लग्न:">Lagna:</span>
          <span id="kw-lagna-sign" class="kw-lagna-val">{init.lagna.signName}</span>
          <span id="kw-lagna-deg"  class="kw-lagna-deg">{init.lagna.deg}° {init.lagna.min}'</span>
        </div>
      </div>

      <!-- Planet table -->
      <div class="kw-table-wrap">
        <table class="kw-table">
          <thead>
            <tr>
              <th data-hi="ग्रह">Graha</th>
              <th data-hi="राशि">Rashi</th>
              <th data-hi="अंश">Deg</th>
              <th data-hi="गति">Motion</th>
            </tr>
          </thead>
          <tbody id="kw-tbody">
            {init.grahas.map(g => (
              <tr class="kw-row" data-planet={g.id} title={`Click for details — ${g.name}`}>
                <td>
                  <PlanetIcon name={g.id} size={14} class="kw-sym" />
                  <span class="en-text">{g.name}</span>&nbsp;
                  <span class="hi-text" style="display:none">{g.nameHi}</span>
                </td>
                <td>
                  <span class="en-text">{g.signName}</span>&nbsp;
                  <span class="hi-text" style="display:none">{g.signNameHi}</span>
                </td>
                <td class="kw-deg-cell">{g.deg}°{String(g.min).padStart(2,'0')}'</td>
                <td>
                  <span class={`kw-badge ${g.isRetrograde ? 'vakri' : 'margi'}`}>{g.motion}</span>
                  {g.isCombust && <span class="kw-badge asta">Asta</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div><!-- .kw-body -->

    <!-- Footer -->
    <div class="kw-footer">
      <span class="kw-note" data-hi="लाहिड़ी अयनांश · उष्णकटिबंधीय से नाक्षत्र">Lahiri Ayanamsha · Tropical-to-Sidereal</span>
      <a href="/jyotish/kundali" class="ps-more-link">
        <span data-hi="पूर्ण कुंडली">Full Kundali</span>
        <span class="arrow-chip">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </span>
      </a>
    </div>

   </div><!-- .bezel-inner -->
  </div><!-- .kw-card -->

  <!-- Planet detail popup -->
  <div class="kw-popup" id="kw-popup" aria-live="polite" hidden>
    <button class="kw-popup-close" id="kw-popup-close" aria-label="Close">×</button>
    <div id="kw-popup-body"></div>
  </div>

</section>

<!-- ─── Styles ───
     is:global — the North (SVG) and South (grid) chart markup is generated
     client-side via innerHTML, so it never gets Astro's scoping attribute;
     scoped selectors would silently fail to match that injected content. -->
<style is:global>
.kw-section {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px 40px;
  position: relative;
}

/* Background/border/radius/shadow/overflow now come from
   .bezel-outer/.bezel-inner (see global.css). */

/* ── Header ── */
.kw-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 20px 24px 16px;
  border-bottom: 1px solid var(--color-hairline);
  background: linear-gradient(135deg, var(--color-saffron-soft) 0%, var(--color-canvas) 60%);
}
.kw-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--color-ink);
  margin: 0 0 4px;
}
.kw-subtitle {
  font-size: 12px;
  color: var(--color-mute);
  margin: 0;
  font-family: var(--font-mono, monospace);
}
.kw-live-tag {
  display: inline-flex;
  align-items: center;
  font-size: 10px;
  font-weight: 600;
  font-family: var(--font-sans, sans-serif);
  padding: 2px 7px;
  margin-left: 4px;
  border-radius: 9999px;
  border: 1px solid rgba(34, 197, 94, 0.3);
  background: var(--color-auspicious-soft);
  color: #15803d;
}

/* ── Tabs ── */
.kw-tabs {
  display: flex;
  border: 1px solid var(--color-hairline);
  border-radius: 6px;
  overflow: hidden;
  flex-shrink: 0;
}
.kw-tab {
  padding: 5px 14px;
  font-size: 12px;
  font-weight: 500;
  background: transparent;
  border: none;
  cursor: pointer;
  color: var(--color-mute);
  transition: background 160ms var(--ease-out), color 160ms var(--ease-out), transform 160ms var(--ease-out);
}
.kw-tab:active { transform: scale(0.94); }
.kw-tab + .kw-tab { border-left: 1px solid var(--color-hairline); }
.kw-tab.active {
  background: var(--color-saffron);
  color: #fff;
}
.kw-tab:not(.active):hover { background: var(--color-canvas-soft); color: var(--color-ink); }

/* ── Body layout ── */
.kw-body {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0;
  align-items: start;
}
@media (max-width: 640px) {
  .kw-body { grid-template-columns: 1fr; }
}

/* ── Chart panel ── */
.kw-chart-panel {
  padding: 20px 16px 20px 20px;
  border-right: 1px solid var(--color-hairline);
}
@media (max-width: 640px) {
  .kw-chart-panel {
    border-right: none;
    border-bottom: 1px solid var(--color-hairline);
    padding: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
}

.kw-chart-container {
  width: 272px;
  height: 272px;
}
.kw-chart-container svg { display: block; max-width: 100%; }

.kw-grid {
  display: grid;
  grid-template-columns: repeat(4, 68px);
  grid-template-rows: repeat(4, 68px);
  background: var(--color-kundali-bg);
  border: 2px solid var(--color-kundali-grid);
  border-radius: 4px;
  width: 272px;
  height: 272px;
}

.kw-cell {
  border: 1px solid var(--color-kundali-grid);
  position: relative;
  overflow: hidden;
  padding: 3px;
  font-size: 10px;
  line-height: 1.3;
  box-sizing: border-box;
}
.kw-cell.kw-center {
  background: var(--color-kundali-bg);
  border-color: var(--color-kundali-grid);
  display: flex;
  align-items: center;
  justify-content: center;
}
.kw-cell.kw-lagna-cell {
  background: color-mix(in srgb, var(--color-saffron) 12%, var(--color-kundali-bg));
}
.kw-om {
  font-size: 18px;
  opacity: 0.25;
}

/* ── Lagna info row ── */
.kw-lagna-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 10px;
  font-size: 12px;
}
.kw-lagna-label { color: var(--color-mute); }
.kw-lagna-val   { font-weight: 600; color: var(--color-saffron-deep); }
.kw-lagna-deg   { font-family: var(--font-mono, monospace); color: var(--color-mute); font-size: 11px; }

/* ── Planet table ── */
.kw-table-wrap {
  overflow-x: auto;
  padding: 16px 20px;
}
.kw-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12.5px;
}
.kw-table th {
  text-align: left;
  color: var(--color-mute);
  font-weight: 600;
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 0 8px 8px 0;
  border-bottom: 1px solid var(--color-hairline);
}
.kw-table td {
  padding: 7px 8px 7px 0;
  border-bottom: 1px solid var(--color-hairline);
  color: var(--color-ink);
  vertical-align: middle;
}
.kw-row { cursor: pointer; }
.kw-row:hover td { background: var(--color-canvas-soft); }
.kw-sym {
  margin-right: 5px;
  vertical-align: middle;
  display: inline-block;
}
.kw-deg-cell { font-family: var(--font-mono, monospace); font-size: 11.5px; }

.kw-badge {
  display: inline-block;
  padding: 1px 7px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 0.03em;
  margin-right: 3px;
}
.kw-badge.margi  { background: #e8f5e9; color: #2e7d32; }
.kw-badge.vakri  { background: #fce4ec; color: #c62828; }
.kw-badge.asta   { background: #f3e5f5; color: #6a1b9a; }
html.dark .kw-badge.margi { background: #1b3a1e; color: #81c784; }
html.dark .kw-badge.vakri { background: #3e1212; color: #ef9a9a; }
html.dark .kw-badge.asta  { background: #2d1040; color: #ce93d8; }

/* ── Footer ── */
.kw-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px;
  border-top: 1px solid var(--color-hairline);
  background: var(--color-canvas-soft);
}
.kw-note { font-size: 11px; color: var(--color-mute); font-family: var(--font-mono, monospace); }

/* ── Popup ── */
.kw-popup {
  position: fixed;
  bottom: 80px;
  right: 24px;
  width: 240px;
  background: var(--color-canvas);
  border: 1px solid var(--color-hairline-strong);
  border-radius: 10px;
  box-shadow: 0 8px 32px rgba(0,0,0,0.18);
  z-index: 1000;
  padding: 16px;
}
.kw-popup[hidden] { display: none; }
.kw-popup-close {
  position: absolute;
  top: 8px; right: 10px;
  background: none; border: none;
  font-size: 18px; color: var(--color-mute);
  cursor: pointer;
  line-height: 1;
}
#kw-popup-body { font-size: 12.5px; color: var(--color-ink); }

/* ── Cell content generated by JS ── */
.kwc-chip {
  font-size: 9.5px;
  font-weight: 700;
  padding: 1px 3px;
  border-radius: 2px;
  background: var(--color-kundali-bg);
  color: var(--color-kundali-label);
  cursor: pointer;
  transition: background 0.12s;
  user-select: none;
}
.kwc-chip:hover { background: color-mix(in srgb, var(--color-saffron) 25%, var(--color-kundali-bg)); }
.kwc-chip.vakri { color: #c62828; }
.kwc-chip.asta  { color: var(--color-mute); }
text.kwc-chip:hover { fill: var(--color-saffron-deep) !important; }
.kw-diamond-house { font-family: var(--font-mono); }
/* South Indian rashi label */
.kwc-si-rashi {
  position: absolute;
  top: 2px; left: 0; right: 0;
  text-align: center;
  font-size: 8px;
  color: var(--color-kundali-house);
  font-weight: 500;
}
.kwc-si-lagna {
  position: absolute;
  top: 12px; left: 0; right: 0;
  text-align: center;
  font-size: 8px;
  font-weight: 700;
  color: var(--color-saffron-deep);
}
.kwc-si-planets {
  position: absolute;
  bottom: 3px; left: 2px; right: 2px;
  display: flex;
  flex-wrap: wrap;
  gap: 1px;
  justify-content: center;
}
</style>

<!-- `define:vars` forces a script into is:inline mode, which skips TypeScript
     compilation — fatal for the type-annotated script below. Pass the data
     as embedded JSON instead, so the script stays a normal (processed) module. -->
<script type="application/json" id="planet-icons-data" set:html={JSON.stringify(PLANET_ICONS).replace(/</g, '\\u003c')}></script>

<!-- ─── Client script ─── -->
<script>
import { calculateKundali, drawNorthDiamond, drawSouthGrid } from '../lib/kundali';
import { onVisible } from '../lib/lazy-init';

const PLANET_ICONS: Record<string, string> = JSON.parse(document.getElementById('planet-icons-data')!.textContent || '{}');

function planetIconSvg(id: string, size: number) {
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:middle;margin-right:5px;">${PLANET_ICONS[id]}</svg>`;
}

// ─── Chart rendering ──────────────────────────────────────────────────────────
let currentStyle = 'north';
let currentData: ReturnType<typeof calculateKundali> | null = null;

function renderChart(data: ReturnType<typeof calculateKundali>, style: string) {
  const container = document.getElementById('kw-chart-container');
  if (!container) return;
  container.innerHTML = style === 'north' ? drawNorthDiamond(data) : drawSouthGrid(data);
}

// ─── Planet table ─────────────────────────────────────────────────────────────
function renderTable(data: ReturnType<typeof calculateKundali>, isHindi: boolean) {
  const tbody = document.getElementById('kw-tbody')!;
  const isHi = isHindi || document.documentElement.dataset.lang === 'hi';
  tbody.innerHTML = data.grahas.map(g => `
    <tr class="kw-row" data-planet="${g.id}" style="cursor:pointer">
      <td>${planetIconSvg(g.id, 14)}<span>${isHi ? g.nameHi : g.name}</span></td>
      <td>${isHi ? g.signNameHi : g.signName}</td>
      <td class="kw-deg-cell">${g.deg}°${String(g.min).padStart(2,'0')}'</td>
      <td>
        <span class="kw-badge ${g.isRetrograde?'vakri':'margi'}">${g.isRetrograde?(isHi?'वक्री':'Vakri'):(isHi?'मार्गी':'Margi')}</span>
        ${g.isCombust?`<span class="kw-badge asta">${isHi?'अस्त':'Asta'}</span>`:''}
      </td>
    </tr>
  `).join('');

  // Re-attach row click listeners
  tbody.querySelectorAll<HTMLElement>('.kw-row').forEach(row => {
    row.addEventListener('click', () => showPopup(row.dataset.planet!, data));
  });
}

// ─── Lagna info ───────────────────────────────────────────────────────────────
function updateLagnaInfo(data: ReturnType<typeof calculateKundali>) {
  const isHi = document.documentElement.dataset.lang === 'hi';
  const ls = document.getElementById('kw-lagna-sign');
  const ld = document.getElementById('kw-lagna-deg');
  if (ls) ls.textContent = isHi ? data.lagna.signNameHi : data.lagna.signName;
  if (ld) ld.textContent = `${data.lagna.deg}° ${data.lagna.min}'`;
}

// ─── Popup ────────────────────────────────────────────────────────────────────
function showPopup(pid: string, data: ReturnType<typeof calculateKundali>) {
  const g = data.grahas.find(x => x.id === pid);
  if (!g) return;
  const isHi = document.documentElement.dataset.lang === 'hi';
  const popup = document.getElementById('kw-popup')!;
  const body  = document.getElementById('kw-popup-body')!;
  body.innerHTML = `
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;">
      ${planetIconSvg(g.id, 22)}
      <div>
        <div style="font-weight:700;font-size:14px">${isHi?g.nameHi:g.name}</div>
        <div style="font-size:11px;color:var(--color-mute)">${isHi?g.name:g.nameHi}</div>
      </div>
    </div>
    <table style="width:100%;border-collapse:collapse;font-size:12px">
      <tr><td style="color:var(--color-mute);padding:3px 0">${isHi?'राशि':'Rashi'}</td><td style="font-weight:600">${isHi?g.signNameHi:g.signName}</td></tr>
      <tr><td style="color:var(--color-mute);padding:3px 0">${isHi?'अंश':'Degree'}</td><td style="font-family:monospace">${g.deg}° ${g.min}'</td></tr>
      <tr><td style="color:var(--color-mute);padding:3px 0">${isHi?'गति':'Motion'}</td><td><span class="kw-badge ${g.isRetrograde?'vakri':'margi'}">${g.isRetrograde?(isHi?'वक्री':'Vakri'):(isHi?'मार्गी':'Margi')}</span></td></tr>
      <tr><td style="color:var(--color-mute);padding:3px 0">${isHi?'दृश्यता':'Visibility'}</td><td><span class="kw-badge ${g.isCombust?'asta':'margi'}">${g.isCombust?(isHi?'अस्त':'Asta'):(isHi?'उदित':'Udita')}</span></td></tr>
    </table>
  `;
  popup.hidden = false;
}

function hidePopup() {
  const p = document.getElementById('kw-popup');
  if (p) p.hidden = true;
}

// ─── Full render ──────────────────────────────────────────────────────────────
function fullRender(data: ReturnType<typeof calculateKundali>) {
  currentData = data;
  renderChart(data, currentStyle);
  renderTable(data, document.documentElement.dataset.lang === 'hi');
  updateLagnaInfo(data);
}

// ─── Timestamp ────────────────────────────────────────────────────────────────
function updateTimestamp(date: Date, cityName: string) {
  const el = document.getElementById('kw-timestamp');
  const sub = document.getElementById('kw-subtitle');
  if (!el) return;
  const t = date.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',hour12:true});
  el.textContent = t;
  if (sub) {
    const cityEl = sub.querySelector('span:first-child');
    if (!cityEl) {
      const isHi = document.documentElement.dataset.lang === 'hi';
      sub.innerHTML = `${cityName} · <span id="kw-timestamp">${t}</span>
        <span class="kw-live-tag"><span class="en-text" style="${isHi ? 'display:none' : ''}">Live position</span><span class="hi-text" style="${isHi ? '' : 'display:none'}">लाइव स्थिति</span></span>`;
    }
  }
}

// ─── State ────────────────────────────────────────────────────────────────────
let kwLat = 28.6139, kwLng = 77.2090, kwCity = 'New Delhi';
let kwActivated = false;

// Global function called by index.astro after location changes
(window as any).updateKundaliWidget = function(lat: number, lng: number, cityName: string) {
  kwLat = lat; kwLng = lng; kwCity = cityName;
  // If the widget hasn't scrolled into view yet, skip the render — activate()
  // (below) will pick up these updated coordinates whenever it does.
  if (!kwActivated) return;
  const now = new Date();
  const data = calculateKundali(now, lat, lng, 0);
  fullRender(data);
  updateTimestamp(now, cityName);
};

// ─── Init & live Lagna update ─────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  // The server-rendered chart/table (see the frontmatter's initChartSvg) is
  // already correct as of build time, so there's no empty-state flash here —
  // only the "make it live" recompute below is deferred until the widget is
  // about to scroll into view, instead of running (and forcing a page-wide
  // relayout) on every load regardless of whether anyone scrolls to it.
  function activate() {
    kwActivated = true;
    const now = new Date();
    const data = calculateKundali(now, kwLat, kwLng, 0);
    fullRender(data);
    updateTimestamp(now, kwCity);

    // Live Lagna update every 2 minutes (Lagna changes ~2° per minute)
    setInterval(() => {
      const now = new Date();
      const data = calculateKundali(now, kwLat, kwLng, 0);
      fullRender(data);
      updateTimestamp(now, kwCity);
    }, 120_000);
  }
  onVisible(document.getElementById('kundali-widget-root'), activate);

  // Tab switching
  document.querySelectorAll<HTMLElement>('.kw-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.kw-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      currentStyle = btn.dataset.style!;
      if (currentData) renderChart(currentData, currentStyle);
    });
  });

  // Planet chip clicks (delegated to chart container — works for both the
  // SVG diamond's <text class="kwc-chip"> and the South grid's <span> chips)
  document.getElementById('kw-chart-container')!.addEventListener('click', e => {
    const chip = (e.target as Element).closest<HTMLElement>('.kwc-chip');
    if (chip && currentData) showPopup(chip.dataset.pid!, currentData);
  });

  // Close popup
  document.getElementById('kw-popup-close')?.addEventListener('click', hidePopup);
  document.addEventListener('click', e => {
    const popup = document.getElementById('kw-popup');
    if (popup && !popup.hidden && !popup.contains(e.target as Node)) {
      const chart = document.getElementById('kw-chart-container');
      const tbody = document.getElementById('kw-tbody');
      if (!chart?.contains(e.target as Node) && !tbody?.contains(e.target as Node)) {
        hidePopup();
      }
    }
  });

  // Language change: re-render table labels
  document.addEventListener('langchange', () => {
    if (currentData) {
      renderTable(currentData, document.documentElement.dataset.lang === 'hi');
      updateLagnaInfo(currentData);
    }
  });
});
</script>
