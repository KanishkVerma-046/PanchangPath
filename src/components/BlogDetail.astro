---
import type { BlogPost } from '../lib/blog';
import { estimateReadingTime } from '../lib/blog';
import { formatDateHi } from '../lib/date-i18n';

interface Props {
  post: BlogPost;
  prev: BlogPost | null;
  next: BlogPost | null;
}

const { post, prev, next } = Astro.props;

const publishDateLabel = formatDateHi(new Date(post.publishDate), false);
const publishDateLabelHi = formatDateHi(new Date(post.publishDate), true);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  author: { '@type': 'Organization', name: 'PanchangPath' },
  publisher: {
    '@type': 'Organization',
    name: 'PanchangPath',
    logo: { '@type': 'ImageObject', url: 'https://panchangpath.com/favicon.svg' },
  },
  datePublished: post.publishDate,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `https://panchangpath.com/blog/${post.slug}` },
};

// Every post ends its English body with a "Frequently Asked Questions" H2 followed by
// H3/P pairs; extract those pairs for FAQPage schema rather than hand-maintaining a
// separate FAQ list per post.
const stripTags = (s: string) => s.replace(/<[^>]+>/g, '').trim();
const faqSectionStart = post.contentHtml.indexOf('Frequently Asked Questions');
const faqSection = faqSectionStart >= 0 ? post.contentHtml.slice(faqSectionStart) : '';
const faqPairs = [...faqSection.matchAll(/<h3>([\s\S]*?)<\/h3>\s*<p>([\s\S]*?)<\/p>/g)];
const faqJsonLd = faqPairs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqPairs.map(([, q, a]) => ({
    '@type': 'Question',
    name: stripTags(q),
    acceptedAnswer: { '@type': 'Answer', text: stripTags(a) },
  })),
} : null;
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
{faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

<!-- Hero -->
<section class="bl-hero">
  <div class="bl-hero-inner">
    <div class="bl-breadcrumb reveal">
      <a href="/" data-hi="होम">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/blog" data-hi="ब्लॉग">Blog</a>
      <span aria-hidden="true">›</span>
      <span data-hi={post.titleHi}>{post.title}</span>
    </div>
    <h1 class="bl-heading reveal" style="transition-delay:60ms;" data-hi={post.titleHi}>{post.title}</h1>
    <p class="bl-hero-meta reveal" style="transition-delay:120ms;">
      <span data-hi={publishDateLabelHi}>{publishDateLabel}</span>
      {' · '}{estimateReadingTime(post.contentHtml)} <span data-hi="मिनट में पढ़ें">min read</span>
    </p>
  </div>
</section>

<!-- Main content -->
<div class="bl-wrapper">
  <article class="bl-article en-text" set:html={post.contentHtml} />
  {post.contentHtmlHi && (
    <article class="bl-article hi-text" style="display:none" set:html={post.contentHtmlHi} />
  )}

  <!-- Prev / Next navigation -->
  <nav class="bl-nav" aria-label="Blog navigation">
    {prev ? (
      <a href={`/blog/${prev.slug}`} class="bl-nav-btn bl-nav-prev">
        <span class="bl-nav-arrow">←</span>
        <div class="bl-nav-meta">
          <span class="bl-nav-label" data-hi="पिछला">Previous</span>
          <span class="bl-nav-name" data-hi={prev.titleHi}>{prev.title}</span>
        </div>
      </a>
    ) : <div></div>}
    {next && (
      <a href={`/blog/${next.slug}`} class="bl-nav-btn bl-nav-next">
        <div class="bl-nav-meta">
          <span class="bl-nav-label" data-hi="अगला">Next</span>
          <span class="bl-nav-name" data-hi={next.titleHi}>{next.title}</span>
        </div>
        <span class="bl-nav-arrow">→</span>
      </a>
    )}
  </nav>
</div>

<script>
  // The article body (post.contentHtml/contentHtmlHi) is raw HTML with embedded
  // links, so it's rendered as two full en-text/hi-text <article> blocks rather
  // than using data-hi's textContent-based swap, which would strip the links.
  function applyPageLang(hindi: boolean) {
    const hasHindi = document.querySelector('.hi-text') !== null;
    document.querySelectorAll<HTMLElement>('.en-text').forEach(el => el.style.display = (hindi && hasHindi) ? 'none' : '');
    document.querySelectorAll<HTMLElement>('.hi-text').forEach(el => el.style.display = hindi ? '' : 'none');
  }
  document.addEventListener('langchange', (e: Event) => {
    applyPageLang((e as CustomEvent).detail.langCode === 'hi');
  });
  if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>

<style>
.bl-hero { padding: 48px 0 32px; border-bottom: 1px solid var(--color-hairline); }
.bl-hero-inner { max-width: 800px; margin: 0 auto; padding: 0 24px; }
.bl-breadcrumb { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: 12px; color: var(--color-mute); margin-bottom: 12px; }
.bl-breadcrumb a { color: var(--color-mute); text-decoration: none; }
.bl-breadcrumb a:hover { color: var(--color-ink); }
.bl-heading { font-size: 32px; font-weight: 700; letter-spacing: -1px; color: var(--color-ink); margin: 0 0 12px; line-height: 1.2; }
@media (max-width: 640px) { .bl-heading { font-size: 24px; } }
.bl-hero-meta { font-size: 12.5px; color: var(--color-mute); margin: 0; }

.bl-wrapper { max-width: 800px; margin: 0 auto; padding: 40px 24px 60px; }
.bl-article { font-size: 16px; line-height: 1.8; color: var(--color-body-text); }
.bl-article :global(h2) { font-size: 22px; font-weight: 700; color: var(--color-ink); margin: 32px 0 14px; }
.bl-article :global(h3) { font-size: 17px; font-weight: 700; color: var(--color-ink); margin: 24px 0 10px; }
.bl-article :global(p) { margin: 0 0 16px; }
.bl-article :global(a) { color: var(--color-saffron-deep); }
.bl-article :global(ul), .bl-article :global(ol) { margin: 0 0 16px; padding-left: 22px; }

.bl-nav { display: flex; justify-content: space-between; gap: 16px; margin-top: 40px; padding-top: 28px; border-top: 1px solid var(--color-hairline); }
.bl-nav-btn { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border: 1px solid var(--color-hairline); border-radius: 8px; text-decoration: none; color: var(--color-ink); transition: border-color 220ms var(--ease-in-out), background 220ms var(--ease-in-out), transform 220ms var(--ease-in-out); max-width: 260px; }
.bl-nav-btn:hover { border-color: var(--color-saffron); background: var(--color-saffron-soft); transform: translateY(-2px); }
.bl-nav-next { text-align: right; margin-left: auto; }
.bl-nav-arrow { font-size: 18px; color: var(--color-saffron); flex-shrink: 0; }
.bl-nav-meta { display: flex; flex-direction: column; gap: 2px; }
.bl-nav-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-mute); font-weight: 600; }
.bl-nav-name { font-size: 13px; font-weight: 600; line-height: 1.3; }
</style>
