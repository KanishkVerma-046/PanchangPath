---
import { RASHIS, getDailyPrediction, getWeeklyPrediction, getMonthlyPrediction, getYearlyPrediction } from '../lib/rashifal';
import RashiIcon from './icons/RashiIcon.astro';
import { formatDateHi } from '../lib/date-i18n';

interface Props { today: Date; }
const { today } = Astro.props;

const dateLabel = formatDateHi(today, false, { weekday: 'long' });
const dateLabelHi = formatDateHi(today, true, { weekday: 'long' });
---

<section class="rf-section">
  <div class="rf-container">

    <!-- Section header -->
    <div class="rf-header">
      <div>
        <p class="caption-mono" data-hi="ज्योतिष · खगोल विद्या" style="color:var(--color-mute);margin:0 0 6px;">Jyotish · Astrology</p>
        <h2 class="rf-title">
          <span class="en-text">Today's Rashifal</span>
          <span class="hi-text" style="display:none;">आज का राशिफल</span>
        </h2>
        <p class="rf-date-label" data-hi={dateLabelHi}>{dateLabel}</p>
      </div>
      <div class="rf-header-right">
        <!-- Period tabs -->
        <div class="rf-period-tabs" role="tablist" aria-label="Rashifal period">
          <a href="/rashifal?period=daily" id="rf-tab-daily" class="rf-tab rf-tab-active" role="tab" aria-selected="true" aria-controls="rashifal-grid" tabindex="0" data-period="daily" data-hi="दैनिक">Daily</a>
          <a href="/rashifal?period=weekly" id="rf-tab-weekly" class="rf-tab" role="tab" aria-selected="false" aria-controls="rashifal-grid" tabindex="-1" data-period="weekly" data-hi="साप्ताहिक">Weekly</a>
          <a href="/rashifal?period=monthly" id="rf-tab-monthly" class="rf-tab" role="tab" aria-selected="false" aria-controls="rashifal-grid" tabindex="-1" data-period="monthly" data-hi="मासिक">Monthly</a>
          <a href="/rashifal?period=yearly" id="rf-tab-yearly" class="rf-tab" role="tab" aria-selected="false" aria-controls="rashifal-grid" tabindex="-1" data-period="yearly" data-hi="वार्षिक">Yearly</a>
        </div>
        <a href="/rashifal" class="rf-more-link">
          <span class="en-text">All Rashis →</span>
          <span class="hi-text" style="display:none;">सभी राशियाँ →</span>
        </a>
      </div>
    </div>

    <!-- 12-rashi grid: 4-col on desktop, horizontal scroll on mobile -->
    <div class="rf-grid" id="rashifal-grid" role="tabpanel" aria-labelledby="rf-tab-daily" tabindex="0">
      {RASHIS.map((rashi, idx) => {
        const predictions = {
          daily: getDailyPrediction(rashi, today),
          weekly: getWeeklyPrediction(rashi, today),
          monthly: getMonthlyPrediction(rashi, today),
          yearly: getYearlyPrediction(rashi, today),
        };
        const daily = predictions.daily;
        const isTruncated = daily.length > 130;
        const short = isTruncated ? daily.slice(0, 130).trim() + '…' : daily;
        return (
          <div class="rf-card animate-in" style={`animation-delay:${idx * 40}ms`} data-predictions={JSON.stringify(predictions)}>
            <!-- Icon strip (links to full rashi page) -->
            <a href={`/rashifal/${rashi.id}`} class="rf-card-thumb-link" aria-label={`${rashi.name} — full prediction`}>
              <div class="rf-card-thumb" style={`background:${rashi.gradient}`}>
                <RashiIcon name={rashi.id} color="#fff" size={26} class="rf-symbol" />
                <div class="rf-card-overlay"></div>
              </div>
            </a>
            <!-- Content -->
            <div class="rf-card-body">
              <div class="rf-card-meta">
                <a href={`/rashifal/${rashi.id}`} class="rf-rashi-link">
                  <p class="rf-rashi-name en-text">{rashi.name}</p>
                  <p class="rf-rashi-name hi-text" style="display:none;">{rashi.nameHi}</p>
                  <p class="rf-rashi-en">{rashi.english}</p>
                </a>
                <span class="rf-lord-badge en-text">{rashi.lord}</span>
                <span class="rf-lord-badge hi-text" style="display:none;">{rashi.lordHi}</span>
              </div>
              <p class="rf-prediction rf-prediction-text">{short}</p>
              <button class="rf-expand-btn" type="button" aria-expanded="false" hidden={!isTruncated}>
                <span class="rf-expand-label">Read more</span>
                <svg class="rf-expand-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Tools row -->
    <div class="rf-tools-row">

      <!-- Prashnavali card -->
      <a href="/prashnavali" class="rf-tool-card rf-prashnavali">
        <div class="rf-tool-icon">🔮</div>
        <div>
          <p class="rf-tool-title">
            <span class="en-text">Prashnavali</span>
            <span class="hi-text" style="display:none;">प्रश्नावली</span>
          </p>
          <p class="rf-tool-desc">
            <span class="en-text">Divine question oracle — focus on your question and receive a cosmic answer</span>
            <span class="hi-text" style="display:none;">दिव्य प्रश्नावली — अपना प्रश्न मन में रखें</span>
          </p>
        </div>
        <span class="rf-tool-arrow">→</span>
      </a>

      <!-- Find Rashi by Name -->
      <div class="rf-tool-card rf-finder" id="rashi-name-finder">
        <div class="rf-tool-icon">🔤</div>
        <div style="flex:1;min-width:0;">
          <p class="rf-tool-title">
            <span class="en-text">Find Rashi by Name</span>
            <span class="hi-text" style="display:none;">नाम से राशि जानें</span>
          </p>
          <div class="rf-finder-input-row">
            <input
              type="text"
              id="name-input"
              aria-label="First name"
              class="rf-input"
              placeholder="Enter first name…"
              data-hi-placeholder="पहला नाम दर्ज करें…"
              maxlength="40"
              autocomplete="off"
            />
            <button class="rf-find-btn" id="name-find-btn" data-hi="खोजें">Find</button>
          </div>
          <p class="rf-finder-result" id="name-result" hidden></p>
        </div>
      </div>

      <!-- Find Rashi by Birth Date -->
      <div class="rf-tool-card rf-finder" id="rashi-date-finder">
        <div class="rf-tool-icon">📅</div>
        <div style="flex:1;min-width:0;">
          <p class="rf-tool-title">
            <span class="en-text">Find Rashi by Birth Date</span>
            <span class="hi-text" style="display:none;">जन्म तिथि से राशि जानें</span>
          </p>
          <div class="rf-finder-input-row">
            <input type="date" id="dob-input" lang="en-GB" aria-label="Date of birth" class="rf-input" />
            <button class="rf-find-btn" id="dob-find-btn" data-hi="खोजें">Find</button>
          </div>
          <p class="rf-finder-result" id="dob-result" hidden></p>
        </div>
      </div>

    </div>
  </div>
</section>

<script>
import { getRashiByNameLetter } from '../lib/rashifal';

// ─── Language ────────────────────────────────────────────────────────────────
// Mirrors the applyPageLang() pattern used by rashifal/index.astro: Header.astro's
// global [data-hi] swap only fires once per langchange, so JS-generated strings
// (expand/collapse label, finder result text) need their own isHindi check.
let rfIsHindi = localStorage.getItem('pp-lang') === 'hi';

// ─── Prediction expand/collapse ─────────────────────────────────────────────
document.getElementById('rashifal-grid')?.addEventListener('click', (e) => {
  const btn = (e.target as Element).closest<HTMLElement>('.rf-expand-btn');
  if (!btn) return;
  const card = btn.closest<HTMLElement>('.rf-card');
  const textEl = card?.querySelector<HTMLElement>('.rf-prediction-text');
  const wasExpanded = btn.getAttribute('aria-expanded') === 'true';
  if (textEl) textEl.textContent = (wasExpanded ? card?.dataset.shortText : card?.dataset.fullText) ?? '';
  btn.setAttribute('aria-expanded', String(!wasExpanded));
  btn.classList.toggle('expanded', !wasExpanded);
  const label = btn.querySelector<HTMLElement>('.rf-expand-label');
  if (label) {
    label.textContent = rfIsHindi
      ? (wasExpanded ? 'और पढ़ें' : 'कम पढ़ें')
      : (wasExpanded ? 'Read more' : 'Read less');
  }
});

// ─── Period tabs (real in-place tab widget, not page navigation) ───────────
// APG "Tabs with Automatic Activation": arrow keys move focus AND switch the
// panel; each tab keeps aria-controls pointing at the one panel (#rashifal-grid)
// whose prediction text swaps per rashi card rather than swapping DOM panels.
type Period = 'daily' | 'weekly' | 'monthly' | 'yearly';
const periodTabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.rf-tab'));
const periodGrid = document.getElementById('rashifal-grid');

function renderCardPrediction(card: HTMLElement, period: Period) {
  let predictions: Partial<Record<Period, string>> = {};
  try { predictions = JSON.parse(card.dataset.predictions ?? '{}'); } catch { /* malformed data, fall back to empty */ }
  const text = predictions[period] ?? predictions.daily ?? '';
  const truncated = text.length > 130;
  const short = truncated ? text.slice(0, 130).trim() + '…' : text;
  card.dataset.shortText = short;
  card.dataset.fullText = text;
  const textEl = card.querySelector<HTMLElement>('.rf-prediction-text');
  if (textEl) textEl.textContent = short;
  const btn = card.querySelector<HTMLElement>('.rf-expand-btn');
  if (btn) {
    btn.hidden = !truncated;
    btn.setAttribute('aria-expanded', 'false');
    btn.classList.remove('expanded');
    const label = btn.querySelector<HTMLElement>('.rf-expand-label');
    if (label) label.textContent = rfIsHindi ? 'और पढ़ें' : 'Read more';
  }
}

function setActivePeriod(period: Period, opts: { focusTab?: boolean } = {}) {
  const targetTab = periodTabs.find(t => t.dataset.period === period);
  if (!targetTab) return;
  periodTabs.forEach(t => {
    const active = t === targetTab;
    t.classList.toggle('rf-tab-active', active);
    t.setAttribute('aria-selected', String(active));
    t.tabIndex = active ? 0 : -1;
  });
  periodGrid?.setAttribute('aria-labelledby', targetTab.id);
  document.querySelectorAll<HTMLElement>('#rashifal-grid .rf-card').forEach(card => renderCardPrediction(card, period));
  if (opts.focusTab) targetTab.focus();
}

periodTabs.forEach(tab => {
  tab.addEventListener('click', (e) => {
    e.preventDefault();
    setActivePeriod((tab.dataset.period as Period) ?? 'daily');
  });
  tab.addEventListener('keydown', (e) => {
    const key = (e as KeyboardEvent).key;
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(key)) return;
    e.preventDefault();
    const idx = periodTabs.indexOf(tab);
    let nextIdx = idx;
    if (key === 'ArrowLeft') nextIdx = (idx - 1 + periodTabs.length) % periodTabs.length;
    else if (key === 'ArrowRight') nextIdx = (idx + 1) % periodTabs.length;
    else if (key === 'Home') nextIdx = 0;
    else if (key === 'End') nextIdx = periodTabs.length - 1;
    setActivePeriod((periodTabs[nextIdx].dataset.period as Period) ?? 'daily', { focusTab: true });
  });
});

// Seed dataset.shortText/fullText for the initially-rendered (daily) period
// so the expand/collapse handler above has data to read from immediately.
document.querySelectorAll<HTMLElement>('#rashifal-grid .rf-card').forEach(card => renderCardPrediction(card, 'daily'));

// ─── Name-to-Rashi lookup ─────────────────────────────────────────────────
// Uses the shared, canonically-derived getRashiByNameLetter() from lib/rashifal.ts instead of a
// locally duplicated map, so this can no longer drift out of sync with each rashi's nameLetters array.
const RASHI_HI: Record<string, string> = {
  Mesha:"मेष",Vrishabha:"वृषभ",Mithuna:"मिथुन",Karka:"कर्क",Simha:"सिंह",Kanya:"कन्या",
  Tula:"तुला",Vrishchika:"वृश्चिक",Dhanu:"धनु",Makara:"मकर",Kumbha:"कुम्भ",Meena:"मीन",
};
const RASHI_ID: Record<string, string> = {
  Mesha:"mesha",Vrishabha:"vrishabha",Mithuna:"mithuna",Karka:"karka",Simha:"simha",Kanya:"kanya",
  Tula:"tula",Vrishchika:"vrishchika",Dhanu:"dhanu",Makara:"makara",Kumbha:"kumbha",Meena:"meena",
};

function findByName(name: string): string | undefined {
  const rashi = getRashiByNameLetter(name);
  return rashi?.name; // e.g. "Mesha" — keeps the capitalized-name contract RASHI_HI/RASHI_ID below expect
}

function findByDate(dateStr: string): string {
  const d = new Date(dateStr + 'T12:00:00');
  const m = d.getMonth() + 1, day = d.getDate(), md = m * 100 + day;
  if (md >= 414 && md <= 514) return "Mesha";
  if (md >= 515 && md <= 614) return "Vrishabha";
  if (md >= 615 && md <= 715) return "Mithuna";
  if (md >= 716 && md <= 816) return "Karka";
  if (md >= 817 && md <= 916) return "Simha";
  if (md >= 917 && md <= 1017) return "Kanya";
  if (md >= 1018 && md <= 1115) return "Tula";
  if (md >= 1116 && md <= 1214) return "Vrishchika";
  if (md >= 1215 || md <= 113) return "Dhanu";
  if (md >= 114 && md <= 212) return "Makara";
  if (md >= 213 && md <= 313) return "Kumbha";
  return "Meena";
}

// ─── Parsed-date echo ────────────────────────────────────────────────────────
// A native <input type="date"> always yields an unambiguous YYYY-MM-DD value
// regardless of how the picker's segments are visually ordered, but the visual
// order itself is locale-dependent (Chromium/Windows commonly show mm/dd/yyyy
// for non-India locales). An India-first visitor who types digits in the
// day-first order they expect can end up filling the wrong segment. Echoing
// the parsed date back in unambiguous long form lets them catch a misparse
// immediately instead of silently getting the wrong Rashi.
const WD_EN = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI = ['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI = ['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(dateStr: string, hindi: boolean): string {
  const [y, m, d] = dateStr.split('-').map(Number);
  const wd = new Date(Date.UTC(y, m - 1, d, 12)).getUTCDay();
  return hindi ? `${WD_HI[wd]}, ${d} ${MO_HI[m - 1]} ${y}` : `${WD_EN[wd]}, ${d} ${MO_EN[m - 1]} ${y}`;
}

function showResult(el: HTMLElement, rashi: string, dateStr?: string) {
  const hi = RASHI_HI[rashi] ?? '';
  const id = RASHI_ID[rashi] ?? rashi.toLowerCase();
  const label = rfIsHindi ? 'आपकी राशि है' : 'Your Rashi is';
  const linkText = rfIsHindi ? 'भविष्यवाणी देखें →' : 'View prediction →';
  const dateEcho = dateStr
    ? `<br/><span style="font-size:12px;color:var(--color-mute);">${rfIsHindi ? 'दर्ज तिथि' : 'Date entered'}: ${formatLongDate(dateStr, rfIsHindi)}</span>`
    : '';
  el.innerHTML = `${label} <strong>${rashi} (${hi})</strong>. <a href="/rashifal/${id}" style="color:var(--color-saffron-deep);text-decoration:none;font-weight:600;">${linkText}</a>${dateEcho}`;
  el.hidden = false;
}

document.getElementById('name-find-btn')?.addEventListener('click', () => {
  const val = (document.getElementById('name-input') as HTMLInputElement)?.value ?? '';
  const result = document.getElementById('name-result') as HTMLElement;
  if (!val.trim()) { result.textContent = rfIsHindi ? 'कृपया एक नाम दर्ज करें।' : 'Please enter a name.'; result.hidden = false; return; }
  const rashi = findByName(val);
  if (rashi) showResult(result, rashi);
  else { result.textContent = rfIsHindi ? 'इस नाम से राशि निर्धारित नहीं हो सकी। जन्म तिथि टूल आज़माएं।' : 'Could not determine Rashi from this name. Try the birth date tool.'; result.hidden = false; }
});

document.getElementById('dob-find-btn')?.addEventListener('click', () => {
  const val = (document.getElementById('dob-input') as HTMLInputElement)?.value ?? '';
  const result = document.getElementById('dob-result') as HTMLElement;
  if (!val) { result.textContent = rfIsHindi ? 'कृपया एक तिथि चुनें।' : 'Please select a date.'; result.hidden = false; return; }
  const rashi = findByDate(val);
  showResult(result, rashi, val);
});

document.getElementById('name-input')?.addEventListener('keydown', (e) => {
  if ((e as KeyboardEvent).key === 'Enter') document.getElementById('name-find-btn')?.click();
});
document.getElementById('dob-input')?.addEventListener('keydown', (e) => {
  if ((e as KeyboardEvent).key === 'Enter') document.getElementById('dob-find-btn')?.click();
});

// ── Hindi UI coverage ──
// Header.astro's global [data-hi] listener already swaps this component's static
// text; this just keeps the JS-generated strings (expand label, finder results,
// placeholder) in sync with the same langchange event.
function rfApplyExpandLabels() {
  document.querySelectorAll<HTMLElement>('.rf-expand-btn').forEach(btn => {
    const label = btn.querySelector<HTMLElement>('.rf-expand-label');
    const isExpanded = btn.getAttribute('aria-expanded') === 'true';
    if (label) label.textContent = rfIsHindi ? (isExpanded ? 'कम पढ़ें' : 'और पढ़ें') : (isExpanded ? 'Read less' : 'Read more');
  });
}
document.addEventListener('langchange', (e: Event) => {
  const evt = e as CustomEvent;
  rfIsHindi = evt.detail.langCode === 'hi';
  const nameInput = document.getElementById('name-input') as HTMLInputElement | null;
  if (nameInput) nameInput.placeholder = rfIsHindi ? (nameInput.dataset.hiPlaceholder || '') : 'Enter first name…';
  rfApplyExpandLabels();
});
rfApplyExpandLabels();
</script>

<style>
.rf-section {
  padding: 56px 0 48px;
  background: var(--color-canvas-soft);
}
.rf-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* Header */
.rf-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 28px;
  flex-wrap: wrap;
}
.rf-title {
  font-size: 24px;
  font-weight: 600;
  letter-spacing: -0.8px;
  color: var(--color-ink);
  margin: 0 0 4px;
}
.rf-date-label {
  font-size: 13px;
  color: var(--color-mute);
  margin: 0;
}
.rf-header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10px;
}
.rf-period-tabs {
  display: flex;
  gap: 4px;
  background: var(--color-canvas);
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-pill);
  padding: 3px;
}
.rf-tab {
  padding: 4px 14px;
  font-size: 12.5px;
  font-weight: 500;
  color: var(--color-mute);
  text-decoration: none;
  border-radius: var(--radius-pill);
  transition: background 0.15s, color 0.15s;
  white-space: nowrap;
}
.rf-tab:hover { color: var(--color-ink); }
.rf-tab-active {
  background: var(--color-ink);
  color: var(--color-on-primary) !important;
}
.rf-more-link {
  font-size: 13px;
  font-weight: 500;
  color: var(--color-saffron-deep);
  text-decoration: none;
}
.rf-more-link:hover { text-decoration: underline; }

/* Grid */
.rf-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
  margin-bottom: 20px;
}

/* Card */
.rf-card {
  background: var(--color-canvas);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.15s, transform 0.15s;
}
.rf-card:hover {
  box-shadow: var(--shadow-card-hover);
  transform: translateY(-2px);
}

.rf-card-thumb-link { text-decoration: none; display: block; }
.rf-rashi-link { text-decoration: none; display: block; }

.rf-card-thumb {
  height: 52px;
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 16px;
  flex-shrink: 0;
}
.rf-symbol {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}
.rf-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(0,0,0,0.15) 0%, transparent 60%);
}

.rf-card-body {
  padding: 14px 16px;
  flex: 1;
  display: flex;
  flex-direction: column;
}
.rf-card-meta {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 6px;
  margin-bottom: 8px;
}
.rf-rashi-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--color-ink);
  margin: 0 0 1px;
  letter-spacing: -0.3px;
}
.rf-rashi-en {
  font-size: 11px;
  color: var(--color-mute);
  margin: 0;
  font-family: var(--font-mono);
}
.rf-lord-badge {
  font-size: 10px;
  font-weight: 600;
  color: var(--color-saffron-deep);
  background: var(--color-saffron-soft);
  padding: 2px 7px;
  border-radius: var(--radius-pill);
  white-space: nowrap;
  flex-shrink: 0;
  border: 1px solid rgba(255,153,51,0.2);
}
.rf-prediction {
  font-size: 14px;
  color: var(--color-body-text);
  line-height: 1.6;
  margin: 0 0 10px;
  flex: 1;
}
.rf-expand-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  align-self: flex-start;
  margin-top: auto;
  padding: 0;
  background: none;
  border: none;
  font-family: var(--font-sans);
  font-size: 11.5px;
  font-weight: 600;
  color: var(--color-saffron-deep);
  cursor: pointer;
}
.rf-expand-chevron { transition: transform 0.15s; flex-shrink: 0; }
.rf-expand-btn.expanded .rf-expand-chevron { transform: rotate(180deg); }

/* Tools row */
.rf-tools-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12px;
  margin-top: 20px;
}
.rf-tool-card {
  background: var(--color-canvas);
