---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sunrise & Sunset Times — PanchangPath" description="Today's sunrise and sunset time for your location, plus a 7-day outlook, computed from real Meeus solar-position astronomy — not a static table.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/" data-hi="← आज का पंचांग" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Today's Panchang</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">सूर्योदय · सूर्यास्त · SUNRISE &amp; SUNSET</p>
      <h1 data-hi="सूर्योदय और सूर्यास्त" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Sunrise &amp; Sunset</h1>
      <p data-hi="आपके स्थान के लिए आज का सूर्योदय और सूर्यास्त समय, साइट पर उपयोग किए जाने वाले उसी मीयस सौर-स्थिति सूत्र से लाइव गणना — साथ ही 7-दिन का पूर्वानुमान।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:500px;">Today's sunrise and sunset time for your location, computed live from the same Meeus solar-position formula used across the site — plus a 7-day outlook.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div>
          <label for="ss-city" data-hi="स्थान" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Location</label>
          <select id="ss-city" class="input" style="height:38px;min-width:160px;"></select>
        </div>
      </div>

      <div id="ss-today" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;margin-bottom:40px;"></div>

      <h3 data-hi="अगले 7 दिन" style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Next 7 Days</h3>
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;max-width:640px;" id="ss-week">
          <thead><tr>
            <th data-hi="दिनांक" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Date</th>
            <th data-hi="सूर्योदय" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Sunrise</th>
            <th data-hi="सूर्यास्त" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Sunset</th>
            <th data-hi="दिन की अवधि" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Day Length</th>
          </tr></thead>
          <tbody id="ss-week-body"></tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>

<script>
import { sunriseUTC } from '../lib/panchang';

const LOCS = [
  {name:'New Delhi',lat:28.6139,lng:77.209,tz:5.5},
  {name:'Mumbai',lat:19.076,lng:72.8777,tz:5.5},
  {name:'Bengaluru',lat:12.9716,lng:77.5946,tz:5.5},
  {name:'Chennai',lat:13.0827,lng:80.2707,tz:5.5},
  {name:'Kolkata',lat:22.5726,lng:88.3639,tz:5.5},
  {name:'Hyderabad',lat:17.385,lng:78.4867,tz:5.5},
  {name:'Jaipur',lat:26.9124,lng:75.7873,tz:5.5},
  {name:'Varanasi',lat:25.3176,lng:82.9739,tz:5.5},
  {name:'Dubai',lat:25.2048,lng:55.2708,tz:4},
  {name:'New York',lat:40.7128,lng:-74.006,tz:-4},
  {name:'London',lat:51.5074,lng:-0.1278,tz:1},
];

function toJD(y:number,m:number,d:number,h=0){
  if(m<=2){y--;m+=12;}
  const A=Math.floor(y/100),B=2-A+Math.floor(A/4);
  return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;
}
const n360=(a:number)=>((a%360)+360)%360;
const toRad=(d:number)=>d*Math.PI/180;
const toDeg=(r:number)=>r*180/Math.PI;

function decHoursToTime(h:number,tz:number){
  const local=h+tz;
  const hh=Math.floor(((local%24)+24)%24);
  const mm=Math.round((local-Math.floor(local))*60);
  const ap=hh<12?'AM':'PM';
  const h12=hh%12||12;
  return `${h12}:${String(mm).padStart(2,'0')} ${ap}`;
}
function fmtDuration(hoursDecimal:number){
  const h=Math.floor(hoursDecimal);
  const m=Math.round((hoursDecimal-h)*60);
  return `${h}h ${m}m`;
}

const sel=document.getElementById('ss-city') as HTMLSelectElement;
sel.innerHTML=LOCS.map(l=>`<option value="${l.name}">${l.name}</option>`).join('');

function applyHeaderLoc(loc:any){
  if(!loc||!loc.name)return;
  const norm=(s:string)=>s.trim().toLowerCase();
  let match=LOCS.find(l=>norm(l.name)===norm(loc.name));
  if(!match){
    match={name:loc.name,lat:loc.lat,lng:loc.lng,tz:loc.tzOffset};
    LOCS.unshift(match);
    sel.innerHTML=LOCS.map(l=>`<option value="${l.name}">${l.name}</option>`).join('');
  }
  sel.value=match.name;
}
if((window as any).__initLoc) applyHeaderLoc((window as any).__initLoc);
window.addEventListener('locationchange',(e:Event)=>{
  applyHeaderLoc((e as CustomEvent).detail);
  calculate();
});

let hindiActive=false;

function calculate(){
  const cityName=sel.value;
  const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
  const now=new Date();
  const y=now.getFullYear(),m=now.getMonth()+1,d=now.getDate();

  const jd=toJD(y,m,d,6-loc.tz);
  const srUTC=sunriseUTC(jd,loc.lat,loc.lng,true);
  const ssUTC=sunriseUTC(jd,loc.lat,loc.lng,false);
  const dayLenHours=ssUTC-srUTC;

  const todayEl=document.getElementById('ss-today');
  if(todayEl){
    todayEl.innerHTML=[
      {label:hindiActive?'सूर्योदय':'Sunrise',value:decHoursToTime(srUTC,loc.tz),color:'#d97706'},
      {label:hindiActive?'सूर्यास्त':'Sunset',value:decHoursToTime(ssUTC,loc.tz),color:'#dc2626'},
      {label:hindiActive?'दिन की अवधि':'Day Length',value:fmtDuration(dayLenHours),color:'var(--color-ink)'},
    ].map(c=>`<div class="card" style="padding:20px;text-align:center;"><p style="font-size:11px;color:var(--color-mute);text-transform:uppercase;letter-spacing:0.06em;font-family:var(--font-mono);margin:0 0 8px;">${c.label}</p><p style="font-size:24px;font-weight:700;color:${c.color};margin:0;font-family:var(--font-mono);">${c.value}</p></div>`).join('');
  }

  const weekBody=document.getElementById('ss-week-body');
  if(weekBody){
    let rows='';
    for(let i=0;i<7;i++){
      const dt=new Date(y,m-1,d+i);
      const jdI=toJD(dt.getFullYear(),dt.getMonth()+1,dt.getDate(),6-loc.tz);
      const sr=sunriseUTC(jdI,loc.lat,loc.lng,true);
      const ss=sunriseUTC(jdI,loc.lat,loc.lng,false);
      const dayName=dt.toLocaleDateString('en-US',{weekday:'short',month:'short',day:'numeric'});
      const todayTag=i===0?(hindiActive?' (आज)':' (Today)'):'';
      rows+=`<tr><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-ink);font-weight:${i===0?'700':'400'};">${dayName}${todayTag}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-body-text);font-family:var(--font-mono);">${decHoursToTime(sr,loc.tz)}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-body-text);font-family:var(--font-mono);">${decHoursToTime(ss,loc.tz)}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-body-text);font-family:var(--font-mono);">${fmtDuration(ss-sr)}</td></tr>`;
    }
    weekBody.innerHTML=rows;
  }
}

sel.addEventListener('change',calculate);
calculate();

function applyPageLang(hindi:boolean){
  hindiActive=hindi;
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el=>{
    if(!el.dataset.en) el.dataset.en=el.textContent||'';
    el.textContent=hindi?(el.dataset.hi as string):(el.dataset.en as string);
  });
  calculate();
}
document.addEventListener('langchange',(e:Event)=>{
  applyPageLang((e as CustomEvent).detail.langCode==='hi');
});
if(localStorage.getItem('pp-lang')==='hi') applyPageLang(true);
</script>
