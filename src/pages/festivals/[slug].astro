---
import Layout from '../../layouts/Layout.astro';
import { metaDescription } from '../../lib/meta';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import {
  FESTIVALS_2025_2027,
  getFestivalSlug,
  getFestivalIcon,
  getFestivalGradient,
  daysUntil,
  formatCountdown,
  formatCountdownHi,
} from '../../lib/festivals';
import { formatDateHi } from '../../lib/date-i18n';

export function getStaticPaths() {
  return FESTIVALS_2025_2027.map(f => ({
    params: { slug: getFestivalSlug(f) },
    props:  { festival: f },
  }));
}

const { festival: f } = Astro.props;
const today     = new Date();
const days      = daysUntil(today, f.date);
const countdown = formatCountdown(days);
const countdownHi = formatCountdownHi(days);
const icon      = getFestivalIcon(f);
const gradient  = getFestivalGradient(f);
const fd        = new Date(f.date);
const dateLabel = formatDateHi(fd, false, { weekday: 'long' });
const dateLabelHi = formatDateHi(fd, true, { weekday: 'long' });
const isToday   = days === 0;
const isPast    = days < 0;

// Build sorted list for prev/next navigation
const thisSlug  = getFestivalSlug(f);
const allSorted = [...FESTIVALS_2025_2027].sort((a, b) => a.date.localeCompare(b.date));
const idx       = allSorted.findIndex(x => getFestivalSlug(x) === thisSlug);
const prev      = idx > 0            ? allSorted[idx - 1] : null;
const next      = idx < allSorted.length - 1 ? allSorted[idx + 1] : null;
---

<Layout
  title={`${f.name} ${f.date.slice(0,4)} — PanchangPath`}
  description={metaDescription(f.description, `${f.name} — date, significance and observance.`)}
>
  <BreadcrumbSchema items={[
    { name: 'Home', url: '/' },
    { name: 'Festivals', url: '/festivals' },
    { name: f.name, url: `/festivals/${thisSlug}` },
  ]} />
  <!-- ── Hero ── -->
  <section class="fd-hero" style={`background:${gradient}`}>
    <div class="fd-hero-inner">
      <span class="fd-icon" aria-hidden="true">{icon}</span>
      <div class="fd-hero-text">
        <div class="fd-breadcrumb">
          <a href="/" data-hi="होम">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/festivals" data-hi="त्योहार">Festivals</a>
          <span aria-hidden="true">›</span>
          <span class="en-text">{f.name}</span>
          <span class="hi-text" style="display:none">{f.nameHi}</span>
        </div>
        <h1 class="fd-heading en-text">{f.name}</h1>
        <h1 class="fd-heading hi-text" style="display:none">{f.nameHi}</h1>
        <div class="fd-hero-badges">
          <span class={`fd-type-badge fd-type-${f.type}`} data-hi={f.type === 'major' ? '✦ प्रमुख त्योहार' : f.type === 'vrat' ? '🙏 व्रत' : '🌏 क्षेत्रीय त्योहार'}>
            {f.type === 'major' ? '✦ Major Festival' : f.type === 'vrat' ? '🙏 Vrat / Fast' : '🌏 Regional Festival'}
          </span>
          {!isPast && (
            <span class={`fd-countdown-badge ${isToday ? 'fd-countdown-today' : ''}`}>
              {isToday && <span class="fd-dot" aria-hidden="true"></span>}
              <span class="en-text">{countdown}</span>
              <span class="hi-text" style="display:none">{countdownHi}</span>
            </span>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Main content ── -->
  <div class="fd-wrapper">
    <div class="fd-grid">

      <!-- Left: main info -->
      <article class="fd-main">

        <!-- Date card -->
        <div class="fd-date-card">
          <div class="fd-date-col">
            <p class="fd-label" data-hi="दिनांक">Date</p>
            <p class="fd-value en-text">{dateLabel}</p>
            <p class="fd-value hi-text" style="display:none">
              {dateLabelHi}
            </p>
          </div>
          <div class="fd-date-sep"></div>
          <div class="fd-date-col">
            <p class="fd-label" data-hi="उलटी गिनती">Countdown</p>
            <p class="fd-value" style={isToday ? 'color:var(--color-saffron-deep)' : isPast ? 'color:var(--color-mute)' : ''} data-hi={isPast ? `${Math.abs(days)} दिन पहले` : countdownHi}>
              {isPast ? `${Math.abs(days)} days ago` : countdown}
            </p>
          </div>
          <div class="fd-date-sep"></div>
          <div class="fd-date-col">
            <p class="fd-label" data-hi="वर्ष">Year</p>
            <p class="fd-value">{f.date.slice(0, 4)}</p>
          </div>
        </div>

        <!-- Description -->
        <div class="fd-section">
          <h2 class="fd-section-title" data-hi="इस त्योहार के बारे में">About this Festival</h2>
          <p class="fd-body" data-hi={f.longDescHi ?? f.descriptionHi}>
            {f.longDesc ?? f.description}
          </p>
        </div>

        <!-- Quick facts -->
        <div class="fd-section">
          <h2 class="fd-section-title" data-hi="मुख्य तथ्य">Quick Facts</h2>
          <dl class="fd-facts">
            <div class="fd-fact-row">
              <dt data-hi="प्रकार">Type</dt>
              <dd data-hi={f.type === 'major' ? 'प्रमुख हिंदू त्योहार' : f.type === 'vrat' ? 'व्रत / उपवास दिवस' : 'क्षेत्रीय त्योहार'}>
                {f.type === 'major' ? 'Major Hindu Festival' : f.type === 'vrat' ? 'Vrat / Fasting Day' : 'Regional Festival'}
              </dd>
            </div>
            <div class="fd-fact-row">
              <dt data-hi="संस्कृत नाम">Sanskrit Name</dt>
              <dd class="hi-text" style="display:none">{f.nameHi}</dd>
            </div>
            <div class="fd-fact-row">
              <dt data-hi={`दिनांक (${f.date.slice(0,4)})`}>Date ({f.date.slice(0,4)})</dt>
              <dd data-hi={dateLabelHi}>{dateLabel}</dd>
            </div>
            <div class="fd-fact-row">
              <dt data-hi="मनाया जाता है">Observed in</dt>
              <dd data-hi={f.type === 'major' ? 'संपूर्ण भारत' : f.type === 'vrat' ? 'भारत भर के हिंदू परिवारों में' : 'क्षेत्रीय समुदायों में'}>
                {f.type === 'major' ? 'Pan-India' : f.type === 'vrat' ? 'Hindu households across India' : 'Regional communities'}
              </dd>
            </div>
          </dl>
        </div>

      </article>

      <!-- Right: sidebar -->
      <aside class="fd-sidebar">

        <!-- Add to calendar (decorative for now) -->
        <div class="fd-side-card">
          <h3 class="fd-side-title" data-hi="कैलेंडर में जोड़ें">Add to Calendar</h3>
          <p class="fd-side-body" data-hi={dateLabelHi}>{dateLabel}</p>
          <a
            href={`/festivals`}
            class="fd-side-btn"
            data-hi="← कैलेंडर पर वापस जाएं"
          >← Back to Calendar</a>
        </div>

        <!-- Related panchang -->
        <div class="fd-side-card">
          <h3 class="fd-side-title" data-hi="पंचांग">Panchang</h3>
          <p class="fd-side-body" data-hi="इस दिन का पूरा पंचांग देखें — तिथि, नक्षत्र, योग, करण, राहु कालम, और मुहूर्त।">See the full Panchang for this day — Tithi, Nakshatra, Yoga, Karana, Rahu Kalam, and Muhurtas.</p>
          <a href="/" class="fd-side-btn" data-hi="आज का पंचांग देखें →">View Today's Panchang →</a>
        </div>

      </aside>

    </div><!-- .fd-grid -->

    <!-- Prev / Next navigation -->
    <nav class="fd-nav" aria-label="Festival navigation">
      {prev && (
        <a href={`/festivals/${getFestivalSlug(prev)}`} class="fd-nav-btn fd-nav-prev">
          <span class="fd-nav-arrow">←</span>
          <div class="fd-nav-meta">
            <span class="fd-nav-label" data-hi="पिछला">Previous</span>
            <span class="fd-nav-name en-text">{prev.name}</span>
            <span class="fd-nav-name hi-text" style="display:none">{prev.nameHi}</span>
          </div>
        </a>
      )}
      {!prev && <div></div>}
      {next && (
        <a href={`/festivals/${getFestivalSlug(next)}`} class="fd-nav-btn fd-nav-next">
          <div class="fd-nav-meta">
            <span class="fd-nav-label" data-hi="अगला">Next</span>
            <span class="fd-nav-name en-text">{next.name}</span>
            <span class="fd-nav-name hi-text" style="display:none">{next.nameHi}</span>
          </div>
          <span class="fd-nav-arrow">→</span>
        </a>
      )}
    </nav>

  </div><!-- .fd-wrapper -->
</Layout>

<script>
  function applyPageLang(hindi: boolean) {
    document.querySelectorAll('.en-text').forEach(el => (el as HTMLElement).style.display = hindi ? 'none' : 'block');
    document.querySelectorAll('.hi-text').forEach(el => (el as HTMLElement).style.display = hindi ? 'block' : 'none');
    document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
      if (!el.dataset.en) el.dataset.en = el.textContent || '';
      el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
    });
  }
  document.addEventListener('langchange', (e: Event) => {
    applyPageLang((e as CustomEvent).detail.langCode === 'hi');
  });
  if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>

<style>
/* ── Hero ── */
.fd-hero {
  padding: 48px 0 40px;
  position: relative;
  overflow: hidden;
}
.fd-hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.08) 0%, rgba(0,0,0,0.22) 100%);
  pointer-events: none;
}
.fd-hero-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  display: flex;
  align-items: center;
  gap: 28px;
  position: relative;
  z-index: 1;
}
.fd-icon {
  font-size: 64px;
  filter: drop-shadow(0 4px 16px rgba(0,0,0,0.22));
  flex-shrink: 0;
  line-height: 1;
}
.fd-hero-text { flex: 1; min-width: 0; }
.fd-breadcrumb {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: rgba(255,255,255,0.75);
  margin-bottom: 10px;
}
.fd-breadcrumb a { color: rgba(255,255,255,0.75); text-decoration: none; }
.fd-breadcrumb a:hover { color: #fff; }
.fd-heading {
  font-size: 32px;
  font-weight: 800;
  letter-spacing: -1px;
  color: #fff;
  margin: 0 0 12px;
  text-shadow: 0 2px 12px rgba(0,0,0,0.2);
  line-height: 1.15;
}
@media (max-width: 640px) {
  .fd-heading { font-size: 24px; }
  .fd-icon    { font-size: 48px; }
}
.fd-hero-badges {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.fd-type-badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  background: rgba(255,255,255,0.22);
  color: #fff;
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255,255,255,0.3);
}
.fd-countdown-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  background: rgba(255,255,255,0.22);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.3);
  font-family: var(--font-mono, monospace);
}
.fd-countdown-today { background: rgba(255,255,255,0.35); }
.fd-dot {
  display: inline-block;
  width: 7px; height: 7px;
  border-radius: 50%;
  background: #fff;
  animation: fd-pulse 1.5s ease-in-out infinite;
}
@keyframes fd-pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

/* ── Wrapper & Grid ── */
.fd-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 24px 60px;
}
.fd-grid {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 32px;
  align-items: start;
}
@media (max-width: 768px) {
  .fd-grid { grid-template-columns: 1fr; }
}

/* ── Date card ── */
.fd-date-card {
  display: flex;
  gap: 0;
  border: 1px solid var(--color-hairline);
  border-radius: 10px;
  box-shadow: var(--shadow-elevation);
  overflow: hidden;
  margin-bottom: 28px;
}
.fd-date-col {
  flex: 1;
  padding: 16px 18px;
}
.fd-date-sep {
  width: 1px;
  background: var(--color-hairline);
  flex-shrink: 0;
}
.fd-label {
  font-size: 10.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-mute);
  margin: 0 0 5px;
}
.fd-value {
  font-size: 14px;
  font-weight: 600;
  color: var(--color-ink);
  margin: 0;
  line-height: 1.4;
}
@media (max-width: 500px) {
  .fd-date-card { flex-direction: column; }
  .fd-date-sep  { width: auto; height: 1px; }
}

/* ── Sections ── */
.fd-section { margin-bottom: 32px; }
.fd-section-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--color-ink);
  margin: 0 0 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--color-hairline);
}
.fd-body {
  font-size: 16px;
  line-height: 1.75;
  color: var(--color-body-text);
  margin: 0;
}

/* ── Facts ── */
.fd-facts { margin: 0; display: flex; flex-direction: column; gap: 0; }
.fd-fact-row {
  display: grid;
  grid-template-columns: 160px 1fr;
  gap: 12px;
  padding: 11px 0;
  border-bottom: 1px solid var(--color-hairline);
  font-size: 13.5px;
}
.fd-fact-row:last-child { border-bottom: none; }
.fd-fact-row dt { color: var(--color-mute); font-weight: 500; }
.fd-fact-row dd { color: var(--color-ink);  font-weight: 500; margin: 0; }
@media (max-width: 400px) {
  .fd-fact-row { grid-template-columns: 1fr; gap: 2px; }
}

/* ── Sidebar ── */
.fd-side-card {
  border: 1px solid var(--color-hairline);
  border-radius: 10px;
  box-shadow: var(--shadow-elevation);
  padding: 18px;
  margin-bottom: 16px;
}
.fd-side-title {
  font-size: 13px;
  font-weight: 700;
  color: var(--color-ink);
  margin: 0 0 8px;
}
.fd-side-body {
  font-size: 14px;
  color: var(--color-body-text);
  margin: 0 0 14px;
  line-height: 1.6;
}
.fd-side-btn {
  display: block;
  text-align: center;
  padding: 8px 16px;
  background: var(--color-canvas-soft);
  border: 1px solid var(--color-hairline);
  border-radius: 6px;
  font-size: 12.5px;
  font-weight: 500;
  color: var(--color-ink);
  text-decoration: none;
  transition: background 0.15s;
}
.fd-side-btn:hover { background: var(--color-saffron-soft); border-color: var(--color-saffron); }

/* ── Prev/Next nav ── */
.fd-nav {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-top: 40px;
  padding-top: 28px;
  border-top: 1px solid var(--color-hairline);
}
.fd-nav-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  border: 1px solid var(--color-hairline);
  border-radius: 8px;
  text-decoration: none;
  color: var(--color-ink);
  transition: border-color 0.15s, background 0.15s;
  max-width: 260px;
}
.fd-nav-btn:hover { border-color: var(--color-saffron); background: var(--color-saffron-soft); }
.fd-nav-next { text-align: right; margin-left: auto; }
.fd-nav-arrow { font-size: 18px; color: var(--color-saffron); flex-shrink: 0; }
.fd-nav-meta { display: flex; flex-direction: column; gap: 2px; }
.fd-nav-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-mute); font-weight: 600; }
.fd-nav-name  { font-size: 13px; font-weight: 600; line-height: 1.3; }
</style>
