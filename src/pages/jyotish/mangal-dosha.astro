---
import Layout from '../../layouts/Layout.astro';
import { PLANET_ICONS } from '../../lib/icons/planets';
import CalculatorFaq from '../../components/CalculatorFaq.astro';
import { sharedCalcFaq } from '../../lib/calculatorFaq';
import { evaluateMangalDosha } from '../../lib/mangalDosha';
import { calcLagna, planetLongitude } from '../../lib/astro-core';
import { moonLongitude, lahiriAyanamsha } from '../../lib/panchang';
import { jdFull, SYNTHETIC_EXAMPLE_BIRTH } from '../../lib/kundali';

function planetIconSvg(id: string, size: number, color: string): string {
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${PLANET_ICONS[id]}</svg>`;
}

// Illustrative-example prerender -- see kundali.ts's SYNTHETIC_EXAMPLE_BIRTH comment: a clearly-
// fictional sample birth, not "today" (a real stranger's live result) and not a real named
// person (which would make a permanent public claim like "so-and-so has Mangal Dosha" about
// them). The client <script> pre-fills this same date/time/place and recalculates on load using
// this same evaluateMangalDosha(), so prerendered and hydrated content start identical.
const EB = SYNTHETIC_EXAMPLE_BIRTH;
const EB_RASHI = ['Mesha', 'Vrishabha', 'Mithuna', 'Karka', 'Simha', 'Kanya', 'Tula', 'Vrishchika', 'Dhanu', 'Makara', 'Kumbha', 'Meena'];
const EB_DATE_STR = `${EB.y}-${String(EB.m).padStart(2, '0')}-${String(EB.d).padStart(2, '0')}`;
const EB_TIME_STR = `${String(EB.hh).padStart(2, '0')}:${String(EB.mm).padStart(2, '0')}`;
const n360eb = (a: number) => ((a % 360) + 360) % 360;
function angDiffEb(a: number, b: number): number { const d = n360eb(a - b); return d > 180 ? 360 - d : d; }

const ebDate = new Date(Date.UTC(EB.y, EB.m - 1, EB.d, EB.hh, EB.mm) - EB.tz * 3600000);
const ebJD = jdFull(ebDate);
const ebAy = lahiriAyanamsha(ebJD);
const ebMarsSign = Math.floor(n360eb(planetLongitude('mars', ebJD) - ebAy) / 30);
const ebMoonSign = Math.floor(n360eb(moonLongitude(ebJD) - ebAy) / 30);
const ebVenusSign = Math.floor(n360eb(planetLongitude('venus', ebJD) - ebAy) / 30);
const ebLagnaSign = Math.floor(n360eb(calcLagna(ebJD, EB.lat, EB.lng) - ebAy) / 30);
const ebSidMars = n360eb(planetLongitude('mars', ebJD) - ebAy);
const ebSidGuru = n360eb(planetLongitude('jupiter', ebJD) - ebAy);
const ebSidMoon = n360eb(moonLongitude(ebJD) - ebAy);
const ebDGuruMars = angDiffEb(ebSidGuru, ebSidMars);
const ebDMoonMars = angDiffEb(ebSidMoon, ebSidMars);
const ebMd = evaluateMangalDosha({ marsSign: ebMarsSign, lagnaSign: ebLagnaSign, moonSign: ebMoonSign, venusSign: ebVenusSign, jupiterMarsOrbDeg: ebDGuruMars, moonMarsOrbDeg: ebDMoonMars });

const EB_REF_LABELS = ['Lagna (Ascendant)', 'Moon', 'Venus'];
const EB_FULL_RULE_LABEL: Record<string, string> = { ownSign: 'Mars in own sign', exalted: 'Mars exalted in Makara', yogakarakaLagna: 'Cancer/Leo Lagna (Yogakaraka Mars)', jupiterConjunct: 'Jupiter conjunct Mars' };
const ebAppliedFullRules = ebMd.cancelRules.filter(c => c.applies && EB_FULL_RULE_LABEL[c.key]).map(c => EB_FULL_RULE_LABEL[c.key]);
let ebSeverityLabel = 'No Mangal Dosha', ebSevColor = '#15803d';
if (ebMd.severity === 'cancelled') { ebSeverityLabel = 'Cancelled (Bhanga)'; ebSevColor = '#0891b2'; }
else if (ebMd.severity === 'high') { ebSeverityLabel = 'High'; ebSevColor = '#dc2626'; }
else if (ebMd.severity === 'low') { ebSeverityLabel = 'Low to Medium'; ebSevColor = '#b45309'; }
const ebBg = ebMd.severity === 'none' || ebMd.severity === 'cancelled' ? 'var(--color-auspicious-soft)' : (ebMd.severity === 'high' ? 'var(--color-inauspicious-soft)' : 'var(--color-warning-soft)');

const EB_RULE_COPY: Record<string, { rule: string; strength: string }> = {
  ownSign: { rule: 'Mars in own sign (Mesha or Vrishchika)', strength: 'Full' },
  exalted: { rule: 'Mars exalted (Makara)', strength: 'Full' },
  yogakarakaLagna: { rule: 'Cancer or Leo Lagna (Yogakaraka)', strength: 'Full' },
  jupiterConjunct: { rule: 'Jupiter conjunct Mars (within 10°)', strength: 'Full' },
  weakSign: { rule: 'Mars in weakening sign (Karka, Simha, Kumbha, Meena)', strength: 'Partial' },
  moonConjunct: { rule: 'Moon conjunct Mars (within 10°)', strength: 'Moderate' },
};

const FAQ_ITEMS = [
  ...sharedCalcFaq('before deciding a match is incompatible'),
  {
    q: 'Why does the calculator check Mars from three different points (Lagna, Moon, and Venus) instead of just one?',
    a: 'Because that\'s the standard method for a complete Mangal Dosha assessment — a person is only considered fully clear if Mars avoids the dosha houses (1st, 2nd, 4th, 7th, 8th, 12th) from all three reference points, not just one. The more of the three points where Mars falls in a dosha house, the more significant the affliction is traditionally considered — which is exactly why this calculator reports how many of the three references flagged it, not just a single yes/no.',
  },
  {
    q: 'The page lists "both partners are Manglik" and "the dosha weakens after age 28" as cancellation rules above, but the Cancellation Analysis table doesn\'t check them — why?',
    a: 'Because neither one can be evaluated from a single birth chart. "Both partners Manglik" requires comparing two separate charts against each other, which is outside what a one-person calculator can check — that\'s a factor to apply yourself once you have both results. The age-28 rule isn\'t a chart placement at all; it\'s a general statement about timing that applies the same way regardless of any specific chart detail. The six rules in the Cancellation Analysis table are the ones this calculator can verify directly from your birth data: Mars in its own sign, Mars exalted, a Cancer/Leo Lagna (where Mars is a yogakaraka), Mars in a weakening sign, and close conjunction with Jupiter or the Moon.',
  },
  {
    q: 'What does a "Cancelled (Bhanga)" result mean, and how is it different from "Present, Low to Medium"?',
    a: 'Both mean Mars falls in a dosha house from at least one reference point — the difference is which cancellation condition, if any, applies. Four of the six rules — Mars in its own sign, Mars exalted, a Cancer/Leo Lagna, and a close Jupiter conjunction — are described as full, near-unanimous cancellations across the classical sources this calculator was cross-checked against, so when any of those applies the result is "Cancelled" rather than "Present." The other two rules — Mars in a weakening sign, and a close Moon conjunction — are recognised in the same sources but with more mixed treatment (one source explicitly calls the Moon\'s influence "a mild modifier" rather than a full cancellation), so they only lower the severity rating rather than flipping the verdict to Cancelled. A Cancelled result is not the same as "nothing to worry about" — it means a specific, classically-recognised exception applies to a placement that would otherwise be flagged, not that the placement was never a placement worth checking.',
  },
  {
    q: 'How is the severity (High vs. Low-to-Medium) determined?',
    a: "This calculator's own reasonable rule of thumb, applying the general principle sources agree on — more afflicted reference points and a poorly-placed Mars mean a more significant dosha — rather than a single universally fixed formula. Specifically: it's rated High when Mars falls in a dosha house from 2 or more of the three references and none of the six cancellation rules apply at all; if any rule applies but none of them is full-strength, or only 1 of 3 references is affected, it's rated Low to Medium; if a full-strength rule applies, the result is Cancelled instead of a severity rating. Different sources grade severity somewhat differently, so treat this rating as directional rather than an authoritative classification.",
  },
];
---

<Layout title="Mangal Dosha Calculator — Manglik Check — PanchangPath" description="Check if you are Manglik (Mangal Dosha) from your birth chart. Analyses Mars from Lagna, Moon and Venus, with severity and classical cancellation rules.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">मंगल दोष · MANGAL DOSHA</p>
      <h1 data-hi="मंगल दोष (मांगलिक) कैलकुलेटर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Mangal Dosha (Manglik) Calculator</h1>
      <p data-hi="जानें कि क्या आपकी कुंडली में मंगल दोष बनता है। यह जांच लग्न, चंद्रमा और शुक्र से की जाती है।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:520px;">Find out whether Mars creates Mangal Dosha in your chart. The check is run from the Lagna, the Moon and Venus.</p>
    </div>
  </section>

  <section style="padding:28px 0 56px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div><label for="f-date" class="fld-label" data-hi="जन्म तिथि">Date of Birth</label><input type="date" id="f-date" lang="en-GB" class="input" style="height:38px;" /></div>
        <div><label for="f-time" class="fld-label" data-hi="जन्म समय">Time of Birth</label><input type="time" id="f-time" class="input" style="height:38px;" /></div>
        <div><label for="f-city" class="fld-label" data-hi="स्थान">Place</label><select id="f-city" class="input" style="height:38px;min-width:150px;"></select></div>
        <button id="f-calc" class="btn-primary" data-hi="दोष जांचें" style="height:38px;padding:0 20px;">Check Dosha</button>
      </div>
      <p id="date-echo" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;">Date of birth: {EB_DATE_STR}</p>
      <p id="example-note" style="font-size:12px;color:var(--color-mute);margin:-16px 0 20px;">Showing an illustrative example (synthetic sample birth, not a real person) — enter your own birth details above and click Check Dosha for your result.</p>

      <div id="result">
        <div class="card" id="dosha-banner" style={`padding:32px;text-align:center;margin-bottom:24px;background:${ebBg};`}>
          {ebMd.severity === 'none' && (
            <>
              <div style="display:flex;justify-content:center;margin-bottom:6px;" set:html={planetIconSvg('mangal', 40, '#15803d')} />
              <h2 style="font-size:24px;font-weight:700;color:#15803d;margin:0 0 6px;">No Mangal Dosha</h2>
              <p style="font-size:14px;color:var(--color-body-text);margin:0;">Mars in {EB_RASHI[ebMarsSign]} does not fall in a dosha house from Lagna, Moon or Venus.</p>
            </>
          )}
          {ebMd.severity === 'cancelled' && (
            <>
              <div style="display:flex;justify-content:center;margin-bottom:6px;" set:html={planetIconSvg('mangal', 40, ebSevColor)} />
              <h2 style={`font-size:22px;font-weight:700;color:${ebSevColor};margin:0 0 6px;`}>Mangal Dosha — Cancelled (Bhanga)</h2>
              <p style="font-size:14px;color:var(--color-body-text);margin:0;">Mars in {EB_RASHI[ebMarsSign]} does place a dosha from {ebMd.doshaCount} of 3 references, but {ebAppliedFullRules.join(' and ')} is a classically recognised cancellation.</p>
            </>
          )}
          {(ebMd.severity === 'high' || ebMd.severity === 'low') && (
            <>
              <div style="display:flex;justify-content:center;margin-bottom:6px;" set:html={planetIconSvg('mangal', 40, ebSevColor)} />
              <h2 style={`font-size:24px;font-weight:700;color:${ebSevColor};margin:0 0 6px;`}>Mangal Dosha Present</h2>
              <p style="font-size:14px;color:var(--color-body-text);margin:0;">Severity: <b style={`color:${ebSevColor};`}>{ebSeverityLabel}</b> &middot; Mars in {EB_RASHI[ebMarsSign]} &middot; Dosha from {ebMd.doshaCount} of 3 references</p>
            </>
          )}
        </div>
        <div class="card" style="padding:20px;margin-bottom:24px;overflow-x:auto;">
          <h3 data-hi="मंगल स्थिति विश्लेषण" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Mars Position Analysis</h3>
          <table style="width:100%;border-collapse:collapse;font-size:13px;" id="pos-table">
            <tr><th>Reference</th><th>Sign</th><th>Mars House</th><th>Status</th></tr>
            {ebMd.referenceHouses.map((r, i) => (
              <tr><td style="color:var(--color-ink);font-weight:600;">From {EB_REF_LABELS[i]}</td><td>{EB_RASHI[r.sign]}</td><td>House {r.house}</td><td><span style={`color:${r.isDosha ? '#dc2626' : '#15803d'};font-weight:600;`}>{r.isDosha ? 'Dosha' : 'Clear'}</span></td></tr>
            ))}
          </table>
        </div>
        <div class="card" style="padding:24px;">
          <h3 data-hi="इसका क्या अर्थ है" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 8px;">What this means</h3>
          <p id="meaning" style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0;">
            {ebMd.severity === 'none' && `Mars is favourably placed and does not create Mangal Dosha for this example chart.`}
            {ebMd.severity === 'cancelled' && `Mars falls in a dosha-causing house from ${ebMd.doshaCount} reference point${ebMd.doshaCount > 1 ? 's' : ''}, but a classical cancellation condition — ${ebAppliedFullRules.join(', ')} — is present, which the classical texts treat as clearing the dosha rather than merely softening it.`}
            {(ebMd.severity === 'high' || ebMd.severity === 'low') && `Mars falls in a dosha-causing house from ${ebMd.doshaCount} reference point${ebMd.doshaCount > 1 ? 's' : ''}. No classical full-cancellation condition applies here.`}
          </p>
        </div>
        <div class="card" style="padding:20px;overflow-x:auto;">
          <h3 data-hi="निवारण विश्लेषण (मंगल दोष भंग)" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Cancellation Analysis (Mangal Dosha Bhanga)</h3>
          <table id="cancel-table" style="width:100%;border-collapse:collapse;font-size:13px;">
            <tr><th>Rule</th><th>Strength</th><th>Status</th></tr>
            {ebMd.cancelRules.map(c => (
              <tr><td style="color:var(--color-ink);font-weight:600;">{EB_RULE_COPY[c.key].rule}</td><td>{EB_RULE_COPY[c.key].strength}</td><td><span style={`color:${c.applies ? '#15803d' : '#9ca3af'};font-weight:600;`}>{c.applies ? '✓ Applies' : '× Not applicable'}</span></td></tr>
            ))}
          </table>
        </div>
        <div id="remedy-panel" class="card" style={`padding:20px;${ebMd.present ? '' : 'display:none;'}`}>
          <h3 style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 10px;">Recommended Remedies</h3>
          <ul style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:8px;">
            <li style="font-size:14px;color:var(--color-body-text);line-height:1.6;">Recite the Mangal Mantra — "Om Angarakaya Namah" — 108 times every Tuesday.</li>
            <li style="font-size:14px;color:var(--color-body-text);line-height:1.6;">Worship Lord Hanuman or Lord Kartikeya (Murugan) on Tuesdays.</li>
            <li style="font-size:14px;color:var(--color-body-text);line-height:1.6;">Observe a Tuesday fast and donate red lentils (masoor dal), red cloth or red flowers.</li>
            <li style="font-size:14px;color:var(--color-body-text);line-height:1.6;">Consider Red Coral (Moonga) in gold on the ring finger — consult a qualified Jyotishi before wearing.</li>
            <li style="font-size:14px;color:var(--color-body-text);line-height:1.6;">A Mangal Shanti Puja performed by a trained priest provides deeper karmic relief.</li>
          </ul>
        </div>
      </div>
      <div id="err" style="display:none;padding:16px;background:var(--color-inauspicious-soft);border-radius:8px;color:#b91c1c;font-size:14px;"></div>

      <div class="card" style="padding:24px;margin-top:24px;">
        <h3 data-hi="निवारण नियम (मंगल दोष भंग)" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Cancellation Rules (Mangal Dosha Bhanga)</h3>
        <ul style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:7px;">
          <li data-hi="स्वराशि (मेष, वृश्चिक) में या उच्च राशि (मकर) में मंगल दोष को शास्त्रोक्त रूप से निष्प्रभावी कर देता है — यह इस कैलकुलेटर की गणना में एक पूर्ण निवारण माना जाता है।" style="font-size:14px;color:var(--color-body-text);line-height:1.6;">Mars in its own sign (Mesha, Vrishchika) or exalted (Makara) classically cancels the dosha — treated as a full cancellation in this calculator's verdict.</li>
          <li data-hi="कर्क, सिंह, कुम्भ या मीन में मंगल कमजोर माना जाता है और दोष की तीव्रता कम हो जाती है, यद्यपि पूर्णतः निष्प्रभावी नहीं होता।" style="font-size:14px;color:var(--color-body-text);line-height:1.6;">Mars in Karka, Simha, Kumbha or Meena is considered weak and reduces the dosha's severity, though it does not cancel it outright.</li>
          <li data-hi="जब दोनों साथी मांगलिक हों, तो दोष परस्पर निष्प्रभावी हो जाता है।" style="font-size:14px;color:var(--color-body-text);line-height:1.6;">When both partners are Manglik, the dosha is mutually cancelled.</li>
          <li data-hi="गुरु की दृष्टि या युति में मंगल दोष शास्त्रोक्त रूप से निष्प्रभावी माना जाता है — स्रोतों में यह सबसे प्रबल एकल निवारण है।" style="font-size:14px;color:var(--color-body-text);line-height:1.6;">Jupiter's aspect or conjunction on Mars is described across sources as the single strongest cancellation — treated as a full cancellation here.</li>
          <li data-hi="चंद्रमा की युति मंगल को कुछ हद तक शांत करती है, परंतु स्रोत इसे गुरु जितना प्रबल नहीं मानते — यह तीव्रता कम करता है, दोष को पूर्णतः निष्प्रभावी नहीं करता।" style="font-size:14px;color:var(--color-body-text);line-height:1.6;">The Moon's conjunction softens Mars somewhat, but sources treat it as milder than Jupiter's — it lowers severity rather than clearing the dosha outright.</li>
          <li data-hi="कर्क या सिंह लग्न में जन्मे लोगों के लिए मंगल योगकारक/शुभ ग्रह है और दोष लागू नहीं होता।" style="font-size:14px;color:var(--color-body-text);line-height:1.6;">For people born with Karka or Simha Lagna, Mars is a yogakaraka/benefic and the dosha does not apply.</li>
          <li data-hi="कहा जाता है कि 28 वर्ष की आयु के बाद दोष स्वाभाविक रूप से कमजोर हो जाता है।" style="font-size:14px;color:var(--color-body-text);line-height:1.6;">The dosha is said to weaken naturally after the age of 28.</li>
        </ul>
      </div>

      <div class="card" style="padding:28px;margin-top:24px;">
        <h2 data-hi="मंगल दोष के बारे में" style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">About Mangal Dosha</h2>
        <p data-hi="मंगल दोष (जिसे कुज दोष या 'मांगलिक' होना भी कहा जाता है) तब होता है जब मंगल पहले, दूसरे, चौथे, सातवें, आठवें या बारहवें भाव में स्थित हो। चूंकि मंगल उग्र और आक्रामक है, माना जाता है कि ये स्थितियां विवाह में घर्षण पैदा करती हैं। विवाह मिलान में, परंपरागत रूप से एक मांगलिक की जोड़ी दूसरे मांगलिक से बनाई जाती है ताकि दोष निष्प्रभावी हो जाएं। आधुनिक अभ्यास कई निवारण कारकों पर विचार करता है, इसलिए केवल मांगलिक परिणाम शायद ही कभी निर्णायक बाधा बनता है।" style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0;">Mangal Dosha (also called Kuja Dosha or being "Manglik") occurs when Mars sits in the 1st, 2nd, 4th, 7th, 8th or 12th house. Because Mars is fiery and aggressive, these placements are believed to create friction in marriage. In matchmaking, a Manglik is traditionally paired with another Manglik so the doshas neutralise. Modern practice weighs many cancellation factors, so a Manglik result alone is rarely a deal-breaker.</p>
      </div>

      <CalculatorFaq items={FAQ_ITEMS} />
    </div>
  </section>
</Layout>

<style>
  .fld-label { font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em; }
  #pos-table th { text-align:left;padding:7px 8px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.04em; }
  #pos-table td { padding:8px;border-bottom:1px solid var(--color-hairline);color:var(--color-body-text); }
</style>

<script>
import { LOCATIONS } from '../../lib/locations';
import { PLANET_ICONS } from '../../lib/icons/planets';
import { moonLongitude, lahiriAyanamsha } from '../../lib/panchang';
import { planetLongitude, calcLagna } from '../../lib/astro-core';
import { evaluateMangalDosha } from '../../lib/mangalDosha';
import { SYNTHETIC_EXAMPLE_BIRTH } from '../../lib/kundali';

const MANGAL_SVG = PLANET_ICONS.mangal;
let LANG_HI = localStorage.getItem('pp-lang') === 'hi';
function tr(en, hi) { return LANG_HI ? hi : en; }
const WD_EN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI=['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN=['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI=['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(y,m,d){const wd=new Date(Date.UTC(y,m-1,d,12)).getUTCDay();return tr(`${WD_EN[wd]}, ${d} ${MO_EN[m-1]} ${y}`,`${WD_HI[wd]}, ${d} ${MO_HI[m-1]} ${y}`);}
function mangalIconSvg(size,color){return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${MANGAL_SVG}</svg>`;}
const LOCS=LOCATIONS.map(l=>({name:l.name,nameHi:l.nameHi,lat:l.lat,lng:l.lng,tz:l.tzOffset}));
function toJD(y,m,d,h){h=h||0;if(m<=2){y--;m+=12;}const A=Math.floor(y/100),B=2-A+Math.floor(A/4);return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;}
const n360=a=>((a%360)+360)%360;
function angDiff(a,b){const d=n360(a-b);return d>180?360-d:d;}

const RASHI=['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RASHI_HI=['मेष','वृषभ','मिथुन','कर्क','सिंह','कन्या','तुला','वृश्चिक','धनु','मकर','कुम्भ','मीन'];
function trRashi(i){return tr(RASHI[i],RASHI_HI[i]);}
const RASHI_EN=['Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius','Capricorn','Aquarius','Pisces'];

const sel=document.getElementById('f-city');function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(LANG_HI?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();
const EB=SYNTHETIC_EXAMPLE_BIRTH;
const ebDateStr=`${EB.y}-${String(EB.m).padStart(2,'0')}-${String(EB.d).padStart(2,'0')}`;
const ebTimeStr=`${String(EB.hh).padStart(2,'0')}:${String(EB.mm).padStart(2,'0')}`;
document.getElementById('f-date').value=ebDateStr;
document.getElementById('f-time').value=ebTimeStr;
sel.value=EB.city;

function calculate(){
  try{
    const dateStr=document.getElementById('f-date').value;
    const timeStr=document.getElementById('f-time').value||'12:00';
    const loc=LOCS.find(l=>l.name===document.getElementById('f-city').value)||LOCS[0];
    const [y,m,d]=dateStr.split('-').map(Number);const [hh,mm]=timeStr.split(':').map(Number);
    const de=document.getElementById('date-echo');
    if(de){de.textContent=tr('Date of birth: ','जन्म तिथि: ')+formatLongDate(y,m,d);de.hidden=false;}
    const noteEl=document.getElementById('example-note');
    if(noteEl)noteEl.style.display=(dateStr===ebDateStr&&timeStr===ebTimeStr&&document.getElementById('f-city').value===EB.city)?'':'none';
    const jd=toJD(y,m,d,(hh+mm/60)-loc.tz);
    const ay=lahiriAyanamsha(jd);
    const marsSign=Math.floor(n360(planetLongitude('mars',jd)-ay)/30);
    const moonSign=Math.floor(n360(moonLongitude(jd)-ay)/30);
    const venusSign=Math.floor(n360(planetLongitude('venus',jd)-ay)/30);
    const lagnaSign=Math.floor(n360(calcLagna(jd,loc.lat,loc.lng)-ay)/30);
    const sid_mangal=n360(planetLongitude('mars',jd)-ay);
    const sid_guru=n360(planetLongitude('jupiter',jd)-ay);
    const sid_moon=n360(moonLongitude(jd)-ay);
    const dGuruMars=angDiff(sid_guru,sid_mangal);
    const dMoonMars=angDiff(sid_moon,sid_mangal);

    const md=evaluateMangalDosha({marsSign,lagnaSign,moonSign,venusSign,jupiterMarsOrbDeg:dGuruMars,moonMarsOrbDeg:dMoonMars});
    const doshaCount=md.doshaCount;
    const refLabels=[tr('Lagna (Ascendant)','लग्न (उदय राशि)'),tr('Moon','चंद्रमा'),tr('Venus','शुक्र')];
    const rows=md.referenceHouses.map((r,i)=>{
      const label=refLabels[i];
      return `<tr><td style="color:var(--color-ink);font-weight:600;">${tr('From '+label,label+' से')}</td><td>${trRashi(r.sign)}</td><td>${tr('House','भाव')} ${r.house}</td><td><span style="color:${r.isDosha?'#dc2626':'#15803d'};font-weight:600;">${r.isDosha?tr('Dosha','दोष'):tr('Clear','शुद्ध')}</span></td></tr>`;
    });
    document.getElementById('pos-table').innerHTML=`<tr><th>${tr('Reference','संदर्भ')}</th><th>${tr('Sign','राशि')}</th><th>${tr('Mars House','मंगल भाव')}</th><th>${tr('Status','स्थिति')}</th></tr>`+rows.join('');

    const present=md.present;
    // Cancellation rules this severity/verdict responds to (see src/lib/mangalDosha.ts for
    // sourcing): Mars own sign, Mars exalted, Cancer/Leo Lagna, and Jupiter conjunction are
    // treated as FULL cancellations (verdict becomes "Cancelled"); Mars in a weakening sign
    // and Moon conjunction are treated as reducing severity without cancelling outright.
    const fullRuleLabel={ownSign:tr('Mars in own sign','मंगल स्वराशि में'),exalted:tr('Mars exalted in Makara','मंगल मकर में उच्च का'),yogakarakaLagna:tr('Cancer/Leo Lagna (Yogakaraka Mars)','कर्क/सिंह लग्न (योगकारक मंगल)'),jupiterConjunct:tr('Jupiter conjunct Mars','गुरु मंगल की युति में')};
    const appliedFullRules=md.cancelRules.filter(c=>c.applies&&fullRuleLabel[c.key]).map(c=>fullRuleLabel[c.key]);
    let severityLabel,sevColor;
    if(md.severity==='none'){severityLabel=tr('No Mangal Dosha','मंगल दोष नहीं');sevColor='#15803d';}
    else if(md.severity==='cancelled'){severityLabel=tr('Cancelled (Bhanga)','निष्प्रभावी (भंग)');sevColor='#0891b2';}
    else if(md.severity==='high'){severityLabel=tr('High','उच्च');sevColor='#dc2626';}
    else{severityLabel=tr('Low to Medium','निम्न से मध्यम');sevColor='#b45309';}

    const bg=md.severity==='none'||md.severity==='cancelled'?'var(--color-auspicious-soft)':(md.severity==='high'?'var(--color-inauspicious-soft)':'var(--color-warning-soft)');
    document.getElementById('dosha-banner').style.background=bg;
    if(md.severity==='none'){
      document.getElementById('dosha-banner').innerHTML=`<div style="display:flex;justify-content:center;margin-bottom:6px;">${mangalIconSvg(40,'#15803d')}</div><h2 style="font-size:24px;font-weight:700;color:#15803d;margin:0 0 6px;">${tr('No Mangal Dosha','मंगल दोष नहीं है')}</h2><p style="font-size:14px;color:var(--color-body-text);margin:0;">${tr('Mars in '+trRashi(marsSign)+' does not fall in a dosha house from your Lagna, Moon or Venus.','आपके लग्न, चंद्रमा या शुक्र से '+trRashi(marsSign)+' में मंगल किसी दोष भाव में नहीं आता।')}</p>`;
    }else if(md.severity==='cancelled'){
      document.getElementById('dosha-banner').innerHTML=`<div style="display:flex;justify-content:center;margin-bottom:6px;">${mangalIconSvg(40,sevColor)}</div><h2 style="font-size:22px;font-weight:700;color:${sevColor};margin:0 0 6px;">${tr('Mangal Dosha — Cancelled (Bhanga)','मंगल दोष — निष्प्रभावी (भंग)')}</h2><p style="font-size:14px;color:var(--color-body-text);margin:0;">${tr('Mars in','मंगल')} ${trRashi(marsSign)} ${tr('does place a dosha from '+doshaCount+' of 3 references, but',doshaCount+' में से 3 संदर्भों से दोष तो बनाता है, परंतु')} ${appliedFullRules.join(tr(' and ',' और '))} ${tr('is a classically recognised cancellation.','एक शास्त्रोक्त निवारण है।')}</p>`;
    }else{
      document.getElementById('dosha-banner').innerHTML=`<div style="display:flex;justify-content:center;margin-bottom:6px;">${mangalIconSvg(40,sevColor)}</div><h2 style="font-size:24px;font-weight:700;color:${sevColor};margin:0 0 6px;">${tr('Mangal Dosha Present','मंगल दोष उपस्थित')}</h2><p style="font-size:14px;color:var(--color-body-text);margin:0;">${tr('Severity','तीव्रता')}: <b style="color:${sevColor};">${severityLabel}</b> · ${tr('Mars in','मंगल')} ${trRashi(marsSign)} · ${tr('Dosha from '+doshaCount+' of 3 references',doshaCount+' में से 3 संदर्भों से दोष')}</p>`;
    }

    let meaning;
    if(md.severity==='none'){meaning=tr(`Your Mars is favourably placed and does not create Mangal Dosha. There are no Manglik-related concerns for marriage from this analysis.`,`आपका मंगल अनुकूल स्थिति में है और मंगल दोष उत्पन्न नहीं करता। इस विश्लेषण के अनुसार विवाह हेतु कोई मांगलिक संबंधी चिंता नहीं है।`);}
    else if(md.severity==='cancelled'){meaning=tr(`Mars falls in a dosha-causing house from ${doshaCount} reference point${doshaCount>1?'s':''}, but a classical cancellation condition — ${appliedFullRules.join(', ')} — is present in your chart, which the classical texts treat as clearing the dosha rather than merely softening it. This is not the same as "nothing to worry about": it means the specific placement that would otherwise be flagged is, by the same tradition that flags it, also the tradition's own exception to it. Most practitioners still weigh the full chart before ruling it out entirely.`,`मंगल ${doshaCount} संदर्भ बिंदु${doshaCount>1?'ओं':''} से दोष उत्पन्न करने वाले भाव में तो है, परंतु आपकी कुंडली में एक शास्त्रोक्त निवारण स्थिति — ${appliedFullRules.join(', ')} — मौजूद है, जिसे शास्त्रों में दोष को केवल कम करने के बजाय पूर्णतः निष्प्रभावी करने वाला माना जाता है। इसका अर्थ यह नहीं कि "कोई चिंता की बात नहीं" — बल्कि यह है कि जो स्थिति सामान्यतः चिह्नित की जाती, वही परंपरा उसका अपवाद भी मानती है। अधिकांश ज्योतिषी फिर भी अंतिम निर्णय से पहले पूर्ण कुंडली पर विचार करते हैं।`);}
    else{meaning=tr(`Mars falls in a dosha-causing house from ${doshaCount} reference point${doshaCount>1?'s':''}. `,`मंगल ${doshaCount} संदर्भ बिंदु${doshaCount>1?'ओं':''} से दोष उत्पन्न करने वाले भाव में स्थित है। `);
      const weakApplies=md.cancelRules.find(c=>c.key==='weakSign')?.applies;
      const moonApplies=md.cancelRules.find(c=>c.key==='moonConjunct')?.applies;
      if(weakApplies)meaning+=tr(`Mars in ${trRashi(marsSign)} is considered a weakening sign, which lessens (but does not cancel) the effect. `,`${trRashi(marsSign)} में मंगल कमजोर राशि माना जाता है, जिससे प्रभाव कम होता है (परंतु निष्प्रभावी नहीं होता)। `);
      if(moonApplies)meaning+=tr(`The Moon's proximity to Mars also softens it somewhat, though sources treat this as a mild modifier rather than a full cancellation. `,`चंद्रमा की मंगल से निकटता भी इसे कुछ हद तक नरम करती है, यद्यपि स्रोत इसे पूर्ण निवारण के बजाय एक हल्का प्रभावक मानते हैं। `);
      meaning+=tr(`No classical full-cancellation condition (own sign, exaltation, yogakaraka Lagna, or close Jupiter conjunction) applies here, so this result should be taken seriously rather than dismissed — though it is one factor among many, and a full chart reading with a qualified Jyotishi gives the complete picture. Traditionally this also calls for matching with a partner who is also Manglik.`,`यहां कोई पूर्ण निवारण स्थिति (स्वराशि, उच्च राशि, योगकारक लग्न, या निकट गुरु युति) लागू नहीं होती, अतः इस परिणाम को हल्के में न लें — यद्यपि यह कई कारकों में से एक है, और किसी योग्य ज्योतिषी द्वारा पूर्ण कुंडली विश्लेषण ही संपूर्ण चित्र देता है। परंपरागत रूप से इसके लिए ऐसे साथी से मिलान भी उपयुक्त है जो स्वयं भी मांगलिक हो।`);}
    document.getElementById('meaning').textContent=meaning;

    // Cancellation analysis table — display copy for the six rules computed in md.cancelRules
    const ruleCopy={
      ownSign:{rule:tr('Mars in own sign (Mesha or Vrishchika)','मंगल स्वराशि में (मेष या वृश्चिक)'),strength:tr('Full','पूर्ण'),note:[0,7].includes(marsSign)?tr('Mars in '+trRashi(marsSign)+' — natural dignity clears the dosha','मंगल '+trRashi(marsSign)+' में — स्वाभाविक गरिमा दोष को निष्प्रभावी करती है'):tr('Mars in '+trRashi(marsSign)+' — not in own sign','मंगल '+trRashi(marsSign)+' में — स्वराशि में नहीं')},
      exalted:{rule:tr('Mars exalted (Makara)','मंगल उच्च राशि में (मकर)'),strength:tr('Full','पूर्ण'),note:marsSign===9?tr('Mars is exalted in Makara — dosha is classically cancelled','मंगल मकर में उच्च का है — दोष शास्त्रोक्त रूप से निष्प्रभावी हो जाता है'):tr('Mars is not exalted (exaltation: Makara)','मंगल उच्च का नहीं है (उच्च राशि: मकर)')},
      yogakarakaLagna:{rule:tr('Cancer or Leo Lagna (Yogakaraka)','कर्क या सिंह लग्न (योगकारक)'),strength:tr('Full','पूर्ण'),note:[3,4].includes(lagnaSign)?tr('For '+trRashi(lagnaSign)+' Lagna, Mars is a benefic yogakaraka — dosha does not apply',trRashi(lagnaSign)+' लग्न के लिए, मंगल एक शुभ योगकारक है — दोष लागू नहीं होता'):tr('Lagna is '+trRashi(lagnaSign)+' — Mars is not yogakaraka','लग्न '+trRashi(lagnaSign)+' है — मंगल योगकारक नहीं है')},
      jupiterConjunct:{rule:tr('Jupiter conjunct Mars (within 10\xb0)','गुरु मंगल की युति में (10° के भीतर)'),strength:tr('Full','पूर्ण'),note:tr('Jupiter is '+dGuruMars.toFixed(1)+'\xb0 from Mars — '+(dGuruMars<10?'this close conjunction is classically the strongest single cancellation':'not in close conjunction'),'गुरु मंगल से '+dGuruMars.toFixed(1)+'° दूर है — '+(dGuruMars<10?'यह निकट युति शास्त्रोक्त रूप से सबसे प्रबल निवारण मानी जाती है':'निकट युति में नहीं'))},
      weakSign:{rule:tr('Mars in weakening sign (Karka, Simha, Kumbha, Meena)','मंगल कमजोर राशि में (कर्क, सिंह, कुम्भ, मीन)'),strength:tr('Partial','आंशिक'),note:[3,4,10,11].includes(marsSign)?tr('Mars in '+trRashi(marsSign)+' is considered weak — reduces severity, does not cancel','मंगल '+trRashi(marsSign)+' में कमजोर माना जाता है — तीव्रता कम करता है, निष्प्रभावी नहीं करता'):tr('Mars in '+trRashi(marsSign)+' is not in a weakening sign','मंगल '+trRashi(marsSign)+' में कमजोर राशि में नहीं है')},
      moonConjunct:{rule:tr('Moon conjunct Mars (within 10\xb0)','चंद्रमा मंगल की युति में (10° के भीतर)'),strength:tr('Moderate','मध्यम'),note:tr('Moon is '+dMoonMars.toFixed(1)+'\xb0 from Mars — '+(dMoonMars<10?'sources treat this as a mild softening modifier, not a full cancellation':'not in close conjunction'),'चंद्रमा मंगल से '+dMoonMars.toFixed(1)+'° दूर है — '+(dMoonMars<10?'स्रोत इसे हल्का शामक प्रभावक मानते हैं, पूर्ण निवारण नहीं':'निकट युति में नहीं'))},
    };
    const cancels=md.cancelRules.map(c=>({...ruleCopy[c.key],applies:c.applies}));
    const thSt='text-align:left;padding:7px 8px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-size:11px;text-transform:uppercase;letter-spacing:0.04em;font-weight:600;';
    const tdSt='padding:8px 8px;border-bottom:1px solid var(--color-hairline);';
    document.getElementById('cancel-table').innerHTML='<tr><th style="'+thSt+'">'+tr('Rule','नियम')+'</th><th style="'+thSt+'">'+tr('Strength','तीव्रता')+'</th><th style="'+thSt+'">'+tr('Status','स्थिति')+'</th><th style="'+thSt+'">'+tr('Note','टिप्पणी')+'</th></tr>'+
      cancels.map(c=>'<tr><td style="'+tdSt+'color:var(--color-ink);font-weight:600;">'+c.rule+'</td><td style="'+tdSt+'">'+c.strength+'</td><td style="'+tdSt+'"><span style="color:'+(c.applies?'#15803d':'#9ca3af')+';font-weight:600;">'+(c.applies?tr('✓ Applies','✓ लागू होता है'):tr('× Not applicable','× लागू नहीं'))+'</span></td><td style="'+tdSt+'color:var(--color-body-text);">'+c.note+'</td></tr>').join('');
    const anyCancel=cancels.some(c=>c.applies);
    const remedyPanel=document.getElementById('remedy-panel');
    if(present){
      remedyPanel.style.display='block';
      remedyPanel.innerHTML='<h3 style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 10px;">'+tr('Recommended Remedies','अनुशंसित उपाय')+'</h3>'+(md.severity==='cancelled'?'<p style="font-size:13px;color:var(--color-body-text);margin:0 0 10px;line-height:1.6;">'+tr('A full cancellation condition applies to your chart, so these remedies are not required — some traditions still recommend them as routine Tuesday practice rather than a response to affliction.','आपकी कुंडली में एक पूर्ण निवारण स्थिति लागू होती है, अतः ये उपाय आवश्यक नहीं हैं — कुछ परंपराओं में इन्हें पीड़ा के प्रत्युत्तर के बजाय नियमित मंगलवार अभ्यास के रूप में अपनाया जाता है।')+'</p>':(anyCancel?'<p style="font-size:13px;color:var(--color-body-text);margin:0 0 10px;line-height:1.6;">'+tr('Partial cancellation factors are present in your chart, which reduce the dosha’s potency without clearing it. The remedies below can be adopted for further pacification.','आपकी कुंडली में आंशिक निवारण कारक मौजूद हैं, जो दोष की तीव्रता को कम करते हैं परंतु उसे निष्प्रभावी नहीं करते। और शांति के लिए नीचे दिए उपाय अपनाए जा सकते हैं।')+'</p>':''))+
      '<ul style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:8px;"><li style="font-size:14px;color:var(--color-body-text);line-height:1.6;">'+tr('Recite the Mangal Mantra — "Om Angarakaya Namah" — 108 times every Tuesday.','हर मंगलवार 108 बार मंगल मंत्र — "ॐ अंगारकाय नमः" — का जाप करें।')+'</li><li style="font-size:14px;color:var(--color-body-text);line-height:1.6;">'+tr('Worship Lord Hanuman or Lord Kartikeya (Murugan) on Tuesdays.','मंगलवार को भगवान हनुमान या भगवान कार्तिकेय (मुरुगन) की पूजा करें।')+'</li><li style="font-size:14px;color:var(--color-body-text);line-height:1.6;">'+tr('Observe a Tuesday fast and donate red lentils (masoor dal), red cloth or red flowers.','मंगलवार का व्रत रखें और मसूर दाल, लाल कपड़ा या लाल फूल दान करें।')+'</li><li style="font-size:14px;color:var(--color-body-text);line-height:1.6;">'+tr('Consider Red Coral (Moonga) in gold on the ring finger — consult a qualified Jyotishi before wearing.','सोने में जड़ित लाल मूंगा अनामिका उंगली में धारण करने पर विचार करें — पहनने से पहले किसी योग्य ज्योतिषी से परामर्श लें।')+'</li><li style="font-size:14px;color:var(--color-body-text);line-height:1.6;">'+tr('A Mangal Shanti Puja performed by a trained priest provides deeper karmic relief.','प्रशिक्षित पुरोहित द्वारा की गई मंगल शांति पूजा गहरी कर्मिक राहत प्रदान करती है।')+'</li></ul>';
    }else{
      remedyPanel.style.display='none';
    }
    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){const er=document.getElementById('err');er.style.display='block';er.textContent='Calculation error: '+e.message;document.getElementById('result').style.display='none';}
}
document.getElementById('f-calc').addEventListener('click',calculate);
calculate();

function applyPageLang(hindi) {
  LANG_HI = hindi;
  renderCityOptions();
  document.querySelectorAll('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? el.dataset.hi : el.dataset.en;
  });
  calculate();
}
document.addEventListener('langchange', (e) => {
  applyPageLang(e.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
