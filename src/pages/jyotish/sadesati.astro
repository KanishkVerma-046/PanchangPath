---
import Layout from '../../layouts/Layout.astro';
import { PLANET_ICONS } from '../../lib/icons/planets';
import CalculatorFaq from '../../components/CalculatorFaq.astro';
import { sharedCalcFaq } from '../../lib/calculatorFaq';

const FAQ_ITEMS = [
  ...sharedCalcFaq(),
  {
    q: 'The calculator labels two of the three phases "Dhaiya" — is that the same thing as Sadesati?',
    a: 'Sources use "Dhaiya" two different ways, and they disagree. Some use it loosely for Sadesati\'s own Rising and Setting sub-phases, which is how this calculator uses the label. Others use it more strictly for a completely separate transit — Saturn passing through the 4th or 8th house from your Moon sign, which has nothing to do with the 12th/1st/2nd houses Sadesati is built on. If you\'ve seen "Dhaiya" used differently elsewhere, that\'s likely why — it isn\'t a universally standardized term.',
  },
  {
    q: 'Will I really experience Sadesati two to three times in my life?',
    a: "For most lifespans, yes, roughly — Saturn's ~29.5-year orbital period means each recurrence lands about 30 years after the last one, so a typical 80-90 year lifespan spans roughly two to three full cycles. This calculator scans a full 95 years forward from your birth date specifically to capture all of them, not just the current or next one.",
  },
  {
    q: 'Which phase is considered the most difficult?',
    a: "The Peak phase — when Saturn transits directly over your natal Moon sign, not the sign before or after it. Classical and contemporary sources agree this middle ~2.5-year stretch is typically the most tested, since it coincides with Saturn's most direct pressure on the Moon's themes of mind and emotional stability, rather than the more anticipatory (Rising) or resolving (Setting) phases on either side.",
  },
];
---

<Layout title="Shani Sadesati Calculator — 7.5 Year Saturn Cycle — PanchangPath" description="Check your Shani Sadesati status — Saturn\'s 7.5-year transit over your Moon sign. See current phase and a lifetime timeline of all three Sadesati periods.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">शनि साढ़ेसाती · SHANI SADESATI</p>
      <h1 data-hi="शनि साढ़े साती कैलकुलेटर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Shani Sadesati Calculator</h1>
      <p data-hi="साढ़े साती वह 7.5 वर्ष की अवधि है जब शनि आपकी चंद्र राशि से पहले, ऊपर और बाद की राशि में गोचर करता है। अपनी स्थिति और पूर्ण समयरेखा जानें।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:520px;">Sadesati is the 7.5-year period when Saturn transits the sign before, over, and after your Moon sign. Find your status and full timeline.</p>
    </div>
  </section>

  <section style="padding:28px 0 56px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div><label for="f-date" class="fld-label" data-hi="जन्म तिथि">Date of Birth</label><input type="date" id="f-date" lang="en-GB" class="input" style="height:38px;" /></div>
        <div><label for="f-time" class="fld-label" data-hi="जन्म समय">Time of Birth</label><input type="time" id="f-time" class="input" style="height:38px;" /></div>
        <div><label for="f-city" class="fld-label" data-hi="स्थान">Place</label><select id="f-city" class="input" style="height:38px;min-width:150px;"></select></div>
        <button id="f-calc" class="btn-primary" data-hi="गणना करें" style="height:38px;padding:0 20px;">Calculate</button>
      </div>
      <p id="date-echo" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;" hidden></p>

      <div id="result" style="display:none;">
        <div class="card" id="ss-banner" style="padding:32px;text-align:center;margin-bottom:24px;"></div>
        <h3 data-hi="आजीवन साढ़े साती समयरेखा" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Lifetime Sadesati Timeline</h3>
        <div id="timeline" style="display:flex;flex-direction:column;gap:10px;margin-bottom:24px;"></div>
        <div class="card" style="padding:24px;">
          <h3 data-hi="तीन चरण" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 10px;">The Three Phases</h3>
          <div id="phases" style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;" class="phase-grid"></div>
        </div>
      </div>
      <div id="err" style="display:none;padding:16px;background:var(--color-inauspicious-soft);border-radius:8px;color:#b91c1c;font-size:14px;"></div>

      <div class="card" style="padding:28px;margin-top:36px;">
        <h2 data-hi="शनि साढ़े साती के बारे में" style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">About Shani Sadesati</h2>
        <p data-hi="शनि (शनिदेव) को राशिचक्र का चक्कर पूरा करने में लगभग 29.5 वर्ष लगते हैं, यानी हर राशि में लगभग 2.5 वर्ष। साढ़े साती ('सात साढ़े') वह अवधि है जब शनि आपकी जन्म चंद्र राशि से बारहवीं, पहली और दूसरी राशि से गुजरता है — कुल मिलाकर लगभग 7.5 वर्ष। यह लगभग हर 30 वर्ष में दोहराई जाती है, इसलिए अधिकांश लोग इसे जीवन में दो से तीन बार अनुभव करते हैं। कठिन परीक्षाओं और सबकों के लिए जानी जाने वाली साढ़े साती अंततः परिपक्वता, अनुशासन और स्थायी विकास की अवधि है। यहां दी गई तिथियां अनुमानित हैं (शनि के निरयण राशि प्रवेश से गणना की गई)।" style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 14px;">Saturn (Shani) takes about 29.5 years to circle the zodiac, spending roughly 2.5 years in each sign. Sadesati ("seven and a half") is the period when Saturn passes through the 12th, 1st and 2nd signs from your natal Moon — about 7.5 years in total. It recurs roughly every 30 years, so most people experience it two to three times in a lifetime. Though known for tests and hard lessons, Sadesati is ultimately a period of maturity, discipline and lasting growth. Dates here are approximate (computed from Saturn's sidereal sign ingress).</p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0;">This calculator scans forward from your birth date to find every window where Saturn's sidereal position falls in one of the three signs anchored to your natal Moon, then locates the boundary between each of the three roughly-2.5-year sub-phases the same way — using the site's shared <code>planetLongitude('saturn', ...)</code> and Lahiri ayanamsha. The three sub-phases are commonly labelled Rising, Peak and Setting: the middle one, when Saturn transits directly over your Moon sign, is traditionally considered the most intense of the three, since it tests career, health, relationships and self-image most directly.</p>
      </div>

      <CalculatorFaq items={FAQ_ITEMS} />
    </div>
  </section>
</Layout>

<style>
  .fld-label { font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em; }
  @media (max-width:640px){ .phase-grid{ grid-template-columns:1fr !important; } }
</style>

<script>
import { LOCATIONS } from '../../lib/locations';
import { PLANET_ICONS } from '../../lib/icons/planets';
import { moonLongitude, lahiriAyanamsha } from '../../lib/panchang';
import { planetLongitude } from '../../lib/astro-core';

const SHANI_SVG = PLANET_ICONS.shani;
let LANG_HI = localStorage.getItem('pp-lang') === 'hi';
function tr(en, hi) { return LANG_HI ? hi : en; }
const WD_EN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI=['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN=['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI=['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(y,m,d){const wd=new Date(Date.UTC(y,m-1,d,12)).getUTCDay();return tr(`${WD_EN[wd]}, ${d} ${MO_EN[m-1]} ${y}`,`${WD_HI[wd]}, ${d} ${MO_HI[m-1]} ${y}`);}
function shaniIconSvg(size,color){return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${SHANI_SVG}</svg>`;}
function toJD(y,m,d,h){h=h||0;if(m<=2){y--;m+=12;}const A=Math.floor(y/100),B=2-A+Math.floor(A/4);return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;}
const LOCS=LOCATIONS.map(l=>({name:l.name,nameHi:l.nameHi,lat:l.lat,lng:l.lng,tz:l.tzOffset}));
const n360=a=>((a%360)+360)%360;
function saturnSign(jd){return Math.floor(n360(planetLongitude('saturn',jd)-lahiriAyanamsha(jd))/30);}

const RASHI=['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RASHI_HI=['मेष','वृषभ','मिथुन','कर्क','सिंह','कन्या','तुला','वृश्चिक','धनु','मकर','कुम्भ','मीन'];
function trRashi(i){return tr(RASHI[i],RASHI_HI[i]);}
const MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const MON_HI=['जन','फर','मार्च','अप्रैल','मई','जून','जुल','अग','सित','अक्टू','नव','दिस'];
function monName(idx){return LANG_HI?MON_HI[idx]:MON[idx];}

const sel=document.getElementById('f-city');function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(LANG_HI?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();
document.getElementById('f-date').value=new Date().toISOString().split('T')[0];
document.getElementById('f-time').value='12:00';

function jdToYMD(jd){const z=Math.floor(jd+0.5);let a=z;if(z>=2299161){const al=Math.floor((z-1867216.25)/36524.25);a=z+1+al-Math.floor(al/4);}const b=a+1524,c=Math.floor((b-122.1)/365.25),dd=Math.floor(365.25*c),e=Math.floor((b-dd)/30.6001);const day=b-dd-Math.floor(30.6001*e);const mo=e<14?e-1:e-13;const yr=mo>2?c-4716:c-4715;return{y:yr,m:mo};}

function findSubPhases(jdStart,jdEnd,setSigns){
  // Returns [p1start,p2start,p3start,end] JD boundaries for the 3 sub-phases
  const bds=[jdStart];let phase=0;
  for(let jd=jdStart+30;jd<=jdEnd;jd+=30){
    const s=saturnSign(jd);
    if(phase===0&&s===setSigns[1]){bds.push(jd);phase=1;}
    else if(phase===1&&s===setSigns[2]){bds.push(jd);phase=2;break;}
  }
  bds.push(jdEnd);
  return bds;
}

function calculate(){
  try{
    const dateStr=document.getElementById('f-date').value;
    const timeStr=document.getElementById('f-time').value||'12:00';
    const loc=LOCS.find(l=>l.name===document.getElementById('f-city').value)||LOCS[0];
    const [by,bm,bd]=dateStr.split('-').map(Number);const [hh,mm]=timeStr.split(':').map(Number);
    const de=document.getElementById('date-echo');
    if(de){de.textContent=tr('Date of birth: ','जन्म तिथि: ')+formatLongDate(by,bm,bd);de.hidden=false;}
    const jdBirth=toJD(by,bm,bd,(hh+mm/60)-loc.tz);
    const moonSign=Math.floor(n360(moonLongitude(jdBirth)-lahiriAyanamsha(jdBirth))/30);
    const setSigns=[(moonSign+11)%12,moonSign,(moonSign+1)%12]; // 12th,1st,2nd from Moon

    // scan monthly from birth to birth+95 years
    const periods=[];let cur=null;
    for(let jd=jdBirth;jd<jdBirth+95*365.25;jd+=15){
      const ss=saturnSign(jd);
      const inSade=setSigns.includes(ss);
      if(inSade){
        if(!cur)cur={start:jd,end:jd};
        else cur.end=jd;
      }else if(cur){periods.push(cur);cur=null;}
    }
    if(cur)periods.push(cur);

    const todayJD=toJD(new Date().getFullYear(),new Date().getMonth()+1,new Date().getDate(),12);
    let active=null;
    periods.forEach(p=>{if(todayJD>=p.start&&todayJD<=p.end)active=p;});

    let bg,html;
    if(active){
      const ssNow=saturnSign(todayJD);
      const phaseIdx=setSigns.indexOf(ssNow);
      const phaseName=[tr('Rising (First Dhaiya)','उदय (प्रथम ढैया)'),tr('Peak (Janma Shani)','शिखर (जन्म शनि)'),tr('Setting (Final Dhaiya)','अस्त (अंतिम ढैया)')][phaseIdx];
      const e=jdToYMD(active.end);
      bg='var(--color-warning-soft)';
      html=`<div style="display:flex;justify-content:center;margin-bottom:6px;">${shaniIconSvg(40,'#b45309')}</div><h2 style="font-size:24px;font-weight:700;color:#b45309;margin:0 0 6px;">${tr('In Sadesati','साढ़े साती में')}</h2>
        <p style="font-size:14px;color:var(--color-body-text);margin:0;">${tr(`Currently in the <b>${phaseName}</b> phase. Saturn is in ${trRashi(ssNow)}, your Moon is in ${trRashi(moonSign)}.`,`वर्तमान में <b>${phaseName}</b> चरण में। शनि ${trRashi(ssNow)} में है, आपका चंद्रमा ${trRashi(moonSign)} में है।`)}<br>${tr(`This Sadesati ends around <b>${monName(e.m-1)} ${e.y}</b>.`,`यह साढ़े साती लगभग <b>${monName(e.m-1)} ${e.y}</b> में समाप्त होती है।`)}</p>`;
    }else{
      // find next
      let next=periods.find(p=>p.start>todayJD);
      bg='var(--color-auspicious-soft)';
      const ns=next?jdToYMD(next.start):null;
      html=`<div style="display:flex;justify-content:center;margin-bottom:6px;">${shaniIconSvg(40,'#15803d')}</div><h2 style="font-size:24px;font-weight:700;color:#15803d;margin:0 0 6px;">${tr('Not in Sadesati','साढ़े साती में नहीं')}</h2>
        <p style="font-size:14px;color:var(--color-body-text);margin:0;">${tr('Your Moon sign is '+trRashi(moonSign)+'.','आपकी चंद्र राशि '+trRashi(moonSign)+' है।')} ${ns?tr(`Your next Sadesati begins around <b>${monName(ns.m-1)} ${ns.y}</b>.`,`आपकी अगली साढ़े साती लगभग <b>${monName(ns.m-1)} ${ns.y}</b> में शुरू होगी।`):tr('No upcoming Sadesati within the scanned range.','जांचे गए समय में कोई आगामी साढ़े साती नहीं है।')}</p>`;
    }
    document.getElementById('ss-banner').style.background=bg;
    document.getElementById('ss-banner').innerHTML=html;

    document.getElementById('timeline').innerHTML=periods.map((p,i)=>{
      const s=jdToYMD(p.start),e=jdToYMD(p.end);
      const isActive=active===p;const isPast=p.end<todayJD;
      const ageS=Math.floor((p.start-jdBirth)/365.25),ageE=Math.floor((p.end-jdBirth)/365.25);
      return `<div class="card" style="padding:14px 18px;display:flex;align-items:center;gap:14px;${isActive?'border-left:3px solid var(--color-warning);':''}">
        <span style="font-size:22px;">${isActive?'🔸':isPast?'✓':'○'}</span>
        <div style="flex:1;">
          <p style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0;">${monName(s.m-1)} ${s.y} – ${monName(e.m-1)} ${e.y}</p>
          <p style="font-size:12px;color:var(--color-mute);margin:2px 0 0;">${tr('Age','आयु')} ${ageS}–${ageE} · ${isActive?tr('Currently active','वर्तमान में सक्रिय'):isPast?tr('Completed','पूर्ण'):tr('Upcoming','आगामी')}</p>
        </div>
        <span class="badge ${isActive?'badge-saffron':''}">${tr('Cycle','चक्र')} ${i+1}</span>
      </div>`;
    }).join('')||`<p style="font-size:13px;color:var(--color-mute);">${tr('No Sadesati periods found in range.','जांचे गए समय में कोई साढ़े साती अवधि नहीं मिली।')}</p>`;

    // Sub-phase dates for the reference Sadesati period (active, or next, or last)
    const refPeriod=active||periods.find(p=>p.start>todayJD)||(periods.length?periods[periods.length-1]:null);
    const subBds=refPeriod?findSubPhases(refPeriod.start,refPeriod.end,setSigns):null;
    const phaseData=[
      [tr('Rising','उदय'),tr('12th House','बारहवां भाव')+' ('+trRashi(setSigns[0])+')',tr('Saturn enters the sign before your Moon. Mental restlessness, unexpected expenses, confusion and health concerns arise. A time to let go of the old and prepare inwardly for transformation.','शनि आपके चंद्रमा से पहले की राशि में प्रवेश करता है। मानसिक बेचैनी, अप्रत्याशित खर्च, भ्रम और स्वास्थ्य संबंधी चिंताएं उत्पन्न होती हैं। यह पुराने को छोड़ने और परिवर्तन के लिए आंतरिक रूप से तैयार होने का समय है।')],
      [tr('Peak','शिखर'),tr('1st House — Janma Shani','पहला भाव — जन्म शनि')+' ('+trRashi(setSigns[1])+')',tr('The most intense 2.5-year phase. Core life pillars are tested: career, health, relationships and self-image. Humility and discipline are the keys to endurance and growth.','सबसे तीव्र 2.5 वर्ष का चरण। जीवन के मूल स्तंभ परखे जाते हैं: करियर, स्वास्थ्य, रिश्ते और आत्म-छवि। विनम्रता और अनुशासन ही सहनशक्ति और विकास की कुंजी हैं।')],
      [tr('Setting','अस्त'),tr('2nd House','दूसरा भाव')+' ('+trRashi(setSigns[2])+')',tr('Saturn moves past your Moon. Pressure eases gradually. Focus shifts to family, finances and speech. The hard lessons of the first two phases crystallise into lasting wisdom.','शनि आपके चंद्रमा को पार कर जाता है। दबाव धीरे-धीरे कम होता है। ध्यान परिवार, वित्त और वाणी पर केंद्रित हो जाता है। पहले दो चरणों के कठिन सबक स्थायी ज्ञान में परिणत होते हैं।')],
    ];
    document.getElementById('phases').innerHTML=phaseData.map((p,i)=>{
      let dateStr='';
      if(subBds&&subBds.length>i+1){
        const s=jdToYMD(subBds[i]),e=jdToYMD(subBds[i+1]);
        dateStr='<p style="font-size:11px;color:var(--color-saffron-deep);font-family:var(--font-mono);margin:2px 0 5px;font-weight:600;">'+monName(s.m-1)+' '+s.y+' – '+monName(e.m-1)+' '+e.y+'</p>';
      }
      const isCurrentPhase=active&&saturnSign(todayJD)===setSigns[i];
      return '<div style="padding:14px;border-radius:8px;background:var(--color-canvas-soft-2);'+(isCurrentPhase?'border:2px solid var(--color-warning);':'')+'"><p style="font-size:12px;font-weight:700;color:var(--color-saffron-deep);margin:0 0 1px;">'+p[0]+(isCurrentPhase?' • '+tr('CURRENT','वर्तमान'):'')+' </p>'+dateStr+'<p style="font-size:12px;font-weight:600;color:var(--color-ink);margin:0 0 5px;">'+p[1]+'</p><p style="font-size:12px;color:var(--color-body-text);line-height:1.5;margin:0;">'+p[2]+'</p></div>';
    }).join('');

    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){const er=document.getElementById('err');er.style.display='block';er.textContent='Calculation error: '+e.message;document.getElementById('result').style.display='none';}
}
document.getElementById('f-calc').addEventListener('click',calculate);
calculate();

function applyPageLang(hindi) {
  LANG_HI = hindi;
  renderCityOptions();
  document.querySelectorAll('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? el.dataset.hi : el.dataset.en;
  });
  calculate();
}
document.addEventListener('langchange', (e) => {
  applyPageLang(e.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
