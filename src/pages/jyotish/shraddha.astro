---
import Layout from '../../layouts/Layout.astro';
import CalculatorFaq from '../../components/CalculatorFaq.astro';
import { sharedCalcFaq } from '../../lib/calculatorFaq';
import { computePitruPaksha } from '../../lib/jyotish';

const ppYear = new Date().getFullYear();
const PP_SCHEDULE = computePitruPaksha(ppYear);
const ppStart = PP_SCHEDULE[0].date;
const ppEnd = PP_SCHEDULE[PP_SCHEDULE.length - 1].date;

const FAQ_ITEMS = [
  ...sharedCalcFaq('before scheduling a Shraddha ceremony'),
  {
    q: 'Why does this calculator use a different tithi rule than the rest of the site?',
    a: "Because Shraddha specifically follows the Aparahna Vyapini rule — the tithi that's active during the afternoon window (the 4th of five equal daylight parts) is the one that governs the ritual, even if a different tithi was present at sunrise. Panchang elements like festivals and daily Tithi/Nakshatra use a sunrise-based rule instead, which is why this page doesn't reuse that logic even though both ultimately come from the same underlying Sun/Moon position functions.",
  },
  {
    q: 'What are Vriddhi and Kshaya tithis, and how does this calculator handle them?',
    a: "These are the two edge cases where a simple \"one tithi per day\" mapping breaks down. Vriddhi is when a tithi is long enough to overlap two consecutive days' Aparahna windows — this calculator assigns it to the first of the two days, per convention. Kshaya is the opposite: a tithi so short it doesn't overlap any day's Aparahna window at all — this calculator assigns it to whichever day's window falls temporally closest to the tithi's actual span.",
  },
  {
    q: "What if I don't know the exact tithi of a family member's passing?",
    a: 'Observe Sarva Pitru Amavasya instead — the final day of Pitru Paksha, specifically set aside for ancestors whose tithi isn\'t known, alongside anyone who passed on any Amavasya. This calculator\'s "By Tithi Directly" mode doesn\'t have an "unknown" option deliberately — Sarva Pitru Amavasya is the traditional answer, so it\'s covered by the About section\'s note rather than a separate form option.',
  },
];
---

<Layout title="Shraddha Tithi Calculator — Pitru Paksha — PanchangPath" description="Find the tithi of a death anniversary and the correct day to perform Shraddha during Pitru Paksha. Includes the full Pitru Paksha tithi schedule.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">श्राद्ध तिथि · SHRADDHA TITHI</p>
      <h1 data-hi="श्राद्ध तिथि कैलकुलेटर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Shraddha Tithi Calculator</h1>
      <p data-hi="मृत्यु की तिथि दर्ज करें और उसकी चंद्र तिथि जानें। फिर पितृ पक्ष के दौरान संबंधित तिथि पर श्राद्ध किया जाता है।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:520px;">Enter the date of passing to find its lunar tithi. Shraddha is then performed on the corresponding tithi during Pitru Paksha.</p>
    </div>
  </section>

  <section style="padding:28px 0 56px;">
    <div class="container">
      <div style="display:flex;gap:8px;margin-bottom:20px;">
        <button class="sh-mode-btn active" id="mode-date" data-mode="date" data-hi="मृत्यु तिथि से">By Death Date</button>
        <button class="sh-mode-btn" id="mode-tithi" data-mode="tithi" data-hi="सीधे तिथि से">By Tithi Directly</button>
      </div>

      <div id="form-date" style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div><label for="f-date" class="fld-label" data-hi="मृत्यु तिथि">Date of Passing</label><input type="date" id="f-date" lang="en-GB" class="input" style="height:38px;" /></div>
        <div><label for="f-time" class="fld-label" data-hi="समय (अनुमानित)">Time (approx)</label><input type="time" id="f-time" class="input" style="height:38px;" /></div>
        <button id="f-calc" class="btn-primary" data-hi="तिथि जानें" style="height:38px;padding:0 20px;">Find Tithi</button>
      </div>
      <p id="date-echo" style="font-size:12px;color:var(--color-mute);margin:-24px 0 20px;" hidden></p>

      <div id="form-tithi" style="display:none;margin-bottom:32px;">
        <p data-hi="यदि आप मृत्यु तिथि की तिथि पहले से जानते हैं, तो नीचे सीधे चुनें।" style="font-size:13px;color:var(--color-mute);margin:0 0 14px;">If you already know the Tithi of the death anniversary, select it directly below.</p>
        <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;">
          <div><label for="t-paksha" class="fld-label" data-hi="पक्ष">Paksha</label>
            <select id="t-paksha" class="input" style="height:38px;min-width:140px;">
              <option value="Shukla" data-hi="शुक्ल (बढ़ता चंद्रमा)">Shukla (Waxing)</option>
              <option value="Krishna" data-hi="कृष्ण (घटता चंद्रमा)">Krishna (Waning)</option>
            </select>
          </div>
          <div><label for="t-tithi" class="fld-label" data-hi="तिथि">Tithi</label>
            <select id="t-tithi" class="input" style="height:38px;min-width:200px;">
              <option value="Pratipada">1 - Pratipada</option>
              <option value="Dwitiya">2 - Dwitiya</option>
              <option value="Tritiya">3 - Tritiya</option>
              <option value="Chaturthi">4 - Chaturthi</option>
              <option value="Panchami">5 - Panchami</option>
              <option value="Shashthi">6 - Shashthi</option>
              <option value="Saptami">7 - Saptami</option>
              <option value="Ashtami">8 - Ashtami</option>
              <option value="Navami">9 - Navami</option>
              <option value="Dashami">10 - Dashami</option>
              <option value="Ekadashi">11 - Ekadashi</option>
              <option value="Dwadashi">12 - Dwadashi</option>
              <option value="Trayodashi">13 - Trayodashi</option>
              <option value="Chaturdashi">14 - Chaturdashi</option>
              <option value="Purnima">15 - Purnima (Shukla)</option>
              <option value="Amavasya">30 - Amavasya (Krishna)</option>
            </select>
          </div>
          <button id="f-calc2" class="btn-primary" data-hi="श्राद्ध दिन जानें" style="height:38px;padding:0 20px;">Find Shraddha Day</button>
        </div>
      </div>

      <div id="result" style="display:none;">
        <div class="card" style="padding:28px;text-align:center;margin-bottom:24px;background:linear-gradient(135deg,var(--color-canvas) 55%,var(--color-saffron-soft));">
          <div id="t-icon" style="display:flex;justify-content:center;margin-bottom:8px;color:var(--color-saffron-deep);"></div>
          <p class="caption-mono" data-hi="मृत्यु की तिथि" style="color:var(--color-saffron-deep);margin:0 0 6px;">TITHI OF PASSING</p>
          <h2 id="t-name" style="font-size:26px;font-weight:700;color:var(--color-ink);margin:0 0 4px;"></h2>
          <p id="t-meta" style="font-size:14px;color:var(--color-mute);margin:0;"></p>
        </div>
        <div class="card" id="shraddha-day" style="padding:24px;margin-bottom:24px;"></div>
      </div>
      <div id="err" style="display:none;padding:16px;background:var(--color-inauspicious-soft);border-radius:8px;color:#b91c1c;font-size:14px;"></div>

      <h3 id="pp-heading" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 6px;">Pitru Paksha {ppYear} Schedule</h3>
      <p id="pp-subheading" style="font-size:12px;color:var(--color-mute);margin:0 0 4px;">Krishna Paksha of Ashwin &middot; {ppStart} &ndash; {ppEnd} {ppYear}</p>
      <p data-hi="चालू वर्ष के लिए इस साइट के अपने चंद्र पंचांग (कन्या-संक्रांति + चंद्र-सूर्य कोणांतर खोज) से लाइव गणना की गई, विकास के दौरान drikpanchang.com से मिलान किया गया।" style="font-size:12px;color:var(--color-mute);margin:0 0 14px;">Computed live for the current year from this site's own lunar calendar (Kanya-Sankranti + Moon-Sun elongation search), cross-checked against drikpanchang.com during development.</p>
      <div class="card" style="padding:20px;overflow-x:auto;margin-bottom:36px;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;" id="pp-table">
          <tr><th>Date ({ppYear})</th><th>Tithi</th><th>Who is honoured</th></tr>
          {PP_SCHEDULE.map(p => (
            <tr><td style="font-weight:600;color:var(--color-ink);">{p.date}</td><td>{p.tithi}</td><td style="font-size:12px;color:var(--color-mute);">{p.note}</td></tr>
          ))}
        </table>
      </div>

      <div class="card" style="padding:28px;">
        <h2 data-hi="श्राद्ध के बारे में" style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">About Shraddha</h2>
        <p data-hi="श्राद्ध पूर्वजों (पितरों) के सम्मान में किया जाने वाला अनुष्ठानिक अर्पण है। वार्षिक श्राद्ध मृत्यु की तिथि के अनुरूप तिथि पर, पितृ पक्ष के दौरान किया जाता है — अश्विन माह (सितंबर-अक्टूबर) के कृष्ण पक्ष का 16-दिवसीय पखवाड़ा।" style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 10px;">Shraddha is the ritual offering made to honour departed ancestors (pitrs). The annual Shraddha is performed on the tithi corresponding to the date of death, during Pitru Paksha — a 16-day fortnight in the Krishna Paksha of the month of Ashwin (September–October).</p>
        <p style="font-size:14px;color:var(--color-mute);line-height:1.7;margin:0 0 14px;"><span data-hi="विशेष स्थितियां: जो किसी भी अमावस्या को गुजरे, या जिनकी तिथि अज्ञात है, उन्हें ">Special cases: those who passed on any Amavasya, or whose tithi is unknown, are honoured on </span><b><span data-hi="सर्व पितृ अमावस्या">Sarva Pitru Amavasya</span></b><span data-hi=" (अंतिम दिन) पर सम्मानित किया जाता है। जिनकी मृत्यु अप्राकृतिक रूप से हुई उन्हें चतुर्दशी पर स्मरण किया जाता है। संन्यासियों को द्वादशी पर सम्मानित किया जाता है।"> (the final day). Those who died unnaturally are remembered on Chaturdashi. Sanyasis are honoured on Dwadashi.</span></p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0;">This calculator applies the Aparahna Vyapini rule specifically for Shraddha — different from the sunrise-based tithi rule this site uses elsewhere for festivals and daily Panchang. Aparahna is the fourth of five equal parts of daylight, the classical afternoon window Dharmashastra prescribes for these rites; a tithi is assigned to whichever day its span actually overlaps that window, even if it isn't the tithi present at sunrise. Two edge cases follow: a long tithi overlapping two days' windows (Vriddhi) is assigned to the first day; a short tithi that misses every window entirely (Kshaya) goes to the day whose window falls nearest to it. The Pitru Paksha schedule below is computed fresh each year using this same rule.</p>
      </div>

      <CalculatorFaq items={FAQ_ITEMS} />
    </div>
  </section>
</Layout>

<style>
  .fld-label { font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em; }
  #pp-table th { text-align:left;padding:7px 8px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.04em; }
  #pp-table td { padding:8px;border-bottom:1px solid var(--color-hairline);color:var(--color-body-text); }
  .sh-mode-btn { padding:7px 16px;border-radius:20px;border:1px solid var(--color-hairline);background:transparent;color:var(--color-mute);font-size:13px;font-weight:600;cursor:pointer;font-family:var(--font-sans); }
  .sh-mode-btn.active { background:var(--color-ink);color:var(--color-canvas);border-color:var(--color-ink); }
</style>

<script>
import { TITHI_ICONS } from '../../lib/icons/tithi';
import { sunTrueLongitude, moonLongitude } from '../../lib/panchang';
import { computePitruPaksha, PP_TITHI_NOTE_HI } from '../../lib/jyotish';
let LANG_HI = localStorage.getItem('pp-lang') === 'hi';
function tr(en, hi) { return LANG_HI ? hi : en; }
const WD_EN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI=['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN=['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI=['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(y,m,d){const wd=new Date(Date.UTC(y,m-1,d,12)).getUTCDay();return tr(`${WD_EN[wd]}, ${d} ${MO_EN[m-1]} ${y}`,`${WD_HI[wd]}, ${d} ${MO_HI[m-1]} ${y}`);}
function tithiIconSvg(id,size){return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${TITHI_ICONS[id]}</svg>`;}
const NAME_TO_NUM={Pratipada:1,Dwitiya:2,Tritiya:3,Chaturthi:4,Panchami:5,Shashthi:6,Saptami:7,Ashtami:8,Navami:9,Dashami:10,Ekadashi:11,Dwadashi:12,Trayodashi:13,Chaturdashi:14,Purnima:15,Amavasya:15};
const MONTHS=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const MONTHS_HI=['जन','फर','मार्च','अप्रैल','मई','जून','जुल','अग','सित','अक्टू','नव','दिस'];
function toJD(y,m,d,h){h=h||0;if(m<=2){y--;m+=12;}const A=Math.floor(y/100),B=2-A+Math.floor(A/4);return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;}
const n360=a=>((a%360)+360)%360;
const TITHI_NAMES=['Pratipada','Dwitiya','Tritiya','Chaturthi','Panchami','Shashthi','Saptami','Ashtami','Navami','Dashami','Ekadashi','Dwadashi','Trayodashi','Chaturdashi','Purnima/Amavasya'];

function fmtSched(p){return tr(`${MONTHS[p.m-1]} ${p.d}`,`${MONTHS_HI[p.m-1]} ${p.d}`);}
const ppYear=new Date().getFullYear();
const PP_SCHEDULE=computePitruPaksha(ppYear);
function renderPPHeadings(){
  document.getElementById('pp-heading').textContent=tr(`Pitru Paksha ${ppYear} Schedule`,`पितृ पक्ष ${ppYear} अनुसूची`);
  document.getElementById('pp-subheading').textContent=tr(`Krishna Paksha of Ashwin \xb7 ${fmtSched(PP_SCHEDULE[0])} – ${fmtSched(PP_SCHEDULE[PP_SCHEDULE.length-1])} ${ppYear}`,`अश्विन कृष्ण पक्ष \xb7 ${fmtSched(PP_SCHEDULE[0])} – ${fmtSched(PP_SCHEDULE[PP_SCHEDULE.length-1])} ${ppYear}`);
}
renderPPHeadings();

document.getElementById('f-date').value=new Date().toISOString().split('T')[0];
document.getElementById('f-time').value='12:00';

function calculate(){
  try{
    const dateStr=document.getElementById('f-date').value;
    const timeStr=document.getElementById('f-time').value||'12:00';
    const [y,m,d]=dateStr.split('-').map(Number);const [hh,mm]=timeStr.split(':').map(Number);
    const de=document.getElementById('date-echo');
    if(de){de.textContent=tr('Date of passing: ','मृत्यु तिथि: ')+formatLongDate(y,m,d);de.hidden=false;}
    const jd=toJD(y,m,d,(hh+mm/60)-5.5);
    const diff=n360(moonLongitude(jd)-sunTrueLongitude(jd));
    const tithiNum=Math.floor(diff/12)+1; // 1..30
    const paksha=tithiNum<=15?'Shukla':'Krishna';
    const inPaksha=tithiNum<=15?tithiNum:tithiNum-15;
    let tName=TITHI_NAMES[inPaksha-1];
    if(inPaksha===15)tName=paksha==='Shukla'?'Purnima':'Amavasya';

    document.getElementById('t-icon').innerHTML=tithiIconSvg(`${paksha.toLowerCase()}-${inPaksha}`,44);
    document.getElementById('t-name').textContent=`${paksha} ${tName}`;
    document.getElementById('t-meta').textContent=tr(`Tithi #${tithiNum} of the lunar month · Moon–Sun angle ${diff.toFixed(1)}°`,`चंद्र मास की तिथि #${tithiNum} \xb7 चंद्र–सूर्य कोण ${diff.toFixed(1)}°`);

    // Map to Pitru Paksha day (Krishna paksha)
    let shraddhaTithi=tName;
    if(tName==='Purnima')shraddhaTithi='Purnima';
    let ppDay=PP_SCHEDULE.find(p=>p.tithi===shraddhaTithi);
    if(!ppDay&&tName==='Amavasya')ppDay=PP_SCHEDULE[PP_SCHEDULE.length-1];
    if(!ppDay)ppDay=PP_SCHEDULE.find(p=>p.tithi===tName)||PP_SCHEDULE[PP_SCHEDULE.length-1];

    document.getElementById('shraddha-day').innerHTML=
      `<h3 style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 8px;">${tr('When to perform the annual Shraddha','वार्षिक श्राद्ध कब करें')}</h3>
       <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 12px;">${tr(`Perform Shraddha on the <b>${shraddhaTithi}</b> tithi during Pitru Paksha. This year, this falls on approximately <b style="color:var(--color-saffron-deep);">${fmtSched(ppDay)}, ${ppYear}</b>.`,`पितृ पक्ष के दौरान <b>${shraddhaTithi}</b> तिथि पर श्राद्ध करें। इस वर्ष यह लगभग <b style="color:var(--color-saffron-deep);">${fmtSched(ppDay)}, ${ppYear}</b> को पड़ता है।`)}</p>
       <p style="font-size:13px;color:var(--color-mute);margin:0;">${tr(ppDay.note,PP_TITHI_NOTE_HI[ppDay.t])}</p>
       <p style="font-size:13px;color:var(--color-mute);margin:8px 0 0;">${tr(`If the exact tithi of death is unknown, observe on Sarva Pitru Amavasya (${fmtSched(PP_SCHEDULE[PP_SCHEDULE.length-1])}, ${ppYear}).`,`यदि मृत्यु की सटीक तिथि अज्ञात है, तो सर्व पितृ अमावस्या (${fmtSched(PP_SCHEDULE[PP_SCHEDULE.length-1])}, ${ppYear}) पर करें।`)}</p>`;

    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){const er=document.getElementById('err');er.style.display='block';er.textContent='Calculation error: '+e.message;}
}
function renderPPTable(){
  document.getElementById('pp-table').innerHTML=`<tr><th>${tr('Date','दिनांक')} (${ppYear})</th><th>${tr('Tithi','तिथि')}</th><th>${tr('Who is honoured','किसका सम्मान')}</th></tr>`+
    PP_SCHEDULE.map(p=>`<tr><td style="font-weight:600;color:var(--color-ink);">${fmtSched(p)}</td><td>${p.tithi}</td><td style="font-size:12px;color:var(--color-mute);">${tr(p.note,PP_TITHI_NOTE_HI[p.t])}</td></tr>`).join('');
}
renderPPTable();
function showShraddhaResult(paksha,tName){
  const shraddhaTithi=(tName==='Purnima'||tName==='Amavasya')?tName:tName;
  let ppDay=PP_SCHEDULE.find(p=>p.tithi===shraddhaTithi)||PP_SCHEDULE[PP_SCHEDULE.length-1];
  document.getElementById('t-icon').innerHTML=tithiIconSvg(`${paksha.toLowerCase()}-${NAME_TO_NUM[tName]}`,44);
  document.getElementById('t-name').textContent=`${paksha} ${tName}`;
  document.getElementById('t-meta').textContent=tr(`${paksha} Paksha · Tithi entered directly`,`${paksha} पक्ष \xb7 तिथि सीधे दर्ज की गई`);
  document.getElementById('shraddha-day').innerHTML=
    `<h3 style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 8px;">${tr('When to perform the annual Shraddha','वार्षिक श्राद्ध कब करें')}</h3>
     <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 12px;">${tr(`Perform Shraddha on the <b>${shraddhaTithi}</b> tithi during Pitru Paksha. This year this falls on approximately <b style="color:var(--color-saffron-deep);">${fmtSched(ppDay)}, ${ppYear}</b>.`,`पितृ पक्ष के दौरान <b>${shraddhaTithi}</b> तिथि पर श्राद्ध करें। इस वर्ष यह लगभग <b style="color:var(--color-saffron-deep);">${fmtSched(ppDay)}, ${ppYear}</b> को पड़ता है।`)}</p>
     <p style="font-size:13px;color:var(--color-mute);margin:0;">${tr(ppDay.note,PP_TITHI_NOTE_HI[ppDay.t])}</p>
     <p style="font-size:13px;color:var(--color-mute);margin:8px 0 0;">${tr(`If the exact tithi of death is unknown, observe on Sarva Pitru Amavasya (${fmtSched(PP_SCHEDULE[PP_SCHEDULE.length-1])}, ${ppYear}).`,`यदि मृत्यु की सटीक तिथि अज्ञात है, तो सर्व पितृ अमावस्या (${fmtSched(PP_SCHEDULE[PP_SCHEDULE.length-1])}, ${ppYear}) पर करें।`)}</p>`;
  document.getElementById('result').style.display='block';
  document.getElementById('err').style.display='none';
}
function calculateByTithi(){
  const paksha=document.getElementById('t-paksha').value;
  const tName=document.getElementById('t-tithi').value;
  showShraddhaResult(paksha,tName);
}
document.getElementById('f-calc').addEventListener('click',calculate);
document.getElementById('f-calc2').addEventListener('click',calculateByTithi);
document.querySelectorAll('.sh-mode-btn').forEach(btn=>btn.addEventListener('click',function(){
  document.querySelectorAll('.sh-mode-btn').forEach(b=>b.classList.remove('active'));
  this.classList.add('active');
  const isDate=this.dataset.mode==='date';
  document.getElementById('form-date').style.display=isDate?'flex':'none';
  document.getElementById('form-tithi').style.display=isDate?'none':'block';
  document.getElementById('result').style.display='none';
}));
calculate();

function applyPageLang(hindi) {
  LANG_HI = hindi;
  document.querySelectorAll('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? el.dataset.hi : el.dataset.en;
  });
  renderPPHeadings();
  renderPPTable();
  calculate();
}
document.addEventListener('langchange', (e) => {
  applyPageLang(e.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
