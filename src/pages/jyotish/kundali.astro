---
import Layout from '../../layouts/Layout.astro';
import { PLANET_ICONS } from '../../lib/icons/planets';
import CalculatorFaq from '../../components/CalculatorFaq.astro';
import { sharedCalcFaq } from '../../lib/calculatorFaq';
import { computeKundaliChartData, kundaliNorthChart, jdFull, SYNTHETIC_EXAMPLE_BIRTH, formatDegMin } from '../../lib/kundali';
import { NAKSHATRAS } from '../../lib/jyotish';

// Illustrative-example prerender (see kundali.ts's SYNTHETIC_EXAMPLE_BIRTH comment): a clearly-
// fictional sample birth, not "today" (which would read as a real stranger's live chart) and not
// a real named person (which would make a permanent public claim about them). The client <script>
// below pre-fills the form with this exact same date/time/place and recalculates on load, so the
// prerendered and hydrated content start identical -- same pattern as every other calculator's
// "today, New Delhi" default, just with a synthetic default instead.
const EB = SYNTHETIC_EXAMPLE_BIRTH;
const ebDate = new Date(Date.UTC(EB.y, EB.m - 1, EB.d, EB.hh, EB.mm) - EB.tz * 3600000);
const ebJD = jdFull(ebDate);
const ebChart = computeKundaliChartData(ebJD, EB.lat, EB.lng);
const ebChartSvg = kundaliNorthChart(ebChart.signOfHouse, ebChart.planetsByHouse);
const EB_DATE_STR = `${EB.y}-${String(EB.m).padStart(2, '0')}-${String(EB.d).padStart(2, '0')}`;
const EB_TIME_STR = `${String(EB.hh).padStart(2, '0')}:${String(EB.mm).padStart(2, '0')}`;

const EB_PLANET_EN: Record<string, string> = { surya: 'Sun', chandra: 'Moon', mangal: 'Mars', budha: 'Mercury', guru: 'Jupiter', shukra: 'Venus', shani: 'Saturn', rahu: 'Rahu', ketu: 'Ketu' };
const EB_RASHI = ['Mesha', 'Vrishabha', 'Mithuna', 'Karka', 'Simha', 'Kanya', 'Tula', 'Vrishchika', 'Dhanu', 'Makara', 'Kumbha', 'Meena'];
const EB_RASHI_HI = ['मेष', 'वृषभ', 'मिथुन', 'कर्क', 'सिंह', 'कन्या', 'तुला', 'वृश्चिक', 'धनु', 'मकर', 'कुम्भ', 'मीन'];
const EB_RASHI_EN = ['Aries', 'Taurus', 'Gemini', 'Cancer', 'Leo', 'Virgo', 'Libra', 'Scorpio', 'Sagittarius', 'Capricorn', 'Aquarius', 'Pisces'];
const EB_RASHI_LORD = ['Mars', 'Venus', 'Mercury', 'Moon', 'Sun', 'Mercury', 'Venus', 'Mars', 'Jupiter', 'Saturn', 'Saturn', 'Jupiter'];
const EB_RASHI_LORD_HI: Record<string, string> = { Sun: 'सूर्य', Moon: 'चंद्र', Mars: 'मंगल', Mercury: 'बुध', Jupiter: 'गुरु', Venus: 'शुक्र', Saturn: 'शनि' };
const EB_PLANET_HI: Record<string, string> = { surya: 'सूर्य', chandra: 'चंद्र', mangal: 'मंगल', budha: 'बुध', guru: 'गुरु', shukra: 'शुक्र', shani: 'शनि', rahu: 'राहु', ketu: 'केतु' };
const ebAkName = EB_PLANET_EN[ebChart.atmakarakaKey];
const ebMoonNakName = NAKSHATRAS[ebChart.moonNak.idx].n;

const FAQ_ITEMS = [
  ...sharedCalcFaq(),
  {
    q: 'What is the Atmakaraka shown in my interpretations, and how is it found?',
    qHi: 'मेरी व्याख्याओं में दिखाया गया आत्मकारक क्या है, और यह कैसे निकाला जाता है?',
    a: 'The Atmakaraka ("soul significator") is whichever planet has progressed furthest through its own sign — measured in degrees from 0° to 30°, regardless of which sign that is. In the Jaimini system, this planet is treated as the primary indicator of the soul\'s purpose in this lifetime. This calculator checks the Sun through Saturn plus Rahu (using Rahu\'s reversed degree count, since it always moves backward through the zodiac) and excludes Ketu — one common variant of the calculation; some traditions use only the seven classical planets.',
    aHi: 'आत्मकारक ("आत्मा का सूचक") वह ग्रह है जो अपनी राशि में सबसे आगे बढ़ चुका है — 0° से 30° तक डिग्री में मापा गया, चाहे वह कोई भी राशि हो। जैमिनी प्रणाली में, इस ग्रह को इस जन्म में आत्मा के उद्देश्य का प्राथमिक सूचक माना जाता है। यह कैलकुलेटर सूर्य से शनि तक साथ ही राहु की जांच करता है (राहु की उलटी डिग्री गणना का उपयोग करते हुए, क्योंकि यह हमेशा राशिचक्र में पीछे की ओर गति करता है) और केतु को शामिल नहीं करता — यह गणना का एक सामान्य प्रकार है; कुछ परंपराएं केवल सात शास्त्रीय ग्रहों का उपयोग करती हैं।',
  },
  {
    q: 'Why are there four chart style options, and do they show different information?',
    qHi: 'चार चार्ट शैली विकल्प क्यों हैं, और क्या वे अलग-अलग जानकारी दिखाते हैं?',
    a: 'No — North Indian, South Indian, East Indian and West Indian are just different regional visual conventions for arranging the same 12 houses and planetary positions. North Indian is a fixed diamond with rotating house numbers; South and West Indian use a fixed 4×4 grid with rotating sign positions; East Indian uses a 3×3 Bengali layout. Whichever style you\'re used to reading, the underlying chart is identical.',
    aHi: 'नहीं — उत्तर भारतीय, दक्षिण भारतीय, पूर्वी भारतीय और पश्चिम भारतीय एक ही 12 भावों और ग्रह स्थितियों को व्यवस्थित करने की केवल अलग-अलग क्षेत्रीय दृश्य परंपराएं हैं। उत्तर भारतीय एक निश्चित हीरा-आकार है जिसमें भाव क्रमांक घूमते हैं; दक्षिण और पश्चिम भारतीय एक निश्चित 4×4 ग्रिड का उपयोग करते हैं जिसमें राशि स्थितियां घूमती हैं; पूर्वी भारतीय एक 3×3 बंगाली लेआउट का उपयोग करता है। आप जिस भी शैली को पढ़ने के आदी हों, अंतर्निहित कुंडली समान ही होती है।',
  },
  {
    q: 'What does "Vakri" (retrograde) next to a planet mean — is it really moving backward?',
    qHi: 'किसी ग्रह के आगे "वक्री" (रेट्रोग्रेड) का क्या अर्थ है — क्या वह वास्तव में पीछे की ओर गति कर रहा है?',
    a: 'No planet actually reverses direction in its orbit. Retrograde is an apparent effect: as Earth and another planet orbit the Sun at different speeds, the other planet can appear to move backward against the background stars for a period, the same way a car you\'re overtaking seems to slide backward relative to you. This calculator detects it by comparing each planet\'s longitude one day apart — if it\'s decreased, the planet is marked Vakri.',
    aHi: 'कोई भी ग्रह वास्तव में अपनी कक्षा में दिशा नहीं बदलता। वक्री एक आभासी प्रभाव है: जैसे पृथ्वी और कोई अन्य ग्रह अलग-अलग गति से सूर्य की परिक्रमा करते हैं, वह अन्य ग्रह कुछ समय के लिए पृष्ठभूमि के तारों के सापेक्ष पीछे की ओर गति करता प्रतीत हो सकता है, ठीक वैसे ही जैसे जिस कार को आप ओवरटेक कर रहे हों वह आपके सापेक्ष पीछे खिसकती दिखाई देती है। यह कैलकुलेटर इसे प्रत्येक ग्रह के रेखांश की एक दिन के अंतर से तुलना करके पहचानता है — यदि यह घटा है, तो ग्रह को वक्री चिह्नित किया जाता है।',
  },
];
---

<Layout title="Kundali Generator — Free Vedic Birth Chart — PanchangPath" description="Generate your free Vedic birth chart (Janma Kundali) with planetary positions, signs, nakshatras, Lagna and interpretations. Lahiri ayanamsha.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">जन्म कुंडली · KUNDALI GENERATOR</p>
      <h1 data-hi="कुंडली जनरेटर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Kundali Generator</h1>
      <p data-hi="ग्रह स्थिति, लग्न, नक्षत्र और मुख्य व्याख्याओं सहित पूर्ण जन्म कुंडली बनाने के लिए अपना जन्म विवरण दर्ज करें।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:500px;">Enter your birth details to generate a full Vedic birth chart with planetary positions, Lagna, nakshatras and key interpretations.</p>
    </div>
  </section>

  <section style="padding:28px 0 56px;">
    <div class="container">
      <!-- Form -->
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
        <div>
          <label for="f-name" class="fld-label" data-hi="नाम (वैकल्पिक)">Name (optional)</label>
          <input type="text" id="f-name" class="input" placeholder="Your name" style="height:38px;min-width:150px;" />
        </div>
        <div>
          <label for="f-date" class="fld-label" data-hi="जन्म तिथि">Date of Birth</label>
          <input type="date" id="f-date" lang="en-GB" class="input" style="height:38px;" />
        </div>
        <div>
          <label for="f-time" class="fld-label" data-hi="जन्म समय">Time of Birth</label>
          <input type="time" id="f-time" class="input" style="height:38px;" />
        </div>
        <div>
          <label for="f-city" class="fld-label" data-hi="जन्म स्थान">Place of Birth</label>
          <select id="f-city" class="input" style="height:38px;min-width:150px;"></select>
        </div>
        <button id="f-calc" class="btn-primary" data-hi="कुंडली बनाएं" style="height:38px;padding:0 20px;">Generate Kundali</button>
      </div>
      <p id="date-echo" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;">Date of birth: {EB_DATE_STR}</p>
      <p id="example-note" style="font-size:12px;color:var(--color-mute);margin:-16px 0 20px;">Showing an illustrative example (synthetic sample birth, not a real person) — enter your own birth details above and click Generate Kundali for your chart.</p>

      <!-- Chart style selector -->
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:28px;">
        <span class="fld-label" data-hi="चार्ट शैली:" style="margin:0;">Chart Style:</span>
        <button class="style-btn active" data-style="north" data-hi="उत्तर भारतीय">North Indian</button>
        <button class="style-btn" data-style="south" data-hi="दक्षिण भारतीय">South Indian</button>
        <button class="style-btn" data-style="east" data-hi="पूर्व भारतीय">East Indian</button>
        <button class="style-btn" data-style="west" data-hi="पश्चिम भारतीय">West Indian</button>
      </div>

      <div id="result">
        <div style="display:grid;grid-template-columns:340px 1fr;gap:28px;align-items:start;" class="kund-layout">
          <!-- Chart -->
          <div>
            <div class="card" style="padding:20px;">
              <h2 id="chart-title" style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 4px;" data-hi="लग्न कुंडली (डी-1)">Lagna Chart (D-1)</h2>
              <p id="chart-sub" style="font-size:12px;color:var(--color-mute);margin:0 0 14px;font-family:var(--font-mono);" data-hi={`${EB_RASHI_HI[ebChart.lagnaSign]} लग्न · ${EB_DATE_STR} ${EB_TIME_STR} · ${EB.city}`}>{EB_RASHI[ebChart.lagnaSign]} Lagna &middot; {EB_DATE_STR} {EB_TIME_STR} &middot; {EB.city}</p>
              <div id="chart-box" set:html={ebChartSvg} />
            </div>
            <div class="card" style="padding:18px;margin-top:16px;">
              <h3 data-hi="जन्म सारांश" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 10px;">Birth Summary</h3>
              <div id="summary-list" style="display:flex;flex-direction:column;gap:8px;">
                {[
                  ['Lagna (Asc)', 'लग्न', `${EB_RASHI[ebChart.lagnaSign]} (${EB_RASHI_EN[ebChart.lagnaSign]})`, `${EB_RASHI_HI[ebChart.lagnaSign]} (${EB_RASHI_EN[ebChart.lagnaSign]})`],
                  ['Lagna Lord', 'लग्न स्वामी', EB_RASHI_LORD[ebChart.lagnaSign], EB_RASHI_LORD_HI[EB_RASHI_LORD[ebChart.lagnaSign]]],
                  ['Moon Rashi', 'चंद्र राशि', `${EB_RASHI[ebChart.moonSign]} (${EB_RASHI_EN[ebChart.moonSign]})`, `${EB_RASHI_HI[ebChart.moonSign]} (${EB_RASHI_EN[ebChart.moonSign]})`],
                  ['Sun Rashi', 'सूर्य राशि', `${EB_RASHI[ebChart.sunSign]} (${EB_RASHI_EN[ebChart.sunSign]})`, `${EB_RASHI_HI[ebChart.sunSign]} (${EB_RASHI_EN[ebChart.sunSign]})`],
                  ['Nakshatra', 'नक्षत्र', `${ebMoonNakName} (Pada ${ebChart.moonNak.pada})`, `${NAKSHATRAS[ebChart.moonNak.idx].h} (पद ${ebChart.moonNak.pada})`],
                  ['Ayanamsha', 'अयनांश', `${ebChart.ay.toFixed(3)}° Lahiri`, `${ebChart.ay.toFixed(3)}° लाहिड़ी`],
                ].map(([label, labelHi, val, valHi]) => (
                  <div style="display:flex;justify-content:space-between;gap:10px;font-size:12.5px;"><span style="color:var(--color-mute);" data-hi={labelHi}>{label}</span><span style="color:var(--color-ink);font-weight:600;text-align:right;" data-hi={valHi}>{val}</span></div>
                ))}
              </div>
            </div>
          </div>

          <!-- Tables + interpretation -->
          <div>
            <div class="card" style="padding:20px;overflow-x:auto;">
              <h3 data-hi="ग्रह स्थिति (ग्रह स्फुट)" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Planetary Positions (Graha Sphuta)</h3>
              <table style="width:100%;border-collapse:collapse;font-size:13px;" id="planet-table">
                <tr><th data-hi="ग्रह">Graha</th><th data-hi="राशि">Rashi</th><th data-hi="अंश">Degree</th><th data-hi="नक्षत्र">Nakshatra</th><th data-hi="पद">Pada</th><th data-hi="गति">Motion</th></tr>
                {ebChart.rows.map(row => (
                  <tr>
                    <td style="color:var(--color-ink);font-weight:600;" data-hi={EB_PLANET_HI[row.key]}>{EB_PLANET_EN[row.key]}</td>
                    <td data-hi={EB_RASHI_HI[row.sign]}>{EB_RASHI[row.sign]}</td>
                    <td style="font-family:var(--font-mono);">{formatDegMin(row.sidLon)}</td>
                    <td data-hi={NAKSHATRAS[row.nakIdx].h}>{NAKSHATRAS[row.nakIdx].n}</td>
                    <td>{row.nakPada}</td>
                    <td style={row.isRetrograde ? 'color:#dc2626;' : 'color:var(--color-body-text);'}>{row.isRetrograde ? 'Vakri' : 'Margi'}</td>
                  </tr>
                ))}
              </table>
            </div>
            <div class="card" style="padding:20px;margin-top:16px;">
              <h3 data-hi="मुख्य व्याख्याएं" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Key Interpretations</h3>
              <div id="interp" style="display:flex;flex-direction:column;gap:12px;">
                {[
                  ['Lagna (Ascendant)', 'लग्न', `The rising sign is ${EB_RASHI[ebChart.lagnaSign]} (${EB_RASHI_EN[ebChart.lagnaSign]}), ruled by ${EB_RASHI_LORD[ebChart.lagnaSign]}. The Lagna shapes physical body, temperament and how others first perceive a person.`, `उदय राशि ${EB_RASHI_HI[ebChart.lagnaSign]} है, जिसका स्वामी ${EB_RASHI_LORD_HI[EB_RASHI_LORD[ebChart.lagnaSign]]} है। लग्न शारीरिक बनावट, स्वभाव और दूसरे व्यक्ति को पहली बार कैसे देखते हैं, इसे आकार देता है।`],
                  ['Moon Sign (Rashi)', 'चंद्र राशि', `The Moon is in ${EB_RASHI[ebChart.moonSign]} (${EB_RASHI_EN[ebChart.moonSign]}) in ${ebMoonNakName} nakshatra. This is the emotional core and the rashi used for daily Rashifal and most muhurta decisions.`, `चंद्रमा ${EB_RASHI_HI[ebChart.moonSign]} राशि में ${NAKSHATRAS[ebChart.moonNak.idx].h} नक्षत्र में है। यह भावनात्मक केंद्र है और दैनिक राशिफल व अधिकांश मुहूर्त निर्णयों में प्रयुक्त राशि है।`],
                  ['Sun Sign', 'सूर्य राशि', `The Sun is in ${EB_RASHI[ebChart.sunSign]} (${EB_RASHI_EN[ebChart.sunSign]}), representing soul, vitality, ego and one's relationship with authority and the father.`, `सूर्य ${EB_RASHI_HI[ebChart.sunSign]} राशि में है, जो आत्मा, जीवनशक्ति, अहंकार और अधिकार व पिता के साथ संबंध को दर्शाता है।`],
                  ['Atmakaraka', 'आत्मकारक', `${ebAkName} holds the highest degree in its sign and is the Atmakaraka — the soul planet of the Jaimini system, signifying the deepest desires and the main lesson of this lifetime.`, `${EB_PLANET_HI[ebChart.atmakarakaKey]} अपनी राशि में सबसे अधिक अंश पर है और आत्मकारक है — जैमिनी प्रणाली का आत्मा-सूचक ग्रह, जो इस जन्म की गहरी इच्छाओं और मुख्य सीख को दर्शाता है।`],
                ].map(([title, titleHi, text, textHi]) => (
                  <div><p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 3px;" data-hi={titleHi}>{title}</p><p style="font-size:14px;color:var(--color-body-text);line-height:1.6;margin:0;" data-hi={textHi}>{text}</p></div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <div id="err" style="display:none;padding:16px;background:var(--color-inauspicious-soft);border-radius:8px;color:#b91c1c;font-size:14px;"></div>

      <!-- About -->
      <div class="card" style="padding:28px;margin-top:36px;">
        <h2 data-hi="जन्म कुंडली के बारे में" style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">About the Janma Kundali</h2>
        <p data-hi="जन्म कुंडली आपके जन्म के ठीक क्षण और स्थान पर आकाश का नक्शा है। 12 भाव, पूर्वी क्षितिज पर उदित होने वाली राशि (लग्न), और नौ ग्रहों की स्थिति मिलकर आपके जीवन की संभावनाओं, शक्तियों और कर्म-पैटर्न को दर्शाते हैं।" style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 10px;">The Janma Kundali (birth chart) is a map of the heavens at the exact moment and place of your birth. The 12 houses (bhavas), the rashi rising on the eastern horizon (Lagna), and the placement of the nine grahas together describe your life's potential, strengths and karmic patterns.</p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 14px;"><span data-hi="चार क्षेत्रीय चार्ट शैलियों में से चुनें: ">Choose from four regional chart styles: </span><b data-hi="उत्तर भारतीय">North Indian</b><span data-hi=" (हिंदुस्तानी हीरा/पतंग शैली), "> (Hindustani diamond/kite), </span><b data-hi="दक्षिण भारतीय">South Indian</b><span data-hi=" (तमिलनाडु और कर्नाटक में प्रयुक्त स्थिर-राशि 4×4 ग्रिड), "> (fixed-sign 4&times;4 grid used in Tamil Nadu and Karnataka), </span><b data-hi="पूर्व भारतीय">East Indian</b><span data-hi=" (बंगाली 3×3 वर्ग), या "> (Bengali 3&times;3 square), or </span><b data-hi="पश्चिम भारतीय">West Indian</b><span data-hi=" (गुजराती/मराठी स्थिर-राशि ग्रिड)। सभी शैलियां समान खगोलीय आंकड़े दर्शाती हैं।"> (Gujarati/Marathi fixed-sign grid). All styles show the same astronomical data.</span></p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0;">This generator computes all nine grahas' sidereal positions from the site's shared <code>allTropicalLons()</code> and Lahiri ayanamsha, plus your Lagna via <code>calcLagna()</code> — the same math used across every chart tool on this site. Retrograde (Vakri) status for the five classical outer planets is derived by comparing each planet's longitude a day apart; Rahu and Ketu, always in retrograde motion by definition, are marked Vakri directly. The Key Interpretations panel also identifies your Atmakaraka — the planet holding the highest degree within its sign, the Jaimini system's primary soul-significator.</p>
      </div>

      <CalculatorFaq items={FAQ_ITEMS} />
    </div>
  </section>
</Layout>

<style>
  .fld-label { font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em; }
  #planet-table th { text-align:left;padding:6px 8px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.04em; }
  #planet-table td { padding:7px 8px;border-bottom:1px solid var(--color-hairline);color:var(--color-body-text); }
  .style-btn { padding:5px 13px;border:1px solid var(--color-hairline-strong);border-radius:6px;background:var(--color-canvas);color:var(--color-body-text);cursor:pointer;font-size:12px;font-family:var(--font-mono); }
  .style-btn.active { background:var(--color-ink);color:var(--color-canvas);border-color:var(--color-ink); }
  /* minmax(0,1fr), not 1fr: a grid item defaults to min-width:auto, so the fixed-width chart
     SVG sets a min-content floor wider than a 360px viewport. That pushed every card in the
     layout to ~347px inside a 328px container, and because html has overflow-x:hidden the
     planetary-positions table was clipped with no way to scroll to the Motion column. */
  @media (max-width: 820px) { .kund-layout { grid-template-columns: minmax(0, 1fr) !important; } }
  /* Let the chart itself scroll inside its card rather than widening the whole layout. */
  #chart-box { max-width: 100%; overflow-x: auto; }
</style>

<script>
import { LOCATIONS } from '../../lib/locations';
import { PLANET_ICONS } from '../../lib/icons/planets';
import { computeKundaliChartData, kundaliNorthChart, kundaliSouthChart, kundaliEastChart, kundaliWestChart, siderealNakshatraPada, formatDegMin, SYNTHETIC_EXAMPLE_BIRTH } from '../../lib/kundali';

function planetIconSvg(id,size){return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:4px;">${PLANET_ICONS[id]}</svg>`;}
let currentStyle = 'north';
let LANG_HI = localStorage.getItem('pp-lang') === 'hi';
function t(en, hi) { return LANG_HI ? hi : en; }
const WD_EN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI=['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN=['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI=['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(y,m,d){const wd=new Date(Date.UTC(y,m-1,d,12)).getUTCDay();return t(`${WD_EN[wd]}, ${d} ${MO_EN[m-1]} ${y}`,`${WD_HI[wd]}, ${d} ${MO_HI[m-1]} ${y}`);}
const LOCS=LOCATIONS.map(l=>({name:l.name,nameHi:l.nameHi,lat:l.lat,lng:l.lng,tz:l.tzOffset}));
function toJD(y,m,d,h){h=h||0;if(m<=2){y--;m+=12;}const A=Math.floor(y/100),B=2-A+Math.floor(A/4);return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;}

const RASHI=['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RASHI_HI=['मेष','वृषभ','मिथुन','कर्क','सिंह','कन्या','तुला','वृश्चिक','धनु','मकर','कुम्भ','मीन'];
const RASHI_EN=['Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius','Capricorn','Aquarius','Pisces'];
const RASHI_LORD=['Mars','Venus','Mercury','Moon','Sun','Mercury','Venus','Mars','Jupiter','Saturn','Saturn','Jupiter'];
const NAKS=['Ashwini','Bharani','Krittika','Rohini','Mrigashira','Ardra','Punarvasu','Pushya','Ashlesha','Magha','Purva Phalguni','Uttara Phalguni','Hasta','Chitra','Swati','Vishakha','Anuradha','Jyeshtha','Mula','Purva Ashadha','Uttara Ashadha','Shravana','Dhanishtha','Shatabhisha','Purva Bhadrapada','Uttara Bhadrapada','Revati'];
const NAKS_HI=['अश्विनी','भरणी','कृत्तिका','रोहिणी','मृगशिरा','आर्द्रा','पुनर्वसु','पुष्य','आश्लेषा','मघा','पूर्व फाल्गुनी','उत्तर फाल्गुनी','हस्त','चित्रा','स्वाति','विशाखा','अनुराधा','ज्येष्ठा','मूल','पूर्वाषाढ़ा','उत्तराषाढ़ा','श्रावण','धनिष्ठा','शतभिषा','पूर्व भाद्रपदा','उत्तर भाद्रपदा','रेवती'];
function trRashi(i){return t(RASHI[i],RASHI_HI[i]);}
function trNak(i){return t(NAKS[i],NAKS_HI[i]);}
const PLANETS=[['surya','Sun','Sy'],['chandra','Moon','Ch'],['mangal','Mars','Ma'],['budha','Mercury','Bu'],['guru','Jupiter','Gu'],['shukra','Venus','Sk'],['shani','Saturn','Sa'],['rahu','Rahu','Ra'],['ketu','Ketu','Ke']];
const PLANET_HI={Sun:'सूर्य',Moon:'चंद्रमा',Mars:'मंगल',Mercury:'बुध',Jupiter:'गुरु',Venus:'शुक्र',Saturn:'शनि',Rahu:'राहु',Ketu:'केतु'};
function fmtDMS(lon){return formatDegMin(lon);}

// Style selector wiring
document.querySelectorAll('.style-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    currentStyle=btn.dataset.style;
    document.querySelectorAll('.style-btn').forEach(b=>b.classList.toggle('active',b===btn));
    if(window._lastCalc)redrawChart();
  });
});

function redrawChart(){
  const{signOfHouse,planetsByHouse,planetsBySign,lagnaSign}=window._lastCalc;
  let html;
  if(currentStyle==='north')html=kundaliNorthChart(signOfHouse,planetsByHouse);
  else if(currentStyle==='south')html=kundaliSouthChart(planetsBySign,lagnaSign);
  else if(currentStyle==='east')html=kundaliEastChart(signOfHouse,planetsByHouse);
  else html=kundaliWestChart(planetsBySign,lagnaSign);
  document.getElementById('chart-box').innerHTML=html;
}

const citySel=document.getElementById('f-city');
function renderCityOptions(){
  const selected=citySel.value;
  citySel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(LANG_HI?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) citySel.value=selected;
}
renderCityOptions();
const EB=SYNTHETIC_EXAMPLE_BIRTH;
const ebDateStr=`${EB.y}-${String(EB.m).padStart(2,'0')}-${String(EB.d).padStart(2,'0')}`;
const ebTimeStr=`${String(EB.hh).padStart(2,'0')}:${String(EB.mm).padStart(2,'0')}`;
document.getElementById('f-date').value=ebDateStr;
document.getElementById('f-time').value=ebTimeStr;
citySel.value=EB.city;

function calculate(){
  try{
    const dateStr=document.getElementById('f-date').value;
    const timeStr=document.getElementById('f-time').value||'12:00';
    const cityName=document.getElementById('f-city').value;
    const name=document.getElementById('f-name').value.trim();
    const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
    const[y,m,d]=dateStr.split('-').map(Number);
    const de=document.getElementById('date-echo');
    if(de){de.textContent=t('Date of birth: ','जन्म तिथि: ')+formatLongDate(y,m,d);de.hidden=false;}
    const noteEl=document.getElementById('example-note');
    if(noteEl)noteEl.style.display=(dateStr===ebDateStr&&timeStr===ebTimeStr&&cityName===EB.city)?'':'none';
    const[hh,mm]=timeStr.split(':').map(Number);
    const jd=toJD(y,m,d,(hh+mm/60)-loc.tz);
    const chart=computeKundaliChartData(jd,loc.lat,loc.lng);
    const{ay,lagna,lagnaSign,signOfHouse,planetsByHouse,planetsBySign,moonSign,sunSign,moonNak,atmakarakaKey}=chart;

    window._lastCalc={signOfHouse,planetsByHouse,planetsBySign,lagnaSign};
    redrawChart();

    document.getElementById('chart-title').textContent=(name?name+"'s ":'')+t('Lagna Chart (D-1)','लग्न चार्ट (डी-1)');
    document.getElementById('chart-sub').textContent=trRashi(lagnaSign)+' '+t('Lagna','लग्न')+' \xb7 '+dateStr+' '+timeStr+' \xb7 '+(LANG_HI?(loc.nameHi||loc.name):loc.name);

    document.getElementById('summary-list').innerHTML=[
      [t('Lagna (Asc)','लग्न'),trRashi(lagnaSign)+' ('+RASHI_EN[lagnaSign]+')'],
      [t('Lagna Lord','लग्न स्वामी'),t(RASHI_LORD[lagnaSign],PLANET_HI[RASHI_LORD[lagnaSign]])],
      [t('Moon Rashi','चंद्र राशि'),trRashi(moonSign)+' ('+RASHI_EN[moonSign]+')'],
      [t('Sun Rashi','सूर्य राशि'),trRashi(sunSign)+' ('+RASHI_EN[sunSign]+')'],
      [t('Nakshatra','नक्षत्र'),trNak(moonNak.idx)+' ('+t('Pada','पद')+' '+moonNak.pada+')'],
      [t('Ayanamsha','अयनांश'),ay.toFixed(3)+'\xb0 Lahiri'],
    ].map(r=>`<div style="display:flex;justify-content:space-between;gap:10px;font-size:12.5px;"><span style="color:var(--color-mute);">${r[0]}</span><span style="color:var(--color-ink);font-weight:600;text-align:right;">${r[1]}</span></div>`).join('');

    const akName=PLANETS.find(([k])=>k===atmakarakaKey)[1];
    let rows=`<tr><th>${t('Graha','ग्रह')}</th><th>${t('Rashi','राशि')}</th><th>${t('Degree','अंश')}</th><th>${t('Nakshatra','नक्षत्र')}</th><th>${t('Pada','पद')}</th><th>${t('Motion','गति')}</th></tr>`;
    PLANETS.forEach(([k,full])=>{
      const row=chart.rows.find(r=>r.key===k);
      const motion=row.isRetrograde?t('Vakri','वक्री'):t('Margi','मार्गी');
      rows+=`<tr><td style="color:var(--color-ink);font-weight:600;">${planetIconSvg(k,14)}${t(full,PLANET_HI[full])}</td><td>${trRashi(row.sign)}</td><td style="font-family:var(--font-mono);">${fmtDMS(row.sidLon)}</td><td>${trNak(row.nakIdx)}</td><td>${row.nakPada}</td><td style="color:${row.isRetrograde?'#dc2626':'var(--color-body-text)'};">${motion}</td></tr>`;
    });
    document.getElementById('planet-table').innerHTML=rows;

    document.getElementById('interp').innerHTML=[
      [t('Lagna (Ascendant)','लग्न (उदय राशि)'),t('Your rising sign is <b>'+trRashi(lagnaSign)+' ('+RASHI_EN[lagnaSign]+')</b>, ruled by '+RASHI_LORD[lagnaSign]+'. The Lagna shapes your physical body, temperament and how others first perceive you.','आपकी उदय राशि <b>'+trRashi(lagnaSign)+' ('+RASHI_EN[lagnaSign]+')</b> है, जिसका स्वामी '+PLANET_HI[RASHI_LORD[lagnaSign]]+' है। लग्न आपके शारीरिक स्वरूप, स्वभाव और दूसरों की आप पर पहली धारणा को आकार देता है।')],
      [t('Moon Sign (Rashi)','चंद्र राशि'),t('Your Moon is in <b>'+trRashi(moonSign)+' ('+RASHI_EN[moonSign]+')</b> in '+trNak(moonNak.idx)+' nakshatra. This is your emotional core and the rashi used for daily Rashifal and most muhurta decisions.','आपका चंद्रमा <b>'+trRashi(moonSign)+' ('+RASHI_EN[moonSign]+')</b> राशि में '+trNak(moonNak.idx)+' नक्षत्र में है। यही आपका भावनात्मक केंद्र है और दैनिक राशिफल व अधिकांश मुहूर्त निर्णयों में इसी राशि का उपयोग होता है।')],
      [t('Sun Sign','सूर्य राशि'),t('Your Sun is in <b>'+trRashi(sunSign)+' ('+RASHI_EN[sunSign]+')</b>, representing your soul, vitality, ego and your relationship with authority and the father.','आपका सूर्य <b>'+trRashi(sunSign)+' ('+RASHI_EN[sunSign]+')</b> राशि में है, जो आपकी आत्मा, जीवनशक्ति, अहं तथा अधिकार व पिता के साथ आपके संबंध को दर्शाता है।')],
      [t('Atmakaraka','आत्मकारक'),t('<b>'+akName+'</b> holds the highest degree in its sign and is your Atmakaraka — the soul planet of the Jaimini system, signifying your deepest desires and the main lesson of this lifetime.','<b>'+PLANET_HI[akName]+'</b> अपनी राशि में सबसे अधिक अंश पर है और आपका आत्मकारक है — जैमिनी पद्धति का आत्मा-ग्रह, जो आपकी गहनतम इच्छाओं और इस जीवन के मुख्य पाठ को दर्शाता है।')],
    ].map(i=>`<div><p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 3px;">${i[0]}</p><p style="font-size:14px;color:var(--color-body-text);line-height:1.6;margin:0;">${i[1]}</p></div>`).join('');

    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){
    const er=document.getElementById('err');er.style.display='block';er.textContent='Could not generate chart: '+e.message;
    document.getElementById('result').style.display='none';
  }
}
document.getElementById('f-calc').addEventListener('click',calculate);
calculate();

function applyPageLang(hindi) {
  LANG_HI = hindi;
  renderCityOptions();
  document.querySelectorAll('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? el.dataset.hi : el.dataset.en;
  });
  if (window._lastCalc) calculate();
}
document.addEventListener('langchange', (e) => {
  applyPageLang(e.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
