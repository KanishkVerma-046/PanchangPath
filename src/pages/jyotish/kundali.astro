---
import Layout from '../../layouts/Layout.astro';
import { PLANET_ICONS } from '../../lib/icons/planets';
---

<Layout title="Kundali Generator — Free Vedic Birth Chart — PanchangPath" description="Generate your free Vedic birth chart (Janma Kundali) with planetary positions, signs, nakshatras, Lagna and interpretations. Drik calculations, Lahiri ayanamsha.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">जन्म कुंडली · KUNDALI GENERATOR</p>
      <h1 data-hi="कुंडली जनरेटर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Kundali Generator</h1>
      <p data-hi="ग्रह स्थिति, लग्न, नक्षत्र और मुख्य व्याख्याओं सहित पूर्ण जन्म कुंडली बनाने के लिए अपना जन्म विवरण दर्ज करें।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:500px;">Enter your birth details to generate a full Vedic birth chart with planetary positions, Lagna, nakshatras and key interpretations.</p>
    </div>
  </section>

  <section style="padding:28px 0 56px;">
    <div class="container">
      <!-- Form -->
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:16px;">
        <div>
          <label for="f-name" class="fld-label" data-hi="नाम (वैकल्पिक)">Name (optional)</label>
          <input type="text" id="f-name" class="input" placeholder="Your name" style="height:38px;min-width:150px;" />
        </div>
        <div>
          <label for="f-date" class="fld-label" data-hi="जन्म तिथि">Date of Birth</label>
          <input type="date" id="f-date" lang="en-GB" class="input" style="height:38px;" />
        </div>
        <div>
          <label for="f-time" class="fld-label" data-hi="जन्म समय">Time of Birth</label>
          <input type="time" id="f-time" class="input" style="height:38px;" />
        </div>
        <div>
          <label for="f-city" class="fld-label" data-hi="जन्म स्थान">Place of Birth</label>
          <select id="f-city" class="input" style="height:38px;min-width:150px;"></select>
        </div>
        <button id="f-calc" class="btn-primary" data-hi="कुंडली बनाएं" style="height:38px;padding:0 20px;">Generate Kundali</button>
      </div>
      <p id="date-echo" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;" hidden></p>

      <!-- Chart style selector -->
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:28px;">
        <span class="fld-label" data-hi="चार्ट शैली:" style="margin:0;">Chart Style:</span>
        <button class="style-btn active" data-style="north" data-hi="उत्तर भारतीय">North Indian</button>
        <button class="style-btn" data-style="south" data-hi="दक्षिण भारतीय">South Indian</button>
        <button class="style-btn" data-style="east" data-hi="पूर्व भारतीय">East Indian</button>
        <button class="style-btn" data-style="west" data-hi="पश्चिम भारतीय">West Indian</button>
      </div>

      <div id="result" style="display:none;">
        <div style="display:grid;grid-template-columns:340px 1fr;gap:28px;align-items:start;" class="kund-layout">
          <!-- Chart -->
          <div>
            <div class="card" style="padding:20px;">
              <h2 id="chart-title" style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">Lagna Chart (D-1)</h2>
              <p id="chart-sub" style="font-size:12px;color:var(--color-mute);margin:0 0 14px;font-family:var(--font-mono);"></p>
              <div id="chart-box"></div>
            </div>
            <div class="card" style="padding:18px;margin-top:16px;">
              <h3 data-hi="जन्म सारांश" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 10px;">Birth Summary</h3>
              <div id="summary-list" style="display:flex;flex-direction:column;gap:8px;"></div>
            </div>
          </div>

          <!-- Tables + interpretation -->
          <div>
            <div class="card" style="padding:20px;overflow-x:auto;">
              <h3 data-hi="ग्रह स्थिति (ग्रह स्फुट)" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Planetary Positions (Graha Sphuta)</h3>
              <table style="width:100%;border-collapse:collapse;font-size:13px;" id="planet-table"></table>
            </div>
            <div class="card" style="padding:20px;margin-top:16px;">
              <h3 data-hi="मुख्य व्याख्याएं" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Key Interpretations</h3>
              <div id="interp" style="display:flex;flex-direction:column;gap:12px;"></div>
            </div>
          </div>
        </div>
      </div>

      <div id="err" style="display:none;padding:16px;background:var(--color-inauspicious-soft);border-radius:8px;color:#b91c1c;font-size:14px;"></div>

      <!-- About -->
      <div class="card" style="padding:28px;margin-top:36px;">
        <h2 data-hi="जन्म कुंडली के बारे में" style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">About the Janma Kundali</h2>
        <p data-hi="जन्म कुंडली आपके जन्म के ठीक क्षण और स्थान पर आकाश का नक्शा है। 12 भाव, पूर्वी क्षितिज पर उदित होने वाली राशि (लग्न), और नौ ग्रहों की स्थिति मिलकर आपके जीवन की संभावनाओं, शक्तियों और कर्म-पैटर्न को दर्शाते हैं।" style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 10px;">The Janma Kundali (birth chart) is a map of the heavens at the exact moment and place of your birth. The 12 houses (bhavas), the rashi rising on the eastern horizon (Lagna), and the placement of the nine grahas together describe your life's potential, strengths and karmic patterns.</p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0;"><span data-hi="चार क्षेत्रीय चार्ट शैलियों में से चुनें: ">Choose from four regional chart styles: </span><b data-hi="उत्तर भारतीय">North Indian</b><span data-hi=" (हिंदुस्तानी हीरा/पतंग शैली), "> (Hindustani diamond/kite), </span><b data-hi="दक्षिण भारतीय">South Indian</b><span data-hi=" (तमिलनाडु और कर्नाटक में प्रयुक्त स्थिर-राशि 4×4 ग्रिड), "> (fixed-sign 4&times;4 grid used in Tamil Nadu and Karnataka), </span><b data-hi="पूर्व भारतीय">East Indian</b><span data-hi=" (बंगाली 3×3 वर्ग), या "> (Bengali 3&times;3 square), or </span><b data-hi="पश्चिम भारतीय">West Indian</b><span data-hi=" (गुजराती/मराठी स्थिर-राशि ग्रिड)। सभी शैलियां समान खगोलीय आंकड़े दर्शाती हैं।"> (Gujarati/Marathi fixed-sign grid). All styles show the same astronomical data.</span></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .fld-label { font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em; }
  #planet-table th { text-align:left;padding:6px 8px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.04em; }
  #planet-table td { padding:7px 8px;border-bottom:1px solid var(--color-hairline);color:var(--color-body-text); }
  .style-btn { padding:5px 13px;border:1px solid var(--color-hairline-strong);border-radius:6px;background:var(--color-canvas);color:var(--color-body-text);cursor:pointer;font-size:12px;font-family:var(--font-mono); }
  .style-btn.active { background:var(--color-ink);color:var(--color-canvas);border-color:var(--color-ink); }
  @media (max-width: 820px) { .kund-layout { grid-template-columns: 1fr !important; } }
</style>

<script>
import { LOCATIONS } from '../../lib/locations';
import { PLANET_ICONS } from '../../lib/icons/planets';
import { allTropicalLons } from '../../lib/kundali';
import { calcLagna } from '../../lib/astro-core';

function planetIconSvg(id,size){return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:4px;">${PLANET_ICONS[id]}</svg>`;}
let currentStyle = 'north';
let LANG_HI = localStorage.getItem('pp-lang') === 'hi';
function t(en, hi) { return LANG_HI ? hi : en; }
const WD_EN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI=['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN=['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI=['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(y,m,d){const wd=new Date(Date.UTC(y,m-1,d,12)).getUTCDay();return t(`${WD_EN[wd]}, ${d} ${MO_EN[m-1]} ${y}`,`${WD_HI[wd]}, ${d} ${MO_HI[m-1]} ${y}`);}
const LOCS=LOCATIONS.map(l=>({name:l.name,lat:l.lat,lng:l.lng,tz:l.tzOffset}));
function toJD(y,m,d,h){h=h||0;if(m<=2){y--;m+=12;}const A=Math.floor(y/100),B=2-A+Math.floor(A/4);return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;}
const n360=a=>((a%360)+360)%360;

const RASHI=['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RASHI_EN=['Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius','Capricorn','Aquarius','Pisces'];
const RASHI_LORD=['Mars','Venus','Mercury','Moon','Sun','Mercury','Venus','Mars','Jupiter','Saturn','Saturn','Jupiter'];
const NAKS=['Ashwini','Bharani','Krittika','Rohini','Mrigashira','Ardra','Punarvasu','Pushya','Ashlesha','Magha','Purva Phalguni','Uttara Phalguni','Hasta','Chitra','Swati','Vishakha','Anuradha','Jyeshtha','Mula','Purva Ashadha','Uttara Ashadha','Shravana','Dhanishtha','Shatabhisha','Purva Bhadrapada','Uttara Bhadrapada','Revati'];
const PLANETS=[['surya','Sun','Sy'],['chandra','Moon','Ch'],['mangal','Mars','Ma'],['budha','Mercury','Bu'],['guru','Jupiter','Gu'],['shukra','Venus','Sk'],['shani','Saturn','Sa'],['rahu','Rahu','Ra'],['ketu','Ketu','Ke']];
function fmtDMS(lon){const d=lon%30;const deg=Math.floor(d);const mn=Math.floor((d-deg)*60);return deg+'\xb0'+String(mn).padStart(2,'0')+"'";}
function nakInfo(sid){const idx=Math.floor(sid/(360/27));const pada=Math.floor((sid%(360/27))/((360/27)/4))+1;return{name:NAKS[idx],pada};}

// ── North Indian chart (diamond/kite) ──
function drawNorthChart(signOfHouse,planetsByHouse){
  const S=320;
  const f=[[0.5,0.25],[0.25,0.12],[0.12,0.25],[0.25,0.5],[0.12,0.75],[0.25,0.88],[0.5,0.75],[0.75,0.88],[0.88,0.75],[0.75,0.5],[0.88,0.25],[0.75,0.12]];
  let lines=`<line x1="0" y1="0" x2="${S}" y2="${S}"/><line x1="${S}" y1="0" x2="0" y2="${S}"/><polygon points="${S/2},0 ${S},${S/2} ${S/2},${S} 0,${S/2}" fill="none"/>`;
  let txt='';
  for(let h=0;h<12;h++){
    const cx=f[h][0]*S,cy=f[h][1]*S;
    txt+=`<text x="${cx}" y="${cy-18}" text-anchor="middle" font-size="10" fill="var(--color-kundali-house)" stroke="none" font-family="var(--font-mono)">${signOfHouse[h]+1}</text>`;
    const pls=planetsByHouse[h]||[];
    pls.forEach((p,i)=>{const perRow=3;const col=i%perRow;const row=Math.floor(i/perRow);const px=cx+(col-(Math.min(pls.length,perRow)-1)/2)*22;const py=cy+row*14;txt+=`<text x="${px}" y="${py}" text-anchor="middle" font-size="11" font-weight="600" fill="${p==='La'?'var(--color-saffron-deep)':'var(--color-kundali-label)'}" stroke="none">${p}</text>`;});
  }
  return `<svg viewBox="-2 -2 ${S+4} ${S+4}" width="100%" style="max-width:320px;stroke:var(--color-kundali-grid);stroke-width:1;"><rect x="0" y="0" width="${S}" height="${S}" fill="var(--color-kundali-bg)"/>${lines}${txt}</svg>`;
}

// ── South Indian chart (fixed-sign 4×4 grid) ──
// Signs fixed clockwise: Pisces top-left → Aries → ... → Aquarius left
const SOUTH_SIGN=[[11,0,1,2],[10,-1,-1,3],[9,-1,-1,4],[8,7,6,5]];
function drawSouthChart(planetsBySign,lagnaSign){
  const C=80,S=C*4;
  let svg=`<svg viewBox="0 0 ${S} ${S}" width="100%" style="max-width:320px;">`;
  svg+=`<rect x="${C}" y="${C}" width="${2*C}" height="${2*C}" fill="var(--color-kundali-bg)" stroke="var(--color-kundali-grid)" stroke-width="1.5"/>`;
  svg+=`<text x="${C+C}" y="${C+C}" text-anchor="middle" dominant-baseline="middle" font-size="30" fill="var(--color-kundali-grid)" stroke="none">&#x1F549;</text>`;
  for(let r=0;r<4;r++){for(let c=0;c<4;c++){
    const s=SOUTH_SIGN[r][c];if(s===-1)continue;
    const x=c*C,y=r*C,isL=s===lagnaSign;
    svg+=`<rect x="${x}" y="${y}" width="${C}" height="${C}" fill="${isL?'rgba(220,130,50,0.08)':'var(--color-kundali-bg)'}" stroke="var(--color-kundali-grid)" stroke-width="1.5"/>`;
    svg+=`<text x="${x+4}" y="${y+12}" font-size="9" fill="var(--color-kundali-house)" stroke="none" font-family="var(--font-mono)">${s+1}</text>`;
    if(isL){svg+=`<line x1="${x}" y1="${y}" x2="${x+22}" y2="${y}" stroke="var(--color-saffron-deep)" stroke-width="2.5"/><line x1="${x}" y1="${y}" x2="${x}" y2="${y+22}" stroke="var(--color-saffron-deep)" stroke-width="2.5"/>`;}
    const plts=planetsBySign[s]||[];
    plts.forEach((p,i)=>{svg+=`<text x="${x+5+(i%3)*24}" y="${y+28+Math.floor(i/3)*14}" font-size="11" font-weight="600" fill="${p==='La'?'var(--color-saffron-deep)':'var(--color-kundali-label)'}" stroke="none">${p}</text>`;});
  }}
  svg+='</svg>';return svg;
}

// ── East Indian chart (Bengali 3×3 grid, Lagna top-centre) ──
// Corner cells hold 2 houses each; edge cells hold 1; centre = Om
const EAST_CELLS=[[[10,11],[0],[1,2]],[[9],null,[3]],[[8,7],[6],[5,4]]];
function drawEastChart(signOfHouse,planetsByHouse){
  const C=100,S=300;
  let svg=`<svg viewBox="0 0 ${S} ${S}" width="100%" style="max-width:300px;">`;
  svg+=`<rect x="${C}" y="${C}" width="${C}" height="${C}" fill="var(--color-kundali-bg)" stroke="var(--color-kundali-grid)" stroke-width="1.5"/>`;
  svg+=`<text x="${C+C/2}" y="${C+C/2}" text-anchor="middle" dominant-baseline="middle" font-size="26" fill="var(--color-kundali-grid)" stroke="none">&#x1F549;</text>`;
  for(let r=0;r<3;r++){for(let c=0;c<3;c++){
    if(r===1&&c===1)continue;
    const houses=EAST_CELLS[r][c];
    const x=c*C,y=r*C,isLagna=houses.includes(0);
    svg+=`<rect x="${x}" y="${y}" width="${C}" height="${C}" fill="${isLagna?'rgba(220,130,50,0.08)':'var(--color-kundali-bg)'}" stroke="var(--color-kundali-grid)" stroke-width="1.5"/>`;
    svg+=`<text x="${x+4}" y="${y+12}" font-size="9" fill="var(--color-kundali-house)" stroke="none" font-family="var(--font-mono)">${houses.map(h=>h+1).join(',')}</text>`;
    if(isLagna){svg+=`<text x="${x+C-4}" y="${y+12}" text-anchor="end" font-size="9" fill="var(--color-saffron-deep)" stroke="none">La</text>`;}
    let allP=[];houses.forEach(h=>{allP=allP.concat(planetsByHouse[h]||[]);});
    allP.forEach((p,i)=>{svg+=`<text x="${x+6+(i%3)*28}" y="${y+32+Math.floor(i/3)*14}" font-size="11" font-weight="600" fill="${p==='La'?'var(--color-saffron-deep)':'var(--color-kundali-label)'}" stroke="none">${p}</text>`;});
  }}
  svg+='</svg>';return svg;
}

// ── West Indian chart (Gujarati/Marathi — fixed-sign like South but signs run anti-clockwise) ──
// Top row L→R: Aries Taurus Gemini Cancer; left col T→B: Pisces Aquarius Capricorn; etc.
const WEST_SIGN=[[0,1,2,3],[11,-1,-1,4],[10,-1,-1,5],[9,8,7,6]];
function drawWestChart(planetsBySign,lagnaSign){
  const C=80,S=C*4;
  let svg=`<svg viewBox="0 0 ${S} ${S}" width="100%" style="max-width:320px;">`;
  svg+=`<rect x="${C}" y="${C}" width="${2*C}" height="${2*C}" fill="var(--color-kundali-bg)" stroke="var(--color-kundali-grid)" stroke-width="1.5"/>`;
  svg+=`<text x="${C+C}" y="${C+C}" text-anchor="middle" dominant-baseline="middle" font-size="30" fill="var(--color-kundali-grid)" stroke="none">&#x1F549;</text>`;
  for(let r=0;r<4;r++){for(let c=0;c<4;c++){
    const s=WEST_SIGN[r][c];if(s===-1)continue;
    const x=c*C,y=r*C,isL=s===lagnaSign;
    svg+=`<rect x="${x}" y="${y}" width="${C}" height="${C}" fill="${isL?'rgba(220,130,50,0.08)':'var(--color-kundali-bg)'}" stroke="var(--color-kundali-grid)" stroke-width="1.5"/>`;
    svg+=`<text x="${x+4}" y="${y+12}" font-size="9" fill="var(--color-kundali-house)" stroke="none" font-family="var(--font-mono)">${s+1}</text>`;
    if(isL){svg+=`<line x1="${x}" y1="${y}" x2="${x+22}" y2="${y}" stroke="var(--color-saffron-deep)" stroke-width="2.5"/><line x1="${x}" y1="${y}" x2="${x}" y2="${y+22}" stroke="var(--color-saffron-deep)" stroke-width="2.5"/>`;}
    const plts=planetsBySign[s]||[];
    plts.forEach((p,i)=>{svg+=`<text x="${x+5+(i%3)*24}" y="${y+28+Math.floor(i/3)*14}" font-size="11" font-weight="600" fill="${p==='La'?'var(--color-saffron-deep)':'var(--color-kundali-label)'}" stroke="none">${p}</text>`;});
  }}
  svg+='</svg>';return svg;
}

// Style selector wiring
document.querySelectorAll('.style-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    currentStyle=btn.dataset.style;
    document.querySelectorAll('.style-btn').forEach(b=>b.classList.toggle('active',b===btn));
    if(window._lastCalc)redrawChart();
  });
});

function redrawChart(){
  const{signOfHouse,planetsByHouse,planetsBySign,lagnaSign}=window._lastCalc;
  let html;
  if(currentStyle==='north')html=drawNorthChart(signOfHouse,planetsByHouse);
  else if(currentStyle==='south')html=drawSouthChart(planetsBySign,lagnaSign);
  else if(currentStyle==='east')html=drawEastChart(signOfHouse,planetsByHouse);
  else html=drawWestChart(planetsBySign,lagnaSign);
  document.getElementById('chart-box').innerHTML=html;
}

const citySel=document.getElementById('f-city');
citySel.innerHTML=LOCS.map(l=>`<option value="${l.name}">${l.name}</option>`).join('');
const today=new Date();
document.getElementById('f-date').value=today.toISOString().split('T')[0];
document.getElementById('f-time').value='12:00';

function calculate(){
  try{
    const dateStr=document.getElementById('f-date').value;
    const timeStr=document.getElementById('f-time').value||'12:00';
    const cityName=document.getElementById('f-city').value;
    const name=document.getElementById('f-name').value.trim();
    const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
    const[y,m,d]=dateStr.split('-').map(Number);
    const de=document.getElementById('date-echo');
    if(de){de.textContent=t('Date of birth: ','जन्म तिथि: ')+formatLongDate(y,m,d);de.hidden=false;}
    const[hh,mm]=timeStr.split(':').map(Number);
    const jd=toJD(y,m,d,(hh+mm/60)-loc.tz);
    const L=allTropicalLons(jd);const ay=L.ayanamsha;
    const Lp=allTropicalLons(jd+1);
    const sid={};PLANETS.forEach(([k])=>sid[k]=n360(L[k]-ay));
    const lagnaTrop=calcLagna(jd,loc.lat,loc.lng);
    const lagna=n360(lagnaTrop-ay);
    const lagnaSign=Math.floor(lagna/30);

    const signOfHouse=[];for(let h=0;h<12;h++)signOfHouse[h]=(lagnaSign+h)%12;
    const planetsByHouse={};for(let h=0;h<12;h++)planetsByHouse[h]=[];
    const planetsBySign={};for(let s=0;s<12;s++)planetsBySign[s]=[];
    planetsByHouse[0].push('La');
    planetsBySign[lagnaSign].push('La');
    PLANETS.forEach(([k,,abbr])=>{
      const sign=Math.floor(sid[k]/30);
      const house=((sign-lagnaSign)+12)%12;
      planetsByHouse[house].push(abbr);
      planetsBySign[sign].push(abbr);
    });

    window._lastCalc={signOfHouse,planetsByHouse,planetsBySign,lagnaSign};
    redrawChart();

    document.getElementById('chart-title').textContent=(name?name+"'s ":'')+t('Lagna Chart (D-1)','लग्न चार्ट (डी-1)');
    document.getElementById('chart-sub').textContent=RASHI[lagnaSign]+' Lagna \xb7 '+dateStr+' '+timeStr+' \xb7 '+cityName;

    const moonSign=Math.floor(sid.chandra/30);
    const sunSign=Math.floor(sid.surya/30);
    const moonNak=nakInfo(sid.chandra);
    document.getElementById('summary-list').innerHTML=[
      [t('Lagna (Asc)','लग्न'),RASHI[lagnaSign]+' ('+RASHI_EN[lagnaSign]+')'],
      [t('Lagna Lord','लग्न स्वामी'),RASHI_LORD[lagnaSign]],
      [t('Moon Rashi','चंद्र राशि'),RASHI[moonSign]+' ('+RASHI_EN[moonSign]+')'],
      [t('Sun Rashi','सूर्य राशि'),RASHI[sunSign]+' ('+RASHI_EN[sunSign]+')'],
      [t('Nakshatra','नक्षत्र'),moonNak.name+' ('+t('Pada','पद')+' '+moonNak.pada+')'],
      [t('Ayanamsha','अयनांश'),ay.toFixed(3)+'\xb0 Lahiri'],
    ].map(r=>`<div style="display:flex;justify-content:space-between;gap:10px;font-size:12.5px;"><span style="color:var(--color-mute);">${r[0]}</span><span style="color:var(--color-ink);font-weight:600;text-align:right;">${r[1]}</span></div>`).join('');

    let rows=`<tr><th>${t('Graha','ग्रह')}</th><th>${t('Rashi','राशि')}</th><th>${t('Degree','अंश')}</th><th>${t('Nakshatra','नक्षत्र')}</th><th>${t('Pada','पद')}</th><th>${t('Motion','गति')}</th></tr>`;
    let akName='',akDeg=-1;
    PLANETS.forEach(([k,full])=>{
      const s=sid[k];const sign=Math.floor(s/30);const nk=nakInfo(s);
      let motion=t('Margi','मार्गी');
      if(k==='rahu'||k==='ketu')motion=t('Vakri','वक्री');
      else if(k!=='surya'&&k!=='chandra'){const cur=n360(L[k]-ay);const nxt=n360(Lp[k]-Lp.ayanamsha);let diff=nxt-cur;if(diff>180)diff-=360;if(diff<-180)diff+=360;motion=diff<0?t('Vakri','वक्री'):t('Margi','मार्गी');}
      let degInSign=s%30;if(k==='rahu')degInSign=30-(s%30);
      if(k!=='ketu'&&degInSign>akDeg){akDeg=degInSign;akName=full;}
      rows+=`<tr><td style="color:var(--color-ink);font-weight:600;">${planetIconSvg(k,14)}${full}</td><td>${RASHI[sign]}</td><td style="font-family:var(--font-mono);">${fmtDMS(s)}</td><td>${nk.name}</td><td>${nk.pada}</td><td style="color:${(motion===t('Vakri','वक्री'))?'#dc2626':'var(--color-body-text)'};">${motion}</td></tr>`;
    });
    document.getElementById('planet-table').innerHTML=rows;

    document.getElementById('interp').innerHTML=[
      [t('Lagna (Ascendant)','लग्न (उदय राशि)'),t('Your rising sign is <b>'+RASHI[lagnaSign]+' ('+RASHI_EN[lagnaSign]+')</b>, ruled by '+RASHI_LORD[lagnaSign]+'. The Lagna shapes your physical body, temperament and how others first perceive you.','आपकी उदय राशि <b>'+RASHI[lagnaSign]+' ('+RASHI_EN[lagnaSign]+')</b> है, जिसका स्वामी '+RASHI_LORD[lagnaSign]+' है। लग्न आपके शारीरिक स्वरूप, स्वभाव और दूसरों की आप पर पहली धारणा को आकार देता है।')],
      [t('Moon Sign (Rashi)','चंद्र राशि'),t('Your Moon is in <b>'+RASHI[moonSign]+' ('+RASHI_EN[moonSign]+')</b> in '+moonNak.name+' nakshatra. This is your emotional core and the rashi used for daily Rashifal and most muhurta decisions.','आपका चंद्रमा <b>'+RASHI[moonSign]+' ('+RASHI_EN[moonSign]+')</b> राशि में '+moonNak.name+' नक्षत्र में है। यही आपका भावनात्मक केंद्र है और दैनिक राशिफल व अधिकांश मुहूर्त निर्णयों में इसी राशि का उपयोग होता है।')],
      [t('Sun Sign','सूर्य राशि'),t('Your Sun is in <b>'+RASHI[sunSign]+' ('+RASHI_EN[sunSign]+')</b>, representing your soul, vitality, ego and your relationship with authority and the father.','आपका सूर्य <b>'+RASHI[sunSign]+' ('+RASHI_EN[sunSign]+')</b> राशि में है, जो आपकी आत्मा, जीवनशक्ति, अहं तथा अधिकार व पिता के साथ आपके संबंध को दर्शाता है।')],
      [t('Atmakaraka','आत्मकारक'),t('<b>'+akName+'</b> holds the highest degree in its sign and is your Atmakaraka — the soul planet of the Jaimini system, signifying your deepest desires and the main lesson of this lifetime.','<b>'+akName+'</b> अपनी राशि में सबसे अधिक अंश पर है और आपका आत्मकारक है — जैमिनी पद्धति का आत्मा-ग्रह, जो आपकी गहनतम इच्छाओं और इस जीवन के मुख्य पाठ को दर्शाता है।')],
    ].map(i=>`<div><p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 3px;">${i[0]}</p><p style="font-size:14px;color:var(--color-body-text);line-height:1.6;margin:0;">${i[1]}</p></div>`).join('');

    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){
    const er=document.getElementById('err');er.style.display='block';er.textContent='Could not generate chart: '+e.message;
    document.getElementById('result').style.display='none';
  }
}
document.getElementById('f-calc').addEventListener('click',calculate);
calculate();

function applyPageLang(hindi) {
  LANG_HI = hindi;
  document.querySelectorAll('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? el.dataset.hi : el.dataset.en;
  });
  if (window._lastCalc) calculate();
}
document.addEventListener('langchange', (e) => {
  applyPageLang(e.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
