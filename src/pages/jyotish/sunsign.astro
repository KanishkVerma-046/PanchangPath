---
import Layout from '../../layouts/Layout.astro';
import CalculatorFaq from '../../components/CalculatorFaq.astro';
import { sharedCalcFaq } from '../../lib/calculatorFaq';
import { RASHI_PROFILES, SOLAR_TRAITS, SOLAR_TRAITS_HI } from '../../lib/jyotish';
import { RASHI_ICONS } from '../../lib/icons/rashi';

const RASHI_ID_LIST = ['mesha', 'vrishabha', 'mithuna', 'karka', 'simha', 'kanya', 'tula', 'vrishchika', 'dhanu', 'makara', 'kumbha', 'meena'];
function rashiSvg(id: string, size: number): string {
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${RASHI_ICONS[id]}</svg>`;
}

const FAQ_ITEMS = [
  ...sharedCalcFaq(),
  {
    q: "Why does the calculator ask for time and place if they're marked optional?",
    qHi: 'यदि समय और स्थान को वैकल्पिक चिह्नित किया गया है, तो कैलकुलेटर उन्हें क्यों मांगता है?',
    a: "Because they only change the result on the one or two days a month when the Sun is actually crossing from one sign into the next. The Sun moves only about 1° per day, so unless your birthday falls right on one of those crossing days, the date alone is already enough to fix both your Western and Vedic Sun sign precisely — time and place don't add any further precision.",
    aHi: 'क्योंकि वे परिणाम केवल महीने के उन एक-दो दिनों में बदलते हैं जब सूर्य वास्तव में एक राशि से दूसरी में पार कर रहा होता है। सूर्य प्रतिदिन लगभग केवल 1° गति करता है, इसलिए जब तक आपका जन्मदिन ठीक उन पार होने वाले दिनों में से किसी पर न पड़े, केवल तिथि ही आपकी पाश्चात्य और वैदिक दोनों सूर्य राशियों को सटीक रूप से निर्धारित करने के लिए पर्याप्त है — समय और स्थान कोई अतिरिक्त सटीकता नहीं जोड़ते।',
  },
  {
    q: 'If my Western and Vedic Sun signs differ, which one is "correct"?',
    qHi: 'यदि मेरी पाश्चात्य और वैदिक सूर्य राशियां अलग-अलग हैं, तो कौन सी "सही" है?',
    a: "Neither is wrong — they answer different questions using different reference points. Western tropical astrology (the sign in most newspaper horoscopes) measures from the seasons; Vedic sidereal astrology measures from the actual background stars. If you're reading a Jyotish prediction, in-depth Vedic Panchang, or anything else on this site, the Vedic sign is the relevant one; the Western sign is what applies to typical Western pop-astrology content.",
    aHi: 'कोई भी गलत नहीं है — वे अलग-अलग संदर्भ बिंदुओं का उपयोग करके अलग-अलग सवालों का जवाब देते हैं। पाश्चात्य उष्णकटिबंधीय ज्योतिष (अधिकांश समाचार पत्र कुंडलियों में दी गई राशि) ऋतुओं से मापता है; वैदिक सिडेरियल ज्योतिष वास्तविक पृष्ठभूमि तारों से मापता है। यदि आप कोई ज्योतिष भविष्यवाणी, गहन वैदिक पंचांग, या इस साइट पर कुछ और पढ़ रहे हैं, तो वैदिक राशि ही प्रासंगिक है; पाश्चात्य राशि सामान्य पाश्चात्य पॉप-ज्योतिष सामग्री पर लागू होती है।',
  },
  {
    q: 'My birthday is right around a sign changeover (like late March) — how do I know which sign I actually am?',
    qHi: 'मेरा जन्मदिन ठीक राशि-परिवर्तन के आसपास है (जैसे मार्च के अंत में) — मुझे कैसे पता चलेगा कि मैं वास्तव में कौन सी राशि का हूं?',
    a: "That's exactly the case where entering an exact birth time and place matters, unlike for most other birth dates. Late March is a genuine edge case for this reason: it's close to when the Western Aries/Pisces boundary falls, and — separately — often lands right around the Vedic Pisces/Aries boundary too because of the ~24° ayanamsha offset. Fill in the optional fields for the most reliable result if your birthday is within a day or two of either boundary.",
    aHi: 'यही वह स्थिति है जहां सटीक जन्म समय और स्थान दर्ज करना मायने रखता है, अधिकांश अन्य जन्म तिथियों के विपरीत। मार्च का अंत इस कारण से एक वास्तविक सीमांत मामला है: यह उस समय के करीब है जब पाश्चात्य मेष/मीन सीमा पड़ती है, और — अलग से — ~24° अयनांश ऑफसेट के कारण यह अक्सर वैदिक मीन/मेष सीमा के भी ठीक आसपास पड़ता है। यदि आपका जन्मदिन किसी भी सीमा के एक-दो दिन के भीतर है, तो सबसे विश्वसनीय परिणाम के लिए वैकल्पिक फ़ील्ड भरें।',
  },
];
---

<Layout title="Sun Sign Calculator — Vedic & Western — PanchangPath" description="Find both your Vedic (sidereal) and Western (tropical) Sun signs from birth date, time and place, with element, quality, ruler and compatible signs.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" class="reveal" style="display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--color-mute);text-decoration:none;"><span class="arrow-chip"><svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></span><span data-hi="ज्योतिष उपकरण">Jyotish Tools</span></a>
      <p class="eyebrow reveal" style="margin:12px 0 8px;transition-delay:40ms;">सूर्य राशि · SUNSIGN CALCULATOR</p>
      <h1 class="reveal" data-hi="सूर्य राशि कैलकुलेटर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;transition-delay:80ms;">Sun Sign Calculator</h1>
      <p class="reveal" data-hi="अपनी दोनों सूर्य राशियां देखें — पश्चिमी (सायन) राशि जो लोकप्रिय राशिफल में प्रयोग होती है, और वैदिक (निरयण) सूर्य राशि जो ज्योतिष में प्रयोग होती है — उनके स्वभाव सहित।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:520px;transition-delay:120ms;">See both your Sun signs — the Western (tropical) sign used in popular horoscopes, and the Vedic (sidereal) sun sign used in Jyotish — along with their personality traits.</p>
    </div>
  </section>

  <section style="padding:28px 0 56px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div><label for="f-date" class="fld-label" data-hi="जन्म तिथि">Date of Birth</label><input type="date" id="f-date" lang="en-GB" class="input" style="height:38px;" /></div>
        <div><label for="f-time" class="fld-label"><span data-hi="जन्म समय">Time of Birth</span> <span style="font-size:10px;color:var(--color-mute);" data-hi="(वैकल्पिक, संधि दिनों में सहायक)">(optional, helps on cusp days)</span></label><input type="time" id="f-time" class="input" style="height:38px;" /></div>
        <div><label for="f-city" class="fld-label"><span data-hi="जन्म स्थान">Place of Birth</span> <span style="font-size:10px;color:var(--color-mute);" data-hi="(वैकल्पिक)">(optional)</span></label><select id="f-city" class="input" style="height:38px;min-width:140px;"></select></div>
        <button id="f-calc" class="btn-primary" data-hi="गणना करें" style="height:38px;padding:0 20px;">Calculate</button>
      </div>
      <p id="date-echo" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;" hidden></p>

      <div id="result" style="display:none;">
        <!-- Side-by-side sign cards -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;" class="two-col">
          <div class="card" id="card-w" style="padding:24px;text-align:center;"></div>
          <div class="card" id="card-v" style="padding:24px;text-align:center;border-top:3px solid var(--color-saffron-deep);"></div>
        </div>
        <!-- Difference note -->
        <div class="card" style="padding:20px;margin-bottom:24px;">
          <h3 data-hi="ये अलग क्यों हैं?" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 6px;">Why are they different?</h3>
          <p id="diff-note" style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0;"></p>
        </div>
        <!-- Vedic sign personality traits -->
        <div class="card" style="padding:24px;">
          <p class="caption-mono" data-hi="वैदिक सूर्य राशि — सौर स्वभाव" style="color:var(--color-saffron-deep);margin:0 0 4px;">VEDIC SUN SIGN — SOLAR PERSONALITY</p>
          <h3 id="trait-title" style="font-size:18px;font-weight:700;color:var(--color-ink);margin:0 0 10px;"></h3>
          <p id="trait-text" style="font-size:14px;color:var(--color-body-text);line-height:1.75;margin:0;"></p>
        </div>
      </div>
      <div id="err" style="display:none;padding:16px;background:var(--color-inauspicious-soft);border-radius:8px;color:#b91c1c;font-size:14px;"></div>

      <h3 style="font-size:14px;font-weight:600;color:var(--color-ink);margin:36px 0 14px;">All 12 Vedic Sun Signs</h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;margin-bottom:16px;">
        {RASHI_PROFILES.map((r, i) => (
          <div class="card" style="padding:16px;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
              <span style="color:var(--color-saffron-deep);flex-shrink:0;" set:html={rashiSvg(RASHI_ID_LIST[i], 22)} />
              <span style="font-size:14px;font-weight:700;color:var(--color-ink);">{r.name} &middot; {r.h}</span>
              <span style="font-size:11px;color:var(--color-mute);">({r.en})</span>
            </div>
            <p style="font-size:12px;color:var(--color-body-text);margin:0;line-height:1.6;">{SOLAR_TRAITS[i]}</p>
          </div>
        ))}
      </div>

      <div class="card" style="padding:28px;margin-top:36px;">
        <h2 data-hi="सूर्य राशि के बारे में" style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">About Sun Signs</h2>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 10px;"><span data-hi="पश्चिमी ज्योतिष ">Western astrology uses the </span><b><span data-hi="उष्णकटिबंधीय राशिचक्र (सायन)">tropical zodiac</span></b><span data-hi=", का उपयोग करता है जो ऋतुओं पर आधारित है (मेष हमेशा वसंत विषुव से आरंभ होता है)। वैदिक ज्योतिष ">, anchored to the seasons (Aries always begins at the spring equinox). Vedic astrology uses the </span><b><span data-hi="निरयण राशिचक्र (सिडेरियल)">sidereal zodiac</span></b><span data-hi=", का उपयोग करता है जो वास्तविक स्थिर तारों पर आधारित है। विषुवों की अयन-गति (precession) के कारण, ये दोनों हजारों वर्षों में लगभग 24° अलग हो गए हैं।">, anchored to the actual fixed stars. Due to the precession of the equinoxes, the two have drifted apart by roughly 24&deg; over millennia.</span></p>
        <p style="font-size:14px;color:var(--color-mute);line-height:1.7;margin:0;"><span data-hi="मार्च के अंत में जन्मे व्यक्ति की सायन राशि सामान्यतः मेष होगी, लेकिन निरयण राशि मीन होगी। दोनों प्रणालियां अपने-अपने संदर्भ बिंदु से आंतरिक रूप से सुसंगत हैं। ज्योतिष में, वैदिक सूर्य राशि आत्मा के मूल उद्देश्य को दर्शाती है, जबकि चंद्र राशि मन और दैनिक जीवन को नियंत्रित करती है।">A person born in late March will typically be a Western Aries but a Vedic Pisces. Both systems are internally consistent — they just measure from different reference points. In Jyotish, the Vedic Sun sign describes the soul's core purpose, while the Moon sign (Rashi) governs the mind and daily life.</span> This calculator's birth time and place fields are optional because they only matter on the one or two days each month when the Sun is crossing from one sign to the next — for any other birth date, the day alone fixes both Sun signs precisely.</p>
      </div>

      <CalculatorFaq items={FAQ_ITEMS} />
    </div>
  </section>
</Layout>

<style>
  .fld-label { font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em; }
  @media (max-width:640px){ .two-col{ grid-template-columns:1fr !important; } }
</style>

<script>
import { LOCATIONS } from '../../lib/locations';
import { RASHI_ICONS } from '../../lib/icons/rashi';
import { sunTrueLongitude as sunLon, lahiriAyanamsha as ayanamsha } from '../../lib/panchang';
import { SOLAR_TRAITS, SOLAR_TRAITS_HI } from '../../lib/jyotish';
let LANG_HI = localStorage.getItem('pp-lang') === 'hi';
function tr(en, hi) { return LANG_HI ? hi : en; }
const WD_EN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI=['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN=['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI=['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(y,m,d){const wd=new Date(Date.UTC(y,m-1,d,12)).getUTCDay();return tr(`${WD_EN[wd]}, ${d} ${MO_EN[m-1]} ${y}`,`${WD_HI[wd]}, ${d} ${MO_HI[m-1]} ${y}`);}
function rashiIconSvg(id,size){return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${RASHI_ICONS[id]}</svg>`;}
const LOCS=LOCATIONS.map(l=>({name:l.name,nameHi:l.nameHi,lat:l.lat,lng:l.lng,tz:l.tzOffset}));
function toJD(y,m,d,h){h=h||0;if(m<=2){y--;m+=12;}const A=Math.floor(y/100),B=2-A+Math.floor(A/4);return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;}
const n360=a=>((a%360)+360)%360;const toR=d=>d*Math.PI/180;

const W_SIGNS=[
{name:'Aries',h:'मेष',sym:'♈',from:[3,21],to:[4,19],el:'Fire',ruler:'Mars',quality:'Cardinal',comp:'Leo, Sagittarius, Gemini'},
{name:'Taurus',h:'वृषभ',sym:'♉',from:[4,20],to:[5,20],el:'Earth',ruler:'Venus',quality:'Fixed',comp:'Virgo, Capricorn, Cancer'},
{name:'Gemini',h:'मिथुन',sym:'♊',from:[5,21],to:[6,20],el:'Air',ruler:'Mercury',quality:'Mutable',comp:'Libra, Aquarius, Aries'},
{name:'Cancer',h:'कर्क',sym:'♋',from:[6,21],to:[7,22],el:'Water',ruler:'Moon',quality:'Cardinal',comp:'Scorpio, Pisces, Taurus'},
{name:'Leo',h:'सिंह',sym:'♌',from:[7,23],to:[8,22],el:'Fire',ruler:'Sun',quality:'Fixed',comp:'Aries, Sagittarius, Libra'},
{name:'Virgo',h:'कन्या',sym:'♍',from:[8,23],to:[9,22],el:'Earth',ruler:'Mercury',quality:'Mutable',comp:'Taurus, Capricorn, Cancer'},
{name:'Libra',h:'तुला',sym:'♎',from:[9,23],to:[10,22],el:'Air',ruler:'Venus',quality:'Cardinal',comp:'Gemini, Aquarius, Leo'},
{name:'Scorpio',h:'वृश्चिक',sym:'♏',from:[10,23],to:[11,21],el:'Water',ruler:'Mars',quality:'Fixed',comp:'Cancer, Pisces, Virgo'},
{name:'Sagittarius',h:'धनु',sym:'♐',from:[11,22],to:[12,21],el:'Fire',ruler:'Jupiter',quality:'Mutable',comp:'Aries, Leo, Aquarius'},
{name:'Capricorn',h:'मकर',sym:'♑',from:[12,22],to:[1,19],el:'Earth',ruler:'Saturn',quality:'Cardinal',comp:'Taurus, Virgo, Scorpio'},
{name:'Aquarius',h:'कुम्भ',sym:'♒',from:[1,20],to:[2,18],el:'Air',ruler:'Saturn',quality:'Fixed',comp:'Gemini, Libra, Sagittarius'},
{name:'Pisces',h:'मीन',sym:'♓',from:[2,19],to:[3,20],el:'Water',ruler:'Jupiter',quality:'Mutable',comp:'Cancer, Scorpio, Capricorn'}];

const RASHI=['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RASHI_HI=['मेष','वृषभ','मिथुन','कर्क','सिंह','कन्या','तुला','वृश्चिक','धनु','मकर','कुम्भ','मीन'];
function trRashi(i){return tr(RASHI[i],RASHI_HI[i]);}
const RASHI_ID=['mesha','vrishabha','mithuna','karka','simha','kanya','tula','vrishchika','dhanu','makara','kumbha','meena'];
const PLANET_HI={Sun:'सूर्य',Moon:'चंद्रमा',Mars:'मंगल',Mercury:'बुध',Jupiter:'गुरु',Venus:'शुक्र',Saturn:'शनि'};
const SIGN_NAME_HI={};W_SIGNS.forEach(s=>{SIGN_NAME_HI[s.name]=s.h;});
function trComp(comp){return comp.split(', ').map(n=>SIGN_NAME_HI[n]||n).join(', ');}

const sel=document.getElementById('f-city');
function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML='<option value="0">'+(LANG_HI?'कोई नहीं (केवल तिथि उपयोग करें)':'None (use date only)')+'</option>'+LOCS.map((l,i)=>`<option value="${i+1}">${LANG_HI?(l.nameHi||l.name):l.name}</option>`).join('');
  if(selected) sel.value=selected;
}
renderCityOptions();
document.getElementById('f-date').value=new Date().toISOString().split('T')[0];
document.getElementById('f-time').value='12:00';

function westernSign(m,d){
  for(let i=0;i<12;i++){const s=W_SIGNS[i];const[fm,fd]=s.from;const[tm,td]=s.to;
    if(fm<=tm){if((m===fm&&d>=fd)||(m===tm&&d<=td)||(m>fm&&m<tm))return i;}
    else{if((m===fm&&d>=fd)||(m===tm&&d<=td)||m>fm||m<tm)return i;}}
  return 0;
}
function fmtRange(s){const M=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];return M[s.from[0]-1]+' '+s.from[1]+' – '+M[s.to[0]-1]+' '+s.to[1];}
const EL_HI={Fire:'अग्नि',Earth:'पृथ्वी',Air:'वायु',Water:'जल'};
const QUAL_HI={Cardinal:'चर',Fixed:'स्थिर',Mutable:'द्विस्वभाव'};
function signCard(s,id,label,subname,showTraits){
  return `<p class="caption-mono" style="color:var(--color-saffron-deep);margin:0 0 8px;">${label}</p>
    <div style="margin-bottom:6px;display:flex;justify-content:center;">${rashiIconSvg(id,52)}</div>
    <h2 style="font-size:24px;font-weight:700;color:var(--color-ink);margin:0 0 2px;">${s.name}</h2>
    <p style="font-size:13px;color:var(--color-mute);margin:0 0 14px;">${subname}</p>
    <div style="display:flex;flex-direction:column;gap:7px;text-align:left;max-width:240px;margin:0 auto;">
      ${[[tr('Dates','तिथियां'),fmtRange(s)],[tr('Element','तत्व'),tr(s.el,EL_HI[s.el])],[tr('Quality','गुण'),tr(s.quality,QUAL_HI[s.quality])],[tr('Ruler','स्वामी'),tr(s.ruler,PLANET_HI[s.ruler])],[tr('Compatible','अनुकूल'),tr(s.comp,trComp(s.comp))]].map(r=>`<div style="display:flex;justify-content:space-between;gap:8px;font-size:12.5px;"><span style="color:var(--color-mute);">${r[0]}</span><span style="color:var(--color-ink);font-weight:600;text-align:right;">${r[1]}</span></div>`).join('')}
    </div>`;
}

function calculate(){
  try{
    const dateStr=document.getElementById('f-date').value;
    const timeStr=document.getElementById('f-time').value||'12:00';
    const cityVal=parseInt(document.getElementById('f-city').value)||0;
    const loc=cityVal>0?LOCS[cityVal-1]:null;
    const tz=loc?loc.tz:0;
    const[y,m,d]=dateStr.split('-').map(Number);
    const[hh,mm]=timeStr.split(':').map(Number);
    const de=document.getElementById('date-echo');
    if(de){de.textContent=tr('Date of birth: ','जन्म तिथि: ')+formatLongDate(y,m,d);de.hidden=false;}
    const wIdx=westernSign(m,d);
    const jd=toJD(y,m,d,(hh+mm/60)-tz);
    const vIdx=Math.floor(n360(sunLon(jd)-ayanamsha(jd))/30);

    document.getElementById('card-w').innerHTML=signCard(W_SIGNS[wIdx],RASHI_ID[wIdx],tr('WESTERN (TROPICAL)','पश्चिमी (सायन)'),W_SIGNS[wIdx].h);
    document.getElementById('card-v').innerHTML=signCard(W_SIGNS[vIdx],RASHI_ID[vIdx],tr('VEDIC (SIDEREAL)','वैदिक (निरयण)'),RASHI[vIdx]+' \xb7 '+W_SIGNS[vIdx].h);

    document.getElementById('diff-note').textContent=vIdx===wIdx
      ?tr('Your Western and Vedic Sun signs are both '+W_SIGNS[wIdx].name+'. This happens when the Sun is far enough into the sign that the ~24\xb0 ayanamsha shift does not push it into the previous sign.','आपकी पश्चिमी और वैदिक दोनों सूर्य राशियां '+W_SIGNS[wIdx].name+' हैं। ऐसा तब होता है जब सूर्य राशि में इतना आगे होता है कि ~24° अयनांश शिफ्ट उसे पिछली राशि में नहीं धकेलता।')
      :tr('Your Western Sun sign is '+W_SIGNS[wIdx].name+', but your Vedic Sun sign is '+RASHI[vIdx]+' ('+W_SIGNS[vIdx].name+'). The difference comes from the ayanamsha — the ~24\xb0 precession gap between the tropical and sidereal zodiacs.','आपकी पश्चिमी सूर्य राशि '+W_SIGNS[wIdx].name+' है, लेकिन आपकी वैदिक सूर्य राशि '+trRashi(vIdx)+' ('+W_SIGNS[vIdx].name+') है। यह अंतर अयनांश के कारण है — सायन और निरयण राशिचक्रों के बीच लगभग 24° का अयन-गति अंतर।');

    document.getElementById('trait-title').textContent=trRashi(vIdx)+' ('+W_SIGNS[vIdx].name+') '+tr('Sun','सूर्य');
    document.getElementById('trait-text').textContent=tr(SOLAR_TRAITS[vIdx],SOLAR_TRAITS_HI[vIdx]);

    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){const er=document.getElementById('err');er.style.display='block';er.textContent='Calculation error: '+e.message;}
}
document.getElementById('f-calc').addEventListener('click',calculate);
calculate();

function applyPageLang(hindi) {
  LANG_HI = hindi;
  renderCityOptions();
  document.querySelectorAll('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? el.dataset.hi : el.dataset.en;
  });
  calculate();
}
document.addEventListener('langchange', (e) => {
  applyPageLang(e.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
