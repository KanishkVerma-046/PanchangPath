---
import Layout from '../../layouts/Layout.astro';
import CalculatorFaq from '../../components/CalculatorFaq.astro';
import { sharedCalcFaq } from '../../lib/calculatorFaq';
import { NAKSHATRAS } from '../../lib/jyotish';
import { NAKSHATRA_LIST, nakshatraIconSvg } from '../../lib/icons/nakshatra';

const FAQ_ITEMS = [
  ...sharedCalcFaq(),
  {
    q: "Why does my Pada matter, and does this tool give the actual naming syllable?",
    a: "Yes — the calculator lists all four padas of your Nakshatra with their traditional naming syllables, highlighting the one that's yours. This is a naming convention, not a rule: many families follow it strictly, others treat it as one input among several.",
  },
  {
    q: 'What\'s the difference between Nakshatra and Rashi (Moon sign)?',
    a: 'Both come from the same Moon position, just sliced differently. Rashi divides the zodiac into 12 signs of 30° each; Nakshatra divides it into 27 lunar mansions of 13°20′ each. Because the two grids don\'t line up evenly, a single Nakshatra can span parts of two different Rashis. See the <a href="/jyotish/rashi">Rashi calculator</a> for that separate 30°-based reading.',
    html: true,
  },
  {
    q: 'Why do Gana and Nadi matter beyond my personal profile?',
    a: 'They\'re two of the eight Ashtakoota factors used in Kundali matching for marriage compatibility (see the <a href="/jyotish/horoscope-match">Horoscope Match calculator</a>). A shared Nadi between two charts is considered the most significant compatibility concern in that system — traditionally advised against regardless of how the other seven factors score.',
    html: true,
  },
];
---

<Layout title="Nakshatra Calculator — Find Your Birth Star — PanchangPath" description="Find your Janma Nakshatra (birth star) and pada from birth details. Includes lord, gana, nadi, yoni, deity, symbol and name syllables.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">नक्षत्र · NAKSHATRA CALCULATOR</p>
      <h1 data-hi="नक्षत्र (जन्म तारा) कैलकुलेटर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Nakshatra (Birth Star) Calculator</h1>
      <p data-hi="27 नक्षत्र वैदिक ज्योतिष के चंद्र भवन हैं। आपका जन्म नक्षत्र वह स्थान है जहां जन्म के समय चंद्रमा स्थित था — यह आपके व्यक्तित्व, नामकरण और मुहूर्त के लिए केंद्रीय महत्व रखता है।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:500px;">The 27 nakshatras are the lunar mansions of Vedic astrology. Your Janma Nakshatra is where the Moon sat at birth — central to your personality, naming and muhurta.</p>
    </div>
  </section>

  <section style="padding:28px 0 56px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div><label for="f-date" class="fld-label" data-hi="जन्म तिथि">Date of Birth</label><input type="date" id="f-date" lang="en-GB" class="input" style="height:38px;" /></div>
        <div><label for="f-time" class="fld-label" data-hi="जन्म समय">Time of Birth</label><input type="time" id="f-time" class="input" style="height:38px;" /></div>
        <div><label for="f-city" class="fld-label" data-hi="स्थान">Place</label><select id="f-city" class="input" style="height:38px;min-width:150px;"></select></div>
        <button id="f-calc" class="btn-primary" data-hi="गणना करें" style="height:38px;padding:0 20px;">Calculate</button>
      </div>
      <p id="date-echo" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;" hidden></p>

      <div id="result" style="display:none;margin-bottom:36px;">
        <div class="card" style="padding:28px;margin-bottom:24px;background:linear-gradient(135deg,var(--color-canvas) 60%,var(--color-saffron-soft));">
          <div style="display:flex;align-items:center;gap:16px;">
            <div id="n-icon" style="color:var(--color-saffron-deep);flex-shrink:0;"></div>
            <div>
              <p class="caption-mono" data-hi="आपका जन्म तारा" style="color:var(--color-saffron-deep);margin:0 0 4px;">YOUR BIRTH STAR</p>
              <h2 id="n-name" style="font-size:28px;font-weight:700;color:var(--color-ink);margin:0 0 4px;"></h2>
              <p id="n-meta" style="font-size:14px;color:var(--color-mute);margin:0 0 8px;"></p>
              <div id="n-badges" style="display:flex;gap:8px;flex-wrap:wrap;"></div>
            </div>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;" class="two-col">
          <div class="card" style="padding:20px;">
            <h3 data-hi="विशेषताएं" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Attributes</h3>
            <div id="attr-list" style="display:flex;flex-direction:column;gap:9px;"></div>
          </div>
          <div class="card" style="padding:20px;">
            <h3 data-hi="चार पद" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">The Four Padas</h3>
            <div id="pada-list" style="display:flex;flex-direction:column;gap:8px;"></div>
            <p data-hi="परंपरागत रूप से, शिशु का नाम उस पद के अक्षर से शुरू होता है जिसमें चंद्रमा स्थित होता है।" style="font-size:14px;color:var(--color-mute);margin:12px 0 0;line-height:1.5;">Traditionally, a baby's name begins with the syllable of the pada in which the Moon falls.</p>
          </div>
        </div>
        <!-- Personality traits panel -->
        <div class="card" style="padding:24px;">
          <p class="caption-mono" data-hi="नक्षत्र व्यक्तित्व विशेषताएं" style="color:var(--color-saffron-deep);margin:0 0 4px;">NAKSHATRA PERSONALITY TRAITS</p>
          <h3 id="trait-title" style="font-size:17px;font-weight:700;color:var(--color-ink);margin:0 0 10px;"></h3>
          <p id="trait-text" style="font-size:14px;color:var(--color-body-text);line-height:1.75;margin:0;"></p>
        </div>
      </div>
      <div id="err" style="display:none;padding:16px;background:var(--color-inauspicious-soft);border-radius:8px;color:#b91c1c;font-size:14px;margin-bottom:24px;"></div>

      <h3 data-hi="सभी 27 नक्षत्र" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">All 27 Nakshatras</h3>
      <div id="all-naks" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:36px;">
        {NAKSHATRAS.map((nk, i) => (
          <div class="card" style="padding:12px;">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px;">
              <div style="display:flex;align-items:center;gap:6px;">
                <span style="color:var(--color-saffron-deep);flex-shrink:0;" set:html={nakshatraIconSvg(NAKSHATRA_LIST[i].id, 16)} />
                <span style="font-size:13px;font-weight:600;color:var(--color-ink);">{nk.n}</span>
              </div>
              <span style="font-size:10px;color:var(--color-mute);font-family:var(--font-mono);">{i + 1}</span>
            </div>
            <p style="font-size:11px;color:var(--color-mute);margin:0;">{nk.h} · {nk.lord}</p>
            <p style="font-size:10.5px;color:var(--color-body-text);margin:4px 0 0;">{nk.gana} · {nk.yoni}</p>
          </div>
        ))}
      </div>

      <div class="card" style="padding:28px;">
        <h2 data-hi="नक्षत्रों के बारे में" style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">About Nakshatras</h2>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 14px;">The 27 nakshatras divide the Moon's path into equal 13°20′ segments — the same span the Moon covers in about one day, which is why "nakshatra" is often translated as "lunar mansion." Each nakshatra further splits into 4 padas of 3°20′, traditionally used for naming: a child's first name syllable is drawn from the pada the Moon occupied at birth, and this calculator lists the exact syllable for each of the four padas alongside your own.</p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 14px;">Beyond naming, every nakshatra carries a ruling planet — the basis for the Vimshottari Dasha system used to time life events — plus a deity, a yoni (animal nature), a gana (temperament: Deva, Manushya or Rakshasa), and a nadi (constitutional type). Nadi and Gana are two of the eight Ashtakoota factors checked in Kundali matching for marriage compatibility, which is why your Janma Nakshatra carries weight well beyond a horoscope column.</p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0;">This calculator finds your Nakshatra and Pada by computing the Moon's sidereal longitude for your birth date, time and place — using the same astronomy-engine-based <code>moonLongitude()</code> and Lahiri ayanamsha the rest of the site shares — then dividing that longitude by 13°20′ to locate the nakshatra, and by 3°20′ within it to locate the pada.</p>
      </div>

      <CalculatorFaq items={FAQ_ITEMS} />
    </div>
  </section>
</Layout>

<style>
  .fld-label { font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em; }
  @media (max-width:640px){ .two-col{ grid-template-columns:1fr !important; } }
</style>

<style is:global>
  /* #attr-list content is injected client-side via innerHTML, so it never receives
     Astro's scoped-style data-astro-cid attribute — these rules must stay global. */
  #attr-list .dl-row { display:flex;justify-content:space-between;gap:10px;font-size:13px; }
  #attr-list .dl-row span:first-child { color:var(--color-mute); }
  #attr-list .dl-row span:last-child { color:var(--color-ink);font-weight:600;text-align:right; }
</style>

<script>
import { LOCATIONS } from '../../lib/locations';
import { NAKSHATRA_LIST, nakshatraIconSvg as nakIconSvg } from '../../lib/icons/nakshatra';
import { moonLongitude as moonLon, lahiriAyanamsha as ayanamsha } from '../../lib/panchang';
import { NAKSHATRAS, NAKSHATRA_TRAITS_HI } from '../../lib/jyotish';
let LANG_HI = localStorage.getItem('pp-lang') === 'hi';
function tr(en, hi) { return LANG_HI ? hi : en; }
const WD_EN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI=['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN=['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI=['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(y,m,d){const wd=new Date(Date.UTC(y,m-1,d,12)).getUTCDay();return tr(`${WD_EN[wd]}, ${d} ${MO_EN[m-1]} ${y}`,`${WD_HI[wd]}, ${d} ${MO_HI[m-1]} ${y}`);}
const YONI_HI={Horse:'घोड़ा',Elephant:'हाथी',Sheep:'भेड़',Serpent:'सर्प',Dog:'कुत्ता',Cat:'बिल्ली',Rat:'चूहा',Cow:'गाय',Buffalo:'भैंस',Tiger:'बाघ',Monkey:'बंदर',Mongoose:'नेवला',Lion:'सिंह',Deer:'हिरण'};
const PLANET_HI={Sun:'सूर्य',Moon:'चंद्रमा',Mars:'मंगल',Mercury:'बुध',Jupiter:'गुरु',Venus:'शुक्र',Saturn:'शनि',Rahu:'राहु',Ketu:'केतु'};
const GANA_HI={Deva:'देव',Manushya:'मनुष्य',Rakshasa:'राक्षस'};
const NADI_HI={Adi:'आदि',Madhya:'मध्य',Antya:'अंत्य'};
const VARNA_HI={Brahmin:'ब्राह्मण',Kshatriya:'क्षत्रिय',Vaishya:'वैश्य',Shudra:'शूद्र',Mleccha:'म्लेच्छ'};
const NAKS_ID=NAKSHATRA_LIST.map(l=>l.id);
const LOCS=LOCATIONS.map(l=>({name:l.name,nameHi:l.nameHi,lat:l.lat,lng:l.lng,tz:l.tzOffset}));
function toJD(y,m,d,h){h=h||0;if(m<=2){y--;m+=12;}const A=Math.floor(y/100),B=2-A+Math.floor(A/4);return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;}
const n360=a=>((a%360)+360)%360;
const toR=d=>d*Math.PI/180;

const NAKS=NAKSHATRAS.map((nk,i)=>({...nk,sym:nk.symbol}));
const sel=document.getElementById('f-city');function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(LANG_HI?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();
document.getElementById('f-date').value=new Date().toISOString().split('T')[0];
document.getElementById('f-time').value='12:00';

function calculate(){
  try{
    const dateStr=document.getElementById('f-date').value;
    const timeStr=document.getElementById('f-time').value||'12:00';
    const loc=LOCS.find(l=>l.name===document.getElementById('f-city').value)||LOCS[0];
    const [y,m,d]=dateStr.split('-').map(Number);const [hh,mm]=timeStr.split(':').map(Number);
    const de=document.getElementById('date-echo');
    if(de){de.textContent=tr('Date of birth: ','जन्म तिथि: ')+formatLongDate(y,m,d);de.hidden=false;}
    const jd=toJD(y,m,d,(hh+mm/60)-loc.tz);
    const ay=ayanamsha(jd);
    const sid=n360(moonLon(jd)-ay);
    const idx=Math.floor(sid/(360/27));const pada=Math.floor((sid%(360/27))/((360/27)/4))+1;
    const nk=NAKS[idx];
    document.getElementById('n-icon').innerHTML=nakIconSvg(NAKS_ID[idx],44);
    document.getElementById('n-name').textContent=nk.n+' \xb7 '+nk.h;
    document.getElementById('n-meta').textContent=tr('Pada','पद')+' '+pada+' \xb7 '+tr('Ruled by','स्वामी')+' '+tr(nk.lord,PLANET_HI[nk.lord])+' \xb7 '+tr('Deity','देवता')+': '+nk.deity;
    document.getElementById('trait-title').textContent=nk.n+' — '+tr('Personality Profile','व्यक्तित्व प्रोफाइल');
    document.getElementById('trait-text').textContent=tr(nk.traits,NAKSHATRA_TRAITS_HI[idx]);
    document.getElementById('n-badges').innerHTML=
      `<span class="badge badge-saffron">${tr(nk.gana,GANA_HI[nk.gana])} ${tr('Gana','गण')}</span><span class="badge">${tr(nk.nadi,NADI_HI[nk.nadi])} ${tr('Nadi','नाड़ी')}</span><span class="badge">${tr(nk.yoni,YONI_HI[nk.yoni]||nk.yoni)} ${tr('Yoni','योनि')}</span><span class="badge">${tr('Syllable','अक्षर')}: ${nk.p[pada-1]}</span>`;
    document.getElementById('attr-list').innerHTML=[
      [tr('Nakshatra','नक्षत्र'),`${nk.n} (#${idx+1})`],[tr('Pada','पद'),String(pada)],[tr('Lord','स्वामी'),tr(nk.lord,PLANET_HI[nk.lord])],[tr('Deity','देवता'),nk.deity],
      [tr('Symbol','प्रतीक'),nk.sym],[tr('Yoni (Animal)','योनि (पशु)'),tr(nk.yoni,YONI_HI[nk.yoni]||nk.yoni)],[tr('Gana','गण'),tr(nk.gana,GANA_HI[nk.gana])],[tr('Nadi','नाड़ी'),tr(nk.nadi,NADI_HI[nk.nadi])],[tr('Varna','वर्ण'),tr(nk.varna,VARNA_HI[nk.varna])],[tr('Ayanamsha','अयनांश'),`${ay.toFixed(3)}° ${tr('Lahiri','लाहिड़ी')}`]
    ].map(r=>`<div class="dl-row"><span>${r[0]}</span><span>${r[1]}</span></div>`).join('');
    document.getElementById('pada-list').innerHTML=nk.p.map((s,i)=>
      `<div style="display:flex;align-items:center;gap:10px;padding:7px 10px;border-radius:7px;background:${i===pada-1?'var(--color-saffron-soft)':'var(--color-canvas-soft-2)'};">
        <span style="font-size:11px;font-weight:600;color:var(--color-mute);font-family:var(--font-mono);">${tr('Pada','पद')} ${i+1}</span>
        <span style="font-size:15px;font-weight:700;color:${i===pada-1?'var(--color-saffron-deep)':'var(--color-ink)'};">${s}</span>
        ${i===pada-1?'<span class="badge badge-saffron" style="margin-left:auto;">'+tr('Your pada','आपका पद')+'</span>':''}
      </div>`).join('');
    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){const er=document.getElementById('err');er.style.display='block';er.textContent='Calculation error: '+e.message;}
}
function renderAllNaks(){
  document.getElementById('all-naks').innerHTML=NAKS.map((nk,i)=>
    `<div class="card" style="padding:12px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px;">
        <div style="display:flex;align-items:center;gap:6px;">
          <span style="color:var(--color-saffron-deep);flex-shrink:0;">${nakIconSvg(NAKS_ID[i],16)}</span>
          <span style="font-size:13px;font-weight:600;color:var(--color-ink);">${nk.n}</span>
        </div>
        <span style="font-size:10px;color:var(--color-mute);font-family:var(--font-mono);">${i+1}</span>
      </div>
      <p style="font-size:11px;color:var(--color-mute);margin:0;">${nk.h} · ${tr(nk.lord,PLANET_HI[nk.lord])}</p>
      <p style="font-size:10.5px;color:var(--color-body-text);margin:4px 0 0;">${tr(nk.gana,GANA_HI[nk.gana])} · ${tr(nk.yoni,YONI_HI[nk.yoni]||nk.yoni)}</p>
    </div>`).join('');
}
renderAllNaks();
document.getElementById('f-calc').addEventListener('click',calculate);
calculate();

function applyPageLang(hindi) {
  LANG_HI = hindi;
  renderCityOptions();
  document.querySelectorAll('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? el.dataset.hi : el.dataset.en;
  });
  calculate();
  renderAllNaks();
}
document.addEventListener('langchange', (e) => {
  applyPageLang(e.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
