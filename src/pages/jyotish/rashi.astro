---
import Layout from '../../layouts/Layout.astro';
import CalculatorFaq from '../../components/CalculatorFaq.astro';
import { sharedCalcFaq } from '../../lib/calculatorFaq';
import { RASHI_PROFILES } from '../../lib/jyotish';
import { RASHI_ICONS } from '../../lib/icons/rashi';

const RASHI_ID_LIST = ['mesha', 'vrishabha', 'mithuna', 'karka', 'simha', 'kanya', 'tula', 'vrishchika', 'dhanu', 'makara', 'kumbha', 'meena'];
function rashiSvg(id: string, size: number): string {
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${RASHI_ICONS[id]}</svg>`;
}

// Hindi for the "All 12 Rashis" reference grid's short vocab fields with no per-row Hi field.
const LORD_HI: Record<string, string> = {
  Sun: 'सूर्य', Moon: 'चंद्र', Mars: 'मंगल', Mercury: 'बुध', Jupiter: 'गुरु', Venus: 'शुक्र', Saturn: 'शनि',
};
const ELEM_HI: Record<string, string> = { Fire: 'अग्नि', Earth: 'पृथ्वी', Air: 'वायु', Water: 'जल' };
const QUAL_HI: Record<string, string> = { Movable: 'चर', Fixed: 'स्थिर', Dual: 'द्विस्वभाव' };
const DAY_HI: Record<string, string> = {
  Sunday: 'रविवार', Monday: 'सोमवार', Tuesday: 'मंगलवार', Wednesday: 'बुधवार',
  Thursday: 'गुरुवार', Friday: 'शुक्रवार', Saturday: 'शनिवार',
};

const FAQ_ITEMS = [
  ...sharedCalcFaq(),
  {
    q: 'How is my Rashi different from my Lagna (Ascendant)?',
    qHi: 'मेरी राशि मेरे लग्न (उदय राशि) से कैसे अलग है?',
    a: 'They come from different points in the chart. Rashi is the Moon\'s sign at birth — your emotional and mental nature, used for daily Rashifal. Lagna is the sign rising on the eastern horizon at birth — your physical body and outward personality, and the basis for all 12 houses. See the <a href="/jyotish/lagna">Lagna calculator</a> for that separate calculation.',
    aHi: 'ये कुंडली के अलग-अलग बिंदुओं से आते हैं। राशि जन्म के समय चंद्रमा की राशि है — आपका भावनात्मक और मानसिक स्वभाव, जो दैनिक राशिफल के लिए उपयोग होता है। लग्न जन्म के समय पूर्वी क्षितिज पर उदय हो रही राशि है — आपका भौतिक शरीर और बाहरी व्यक्तित्व, और सभी 12 भावों का आधार। उस अलग गणना के लिए <a href="/jyotish/lagna">लग्न कैलकुलेटर</a> देखें।',
    html: true,
  },
  {
    q: 'Is this the same as my "zodiac sign" from Western horoscopes?',
    qHi: 'क्या यह पाश्चात्य कुंडली से मेरी "राशि चिह्न" के समान है?',
    a: 'No. Western astrology uses the tropical zodiac, anchored to the seasons; Vedic astrology uses the sidereal zodiac, anchored to the actual background stars. Precession has opened a gap of roughly 24° between the two over the centuries — enough that most people\'s Vedic Rashi is one sign "earlier" than their familiar Western sun sign.',
    aHi: 'नहीं। पाश्चात्य ज्योतिष उष्णकटिबंधीय राशिचक्र का उपयोग करता है, जो ऋतुओं पर आधारित है; वैदिक ज्योतिष सिडेरियल राशिचक्र का उपयोग करता है, जो वास्तविक पृष्ठभूमि तारों पर आधारित है। सदियों में अयनगति (प्रीसेशन) ने दोनों के बीच लगभग 24° का अंतर खोल दिया है — इतना कि अधिकांश लोगों की वैदिक राशि उनकी परिचित पाश्चात्य सूर्य राशि से एक राशि "पहले" होती है।',
  },
  {
    q: 'Why does the calculator ask for my birth place?',
    qHi: 'कैलकुलेटर मेरा जन्म स्थान क्यों पूछता है?',
    a: "Mainly to convert your local birth time into the correct universal time for the calculation. This calculator's Moon-longitude computation (<code>moonLongitude()</code> in <code>astro-core.ts</code>, the same function used sitewide for Rashi, Nakshatra, and Panchang) is geocentric — it doesn't apply a location-specific (topocentric/parallax) correction, a real effect that can shift the Moon's apparent position by up to roughly a degree near the horizon. That's a characteristic of how this site currently computes the Moon everywhere, not a claim that location is astronomically irrelevant to the Moon's position in general. In practice, your city selection here matters for getting the time zone right; it's your Lagna, not your Rashi, that's genuinely location-sensitive.",
    aHi: 'मुख्य रूप से आपके स्थानीय जन्म समय को गणना के लिए सही सार्वभौमिक समय में बदलने के लिए। इस कैलकुलेटर की चंद्र-रेखांश गणना (<code>astro-core.ts</code> में <code>moonLongitude()</code>, वही फ़ंक्शन जो साइट भर में राशि, नक्षत्र, और पंचांग के लिए उपयोग होता है) भूकेंद्रिक है — यह स्थान-विशिष्ट (टोपोसेंट्रिक/लंबन) सुधार लागू नहीं करती, जो एक वास्तविक प्रभाव है और क्षितिज के पास चंद्रमा की स्पष्ट स्थिति को लगभग एक डिग्री तक बदल सकता है। यह इस बात की विशेषता है कि यह साइट वर्तमान में चंद्रमा की गणना हर जगह कैसे करती है, यह दावा नहीं कि स्थान सामान्यतः चंद्रमा की स्थिति के लिए खगोलीय दृष्टि से अप्रासंगिक है। व्यवहार में, यहां आपका शहर चयन समय क्षेत्र सही करने के लिए मायने रखता है; आपका लग्न, न कि आपकी राशि, वास्तव में स्थान-संवेदनशील है।',
    html: true,
  },
  {
    q: 'What\'s the difference between Rashi and Nakshatra?',
    qHi: 'राशि और नक्षत्र में क्या अंतर है?',
    a: 'Both come from the same Moon position, just sliced differently. Rashi divides the zodiac into 12 signs of 30° each; Nakshatra divides it into 27 lunar mansions of 13°20′ each. Because the two grids don\'t line up evenly, a single Rashi can span parts of two or more Nakshatras. See the <a href="/jyotish/nakshatra">Nakshatra calculator</a> for that separate 13°20′-based reading, including your Pada and naming syllable.',
    aHi: 'दोनों एक ही चंद्र स्थिति से आते हैं, बस अलग-अलग तरीके से विभाजित। राशि राशिचक्र को 12 राशियों में विभाजित करती है, प्रत्येक 30°; नक्षत्र इसे 27 चंद्र मंडलों में विभाजित करता है, प्रत्येक 13°20′। चूंकि दोनों ग्रिड समान रूप से मेल नहीं खाते, एक ही राशि दो या अधिक नक्षत्रों के हिस्सों में फैल सकती है। उस अलग 13°20′-आधारित रीडिंग के लिए, जिसमें आपका पद और नामकरण अक्षर शामिल है, <a href="/jyotish/nakshatra">नक्षत्र कैलकुलेटर</a> देखें।',
    html: true,
  },
];
---

<Layout title="Rashi Calculator — Find Your Moon Sign — PanchangPath" description="Find your Vedic Moon sign (Rashi) from your birth date, time and place. Includes nakshatra, pada, ruling planet and rashi characteristics.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">राशि · RASHI CALCULATOR</p>
      <h1 data-hi="राशि (चंद्र राशि) कैलकुलेटर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Rashi (Moon Sign) Calculator</h1>
      <p data-hi="आपकी राशि वह राशिचक्र चिह्न है जिसमें आपके जन्म के समय चंद्रमा स्थित था। यह वैदिक ज्योतिष की सबसे महत्वपूर्ण राशि है — दैनिक राशिफल और मुहूर्त के लिए उपयोग की जाती है।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:500px;">Your Rashi is the zodiac sign occupied by the Moon at your birth. It is the most important sign in Vedic astrology — used for daily Rashifal and muhurta.</p>
    </div>
  </section>

  <section style="padding:28px 0 56px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div><label for="f-date" class="fld-label" data-hi="जन्म तिथि">Date of Birth</label><input type="date" id="f-date" lang="en-GB" class="input" style="height:38px;" /></div>
        <div><label for="f-time" class="fld-label" data-hi="जन्म समय">Time of Birth</label><input type="time" id="f-time" class="input" style="height:38px;" /></div>
        <div><label for="f-city" class="fld-label" data-hi="स्थान">Place</label><select id="f-city" class="input" style="height:38px;min-width:150px;"></select></div>
        <button id="f-calc" class="btn-primary" data-hi="गणना करें" style="height:38px;padding:0 20px;">Calculate</button>
      </div>
      <p id="date-echo" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;" hidden></p>

      <div id="result" style="display:none;">
        <div class="card" style="padding:28px;text-align:center;margin-bottom:24px;background:linear-gradient(135deg,var(--color-canvas) 60%,var(--color-saffron-soft));">
          <div id="r-sym" style="display:flex;justify-content:center;margin-bottom:8px;"></div>
          <h2 id="r-name" style="font-size:26px;font-weight:700;color:var(--color-ink);margin:0 0 4px;"></h2>
          <p id="r-en" style="font-size:14px;color:var(--color-mute);margin:0 0 14px;"></p>
          <div id="r-badges" style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;"></div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;" class="two-col">
          <div class="card" style="padding:20px;">
            <h3 data-hi="राशि विवरण" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Rashi Details</h3>
            <div id="detail-list" style="display:flex;flex-direction:column;gap:9px;"></div>
          </div>
          <div class="card" style="padding:20px;">
            <h3 data-hi="विशेषताएं" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Characteristics</h3>
            <p id="r-desc" style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0;"></p>
          </div>
        </div>
        <!-- Lucky Attributes -->
        <div class="card" style="padding:20px;">
          <h3 data-hi="शुभ विशेषताएं" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Lucky Attributes</h3>
          <div id="lucky-list" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;"></div>
        </div>
      </div>
      <div id="err" style="display:none;padding:16px;background:var(--color-inauspicious-soft);border-radius:8px;color:#b91c1c;font-size:14px;"></div>

      <h3 data-hi="सभी 12 राशियां" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:36px 0 14px;">All 12 Rashis</h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin-bottom:16px;">
        {RASHI_PROFILES.map((r, i) => (
          <div class="card" style="padding:14px;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
              <span style="color:var(--color-saffron-deep);flex-shrink:0;" set:html={rashiSvg(RASHI_ID_LIST[i], 20)} />
              <div>
                <span style="font-size:13px;font-weight:600;color:var(--color-ink);">{r.name} &middot; {r.h}</span>
                <span style="font-size:10.5px;color:var(--color-mute);display:block;"><span data-hi={ELEM_HI[r.elem] ?? r.elem}>{r.elem}</span> &middot; <span data-hi={QUAL_HI[r.qual] ?? r.qual}>{r.qual}</span></span>
              </div>
            </div>
            <p style="font-size:11.5px;color:var(--color-body-text);margin:0 0 6px;line-height:1.5;" data-hi={r.descHi}>{r.desc}</p>
            <p style="font-size:10.5px;color:var(--color-mute);margin:0;"><span data-hi="स्वामी">Lord</span>: <span data-hi={LORD_HI[r.lord] ?? r.lord}>{r.lord}</span> &middot; <span data-hi="रत्न">Gem</span>: <span data-hi={r.gemHi}>{r.gem}</span> &middot; <span data-hi="दिन">Day</span>: <span data-hi={DAY_HI[r.day] ?? r.day}>{r.day}</span></p>
          </div>
        ))}
      </div>

      <div class="card" style="padding:28px;margin-top:36px;">
        <h2 data-hi="राशि के बारे में" style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">About Rashi</h2>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 14px;">Your Rashi — also called Chandra Rashi or Janma Rashi — is the zodiac sign the Moon occupied at the moment of your birth, and it's the single most-used placement in everyday Vedic astrology: it's the sign Rashifal predictions, Muhurta timing, and gemstone recommendations are built around, distinct from the Sun-based sign most Western horoscopes use.</p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 14px;">Because the Moon completes a full 360° circuit of the sidereal zodiac in about 27.3 days, it moves through each 30°-wide Rashi in roughly 2.25 days on average — noticeably faster than the Sun, which takes about a month per sign. That speed is exactly why an accurate birth time matters more here than for a Sun-based reading: if your birth falls within a day or so of the Moon crossing into the next sign, only the precise time settles which Rashi is genuinely yours.</p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0;">This calculator computes the Moon's sidereal longitude for your birth date, time and place using the site's shared astronomy-engine-based <code>moonLongitude()</code> function, subtracts the Lahiri ayanamsha, and reads off the Rashi, its ruling planet, element, quality, and your Moon's exact Nakshatra Pada — the same math used everywhere else Rashi appears on this site.</p>
      </div>

      <CalculatorFaq items={FAQ_ITEMS} />
    </div>
  </section>
</Layout>

<style>
  .fld-label { font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em; }
  @media (max-width:640px){ .two-col{ grid-template-columns:1fr !important; } }
</style>

<style is:global>
  /* #detail-list content is injected client-side via innerHTML, so it never receives
     Astro's scoped-style data-astro-cid attribute — these rules must stay global. */
  #detail-list .dl-row { display:flex;justify-content:space-between;gap:10px;font-size:13px; }
  #detail-list .dl-row span:first-child { color:var(--color-mute); }
  #detail-list .dl-row span:last-child { color:var(--color-ink);font-weight:600;text-align:right; }
</style>

<script>
import { LOCATIONS } from '../../lib/locations';
import { RASHI_ICONS } from '../../lib/icons/rashi';
import { moonLongitude as moonLon, lahiriAyanamsha as ayanamsha } from '../../lib/panchang';
import { RASHI_PROFILES } from '../../lib/jyotish';
let LANG_HI = localStorage.getItem('pp-lang') === 'hi';
function tr(en, hi) { return LANG_HI ? hi : en; }
const WD_EN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI=['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN=['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI=['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(y,m,d){const wd=new Date(Date.UTC(y,m-1,d,12)).getUTCDay();return tr(`${WD_EN[wd]}, ${d} ${MO_EN[m-1]} ${y}`,`${WD_HI[wd]}, ${d} ${MO_HI[m-1]} ${y}`);}
const LOCS=LOCATIONS.map(l=>({name:l.name,nameHi:l.nameHi,lat:l.lat,lng:l.lng,tz:l.tzOffset}));
function toJD(y,m,d,h){h=h||0;if(m<=2){y--;m+=12;}const A=Math.floor(y/100),B=2-A+Math.floor(A/4);return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;}
const n360=a=>((a%360)+360)%360;
const toR=d=>d*Math.PI/180;

const RASHI=['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RASHI_EN=['Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius','Capricorn','Aquarius','Pisces'];
const RASHI_HI=['मेष','वृषभ','मिथुन','कर्क','सिंह','कन्या','तुला','वृश्चिक','धनु','मकर','कुम्भ','मीन'];
const RASHI_ID=['mesha','vrishabha','mithuna','karka','simha','kanya','tula','vrishchika','dhanu','makara','kumbha','meena'];
function rashiIconSvg(id,size){return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${RASHI_ICONS[id]}</svg>`;}
// Promoted 2026-08-26 (Jyotish Tier-1 prerender pass): these used to be this page's own literal
// arrays, now derived from the single RASHI_PROFILES export (../../lib/jyotish) that also feeds
// rashi.astro's frontmatter "All 12 Rashis" reference grid, so the two render paths can't diverge.
const LORD=RASHI_PROFILES.map(r=>r.lord);
const ELEM=RASHI_PROFILES.map(r=>r.elem);
const QUAL=RASHI_PROFILES.map(r=>r.qual);
const NAKS=['Ashwini','Bharani','Krittika','Rohini','Mrigashira','Ardra','Punarvasu','Pushya','Ashlesha','Magha','Purva Phalguni','Uttara Phalguni','Hasta','Chitra','Swati','Vishakha','Anuradha','Jyeshtha','Mula','Purva Ashadha','Uttara Ashadha','Shravana','Dhanishtha','Shatabhisha','Purva Bhadrapada','Uttara Bhadrapada','Revati'];
const NAKS_HI=['अश्विनी','भरणी','कृत्तिका','रोहिणी','मृगशिरा','आर्द्रा','पुनर्वसु','पुष्य','आश्लेषा','मघा','पूर्व फाल्गुनी','उत्तर फाल्गुनी','हस्त','चित्रा','स्वाति','विशाखा','अनुराधा','ज्येष्ठा','मूल','पूर्वाषाढ़ा','उत्तराषाढ़ा','श्रावण','धनिष्ठा','शतभिषा','पूर्व भाद्रपदा','उत्तर भाद्रपदा','रेवती'];
const COLOR=RASHI_PROFILES.map(r=>r.color);
const DAY=RASHI_PROFILES.map(r=>r.day);
const GEM=RASHI_PROFILES.map(r=>r.gem);
const COMPAT=RASHI_PROFILES.map(r=>r.compat);
const NUM=RASHI_PROFILES.map(r=>r.num);
const DESC=RASHI_PROFILES.map(r=>r.desc);
const DESC_HI=RASHI_PROFILES.map(r=>r.descHi);
const EL_HI={Fire:'अग्नि',Earth:'पृथ्वी',Air:'वायु',Water:'जल'};
const QUAL_HI={Movable:'चर',Fixed:'स्थिर',Dual:'द्विस्वभाव'};
const DAY_HI={Sunday:'रविवार',Monday:'सोमवार',Tuesday:'मंगलवार',Wednesday:'बुधवार',Thursday:'गुरुवार',Friday:'शुक्रवार',Saturday:'शनिवार'};
const COLOR_HI=RASHI_PROFILES.map(r=>r.colorHi);
const GEM_HI=RASHI_PROFILES.map(r=>r.gemHi);
const PLANET_HI={Sun:'सूर्य',Moon:'चंद्रमा',Mars:'मंगल',Mercury:'बुध',Jupiter:'गुरु',Venus:'शुक्र',Saturn:'शनि'};
const SIGN_EN_TO_HI={};RASHI_EN.forEach((n,i)=>{SIGN_EN_TO_HI[n]=RASHI_HI[i];});
function trCompat(list){return list.split(', ').map(n=>SIGN_EN_TO_HI[n]||n).join(', ');}

const sel=document.getElementById('f-city');function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(LANG_HI?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();
document.getElementById('f-date').value=new Date().toISOString().split('T')[0];
document.getElementById('f-time').value='12:00';

function calculate(){
  try{
    const dateStr=document.getElementById('f-date').value;
    const timeStr=document.getElementById('f-time').value||'12:00';
    const loc=LOCS.find(l=>l.name===document.getElementById('f-city').value)||LOCS[0];
    const [y,m,d]=dateStr.split('-').map(Number);const [hh,mm]=timeStr.split(':').map(Number);
    const de=document.getElementById('date-echo');
    if(de){de.textContent=tr('Date of birth: ','जन्म तिथि: ')+formatLongDate(y,m,d);de.hidden=false;}
    const jd=toJD(y,m,d,(hh+mm/60)-loc.tz);
    const ay=ayanamsha(jd);
    const sid=n360(moonLon(jd)-ay);
    const idx=Math.floor(sid/30);
    const nakIdx=Math.floor(sid/(360/27));const pada=Math.floor((sid%(360/27))/((360/27)/4))+1;
    const deg=sid%30;

    document.getElementById('r-sym').innerHTML=rashiIconSvg(RASHI_ID[idx],56);
    document.getElementById('r-name').textContent=`${RASHI[idx]} · ${RASHI_HI[idx]}`;
    document.getElementById('r-en').textContent=RASHI_EN[idx];
    document.getElementById('r-badges').innerHTML=
      `<span class="badge badge-saffron">${tr(ELEM[idx],EL_HI[ELEM[idx]])}</span><span class="badge">${tr(QUAL[idx],QUAL_HI[QUAL[idx]])}</span><span class="badge">${tr('Lord','स्वामी')}: ${tr(LORD[idx],PLANET_HI[LORD[idx]])}</span>`;
    document.getElementById('detail-list').innerHTML=[
      [tr('Rashi','राशि'),`${tr(RASHI[idx],RASHI_HI[idx])} (${RASHI_EN[idx]})`],
      [tr('Ruling Planet','स्वामी ग्रह'),tr(LORD[idx],PLANET_HI[LORD[idx]])],
      [tr('Element','तत्व'),tr(ELEM[idx],EL_HI[ELEM[idx]])],
      [tr('Quality','गुण'),tr(QUAL[idx],QUAL_HI[QUAL[idx]])],
      [tr('Moon Degree','चंद्र अंश'),`${Math.floor(deg)}° ${String(Math.floor((deg%1)*60)).padStart(2,'0')}'`],
      [tr('Nakshatra','नक्षत्र'),tr(NAKS[nakIdx],NAKS_HI[nakIdx])],
      [tr('Pada','पद'),String(pada)],
      [tr('Ayanamsha','अयनांश'),`${ay.toFixed(3)}° ${tr('Lahiri','लाहिड़ी')}`],
    ].map(r=>`<div class="dl-row"><span>${r[0]}</span><span>${r[1]}</span></div>`).join('');
    document.getElementById('r-desc').textContent=tr(DESC[idx],DESC_HI[idx]);
    document.getElementById('lucky-list').innerHTML=[
      [tr('Lucky Color','शुभ रंग'),tr(COLOR[idx],COLOR_HI[idx]),'🎨'],
      [tr('Lucky Day','शुभ दिन'),tr(DAY[idx],DAY_HI[DAY[idx]]),'📅'],
      [tr('Lucky Gemstone','शुभ रत्न'),tr(GEM[idx],GEM_HI[idx]),'💎'],
      [tr('Lucky Number','शुभ अंक'),NUM[idx],'🔢'],
      [tr('Compatible Rashis','अनुकूल राशियां'),tr(COMPAT[idx],trCompat(COMPAT[idx])),'❤️'],
      [tr('Ruling Planet','स्वामी ग्रह'),tr(LORD[idx],PLANET_HI[LORD[idx]]),'🪐'],
    ].map(r=>`<div style="padding:12px 14px;background:var(--color-canvas-soft);border-radius:8px;"><p style="font-size:10px;color:var(--color-mute);margin:0 0 3px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.05em;">${r[0]}</p><p style="font-size:13.5px;font-weight:600;color:var(--color-ink);margin:0;">${r[2]} ${r[1]}</p></div>`).join('');
    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){const er=document.getElementById('err');er.style.display='block';er.textContent='Calculation error: '+e.message;}
}
document.getElementById('f-calc').addEventListener('click',calculate);
calculate();

function applyPageLang(hindi) {
  LANG_HI = hindi;
  renderCityOptions();
  document.querySelectorAll('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? el.dataset.hi : el.dataset.en;
  });
  calculate();
}
document.addEventListener('langchange', (e) => {
  applyPageLang(e.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
