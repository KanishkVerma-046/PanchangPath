---
import Layout from '../../layouts/Layout.astro';
import { PLANET_ICONS } from '../../lib/icons/planets';
---

<Layout title="Janma Kundali — Detailed Natal Chart Report — PanchangPath" description="Generate a detailed Janma Kundali report with ascendant, sidereal planetary positions, house lords, dignity analysis, yoga detection and Vimshottari Dasha. Lahiri ayanamsha.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">जन्म कुंडली · NATAL CHART REPORT</p>
      <h1 data-hi="जन्म कुंडली" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Janma Kundali</h1>
      <p data-hi="एक संपूर्ण जन्म कुंडली रिपोर्ट — लग्न, नाक्षत्र ग्रह स्थिति, भाव स्वामी, ग्रह बल, प्रमुख योग और जन्म के समय आपकी विंशोत्तरी दशा शेष।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:520px;">A complete natal chart report — Lagna, sidereal planetary positions, house lords, dignity, key yogas and your Vimshottari Dasha balance at birth.</p>
    </div>
  </section>

  <section style="padding:28px 0 56px;">
    <div class="container">

      <!-- Form -->
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:28px;">
        <div><label for="f-name" class="fld-label" data-hi="नाम (वैकल्पिक)">Name (optional)</label><input type="text" id="f-name" class="input" placeholder="Your name" style="height:38px;min-width:150px;" /></div>
        <div><label for="f-date" class="fld-label" data-hi="जन्म तिथि">Date of Birth</label><input type="date" id="f-date" lang="en-GB" class="input" style="height:38px;" /></div>
        <div><label for="f-time" class="fld-label" data-hi="जन्म समय">Time of Birth</label><input type="time" id="f-time" class="input" style="height:38px;" /></div>
        <div><label for="f-city" class="fld-label" data-hi="जन्म स्थान">Place of Birth</label><select id="f-city" class="input" style="height:38px;min-width:150px;"></select></div>
        <button id="f-calc" class="btn-primary" data-hi="रिपोर्ट बनाएं" style="height:38px;padding:0 20px;">Generate Report</button>
      </div>
      <p id="date-echo" style="font-size:12px;color:var(--color-mute);margin:-24px 0 20px;" hidden></p>

      <div id="result" style="display:none;">

        <!-- Row 1: Chart + Birth Summary -->
        <div style="display:grid;grid-template-columns:300px 1fr;gap:24px;margin-bottom:24px;" class="r1">
          <div class="card" style="padding:20px;">
            <h2 id="chart-title" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 3px;">Lagna Chart</h2>
            <p id="chart-sub" style="font-size:11px;color:var(--color-mute);margin:0 0 12px;font-family:var(--font-mono);"></p>
            <div id="chart-box"></div>
          </div>
          <div>
            <div class="card" style="padding:20px;height:100%;box-sizing:border-box;">
              <h3 data-hi="जन्म सारांश" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Birth Summary</h3>
              <div id="summary-list" style="display:grid;grid-template-columns:1fr 1fr;gap:10px 20px;"></div>
            </div>
          </div>
        </div>

        <!-- Row 2: Planetary Positions (full) -->
        <div class="card" style="padding:20px;overflow-x:auto;margin-bottom:24px;">
          <h3 data-hi="ग्रह स्फुट — ग्रह स्थिति" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Graha Sphuta — Planetary Positions</h3>
          <table style="width:100%;border-collapse:collapse;font-size:13px;min-width:640px;" id="planet-table"></table>
        </div>

        <!-- Row 3: House Lords -->
        <div class="card" style="padding:20px;overflow-x:auto;margin-bottom:24px;">
          <h3 data-hi="भाव स्वामी — भाव विश्लेषण" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Bhava Lords — House Analysis</h3>
          <table style="width:100%;border-collapse:collapse;font-size:13px;min-width:560px;" id="house-table"></table>
        </div>

        <!-- Row 4: Yogas + Dasha side by side -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px;" class="r4">
          <div class="card" style="padding:20px;">
            <h3 data-hi="योग विचार — प्रमुख ग्रह योग" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Yoga Vichar — Key Planetary Yogas</h3>
            <div id="yoga-list" style="display:flex;flex-direction:column;gap:10px;"></div>
          </div>
          <div class="card" style="padding:20px;">
            <h3 data-hi="विंशोत्तरी दशा" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">Vimshottari Dasha</h3>
            <p data-hi="जन्म से शुरू होने वाला 120-वर्षीय ग्रह अवधि चक्र" style="font-size:12px;color:var(--color-mute);margin:0 0 12px;">120-year planetary period cycle from birth</p>
            <div id="dasha-balance" style="margin-bottom:12px;"></div>
            <table style="width:100%;border-collapse:collapse;font-size:12.5px;" id="dasha-table"></table>
          </div>
        </div>

      </div><!-- /result -->

      <div id="err" style="display:none;padding:16px;background:var(--color-inauspicious-soft);border-radius:8px;color:#b91c1c;font-size:14px;"></div>

      <!-- About -->
      <div class="card" style="padding:28px;margin-top:36px;">
        <h2 data-hi="अपनी जन्म कुंडली को समझना" style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Understanding Your Janma Kundali</h2>
        <p data-hi="जन्म कुंडली आपके जन्म के क्षण आकाश का पूर्ण मानचित्र है। हर ग्रह का नाक्षत्र देशांतर (लाहिड़ी अयनांश लगाने के बाद) उसे 12 राशियों में से एक और 12 भावों में से एक में रखता है, जो आपका कर्म-खाका प्रकट करता है।" style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 10px;">The Janma Kundali is the complete map of the sky at your birth moment. Every planet's sidereal longitude (after applying the Lahiri ayanamsha) places it in one of 12 rashis (signs) and 12 bhavas (houses), revealing your karmic blueprint.</p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 10px;"><b data-hi="भाव स्वामी:">House Lords:</b> <span data-hi="प्रत्येक भाव का स्वामी उस राशि का स्वामी होता है जो वहां पड़ती है। स्वामी की अपनी स्थिति यह तय करती है कि उस भाव के विषय फलें-फूलें या चुनौतियों का सामना करें।">Each house is owned by the sign lord of the rashi that falls there. The lord's own placement determines whether the house's themes flourish or face challenges.</span></p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 10px;"><b data-hi="ग्रह बल:">Planetary Dignity:</b> <span data-hi="अपनी राशि या उच्च राशि में स्थित ग्रह पूर्ण बल से कार्य करता है; नीच राशि में उसे सचेत प्रयास की आवश्यकता हो सकती है। नीच भंग (नीचता का निवारण) उसकी ऊर्जा को पुनः स्थापित कर सकता है।">A planet in its own sign or exaltation functions at full strength; in debilitation it may need conscious cultivation. Neecha Bhanga (cancellation of debilitation) can restore its energy.</span></p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0;"><b data-hi="विंशोत्तरी दशा:">Vimshottari Dasha:</b> <span data-hi="जन्म के समय चंद्र नक्षत्र से सक्रिय होने वाली 120-वर्षीय ग्रह अवधि प्रणाली। जन्म दशा के शेष वर्ष, फिर पूरा क्रम, यहां दिखाया गया है। व्यक्तिगत विश्लेषण हेतु किसी योग्य ज्योतिषी से परामर्श लें।">The 120-year planetary period system activated by the Moon's nakshatra at birth. The remaining years of the birth dasha, then the full sequence, are shown. Consult a qualified Jyotishi for a personalised reading.</span></p>
      </div>

    </div>
  </section>
</Layout>

<style>
  .fld-label { font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em; }
  #planet-table th,#house-table th,#dasha-table th { text-align:left;padding:6px 8px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.04em; }
  #planet-table td,#house-table td,#dasha-table td { padding:7px 8px;border-bottom:1px solid var(--color-hairline);color:var(--color-body-text); }
  .dignity-exalt { color:#15803d;font-weight:700; }
  .dignity-own { color:#0369a1;font-weight:600; }
  .dignity-debil { color:#dc2626;font-weight:600; }
  .dasha-active { background:var(--color-auspicious-soft); }
  @media(max-width:820px){ .r1,.r4 { grid-template-columns:1fr !important; } }
</style>

<script>
import { LOCATIONS } from '../../lib/locations';
import { PLANET_ICONS } from '../../lib/icons/planets';
import { allTropicalLons } from '../../lib/kundali';
import { calcLagna } from '../../lib/astro-core';

function planetIconSvg(id,size){return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:4px;">${PLANET_ICONS[id]}</svg>`;}
let LANG_HI = localStorage.getItem('pp-lang') === 'hi';
function tr(en, hi) { return LANG_HI ? hi : en; }
const WD_EN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI=['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN=['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI=['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(y,m,d){const wd=new Date(Date.UTC(y,m-1,d,12)).getUTCDay();return tr(`${WD_EN[wd]}, ${d} ${MO_EN[m-1]} ${y}`,`${WD_HI[wd]}, ${d} ${MO_HI[m-1]} ${y}`);}
const LOCS=LOCATIONS.map(l=>({name:l.name,lat:l.lat,lng:l.lng,tz:l.tzOffset}));
function toJD(y,m,d,h){h=h||0;if(m<=2){y--;m+=12;}const A=Math.floor(y/100),B=2-A+Math.floor(A/4);return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;}
const n360=a=>((a%360)+360)%360;

const RASHI=['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RASHI_EN=['Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius','Capricorn','Aquarius','Pisces'];
const RASHI_LORD=['Mars','Venus','Mercury','Moon','Sun','Mercury','Venus','Mars','Jupiter','Saturn','Saturn','Jupiter'];
const NAKS=['Ashwini','Bharani','Krittika','Rohini','Mrigashira','Ardra','Punarvasu','Pushya','Ashlesha','Magha','Purva Phalguni','Uttara Phalguni','Hasta','Chitra','Swati','Vishakha','Anuradha','Jyeshtha','Mula','Purva Ashadha','Uttara Ashadha','Shravana','Dhanishtha','Shatabhisha','Purva Bhadrapada','Uttara Bhadrapada','Revati'];
const PLANETS=[['surya','Sun','Sy'],['chandra','Moon','Ch'],['mangal','Mars','Ma'],['budha','Mercury','Bu'],['guru','Jupiter','Gu'],['shukra','Venus','Sk'],['shani','Saturn','Sa'],['rahu','Rahu','Ra'],['ketu','Ketu','Ke']];
const PLANET_HI={Sun:'सूर्य',Moon:'चंद्रमा',Mars:'मंगल',Mercury:'बुध',Jupiter:'गुरु',Venus:'शुक्र',Saturn:'शनि',Rahu:'राहु',Ketu:'केतु'};

// Dignity data
const EXALT={surya:0,chandra:1,mangal:9,budha:5,guru:3,shukra:11,shani:6};
const DEBIL={surya:6,chandra:7,mangal:3,budha:11,guru:9,shukra:5,shani:0};
const OWN={surya:[4],chandra:[3],mangal:[0,7],budha:[2,5],guru:[8,11],shukra:[1,6],shani:[9,10]};
function dignity(k,sign){
  if(EXALT[k]===sign)return{label:tr('Exalted','उच्च'),cls:'dignity-exalt'};
  if(DEBIL[k]===sign)return{label:tr('Debilitated','नीच'),cls:'dignity-debil'};
  if(OWN[k]&&OWN[k].includes(sign))return{label:tr('Own Sign','स्वराशि'),cls:'dignity-own'};
  return{label:'',cls:''};
}

// House significations
const HOUSE_SIG=['Self, body, personality','Wealth, family, speech','Courage, siblings, communication','Home, mother, comforts','Children, intellect, creativity','Health, enemies, service','Marriage, partnerships, business','Longevity, transformation, hidden matters','Dharma, luck, higher learning','Career, status, father','Gains, social network, aspirations','Expenses, moksha, foreign travel'];
const HOUSE_SIG_HI=['स्वयं, शरीर, व्यक्तित्व','धन, परिवार, वाणी','साहस, भाई-बहन, संचार','घर, माता, सुख-सुविधा','संतान, बुद्धि, रचनात्मकता','स्वास्थ्य, शत्रु, सेवा','विवाह, साझेदारी, व्यापार','आयु, रूपांतरण, गुप्त विषय','धर्म, भाग्य, उच्च शिक्षा','करियर, प्रतिष्ठा, पिता','लाभ, सामाजिक जुड़ाव, आकांक्षाएं','व्यय, मोक्ष, विदेश यात्रा'];

// Vimshottari Dasha
const DASHA_ORDER=['Ketu','Venus','Sun','Moon','Mars','Rahu','Jupiter','Saturn','Mercury'];
const DASHA_YRS={Ketu:7,Venus:20,Sun:6,Moon:10,Mars:7,Rahu:18,Jupiter:16,Saturn:19,Mercury:17};
// nakshatra index → dasha lord (repeating 9-cycle over 27 nakshatras)
function nakDashaLord(nakIdx){return DASHA_ORDER[nakIdx%9];}
const MO_EN_SHORT=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const MO_HI_SHORT=['जन','फर','मार्च','अप्रैल','मई','जून','जुल','अग','सित','अक्टू','नव','दिस'];
function fmtDt(ms){const d=new Date(ms);return tr(`${MO_EN_SHORT[d.getMonth()]} ${d.getFullYear()}`,`${MO_HI_SHORT[d.getMonth()]} ${d.getFullYear()}`);}

function fmtDMS(lon){const d=lon%30;const deg=Math.floor(d);const mn=Math.floor((d-deg)*60);return deg+'\xb0'+String(mn).padStart(2,'0')+"'";}
function nakInfo(sid){const sz=360/27;const idx=Math.floor(sid/sz);const pada=Math.floor((sid%sz)/(sz/4))+1;return{name:NAKS[idx],idx,pada,frac:(sid%sz)/sz};}

// North Indian chart drawing
function drawNorthChart(signOfHouse,planetsByHouse){
  const S=280;
  const f=[[0.5,0.25],[0.25,0.12],[0.12,0.25],[0.25,0.5],[0.12,0.75],[0.25,0.88],[0.5,0.75],[0.75,0.88],[0.88,0.75],[0.75,0.5],[0.88,0.25],[0.75,0.12]];
  let lines=`<line x1="0" y1="0" x2="${S}" y2="${S}"/><line x1="${S}" y1="0" x2="0" y2="${S}"/><polygon points="${S/2},0 ${S},${S/2} ${S/2},${S} 0,${S/2}" fill="none"/>`;
  let txt='';
  for(let h=0;h<12;h++){
    const cx=f[h][0]*S,cy=f[h][1]*S;
    txt+=`<text x="${cx}" y="${cy-16}" text-anchor="middle" font-size="9" fill="var(--color-kundali-house)" stroke="none" font-family="var(--font-mono)">${signOfHouse[h]+1}</text>`;
    const pls=planetsByHouse[h]||[];
    pls.forEach((p,i)=>{const perRow=3;const col=i%perRow;const row=Math.floor(i/perRow);const px=cx+(col-(Math.min(pls.length,perRow)-1)/2)*20;const py=cy+row*13;txt+=`<text x="${px}" y="${py}" text-anchor="middle" font-size="10" font-weight="600" fill="${p==='La'?'var(--color-saffron-deep)':'var(--color-kundali-label)'}" stroke="none">${p}</text>`;});
  }
  return `<svg viewBox="-2 -2 ${S+4} ${S+4}" width="100%" style="max-width:280px;stroke:var(--color-kundali-grid);stroke-width:1;"><rect x="0" y="0" width="${S}" height="${S}" fill="var(--color-kundali-bg)"/>${lines}${txt}</svg>`;
}

// Setup
const sel=document.getElementById('f-city');
sel.innerHTML=LOCS.map(l=>`<option value="${l.name}">${l.name}</option>`).join('');
const today=new Date();
document.getElementById('f-date').value=today.toISOString().split('T')[0];
document.getElementById('f-time').value='12:00';

function calculate(){
  try{
    const dateStr=document.getElementById('f-date').value;
    const timeStr=document.getElementById('f-time').value||'12:00';
    const cityName=document.getElementById('f-city').value;
    const name=document.getElementById('f-name').value.trim();
    const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
    const[y,m,d]=dateStr.split('-').map(Number);
    const de=document.getElementById('date-echo');
    if(de){de.textContent=tr('Date of birth: ','जन्म तिथि: ')+formatLongDate(y,m,d);de.hidden=false;}
    const[hh,mm]=timeStr.split(':').map(Number);
    const jd=toJD(y,m,d,(hh+mm/60)-loc.tz);
    const L=allTropicalLons(jd),ay=L.ayanamsha;
    const Lp=allTropicalLons(jd+1);
    const sid={};PLANETS.forEach(([k])=>sid[k]=n360(L[k]-ay));
    const lagnaTrop=calcLagna(jd,loc.lat,loc.lng);
    const lagna=n360(lagnaTrop-ay);
    const lagnaSign=Math.floor(lagna/30);
    const lagnaLord=RASHI_LORD[lagnaSign];

    // House structures
    const signOfHouse=[],houseOfSign=[];
    for(let h=0;h<12;h++){signOfHouse[h]=(lagnaSign+h)%12;}
    for(let h=0;h<12;h++)houseOfSign[signOfHouse[h]]=h;
    const planetsByHouse={};for(let h=0;h<12;h++)planetsByHouse[h]=[];
    planetsByHouse[0].push('La');
    PLANETS.forEach(([k,,abbr])=>{const sign=Math.floor(sid[k]/30);planetsByHouse[((sign-lagnaSign)+12)%12].push(abbr);});

    // ── Chart ──
    document.getElementById('chart-box').innerHTML=drawNorthChart(signOfHouse,planetsByHouse);
    document.getElementById('chart-title').textContent=(name?name+"'s ":'')+tr('Lagna Chart (D-1)','लग्न चार्ट (डी-1)');
    document.getElementById('chart-sub').textContent=RASHI[lagnaSign]+' Lagna \xb7 '+dateStr+' '+timeStr+' \xb7 '+cityName;

    // ── Birth Summary ──
    const moonSign=Math.floor(sid.chandra/30),sunSign=Math.floor(sid.surya/30);
    const moonNak=nakInfo(sid.chandra);
    const sumItems=[
      [tr('Lagna (Ascendant)','लग्न (उदय राशि)'),RASHI[lagnaSign]+' ('+RASHI_EN[lagnaSign]+')'],
      [tr('Lagna Lord','लग्न स्वामी'),tr(lagnaLord,PLANET_HI[lagnaLord])],
      [tr('Lagna Degree','लग्न अंश'),fmtDMS(lagna)],
      [tr('Moon Rashi','चंद्र राशि'),RASHI[moonSign]+' ('+RASHI_EN[moonSign]+')'],
      [tr('Sun Rashi','सूर्य राशि'),RASHI[sunSign]+' ('+RASHI_EN[sunSign]+')'],
      [tr('Janma Nakshatra','जन्म नक्षत्र'),moonNak.name+' '+tr('pada','पद')+' '+moonNak.pada],
      [tr('Paksha','पक्ष'),sid.chandra>sid.surya&&sid.chandra-sid.surya<180?tr('Shukla (Waxing)','शुक्ल (बढ़ता चंद्रमा)'):tr('Krishna (Waning)','कृष्ण (घटता चंद्रमा)')],
      [tr('Ayanamsha','अयनांश'),ay.toFixed(3)+'\xb0 Lahiri'],
    ];
    document.getElementById('summary-list').innerHTML=sumItems.map(r=>
      `<div><p style="font-size:11px;color:var(--color-mute);margin:0 0 2px;font-family:var(--font-mono);">${r[0].toUpperCase()}</p><p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0;">${r[1]}</p></div>`
    ).join('');

    // ── Planetary Positions Table ──
    let pRows=`<tr><th>${tr('Graha','ग्रह')}</th><th>${tr('Rashi','राशि')}</th><th>${tr('Degree','अंश')}</th><th>${tr('House','भाव')}</th><th>${tr('Nakshatra','नक्षत्र')}</th><th>${tr('Pada','पद')}</th><th>${tr('Motion','गति')}</th><th>${tr('Dignity','बल')}</th></tr>`;
    PLANETS.forEach(([k,full])=>{
      const s=sid[k],sign=Math.floor(s/30);
      const house=((sign-lagnaSign)+12)%12;
      const nk=nakInfo(s);
      let motion=tr('Margi','मार्गी');
      if(k==='rahu'||k==='ketu')motion=tr('Vakri (always)','वक्री (सदैव)');
      else if(k!=='surya'&&k!=='chandra'){const c=n360(L[k]-ay),nx=n360(Lp[k]-Lp.ayanamsha);let df=nx-c;if(df>180)df-=360;if(df<-180)df+=360;motion=df<0?tr('Vakri','वक्री'):tr('Margi','मार्गी');}
      const dig=dignity(k,sign);
      pRows+=`<tr><td style="color:var(--color-ink);font-weight:600;">${planetIconSvg(k,14)}${tr(full,PLANET_HI[full])}</td><td>${RASHI[sign]}</td><td style="font-family:var(--font-mono);">${fmtDMS(s)}</td><td style="text-align:center;">${house+1}</td><td>${nk.name}</td><td>${nk.pada}</td><td style="color:${(motion.startsWith('Vakri')||motion.startsWith('वक्री'))?'#dc2626':'var(--color-body-text)'};">${motion}</td><td class="${dig.cls}">${dig.label}</td></tr>`;
    });
    document.getElementById('planet-table').innerHTML=pRows;

    // ── House Lords Table ──
    let hRows=`<tr><th>${tr('House','भाव')}</th><th>${tr('Rashi','राशि')}</th><th>${tr('Lord','स्वामी')}</th><th>${tr('Lord is in','स्वामी की स्थिति')}</th><th>${tr('Significance','महत्व')}</th></tr>`;
    for(let h=0;h<12;h++){
      const sign=signOfHouse[h];
      const lord=RASHI_LORD[sign];
      const lordKey={Sun:'surya',Moon:'chandra',Mars:'mangal',Mercury:'budha',Jupiter:'guru',Venus:'shukra',Saturn:'shani'}[lord];
      const lordSign=lordKey?Math.floor(sid[lordKey]/30):-1;
      const lordHouse=lordKey?((lordSign-lagnaSign+12)%12):-1;
      const lordPos=lordKey?'H'+(lordHouse+1)+' ('+RASHI[lordSign]+')':'—';
      hRows+=`<tr><td style="font-weight:600;color:var(--color-ink);">H${h+1}</td><td>${RASHI[sign]}</td><td>${tr(lord,PLANET_HI[lord])}</td><td>${lordPos}</td><td style="font-size:12px;color:var(--color-mute);">${tr(HOUSE_SIG[h],HOUSE_SIG_HI[h])}</td></tr>`;
    }
    document.getElementById('house-table').innerHTML=hRows;

    // ── Yoga Detection ──
    const yogas=[];
    // Gajakesari: Jupiter in 1,4,7,10 from Moon
    const guruSign=Math.floor(sid.guru/30),moonFromMoon=((guruSign-moonSign+12)%12);
    if([0,3,6,9].includes(moonFromMoon))yogas.push({name:tr('Gajakesari Yoga','गजकेसरी योग'),desc:tr('Jupiter in kendra from Moon — brings wisdom, reputation and prosperity.','चंद्रमा से केंद्र में गुरु — बुद्धि, प्रतिष्ठा और समृद्धि लाता है।'),badge:'auspicious'});
    // Budhaditya: Sun + Mercury same sign
    if(Math.floor(sid.surya/30)===Math.floor(sid.budha/30))yogas.push({name:tr('Budhaditya Yoga','बुधादित्य योग'),desc:tr('Sun and Mercury conjunct — enhances intellect, analytical skill and communication.','सूर्य और बुध की युति — बुद्धि, विश्लेषण क्षमता और संवाद कौशल बढ़ाती है।'),badge:'auspicious'});
    // Chandra-Mangal: Moon and Mars conjunct or 7th from each other
    const marsSign=Math.floor(sid.mangal/30),marsFromMoon=(marsSign-moonSign+12)%12;
    if(marsFromMoon===0||marsFromMoon===6)yogas.push({name:tr('Chandra-Mangal Yoga','चंद्र-मंगल योग'),desc:tr('Moon and Mars conjunct or in opposition — drives ambition, financial determination.','चंद्रमा और मंगल की युति या प्रतियुति — महत्वाकांक्षा और आर्थिक दृढ़ता को बढ़ाती है।'),badge:'auspicious'});
    // Pancha Mahapurusha Yogas
    const PM=[['guru','Hamsa','हंस','Jupiter in own (Dhanu/Meena) or exalted (Karka) and in kendra.','गुरु स्वराशि (धनु/मीन) या उच्च राशि (कर्क) में और केंद्र में हो।'],['shukra','Malavya','मालव्य','Venus in own (Vrishabha/Tula) or exalted (Meena) and in kendra.','शुक्र स्वराशि (वृषभ/तुला) या उच्च राशि (मीन) में और केंद्र में हो।'],['mangal','Ruchaka','रुचक','Mars in own (Mesha/Vrishchika) or exalted (Makara) and in kendra.','मंगल स्वराशि (मेष/वृश्चिक) या उच्च राशि (मकर) में और केंद्र में हो।'],['budha','Bhadra','भद्र','Mercury in own (Mithuna/Kanya) or exalted (Kanya) and in kendra.','बुध स्वराशि (मिथुन/कन्या) या उच्च राशि (कन्या) में और केंद्र में हो।'],['shani','Shasha','शश','Saturn in own (Makara/Kumbha) or exalted (Tula) and in kendra.','शनि स्वराशि (मकर/कुंभ) या उच्च राशि (तुला) में और केंद्र में हो।']];
    PM.forEach(([k,yname,ynameHi,desc,descHi])=>{
      const sg=Math.floor(sid[k]/30),ho=((sg-lagnaSign+12)%12);
      if((OWN[k]&&OWN[k].includes(sg)||EXALT[k]===sg)&&[0,3,6,9].includes(ho))yogas.push({name:tr(yname+' Yoga (Mahapurusha)',ynameHi+' योग (महापुरुष)'),desc:tr(desc,descHi),badge:'auspicious'});
    });
    // Raja Yoga: lord of 1 + lord of 5 or 9 conjunct
    const lordKey2=n=>{const s=signOfHouse[n];const lord=RASHI_LORD[s];return{Sun:'surya',Moon:'chandra',Mars:'mangal',Mercury:'budha',Jupiter:'guru',Venus:'shukra',Saturn:'shani'}[lord];};
    const l1k=lordKey2(0),l5k=lordKey2(4),l9k=lordKey2(8);
    if(l1k&&l5k&&l1k!==l5k&&Math.floor(sid[l1k]/30)===Math.floor(sid[l5k]/30))yogas.push({name:tr('Raja Yoga (1-5 Lords)','राज योग (1-5 भाव स्वामी)'),desc:tr('Lords of Lagna and 5th house conjunct — authority, creativity and prosperity.','लग्न और पंचम भाव के स्वामियों की युति — अधिकार, रचनात्मकता और समृद्धि।'),badge:'auspicious'});
    if(l1k&&l9k&&l1k!==l9k&&Math.floor(sid[l1k]/30)===Math.floor(sid[l9k]/30))yogas.push({name:tr('Raja Yoga (1-9 Lords)','राज योग (1-9 भाव स्वामी)'),desc:tr('Lords of Lagna and 9th house conjunct — excellent fortune, leadership and dharmic life.','लग्न और नवम भाव के स्वामियों की युति — उत्कृष्ट भाग्य, नेतृत्व और धर्ममय जीवन।'),badge:'auspicious'});
    // Kemadruma: Moon with no planets in adjacent houses
    const adjH=[(moonSign-lagnaSign+11)%12,(moonSign-lagnaSign+1)%12];
    const moonHouse=(moonSign-lagnaSign+12)%12;
    const hasNeighbour=PLANETS.some(([k])=>k!=='chandra'&&k!=='rahu'&&k!=='ketu'&&[adjH[0],adjH[1]].includes(((Math.floor(sid[k]/30)-lagnaSign)+12)%12));
    if(!hasNeighbour)yogas.push({name:tr('Kemadruma Yoga','केमद्रुम योग'),desc:tr('Moon without planets in adjacent houses — may cause emotional isolation; mitigated if Moon is in kendra.','आसन्न भावों में कोई ग्रह न होने से चंद्रमा अकेला — भावनात्मक अलगाव हो सकता है; चंद्रमा केंद्र में हो तो प्रभाव कम होता है।'),badge:'caution'});

    if(yogas.length===0)yogas.push({name:tr('No prominent yogas detected','कोई प्रमुख योग नहीं मिला'),desc:tr('The chart has a balanced, ordinary planetary configuration.','कुंडली में संतुलित, सामान्य ग्रह संरचना है।'),badge:''});
    document.getElementById('yoga-list').innerHTML=yogas.map(y=>
      `<div style="padding:10px 12px;border-radius:8px;background:${y.badge==='auspicious'?'var(--color-auspicious-soft)':y.badge==='caution'?'var(--color-inauspicious-soft)':'var(--color-canvas-soft)'};">
        <p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 3px;">${y.name}</p>
        <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.5;">${y.desc}</p>
      </div>`
    ).join('');

    // ── Vimshottari Dasha ──
    const moonNakFull=nakInfo(sid.chandra);
    const nakIdx=moonNakFull.idx;
    const dashaLord=nakDashaLord(nakIdx);
    const dashaYrs=DASHA_YRS[dashaLord];
    const consumed=moonNakFull.frac*dashaYrs;
    const remaining=dashaYrs-consumed;

    document.getElementById('dasha-balance').innerHTML=
      `<div style="padding:10px 14px;background:var(--color-canvas-soft);border-radius:8px;">
        <p style="font-size:11px;color:var(--color-mute);margin:0 0 3px;font-family:var(--font-mono);">${tr('BIRTH DASHA BALANCE','जन्म दशा शेष')}</p>
        <p style="font-size:15px;font-weight:700;color:var(--color-ink);margin:0;">${tr(dashaLord,PLANET_HI[dashaLord])} — ${remaining.toFixed(1)} ${tr('yrs remaining','वर्ष शेष')}</p>
        <p style="font-size:12px;color:var(--color-mute);margin:2px 0 0;">${tr('Janma Nakshatra','जन्म नक्षत्र')}: ${NAKS[nakIdx]} (${(moonNakFull.frac*100).toFixed(0)}% ${tr('elapsed in','व्यतीत,')} ${tr(dashaLord,PLANET_HI[dashaLord])} ${tr('dasha','दशा')})</p>
      </div>`;

    const msPerYr=365.25*24*3600*1000;
    const birthMs=Date.UTC(y,m-1,d,hh,mm)-loc.tz*3600000;
    const dashaStartMs=birthMs-consumed*msPerYr;
    const startIdx=DASHA_ORDER.indexOf(dashaLord);
    const now=Date.now();
    let t=dashaStartMs;
    let dRows=`<tr><th>${tr('Dasha Lord','दशा स्वामी')}</th><th>${tr('Years','वर्ष')}</th><th>${tr('From','से')}</th><th>${tr('To','तक')}</th></tr>`;
    for(let i=0;i<9;i++){
      const lord=DASHA_ORDER[(startIdx+i)%9];
      const yrs=DASHA_YRS[lord];
      const st=t,en=t+yrs*msPerYr;
      const isActive=now>=st&&now<en;
      const from=i===0?tr('Birth','जन्म'):fmtDt(st);
      dRows+=`<tr class="${isActive?'dasha-active':''}"><td style="font-weight:${isActive?700:400};color:${isActive?'var(--color-ink)':'var(--color-body-text)'};">${tr(lord,PLANET_HI[lord])}${isActive?' ◀':''}</td><td>${yrs}</td><td>${from}</td><td>${fmtDt(en)}</td></tr>`;
      t=en;
    }
    document.getElementById('dasha-table').innerHTML=dRows;

    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){
    const er=document.getElementById('err');er.style.display='block';er.textContent='Could not generate report: '+e.message;
    document.getElementById('result').style.display='none';
  }
}
document.getElementById('f-calc').addEventListener('click',calculate);
calculate();

function applyPageLang(hindi) {
  LANG_HI = hindi;
  document.querySelectorAll('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? el.dataset.hi : el.dataset.en;
  });
  calculate();
}
document.addEventListener('langchange', (e) => {
  applyPageLang(e.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
