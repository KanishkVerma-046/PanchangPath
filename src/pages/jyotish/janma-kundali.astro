---
import Layout from '../../layouts/Layout.astro';
import { PLANET_ICONS } from '../../lib/icons/planets';
import CalculatorFaq from '../../components/CalculatorFaq.astro';
import { sharedCalcFaq } from '../../lib/calculatorFaq';
import { computeJanmaKundaliData, janmaNorthChart, jdFull, SYNTHETIC_EXAMPLE_BIRTH, planetDignity, DASHA_ORDER, DASHA_YEARS, type YogaKey } from '../../lib/kundali';
import { LAGNA_HOUSES, LAGNA_HOUSES_HI, NAKSHATRAS } from '../../lib/jyotish';

// Illustrative-example prerender -- see kundali.ts's SYNTHETIC_EXAMPLE_BIRTH comment and
// jyotish/kundali.astro's identical pattern: a clearly-fictional sample birth, not "today" (which
// would read as a real stranger's live natal report) and not a real named person (which would
// make a permanent public claim about them). The client <script> pre-fills the same date/time/
// place and recalculates on load using this same computeJanmaKundaliData(), so prerendered and
// hydrated content start identical.
const EB = SYNTHETIC_EXAMPLE_BIRTH;
const ebDate = new Date(Date.UTC(EB.y, EB.m - 1, EB.d, EB.hh, EB.mm) - EB.tz * 3600000);
const ebJD = jdFull(ebDate);
const ebJK = computeJanmaKundaliData(ebJD, EB.lat, EB.lng);
const { chart: ebChart, houseLords: ebHouseLords, yogas: ebYogas, dashaLordKey: ebDashaLordKey, dashaYears: ebDashaYears, dashaFractionElapsed: ebDashaFrac } = ebJK;
const ebChartSvg = janmaNorthChart(ebChart.signOfHouse, ebChart.planetsByHouse);
const EB_DATE_STR = `${EB.y}-${String(EB.m).padStart(2, '0')}-${String(EB.d).padStart(2, '0')}`;
const EB_TIME_STR = `${String(EB.hh).padStart(2, '0')}:${String(EB.mm).padStart(2, '0')}`;

const EB_PLANET_EN: Record<string, string> = { surya: 'Sun', chandra: 'Moon', mangal: 'Mars', budha: 'Mercury', guru: 'Jupiter', shukra: 'Venus', shani: 'Saturn', rahu: 'Rahu', ketu: 'Ketu' };
const EB_PLANET_HI: Record<string, string> = { surya: 'सूर्य', chandra: 'चंद्र', mangal: 'मंगल', budha: 'बुध', guru: 'गुरु', shukra: 'शुक्र', shani: 'शनि', rahu: 'राहु', ketu: 'केतु' };
const EB_RASHI = ['Mesha', 'Vrishabha', 'Mithuna', 'Karka', 'Simha', 'Kanya', 'Tula', 'Vrishchika', 'Dhanu', 'Makara', 'Kumbha', 'Meena'];
const EB_RASHI_HI = ['मेष', 'वृषभ', 'मिथुन', 'कर्क', 'सिंह', 'कन्या', 'तुला', 'वृश्चिक', 'धनु', 'मकर', 'कुम्भ', 'मीन'];
const EB_RASHI_EN = ['Aries', 'Taurus', 'Gemini', 'Cancer', 'Leo', 'Virgo', 'Libra', 'Scorpio', 'Sagittarius', 'Capricorn', 'Aquarius', 'Pisces'];
const EB_RASHI_LORD = ['Mars', 'Venus', 'Mercury', 'Moon', 'Sun', 'Mercury', 'Venus', 'Mars', 'Jupiter', 'Saturn', 'Saturn', 'Jupiter'];
const EB_RASHI_LORD_HI: Record<string, string> = { Sun: 'सूर्य', Moon: 'चंद्र', Mars: 'मंगल', Mercury: 'बुध', Jupiter: 'गुरु', Venus: 'शुक्र', Saturn: 'शनि' };
const EB_DIGNITY_LABEL: Record<string, string> = { exalted: 'Exalted', debilitated: 'Debilitated', own: 'Own Sign', '': '' };
const EB_DIGNITY_LABEL_HI: Record<string, string> = { exalted: 'उच्च', debilitated: 'नीच', own: 'स्वराशि', '': '' };
const ebMoonNakName = NAKSHATRAS[ebChart.moonNak.idx].n;
const ebSunSid = ebChart.rows.find(r => r.key === 'surya')!.sidLon;
const ebMoonSid = ebChart.rows.find(r => r.key === 'chandra')!.sidLon;
const ebPaksha = ebMoonSid > ebSunSid && ebMoonSid - ebSunSid < 180 ? 'Shukla (Waxing)' : 'Krishna (Waning)';
const ebPakshaHi = ebMoonSid > ebSunSid && ebMoonSid - ebSunSid < 180 ? 'शुक्ल (बढ़ता चंद्र)' : 'कृष्ण (घटता चंद्र)';

const YOGA_COPY_EN: Record<YogaKey, { name: string; desc: string; badge: string }> = {
  gajakesari: { name: 'Gajakesari Yoga', desc: 'Jupiter in kendra from Moon — brings wisdom, reputation and prosperity.', badge: 'auspicious' },
  budhaditya: { name: 'Budhaditya Yoga', desc: 'Sun and Mercury conjunct — enhances intellect, analytical skill and communication.', badge: 'auspicious' },
  chandraMangal: { name: 'Chandra-Mangal Yoga', desc: 'Moon and Mars conjunct or in opposition — drives ambition, financial determination.', badge: 'auspicious' },
  mahapurusha_guru: { name: 'Hamsa Yoga (Mahapurusha)', desc: 'Jupiter in own (Dhanu/Meena) or exalted (Karka) and in kendra.', badge: 'auspicious' },
  mahapurusha_shukra: { name: 'Malavya Yoga (Mahapurusha)', desc: 'Venus in own (Vrishabha/Tula) or exalted (Meena) and in kendra.', badge: 'auspicious' },
  mahapurusha_mangal: { name: 'Ruchaka Yoga (Mahapurusha)', desc: 'Mars in own (Mesha/Vrishchika) or exalted (Makara) and in kendra.', badge: 'auspicious' },
  mahapurusha_budha: { name: 'Bhadra Yoga (Mahapurusha)', desc: 'Mercury in own (Mithuna/Kanya) or exalted (Kanya) and in kendra.', badge: 'auspicious' },
  mahapurusha_shani: { name: 'Shasha Yoga (Mahapurusha)', desc: 'Saturn in own (Makara/Kumbha) or exalted (Tula) and in kendra.', badge: 'auspicious' },
  rajaYoga15: { name: 'Raja Yoga (1-5 Lords)', desc: 'Lords of Lagna and 5th house conjunct — authority, creativity and prosperity.', badge: 'auspicious' },
  rajaYoga19: { name: 'Raja Yoga (1-9 Lords)', desc: 'Lords of Lagna and 9th house conjunct — excellent fortune, leadership and dharmic life.', badge: 'auspicious' },
  kemadruma: { name: 'Kemadruma Yoga', desc: 'Moon without planets in adjacent houses — may cause emotional isolation; mitigated if Moon is in kendra.', badge: 'caution' },
};
const YOGA_COPY_HI: Record<YogaKey, { name: string; desc: string }> = {
  gajakesari: { name: 'गजकेसरी योग', desc: 'चंद्रमा से केंद्र में गुरु — ज्ञान, प्रतिष्ठा और समृद्धि लाता है।' },
  budhaditya: { name: 'बुधादित्य योग', desc: 'सूर्य और बुध की युति — बुद्धि, विश्लेषणात्मक क्षमता और संवाद कौशल बढ़ाती है।' },
  chandraMangal: { name: 'चंद्र-मंगल योग', desc: 'चंद्रमा और मंगल की युति या प्रतियुति — महत्वाकांक्षा और आर्थिक दृढ़ता को बढ़ावा देती है।' },
  mahapurusha_guru: { name: 'हंस योग (महापुरुष)', desc: 'गुरु स्वराशि (धनु/मीन) या उच्च (कर्क) में और केंद्र में।' },
  mahapurusha_shukra: { name: 'मालव्य योग (महापुरुष)', desc: 'शुक्र स्वराशि (वृषभ/तुला) या उच्च (मीन) में और केंद्र में।' },
  mahapurusha_mangal: { name: 'रुचक योग (महापुरुष)', desc: 'मंगल स्वराशि (मेष/वृश्चिक) या उच्च (मकर) में और केंद्र में।' },
  mahapurusha_budha: { name: 'भद्र योग (महापुरुष)', desc: 'बुध स्वराशि (मिथुन/कन्या) या उच्च (कन्या) में और केंद्र में।' },
  mahapurusha_shani: { name: 'शश योग (महापुरुष)', desc: 'शनि स्वराशि (मकर/कुम्भ) या उच्च (तुला) में और केंद्र में।' },
  rajaYoga15: { name: 'राज योग (1-5 स्वामी)', desc: 'लग्न और पंचम भाव के स्वामियों की युति — अधिकार, रचनात्मकता और समृद्धि।' },
  rajaYoga19: { name: 'राज योग (1-9 स्वामी)', desc: 'लग्न और नवम भाव के स्वामियों की युति — उत्कृष्ट सौभाग्य, नेतृत्व और धर्ममय जीवन।' },
  kemadruma: { name: 'केमद्रुम योग', desc: 'चंद्रमा के निकटवर्ती भावों में कोई ग्रह न होना — भावनात्मक अलगाव का कारण बन सकता है; चंद्रमा केंद्र में हो तो प्रभाव कम हो जाता है।' },
};
const ebYogaDisplay = ebYogas.length ? ebYogas.map(k => ({ ...YOGA_COPY_EN[k], nameHi: YOGA_COPY_HI[k].name, descHi: YOGA_COPY_HI[k].desc })) : [{ name: 'No prominent yogas detected', nameHi: 'कोई प्रमुख योग नहीं मिला', desc: 'The chart has a balanced, ordinary planetary configuration.', descHi: 'कुंडली में एक संतुलित, सामान्य ग्रह विन्यास है।', badge: '' }];

const ebDashaLordEn = EB_PLANET_EN[ebDashaLordKey];
const ebConsumed = ebDashaFrac * ebDashaYears;
const ebRemaining = ebDashaYears - ebConsumed;
const EB_MS_PER_YR = 365.25 * 24 * 3600 * 1000;
const ebBirthMs = ebDate.getTime();
const ebDashaStartMs = ebBirthMs - ebConsumed * EB_MS_PER_YR;
const ebStartIdx = DASHA_ORDER.indexOf(ebDashaLordKey);
const EB_MO_SHORT = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function ebFmtDt(ms: number): string { const d = new Date(ms); return `${EB_MO_SHORT[d.getUTCMonth()]} ${d.getUTCFullYear()}`; }
let ebT = ebDashaStartMs;
const ebDashaRows = Array.from({ length: 9 }, (_, i) => {
  const lordKey = DASHA_ORDER[(ebStartIdx + i) % 9];
  const yrs = DASHA_YEARS[lordKey];
  const st = ebT, en = ebT + yrs * EB_MS_PER_YR;
  const from = i === 0 ? 'Birth' : ebFmtDt(st);
  const fromHi = i === 0 ? 'जन्म' : ebFmtDt(st);
  ebT = en;
  return { lord: EB_PLANET_EN[lordKey], lordHi: EB_PLANET_HI[lordKey], yrs, from, fromHi, to: ebFmtDt(en) };
});

const FAQ_ITEMS = [
  ...sharedCalcFaq(),
  {
    q: 'Which yogas does this report check for, and how are they detected?',
    qHi: 'यह रिपोर्ट किन योगों की जांच करती है, और उन्हें कैसे पहचाना जाता है?',
    a: "Nine checks run automatically: Gajakesari (Jupiter in a kendra — 1st, 4th, 7th or 10th — from the Moon), Budhaditya (Sun and Mercury in the same sign), Chandra-Mangal (Moon and Mars conjunct or opposite), the five Pancha Mahapurusha yogas (Ruchaka, Bhadra, Hamsa, Malavya, Shasha — each formed when Mars, Mercury, Jupiter, Venus or Saturn respectively sits in its own or exalted sign and in a kendra from the Lagna), two Raja Yoga variants (Lagna lord conjunct the 5th or 9th lord), and Kemadruma (Moon with no other planet in the houses immediately before or after it). Each uses the base classical definition; some traditions layer additional refinement conditions on top of a few of these — see the Gajakesari/Kemadruma note below for a specific example.",
    aHi: 'नौ जांच स्वचालित रूप से चलती हैं: गजकेसरी (चंद्रमा से केंद्र — पहला, चौथा, सातवां या दसवां — में गुरु), बुधादित्य (सूर्य और बुध एक ही राशि में), चंद्र-मंगल (चंद्रमा और मंगल की युति या प्रतियुति), पांच पंच महापुरुष योग (रुचक, भद्र, हंस, मालव्य, शश — प्रत्येक तब बनता है जब क्रमशः मंगल, बुध, गुरु, शुक्र या शनि अपनी स्वयं की या उच्च राशि में और लग्न से केंद्र में स्थित हो), दो राजयोग प्रकार (लग्न स्वामी की 5वें या 9वें स्वामी के साथ युति), और केमद्रुम (चंद्रमा जिसके ठीक पहले या बाद के भावों में कोई अन्य ग्रह न हो)। प्रत्येक मूल शास्त्रीय परिभाषा का उपयोग करता है; कुछ परंपराएं इनमें से कुछ पर अतिरिक्त परिष्करण शर्तें भी जोड़ती हैं — विशिष्ट उदाहरण के लिए नीचे गजकेसरी/केमद्रुम टिप्पणी देखें।',
  },
  {
    q: "I've seen Gajakesari or Kemadruma Yoga reported differently on another site — why?",
    qHi: 'मैंने किसी अन्य साइट पर गजकेसरी या केमद्रुम योग को अलग तरह से रिपोर्ट होते देखा है — ऐसा क्यों?',
    a: 'Sources genuinely disagree on the fine print for both. For Gajakesari, some sources add extra conditions beyond "Jupiter in a kendra from the Moon" — for instance, requiring the Moon itself not be in the 6th, 8th or 12th house, or not already caught in Kemadruma — before calling the yoga "fully formed." This report checks the core, most commonly cited condition only. For Kemadruma, sources disagree on whether the Sun counts as a "neighbour" that prevents the yoga: most sources include the Sun in that check (which is what this report does), but some — citing Brihat Parashara Hora Shastra — exclude the Sun specifically, reasoning that the Sun and Moon represent different enough principles (soul vs. mind) that the Sun\'s presence doesn\'t provide real companionship to the Moon. Neither reading is being treated as more authoritative here — it\'s a genuine, documented difference between sources.',
    aHi: 'स्रोत वास्तव में दोनों के बारीक विवरण पर असहमत हैं। गजकेसरी के लिए, कुछ स्रोत "चंद्रमा से केंद्र में गुरु" से आगे अतिरिक्त शर्तें जोड़ते हैं — उदाहरण के लिए, यह आवश्यक बताते हुए कि चंद्रमा स्वयं छठे, आठवें या बारहवें भाव में न हो, या पहले से ही केमद्रुम में न फंसा हो — इससे पहले कि योग को "पूर्ण रूप से निर्मित" कहा जाए। यह रिपोर्ट केवल मूल, सबसे अधिक उद्धृत शर्त की जांच करती है। केमद्रुम के लिए, स्रोत इस बात पर असहमत हैं कि क्या सूर्य को एक "पड़ोसी" माना जाए जो योग को रोकता है: अधिकांश स्रोत उस जांच में सूर्य को शामिल करते हैं (यही यह रिपोर्ट करती है), लेकिन कुछ — बृहत् पराशर होरा शास्त्र का हवाला देते हुए — विशेष रूप से सूर्य को बाहर रखते हैं, यह तर्क देते हुए कि सूर्य और चंद्रमा इतने अलग सिद्धांतों (आत्मा बनाम मन) का प्रतिनिधित्व करते हैं कि सूर्य की उपस्थिति चंद्रमा को वास्तविक साथ नहीं देती। यहां किसी भी पठन को अधिक आधिकारिक नहीं माना जा रहा है — यह स्रोतों के बीच एक वास्तविक, दस्तावेज़ीकृत अंतर है।',
  },
  {
    q: 'How is my Vimshottari Dasha balance calculated?',
    qHi: 'मेरी विंशोत्तरी दशा शेष की गणना कैसे की जाती है?',
    a: "From your Moon's exact position within its Janma Nakshatra at birth. Each of the 27 nakshatras is ruled by one of 9 planets in a fixed repeating order, and each planet's Dasha (planetary period) has a fixed length in the 120-year cycle. The fraction of your Janma Nakshatra the Moon had already crossed at your birth is applied to that ruling planet's full Dasha length to find how many years of it remain — that remainder becomes your first (birth) Dasha, and the rest of the 120-year sequence follows in the fixed planetary order from there.",
    aHi: 'जन्म के समय आपके जन्म नक्षत्र के भीतर चंद्रमा की सटीक स्थिति से। 27 नक्षत्रों में से प्रत्येक पर 9 ग्रहों में से एक का शासन एक निश्चित दोहराव क्रम में होता है, और प्रत्येक ग्रह की दशा (ग्रह अवधि) की 120-वर्षीय चक्र में एक निश्चित लंबाई होती है। जन्म के समय चंद्रमा ने आपके जन्म नक्षत्र का जितना हिस्सा पहले ही पार कर लिया था, उस अंश को उस शासक ग्रह की पूर्ण दशा लंबाई पर लागू किया जाता है यह जानने के लिए कि उसमें से कितने वर्ष शेष हैं — वह शेष भाग आपकी पहली (जन्म) दशा बन जाता है, और 120-वर्षीय क्रम का बाकी हिस्सा वहां से निश्चित ग्रह क्रम में आगे बढ़ता है।',
  },
];
---

<Layout title="Janma Kundali — Detailed Natal Chart Report — PanchangPath" description="Generate a detailed Janma Kundali report with ascendant, sidereal planetary positions, house lords, dignity analysis, yoga detection and Vimshottari Dasha.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">जन्म कुंडली · NATAL CHART REPORT</p>
      <h1 data-hi="जन्म कुंडली" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Janma Kundali</h1>
      <p data-hi="एक संपूर्ण जन्म कुंडली रिपोर्ट — लग्न, नाक्षत्र ग्रह स्थिति, भाव स्वामी, ग्रह बल, प्रमुख योग और जन्म के समय आपकी विंशोत्तरी दशा शेष।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:520px;">A complete natal chart report — Lagna, sidereal planetary positions, house lords, dignity, key yogas and your Vimshottari Dasha balance at birth.</p>
    </div>
  </section>

  <section style="padding:28px 0 56px;">
    <div class="container">

      <!-- Form -->
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:28px;">
        <div><label for="f-name" class="fld-label" data-hi="नाम (वैकल्पिक)">Name (optional)</label><input type="text" id="f-name" class="input" placeholder="Your name" style="height:38px;min-width:150px;" /></div>
        <div><label for="f-date" class="fld-label" data-hi="जन्म तिथि">Date of Birth</label><input type="date" id="f-date" lang="en-GB" class="input" style="height:38px;" /></div>
        <div><label for="f-time" class="fld-label" data-hi="जन्म समय">Time of Birth</label><input type="time" id="f-time" class="input" style="height:38px;" /></div>
        <div><label for="f-city" class="fld-label" data-hi="जन्म स्थान">Place of Birth</label><select id="f-city" class="input" style="height:38px;min-width:150px;"></select></div>
        <button id="f-calc" class="btn-primary" data-hi="रिपोर्ट बनाएं" style="height:38px;padding:0 20px;">Generate Report</button>
      </div>
      <p id="date-echo" style="font-size:12px;color:var(--color-mute);margin:-24px 0 20px;">Date of birth: {EB_DATE_STR}</p>
      <p id="example-note" style="font-size:12px;color:var(--color-mute);margin:-16px 0 20px;">Showing an illustrative example (synthetic sample birth, not a real person) — enter your own birth details above and click Generate Report for your report.</p>

      <div id="result">

        <!-- Row 1: Chart + Birth Summary -->
        <div style="display:grid;grid-template-columns:300px 1fr;gap:24px;margin-bottom:24px;" class="r1">
          <div class="card" style="padding:20px;">
            <h2 id="chart-title" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 3px;" data-hi="लग्न कुंडली">Lagna Chart</h2>
            <p id="chart-sub" style="font-size:11px;color:var(--color-mute);margin:0 0 12px;font-family:var(--font-mono);" data-hi={`${EB_RASHI_HI[ebChart.lagnaSign]} लग्न · ${EB_DATE_STR} ${EB_TIME_STR} · ${EB.city}`}>{EB_RASHI[ebChart.lagnaSign]} Lagna &middot; {EB_DATE_STR} {EB_TIME_STR} &middot; {EB.city}</p>
            <div id="chart-box" set:html={ebChartSvg} />
          </div>
          <div>
            <div class="card" style="padding:20px;height:100%;box-sizing:border-box;">
              <h3 data-hi="जन्म सारांश" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Birth Summary</h3>
              <div id="summary-list" style="display:grid;grid-template-columns:1fr 1fr;gap:10px 20px;">
                {[
                  ['Lagna (Ascendant)', 'लग्न', `${EB_RASHI[ebChart.lagnaSign]} (${EB_RASHI_EN[ebChart.lagnaSign]})`, `${EB_RASHI_HI[ebChart.lagnaSign]} (${EB_RASHI_EN[ebChart.lagnaSign]})`],
                  ['Lagna Lord', 'लग्न स्वामी', EB_RASHI_LORD[ebChart.lagnaSign], EB_RASHI_LORD_HI[EB_RASHI_LORD[ebChart.lagnaSign]]],
                  ['Lagna Degree', 'लग्न अंश', `${Math.floor(ebChart.lagna % 30)}°${String(Math.floor(((ebChart.lagna % 30) % 1) * 60)).padStart(2, '0')}'`, `${Math.floor(ebChart.lagna % 30)}°${String(Math.floor(((ebChart.lagna % 30) % 1) * 60)).padStart(2, '0')}'`],
                  ['Moon Rashi', 'चंद्र राशि', `${EB_RASHI[ebChart.moonSign]} (${EB_RASHI_EN[ebChart.moonSign]})`, `${EB_RASHI_HI[ebChart.moonSign]} (${EB_RASHI_EN[ebChart.moonSign]})`],
                  ['Sun Rashi', 'सूर्य राशि', `${EB_RASHI[ebChart.sunSign]} (${EB_RASHI_EN[ebChart.sunSign]})`, `${EB_RASHI_HI[ebChart.sunSign]} (${EB_RASHI_EN[ebChart.sunSign]})`],
                  ['Janma Nakshatra', 'जन्म नक्षत्र', `${ebMoonNakName} pada ${ebChart.moonNak.pada}`, `${NAKSHATRAS[ebChart.moonNak.idx].h} पद ${ebChart.moonNak.pada}`],
                  ['Paksha', 'पक्ष', ebPaksha, ebPakshaHi],
                  ['Ayanamsha', 'अयनांश', `${ebChart.ay.toFixed(3)}° Lahiri`, `${ebChart.ay.toFixed(3)}° लाहिड़ी`],
                ].map(([label, labelHi, val, valHi]) => (
                  <div><p style="font-size:11px;color:var(--color-mute);margin:0 0 2px;font-family:var(--font-mono);" data-hi={(labelHi as string).toUpperCase()}>{(label as string).toUpperCase()}</p><p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0;" data-hi={valHi}>{val}</p></div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Row 2: Planetary Positions (full) -->
        <div class="card" style="padding:20px;overflow-x:auto;margin-bottom:24px;">
          <h3 data-hi="ग्रह स्फुट — ग्रह स्थिति" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Graha Sphuta — Planetary Positions</h3>
          <table style="width:100%;border-collapse:collapse;font-size:13px;min-width:640px;" id="planet-table">
            <tr><th data-hi="ग्रह">Graha</th><th data-hi="राशि">Rashi</th><th data-hi="अंश">Degree</th><th data-hi="भाव">House</th><th data-hi="नक्षत्र">Nakshatra</th><th data-hi="पद">Pada</th><th data-hi="गति">Motion</th><th data-hi="बल">Dignity</th></tr>
            {ebChart.rows.map(row => {
              const dig = planetDignity(row.key, row.sign);
              const house = ((row.sign - ebChart.lagnaSign) + 12) % 12;
              const motion = (row.key === 'rahu' || row.key === 'ketu') ? 'Vakri (always)' : (row.isRetrograde ? 'Vakri' : 'Margi');
              const motionHi = (row.key === 'rahu' || row.key === 'ketu') ? 'वक्री (सदैव)' : (row.isRetrograde ? 'वक्री' : 'मार्गी');
              return (
                <tr>
                  <td style="color:var(--color-ink);font-weight:600;" data-hi={EB_PLANET_HI[row.key]}>{EB_PLANET_EN[row.key]}</td>
                  <td data-hi={EB_RASHI_HI[row.sign]}>{EB_RASHI[row.sign]}</td>
                  <td style="font-family:var(--font-mono);">{Math.floor(row.sidLon % 30)}&deg;{String(Math.floor(((row.sidLon % 30) % 1) * 60)).padStart(2, '0')}'</td>
                  <td style="text-align:center;">{house + 1}</td>
                  <td data-hi={NAKSHATRAS[row.nakIdx].h}>{NAKSHATRAS[row.nakIdx].n}</td>
                  <td>{row.nakPada}</td>
                  <td style={row.isRetrograde ? 'color:#dc2626;' : 'color:var(--color-body-text);'} data-hi={motionHi}>{motion}</td>
                  <td class={dig === 'exalted' ? 'dignity-exalt' : dig === 'debilitated' ? 'dignity-debil' : dig === 'own' ? 'dignity-own' : ''} data-hi={EB_DIGNITY_LABEL_HI[dig]}>{EB_DIGNITY_LABEL[dig]}</td>
                </tr>
              );
            })}
          </table>
        </div>

        <!-- Row 3: House Lords -->
        <div class="card" style="padding:20px;overflow-x:auto;margin-bottom:24px;">
          <h3 data-hi="भाव स्वामी — भाव विश्लेषण" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Bhava Lords — House Analysis</h3>
          <table style="width:100%;border-collapse:collapse;font-size:13px;min-width:560px;" id="house-table">
            <tr><th data-hi="भाव">House</th><th data-hi="राशि">Rashi</th><th data-hi="स्वामी">Lord</th><th data-hi="स्वामी की स्थिति">Lord is in</th><th data-hi="महत्व">Significance</th></tr>
            {ebHouseLords.map(hl => (
              <tr>
                <td style="font-weight:600;color:var(--color-ink);" data-hi={`भाव ${hl.house + 1}`}>H{hl.house + 1}</td>
                <td data-hi={EB_RASHI_HI[hl.sign]}>{EB_RASHI[hl.sign]}</td>
                <td data-hi={EB_PLANET_HI[hl.lordKey]}>{EB_PLANET_EN[hl.lordKey]}</td>
                <td data-hi={`भाव ${hl.lordHouse + 1} (${EB_RASHI_HI[hl.lordSign]})`}>H{hl.lordHouse + 1} ({EB_RASHI[hl.lordSign]})</td>
                <td style="font-size:12px;color:var(--color-mute);" data-hi={LAGNA_HOUSES_HI[hl.house]}>{LAGNA_HOUSES[hl.house]}</td>
              </tr>
            ))}
          </table>
        </div>

        <!-- Row 4: Yogas + Dasha side by side -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:24px;" class="r4">
          <div class="card" style="padding:20px;">
            <h3 data-hi="योग विचार — प्रमुख ग्रह योग" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Yoga Vichar — Key Planetary Yogas</h3>
            <div id="yoga-list" style="display:flex;flex-direction:column;gap:10px;">
              {ebYogaDisplay.map(y => (
                <div style={`padding:10px 12px;border-radius:8px;background:${y.badge === 'auspicious' ? 'var(--color-auspicious-soft)' : y.badge === 'caution' ? 'var(--color-inauspicious-soft)' : 'var(--color-canvas-soft)'};`}>
                  <p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 3px;" data-hi={y.nameHi}>{y.name}</p>
                  <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.5;" data-hi={y.descHi}>{y.desc}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="card" style="padding:20px;">
            <h3 data-hi="विंशोत्तरी दशा" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">Vimshottari Dasha</h3>
            <p data-hi="जन्म से शुरू होने वाला 120-वर्षीय ग्रह अवधि चक्र" style="font-size:12px;color:var(--color-mute);margin:0 0 12px;">120-year planetary period cycle from birth</p>
            <div id="dasha-balance" style="margin-bottom:12px;">
              <div style="padding:10px 14px;background:var(--color-canvas-soft);border-radius:8px;">
                <p style="font-size:11px;color:var(--color-mute);margin:0 0 3px;font-family:var(--font-mono);" data-hi="जन्म दशा शेष">BIRTH DASHA BALANCE</p>
                <p style="font-size:15px;font-weight:700;color:var(--color-ink);margin:0;" data-hi={`${EB_PLANET_HI[ebDashaLordKey]} — ${ebRemaining.toFixed(1)} वर्ष शेष`}>{ebDashaLordEn} — {ebRemaining.toFixed(1)} yrs remaining</p>
                <p style="font-size:12px;color:var(--color-mute);margin:2px 0 0;" data-hi={`जन्म नक्षत्र: ${NAKSHATRAS[ebChart.moonNak.idx].h} (${EB_PLANET_HI[ebDashaLordKey]} दशा में ${(ebDashaFrac * 100).toFixed(0)}% पूर्ण)`}>Janma Nakshatra: {ebMoonNakName} ({(ebDashaFrac * 100).toFixed(0)}% elapsed in {ebDashaLordEn} dasha)</p>
              </div>
            </div>
            <table style="width:100%;border-collapse:collapse;font-size:12.5px;" id="dasha-table">
              <tr><th data-hi="दशा स्वामी">Dasha Lord</th><th data-hi="वर्ष">Years</th><th data-hi="से">From</th><th data-hi="तक">To</th></tr>
              {ebDashaRows.map(r => (
                <tr><td data-hi={r.lordHi}>{r.lord}</td><td>{r.yrs}</td><td data-hi={r.fromHi}>{r.from}</td><td>{r.to}</td></tr>
              ))}
            </table>
          </div>
        </div>

      </div><!-- /result -->

      <div id="err" style="display:none;padding:16px;background:var(--color-inauspicious-soft);border-radius:8px;color:#b91c1c;font-size:14px;"></div>

      <!-- About -->
      <div class="card" style="padding:28px;margin-top:36px;">
        <h2 data-hi="अपनी जन्म कुंडली को समझना" style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">Understanding Your Janma Kundali</h2>
        <p data-hi="जन्म कुंडली आपके जन्म के क्षण आकाश का पूर्ण मानचित्र है। हर ग्रह का नाक्षत्र देशांतर (लाहिड़ी अयनांश लगाने के बाद) उसे 12 राशियों में से एक और 12 भावों में से एक में रखता है, जो आपका कर्म-खाका प्रकट करता है।" style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 10px;">The Janma Kundali is the complete map of the sky at your birth moment. Every planet's sidereal longitude (after applying the Lahiri ayanamsha) places it in one of 12 rashis (signs) and 12 bhavas (houses), revealing your karmic blueprint.</p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 10px;"><b data-hi="भाव स्वामी:">House Lords:</b> <span data-hi="प्रत्येक भाव का स्वामी उस राशि का स्वामी होता है जो वहां पड़ती है। स्वामी की अपनी स्थिति यह तय करती है कि उस भाव के विषय फलें-फूलें या चुनौतियों का सामना करें।">Each house is owned by the sign lord of the rashi that falls there. The lord's own placement determines whether the house's themes flourish or face challenges.</span></p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 10px;"><b data-hi="ग्रह बल:">Planetary Dignity:</b> <span data-hi="अपनी राशि या उच्च राशि में स्थित ग्रह पूर्ण बल से कार्य करता है; नीच राशि में उसे सचेत प्रयास की आवश्यकता हो सकती है। नीच भंग (नीचता का निवारण) उसकी ऊर्जा को पुनः स्थापित कर सकता है।">A planet in its own sign or exaltation functions at full strength; in debilitation it may need conscious cultivation. Neecha Bhanga (cancellation of debilitation) can restore its energy.</span></p>
        <p style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0;"><b data-hi="विंशोत्तरी दशा:">Vimshottari Dasha:</b> <span data-hi="जन्म के समय चंद्र नक्षत्र से सक्रिय होने वाली 120-वर्षीय ग्रह अवधि प्रणाली। जन्म दशा के शेष वर्ष, फिर पूरा क्रम, यहां दिखाया गया है। व्यक्तिगत विश्लेषण हेतु किसी योग्य ज्योतिषी से परामर्श लें।">The 120-year planetary period system activated by the Moon's nakshatra at birth. The remaining years of the birth dasha, then the full sequence, are shown. Consult a qualified Jyotishi for a personalised reading.</span></p>
      </div>

      <CalculatorFaq items={FAQ_ITEMS} />

    </div>
  </section>
</Layout>

<style>
  .fld-label { font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em; }
  #planet-table th,#house-table th,#dasha-table th { text-align:left;padding:6px 8px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:0.04em; }
  #planet-table td,#house-table td,#dasha-table td { padding:7px 8px;border-bottom:1px solid var(--color-hairline);color:var(--color-body-text); }
  .dignity-exalt { color:#15803d;font-weight:700; }
  .dignity-own { color:#0369a1;font-weight:600; }
  .dignity-debil { color:#dc2626;font-weight:600; }
  .dasha-active { background:var(--color-auspicious-soft); }
  @media(max-width:820px){ .r1,.r4 { grid-template-columns:1fr !important; } }
</style>

<script>
import { LOCATIONS } from '../../lib/locations';
import { PLANET_ICONS } from '../../lib/icons/planets';
import { computeJanmaKundaliData, janmaNorthChart, planetDignity, DASHA_ORDER, DASHA_YEARS, SYNTHETIC_EXAMPLE_BIRTH } from '../../lib/kundali';
import { LAGNA_HOUSES, LAGNA_HOUSES_HI } from '../../lib/jyotish';

function planetIconSvg(id,size){return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-3px;margin-right:4px;">${PLANET_ICONS[id]}</svg>`;}
let LANG_HI = localStorage.getItem('pp-lang') === 'hi';
function tr(en, hi) { return LANG_HI ? hi : en; }
const WD_EN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI=['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN=['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI=['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(y,m,d){const wd=new Date(Date.UTC(y,m-1,d,12)).getUTCDay();return tr(`${WD_EN[wd]}, ${d} ${MO_EN[m-1]} ${y}`,`${WD_HI[wd]}, ${d} ${MO_HI[m-1]} ${y}`);}
const LOCS=LOCATIONS.map(l=>({name:l.name,nameHi:l.nameHi,lat:l.lat,lng:l.lng,tz:l.tzOffset}));
function toJD(y,m,d,h){h=h||0;if(m<=2){y--;m+=12;}const A=Math.floor(y/100),B=2-A+Math.floor(A/4);return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;}

const RASHI=['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RASHI_HI=['मेष','वृषभ','मिथुन','कर्क','सिंह','कन्या','तुला','वृश्चिक','धनु','मकर','कुम्भ','मीन'];
const RASHI_EN=['Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius','Capricorn','Aquarius','Pisces'];
const RASHI_LORD=['Mars','Venus','Mercury','Moon','Sun','Mercury','Venus','Mars','Jupiter','Saturn','Saturn','Jupiter'];
const NAKS=['Ashwini','Bharani','Krittika','Rohini','Mrigashira','Ardra','Punarvasu','Pushya','Ashlesha','Magha','Purva Phalguni','Uttara Phalguni','Hasta','Chitra','Swati','Vishakha','Anuradha','Jyeshtha','Mula','Purva Ashadha','Uttara Ashadha','Shravana','Dhanishtha','Shatabhisha','Purva Bhadrapada','Uttara Bhadrapada','Revati'];
const NAKS_HI=['अश्विनी','भरणी','कृत्तिका','रोहिणी','मृगशिरा','आर्द्रा','पुनर्वसु','पुष्य','आश्लेषा','मघा','पूर्व फाल्गुनी','उत्तर फाल्गुनी','हस्त','चित्रा','स्वाति','विशाखा','अनुराधा','ज्येष्ठा','मूल','पूर्वाषाढ़ा','उत्तराषाढ़ा','श्रावण','धनिष्ठा','शतभिषा','पूर्व भाद्रपदा','उत्तर भाद्रपदा','रेवती'];
function trRashi(i){return tr(RASHI[i],RASHI_HI[i]);}
function trNak(i){return tr(NAKS[i],NAKS_HI[i]);}
const PLANET_HI={Sun:'सूर्य',Moon:'चंद्रमा',Mars:'मंगल',Mercury:'बुध',Jupiter:'गुरु',Venus:'शुक्र',Saturn:'शनि',Rahu:'राहु',Ketu:'केतु'};
// key (astro-core/kundali.ts graha id) -> English display name, matching PLANET_HI's keys
const KEY_EN={surya:'Sun',chandra:'Moon',mangal:'Mars',budha:'Mercury',guru:'Jupiter',shukra:'Venus',shani:'Saturn',rahu:'Rahu',ketu:'Ketu'};
function dignityLabel(cls){
  if(cls==='exalted')return{label:tr('Exalted','उच्च'),cls:'dignity-exalt'};
  if(cls==='debilitated')return{label:tr('Debilitated','नीच'),cls:'dignity-debil'};
  if(cls==='own')return{label:tr('Own Sign','स्वराशि'),cls:'dignity-own'};
  return{label:'',cls:''};
}

const YOGA_COPY={
  gajakesari:{name:tr('Gajakesari Yoga','गजकेसरी योग'),desc:tr('Jupiter in kendra from Moon — brings wisdom, reputation and prosperity.','चंद्रमा से केंद्र में गुरु — बुद्धि, प्रतिष्ठा और समृद्धि लाता है।'),badge:'auspicious'},
  budhaditya:{name:tr('Budhaditya Yoga','बुधादित्य योग'),desc:tr('Sun and Mercury conjunct — enhances intellect, analytical skill and communication.','सूर्य और बुध की युति — बुद्धि, विश्लेषण क्षमता और संवाद कौशल बढ़ाती है।'),badge:'auspicious'},
  chandraMangal:{name:tr('Chandra-Mangal Yoga','चंद्र-मंगल योग'),desc:tr('Moon and Mars conjunct or in opposition — drives ambition, financial determination.','चंद्रमा और मंगल की युति या प्रतियुति — महत्वाकांक्षा और आर्थिक दृढ़ता को बढ़ाती है।'),badge:'auspicious'},
  mahapurusha_guru:{name:tr('Hamsa Yoga (Mahapurusha)','हंस योग (महापुरुष)'),desc:tr('Jupiter in own (Dhanu/Meena) or exalted (Karka) and in kendra.','गुरु स्वराशि (धनु/मीन) या उच्च राशि (कर्क) में और केंद्र में हो।'),badge:'auspicious'},
  mahapurusha_shukra:{name:tr('Malavya Yoga (Mahapurusha)','मालव्य योग (महापुरुष)'),desc:tr('Venus in own (Vrishabha/Tula) or exalted (Meena) and in kendra.','शुक्र स्वराशि (वृषभ/तुला) या उच्च राशि (मीन) में और केंद्र में हो।'),badge:'auspicious'},
  mahapurusha_mangal:{name:tr('Ruchaka Yoga (Mahapurusha)','रुचक योग (महापुरुष)'),desc:tr('Mars in own (Mesha/Vrishchika) or exalted (Makara) and in kendra.','मंगल स्वराशि (मेष/वृश्चिक) या उच्च राशि (मकर) में और केंद्र में हो।'),badge:'auspicious'},
  mahapurusha_budha:{name:tr('Bhadra Yoga (Mahapurusha)','भद्र योग (महापुरुष)'),desc:tr('Mercury in own (Mithuna/Kanya) or exalted (Kanya) and in kendra.','बुध स्वराशि (मिथुन/कन्या) या उच्च राशि (कन्या) में और केंद्र में हो।'),badge:'auspicious'},
  mahapurusha_shani:{name:tr('Shasha Yoga (Mahapurusha)','शश योग (महापुरुष)'),desc:tr('Saturn in own (Makara/Kumbha) or exalted (Tula) and in kendra.','शनि स्वराशि (मकर/कुंभ) या उच्च राशि (तुला) में और केंद्र में हो।'),badge:'auspicious'},
  rajaYoga15:{name:tr('Raja Yoga (1-5 Lords)','राज योग (1-5 भाव स्वामी)'),desc:tr('Lords of Lagna and 5th house conjunct — authority, creativity and prosperity.','लग्न और पंचम भाव के स्वामियों की युति — अधिकार, रचनात्मकता और समृद्धि।'),badge:'auspicious'},
  rajaYoga19:{name:tr('Raja Yoga (1-9 Lords)','राज योग (1-9 भाव स्वामी)'),desc:tr('Lords of Lagna and 9th house conjunct — excellent fortune, leadership and dharmic life.','लग्न और नवम भाव के स्वामियों की युति — उत्कृष्ट भाग्य, नेतृत्व और धर्ममय जीवन।'),badge:'auspicious'},
  kemadruma:{name:tr('Kemadruma Yoga','केमद्रुम योग'),desc:tr('Moon without planets in adjacent houses — may cause emotional isolation; mitigated if Moon is in kendra.','आसन्न भावों में कोई ग्रह न होने से चंद्रमा अकेला — भावनात्मक अलगाव हो सकता है; चंद्रमा केंद्र में हो तो प्रभाव कम होता है।'),badge:'caution'},
};

const MO_EN_SHORT=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const MO_HI_SHORT=['जन','फर','मार्च','अप्रैल','मई','जून','जुल','अग','सित','अक्टू','नव','दिस'];
function fmtDt(ms){const d=new Date(ms);return tr(`${MO_EN_SHORT[d.getMonth()]} ${d.getFullYear()}`,`${MO_HI_SHORT[d.getMonth()]} ${d.getFullYear()}`);}

function fmtDMS(lon){const d=lon%30;const deg=Math.floor(d);const mn=Math.floor((d-deg)*60);return deg+'\xb0'+String(mn).padStart(2,'0')+"'";}

// Setup
const sel=document.getElementById('f-city');
function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(LANG_HI?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();
const EB=SYNTHETIC_EXAMPLE_BIRTH;
const ebDateStr=`${EB.y}-${String(EB.m).padStart(2,'0')}-${String(EB.d).padStart(2,'0')}`;
const ebTimeStr=`${String(EB.hh).padStart(2,'0')}:${String(EB.mm).padStart(2,'0')}`;
document.getElementById('f-date').value=ebDateStr;
document.getElementById('f-time').value=ebTimeStr;
sel.value=EB.city;

function calculate(){
  try{
    const dateStr=document.getElementById('f-date').value;
    const timeStr=document.getElementById('f-time').value||'12:00';
    const cityName=document.getElementById('f-city').value;
    const name=document.getElementById('f-name').value.trim();
    const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
    const[y,m,d]=dateStr.split('-').map(Number);
    const de=document.getElementById('date-echo');
    if(de){de.textContent=tr('Date of birth: ','जन्म तिथि: ')+formatLongDate(y,m,d);de.hidden=false;}
    const noteEl=document.getElementById('example-note');
    if(noteEl)noteEl.style.display=(dateStr===ebDateStr&&timeStr===ebTimeStr&&cityName===EB.city)?'':'none';
    const[hh,mm]=timeStr.split(':').map(Number);
    const jd=toJD(y,m,d,(hh+mm/60)-loc.tz);
    const jk=computeJanmaKundaliData(jd,loc.lat,loc.lng);
    const{chart,houseLords,yogas,dashaLordKey,dashaYears,dashaFractionElapsed}=jk;
    const{ay,lagna,lagnaSign,signOfHouse,planetsByHouse,moonSign,sunSign,moonNak}=chart;
    const lagnaLord=RASHI_LORD[lagnaSign];

    // ── Chart ──
    document.getElementById('chart-box').innerHTML=janmaNorthChart(signOfHouse,planetsByHouse);
    document.getElementById('chart-title').textContent=(name?name+"'s ":'')+tr('Lagna Chart (D-1)','लग्न चार्ट (डी-1)');
    document.getElementById('chart-sub').textContent=trRashi(lagnaSign)+' '+tr('Lagna','लग्न')+' \xb7 '+dateStr+' '+timeStr+' \xb7 '+(LANG_HI?(loc.nameHi||loc.name):loc.name);

    // ── Birth Summary ──
    const sunSid=chart.rows.find(r=>r.key==='surya').sidLon;
    const moonSid=chart.rows.find(r=>r.key==='chandra').sidLon;
    const sumItems=[
      [tr('Lagna (Ascendant)','लग्न (उदय राशि)'),trRashi(lagnaSign)+' ('+RASHI_EN[lagnaSign]+')'],
      [tr('Lagna Lord','लग्न स्वामी'),tr(lagnaLord,PLANET_HI[lagnaLord])],
      [tr('Lagna Degree','लग्न अंश'),fmtDMS(lagna)],
      [tr('Moon Rashi','चंद्र राशि'),trRashi(moonSign)+' ('+RASHI_EN[moonSign]+')'],
      [tr('Sun Rashi','सूर्य राशि'),trRashi(sunSign)+' ('+RASHI_EN[sunSign]+')'],
      [tr('Janma Nakshatra','जन्म नक्षत्र'),trNak(moonNak.idx)+' '+tr('pada','पद')+' '+moonNak.pada],
      [tr('Paksha','पक्ष'),moonSid>sunSid&&moonSid-sunSid<180?tr('Shukla (Waxing)','शुक्ल (बढ़ता चंद्रमा)'):tr('Krishna (Waning)','कृष्ण (घटता चंद्रमा)')],
      [tr('Ayanamsha','अयनांश'),ay.toFixed(3)+'\xb0 Lahiri'],
    ];
    document.getElementById('summary-list').innerHTML=sumItems.map(r=>
      `<div><p style="font-size:11px;color:var(--color-mute);margin:0 0 2px;font-family:var(--font-mono);">${r[0].toUpperCase()}</p><p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0;">${r[1]}</p></div>`
    ).join('');

    // ── Planetary Positions Table ──
    let pRows=`<tr><th>${tr('Graha','ग्रह')}</th><th>${tr('Rashi','राशि')}</th><th>${tr('Degree','अंश')}</th><th>${tr('House','भाव')}</th><th>${tr('Nakshatra','नक्षत्र')}</th><th>${tr('Pada','पद')}</th><th>${tr('Motion','गति')}</th><th>${tr('Dignity','बल')}</th></tr>`;
    chart.rows.forEach(row=>{
      const k=row.key,full=KEY_EN[k];
      const house=((row.sign-lagnaSign)+12)%12;
      let motion;
      if(k==='rahu'||k==='ketu')motion=tr('Vakri (always)','वक्री (सदैव)');
      else motion=row.isRetrograde?tr('Vakri','वक्री'):tr('Margi','मार्गी');
      const dig=dignityLabel(planetDignity(k,row.sign));
      pRows+=`<tr><td style="color:var(--color-ink);font-weight:600;">${planetIconSvg(k,14)}${tr(full,PLANET_HI[full])}</td><td>${trRashi(row.sign)}</td><td style="font-family:var(--font-mono);">${fmtDMS(row.sidLon)}</td><td style="text-align:center;">${house+1}</td><td>${trNak(row.nakIdx)}</td><td>${row.nakPada}</td><td style="color:${row.isRetrograde?'#dc2626':'var(--color-body-text)'};">${motion}</td><td class="${dig.cls}">${dig.label}</td></tr>`;
    });
    document.getElementById('planet-table').innerHTML=pRows;

    // ── House Lords Table ──
    let hRows=`<tr><th>${tr('House','भाव')}</th><th>${tr('Rashi','राशि')}</th><th>${tr('Lord','स्वामी')}</th><th>${tr('Lord is in','स्वामी की स्थिति')}</th><th>${tr('Significance','महत्व')}</th></tr>`;
    houseLords.forEach(hl=>{
      const lordEn=KEY_EN[hl.lordKey];
      const lordPos='H'+(hl.lordHouse+1)+' ('+trRashi(hl.lordSign)+')';
      hRows+=`<tr><td style="font-weight:600;color:var(--color-ink);">H${hl.house+1}</td><td>${trRashi(hl.sign)}</td><td>${tr(lordEn,PLANET_HI[lordEn])}</td><td>${lordPos}</td><td style="font-size:12px;color:var(--color-mute);">${tr(LAGNA_HOUSES[hl.house],LAGNA_HOUSES_HI[hl.house])}</td></tr>`;
    });
    document.getElementById('house-table').innerHTML=hRows;

    // ── Yoga Detection ──
    const yogaDisplay=yogas.length?yogas.map(k=>YOGA_COPY[k]):[{name:tr('No prominent yogas detected','कोई प्रमुख योग नहीं मिला'),desc:tr('The chart has a balanced, ordinary planetary configuration.','कुंडली में संतुलित, सामान्य ग्रह संरचना है।'),badge:''}];
    document.getElementById('yoga-list').innerHTML=yogaDisplay.map(y=>
      `<div style="padding:10px 12px;border-radius:8px;background:${y.badge==='auspicious'?'var(--color-auspicious-soft)':y.badge==='caution'?'var(--color-inauspicious-soft)':'var(--color-canvas-soft)'};">
        <p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 3px;">${y.name}</p>
        <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.5;">${y.desc}</p>
      </div>`
    ).join('');

    // ── Vimshottari Dasha ──
    const dashaLordEn=KEY_EN[dashaLordKey];
    const consumed=dashaFractionElapsed*dashaYears;
    const remaining=dashaYears-consumed;

    document.getElementById('dasha-balance').innerHTML=
      `<div style="padding:10px 14px;background:var(--color-canvas-soft);border-radius:8px;">
        <p style="font-size:11px;color:var(--color-mute);margin:0 0 3px;font-family:var(--font-mono);">${tr('BIRTH DASHA BALANCE','जन्म दशा शेष')}</p>
        <p style="font-size:15px;font-weight:700;color:var(--color-ink);margin:0;">${tr(dashaLordEn,PLANET_HI[dashaLordEn])} — ${remaining.toFixed(1)} ${tr('yrs remaining','वर्ष शेष')}</p>
        <p style="font-size:12px;color:var(--color-mute);margin:2px 0 0;">${tr('Janma Nakshatra','जन्म नक्षत्र')}: ${trNak(moonNak.idx)} (${(dashaFractionElapsed*100).toFixed(0)}% ${tr('elapsed in','व्यतीत,')} ${tr(dashaLordEn,PLANET_HI[dashaLordEn])} ${tr('dasha','दशा')})</p>
      </div>`;

    const msPerYr=365.25*24*3600*1000;
    const birthMs=Date.UTC(y,m-1,d,hh,mm)-loc.tz*3600000;
    const dashaStartMs=birthMs-consumed*msPerYr;
    const startIdx=DASHA_ORDER.indexOf(dashaLordKey);
    const now=Date.now();
    let t=dashaStartMs;
    let dRows=`<tr><th>${tr('Dasha Lord','दशा स्वामी')}</th><th>${tr('Years','वर्ष')}</th><th>${tr('From','से')}</th><th>${tr('To','तक')}</th></tr>`;
    for(let i=0;i<9;i++){
      const lordKey=DASHA_ORDER[(startIdx+i)%9];
      const lordEn=KEY_EN[lordKey];
      const yrs=DASHA_YEARS[lordKey];
      const st=t,en=t+yrs*msPerYr;
      const isActive=now>=st&&now<en;
      const from=i===0?tr('Birth','जन्म'):fmtDt(st);
      dRows+=`<tr class="${isActive?'dasha-active':''}"><td style="font-weight:${isActive?700:400};color:${isActive?'var(--color-ink)':'var(--color-body-text)'};">${tr(lordEn,PLANET_HI[lordEn])}${isActive?' ◀':''}</td><td>${yrs}</td><td>${from}</td><td>${fmtDt(en)}</td></tr>`;
      t=en;
    }
    document.getElementById('dasha-table').innerHTML=dRows;

    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){
    const er=document.getElementById('err');er.style.display='block';er.textContent='Could not generate report: '+e.message;
    document.getElementById('result').style.display='none';
  }
}
document.getElementById('f-calc').addEventListener('click',calculate);
calculate();

function applyPageLang(hindi) {
  LANG_HI = hindi;
  renderCityOptions();
  document.querySelectorAll('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? el.dataset.hi : el.dataset.en;
  });
  calculate();
}
document.addEventListener('langchange', (e) => {
  applyPageLang(e.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
