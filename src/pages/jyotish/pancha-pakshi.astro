---
import Layout from '../../layouts/Layout.astro';
import { pakshiBirthBird, computePanchaPakshi } from '../../lib/jyotish';
import { formatMinutes12h } from '../../lib/time-format';

// Build-time default: exactly reproduces what this page's client <script> already computes
// unconditionally on load (calculate() runs immediately, no user interaction required) —
// "born now, at noon, in New Delhi" — so this is not inventing new default content, just
// moving the page's own existing default state to build time. Uses the exact same
// pakshiBirthBird()/computePanchaPakshi() the client <script> below calls, so server and
// client can never disagree — see CLAUDE.md's 2026-08-18 SEO-prerender rollout note.
const NEW_DELHI = { name: 'New Delhi', lat: 28.6139, lng: 77.209, tz: 5.5 };
const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
const istNow = new Date(Date.now() + IST_OFFSET_MS);
const defY = istNow.getUTCFullYear();
const defM = istNow.getUTCMonth() + 1;
const defD = istNow.getUTCDate();

const defBirthBird = pakshiBirthBird(defY, defM, defD, 12, NEW_DELHI.tz);
const defResult = computePanchaPakshi(defY, defM, defD, NEW_DELHI.lat, NEW_DELHI.lng, NEW_DELHI.tz, defBirthBird);
const fmt = formatMinutes12h;

const BIRDS = ['Vulture', 'Owl', 'Crow', 'Cock', 'Peacock'];
const BIRDS_HI = ['गिद्ध', 'उल्लू', 'कौआ', 'मुर्गा', 'मोर'];
const BIRD_EMOJI = ['🦅', '🦉', '🐦‍⬛', '🐓', '🦚'];
const BIRD_DESC = [
  'Powerful, far-sighted and commanding. Vulture-born are natural leaders with sharp vision, ambition and the ability to rise above obstacles.',
  'Wise, introspective and patient. Owl-born possess deep intuition, work well at night, and excel in research and contemplation.',
  'Clever, social and adaptable. Crow-born are resourceful communicators, quick learners and skilled at networking.',
  'Energetic, disciplined and alert. Cock-born are punctual, courageous and thrive on routine, leadership and protection of others.',
  'Charming, creative and graceful. Peacock-born are artistic, attractive and expressive, drawing admiration wherever they go.',
];
const ACTIVITIES = ['Ruling', 'Eating', 'Walking', 'Sleeping', 'Dying'];
const ACT_Q = ['Best', 'Good', 'Neutral', 'Unfavorable', 'Worst'];
const ACT_COLOR = ['#15803d', '#65a30d', '#b45309', '#ea580c', '#dc2626'];
const WD_EN = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const MO_EN = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const defDateLabel = `${WD_EN[defResult.weekday]}, ${defD} ${MO_EN[defM - 1]} ${defY}`;
const defBirthDateLabel = defDateLabel; // birth date defaults to today, same string
const periodSub = `${defDateLabel} · Day ruling bird: ${BIRDS[defResult.dayBird]} · Sunrise ${fmt(defResult.srMins)}, Sunset ${fmt(defResult.ssMins)}`;
---

<Layout title="Pancha Pakshi Calculator — Your Birth Bird — PanchangPath" description="Find your Pancha Pakshi birth bird from your nakshatra and see today's favourable and unfavourable periods in the traditional South Indian bird system.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">पंच पक्षी · PANCHA PAKSHI</p>
      <h1 data-hi="पंच पक्षी कैलकुलेटर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Pancha Pakshi Calculator</h1>
      <p data-hi="पंच पक्षी एक दक्षिण भारतीय प्रणाली है जो हर व्यक्ति को पांच पक्षियों में से एक सौंपती है। अपना जन्म पक्षी और आज के शुभ समय जानें।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:520px;">Pancha Pakshi is a South Indian system assigning each person one of five birds. Find your birth bird and today's favourable periods.</p>
    </div>
  </section>

  <section style="padding:28px 0 56px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div><label for="f-date" class="fld-label" data-hi="जन्म तिथि">Date of Birth</label><input type="date" id="f-date" lang="en-GB" class="input" style="height:38px;" /></div>
        <div><label for="f-time" class="fld-label" data-hi="जन्म समय">Time of Birth</label><input type="time" id="f-time" class="input" style="height:38px;" /></div>
        <div><label for="f-city" class="fld-label" data-hi="स्थान">Place</label><select id="f-city" class="input" style="height:38px;min-width:150px;"></select></div>
        <button id="f-calc" class="btn-primary" data-hi="गणना करें" style="height:38px;padding:0 20px;">Calculate</button>
      </div>
      <p id="date-echo" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;">Date of birth: {defBirthDateLabel}</p>

      <div style="border-top:1px solid var(--color-hairline);padding-top:22px;margin-bottom:32px;">
        <p data-hi="त्वरित खोज — अपना नक्षत्र जानें" style="font-size:12px;font-weight:600;color:var(--color-mute);margin:0 0 12px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Quick Lookup — Know Your Nakshatra</p>
        <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;">
          <div><label for="f-nak" class="fld-label" data-hi="जन्म नक्षत्र">Birth Nakshatra</label><select id="f-nak" class="input" style="height:38px;min-width:220px;"></select></div>
          <div><label for="f-city2" class="fld-label" data-hi="स्थान (सूर्योदय हेतु)">Place (for sunrise)</label><select id="f-city2" class="input" style="height:38px;min-width:150px;"></select></div>
          <button id="f-calc-nak" class="btn-primary" data-hi="मेरा पक्षी जानें" style="height:38px;padding:0 20px;">Find My Bird</button>
        </div>
      </div>

      <div id="result">
        <div class="card" style="padding:28px;text-align:center;margin-bottom:24px;background:linear-gradient(135deg,var(--color-canvas) 55%,var(--color-saffron-soft));">
          <div id="bird-emoji" style="font-size:48px;line-height:1;margin-bottom:8px;">{BIRD_EMOJI[defBirthBird]}</div>
          <p class="caption-mono" data-hi="आपका जन्म पक्षी" style="color:var(--color-saffron-deep);margin:0 0 6px;">YOUR BIRTH BIRD</p>
          <h2 id="bird-name" style="font-size:26px;font-weight:700;color:var(--color-ink);margin:0 0 6px;">{BIRDS[defBirthBird]} · {BIRDS_HI[defBirthBird]}</h2>
          <p id="bird-desc" style="font-size:14px;color:var(--color-body-text);margin:0 auto;max-width:460px;line-height:1.6;">{BIRD_DESC[defBirthBird]}</p>
        </div>
        <h3 data-hi="आज के सक्रियता काल" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">Today's Activity Periods</h3>
        <p style="font-size:12px;color:var(--color-mute);margin:0 0 14px;" id="period-sub">{periodSub}</p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;" class="period-cols">
          <div>
            <p data-hi="☀ दिन (सूर्योदय → सूर्यास्त)" style="font-size:12px;font-weight:600;color:var(--color-mute);margin:0 0 8px;font-family:var(--font-mono);">☀ DAY (Sunrise → Sunset)</p>
            <div id="day-periods" style="display:flex;flex-direction:column;gap:8px;">
              {defResult.day.map(p => (
                <div style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;background:var(--color-canvas-soft-2);">
                  <span style={`width:8px;height:8px;border-radius:50%;background:${ACT_COLOR[p.activityIdx]};flex-shrink:0;`}></span>
                  <div style="flex:1;">
                    <p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0;">{ACTIVITIES[p.activityIdx]} <span style={`font-size:11px;font-weight:500;color:${ACT_COLOR[p.activityIdx]};`}>· {ACT_Q[p.activityIdx]}</span></p>
                    <p style="font-size:11px;color:var(--color-mute);margin:1px 0 0;font-family:var(--font-mono);">{fmt(p.start)} – {fmt(p.end)}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div>
            <p data-hi="🌙 रात्रि (सूर्यास्त → सूर्योदय)" style="font-size:12px;font-weight:600;color:var(--color-mute);margin:0 0 8px;font-family:var(--font-mono);">🌙 NIGHT (Sunset → Sunrise)</p>
            <div id="night-periods" style="display:flex;flex-direction:column;gap:8px;">
              {defResult.night.map(p => (
                <div style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;background:var(--color-canvas-soft-2);">
                  <span style={`width:8px;height:8px;border-radius:50%;background:${ACT_COLOR[p.activityIdx]};flex-shrink:0;`}></span>
                  <div style="flex:1;">
                    <p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0;">{ACTIVITIES[p.activityIdx]} <span style={`font-size:11px;font-weight:500;color:${ACT_COLOR[p.activityIdx]};`}>· {ACT_Q[p.activityIdx]}</span></p>
                    <p style="font-size:11px;color:var(--color-mute);margin:1px 0 0;font-family:var(--font-mono);">{fmt(p.start)} – {fmt(p.end)}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div id="err" style="display:none;padding:16px;background:var(--color-inauspicious-soft);border-radius:8px;color:#b91c1c;font-size:14px;"></div>

      <div class="card" style="padding:28px;margin-top:36px;">
        <h2 data-hi="पंच पक्षी के बारे में" style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">About Pancha Pakshi</h2>
        <p data-hi="पंच पक्षी शास्त्र ('पांच पक्षी') मुहूर्त ज्योतिष की एक दक्षिण भारतीय प्रणाली है। हर व्यक्ति पांच पक्षियों में से एक द्वारा शासित होता है — गिद्ध, उल्लू, कौआ, मुर्गा या मोर — जो उनके जन्म नक्षत्र से निर्धारित होता है। हर पक्षी दिन और रात में पांच गतिविधियों (शासन, भोजन, चलना, सोना, मरना) के चक्र से गुजरता है। जब आपका पक्षी शासन या भोजन में हो तब कार्य करना सबसे शुभ माना जाता है, जबकि सोने और मरने की अवधि महत्वपूर्ण कार्यों के लिए टालना बेहतर है।" style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 10px;">Pancha Pakshi Shastra ("five birds") is a South Indian system of electional astrology. Each person is governed by one of five birds — Vulture, Owl, Crow, Cock or Peacock — determined by their birth nakshatra. Each bird cycles through five activities (Ruling, Eating, Walking, Sleeping, Dying) across the day and night. Acting when your bird is Ruling or Eating is considered most auspicious, while Sleeping and Dying periods are best avoided for important tasks.</p>
        <p data-hi="टिप्पणी: यह कैलकुलेटर पारंपरिक नियमों का एक सरलीकृत संस्करण उपयोग करता है — यह दिन और रात को पांच समान अवधियों में बांटता है और पक्षी निर्धारण में लिंग-भेद नहीं करता, जबकि पूर्ण शास्त्रीय पंच पक्षी शास्त्र इन दोनों को अलग तरीके से संभालता है। यहां के परिणामों को एक अनुमानित, सरलीकृत मार्गदर्शिका के रूप में लें, न कि किसी पारंपरिक विद्वान की गणना के रूप में।" style="font-size:14px;color:var(--color-mute);line-height:1.6;margin:0;">Note: this calculator uses a simplified version of the traditional rules — it divides day and night into five equal periods and does not distinguish bird assignment by gender, both of which the full classical Pancha Pakshi Shastra does differently. Treat results here as an approximate, stylized guide rather than a traditional practitioner's calculation.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .fld-label { font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em; }
  @media (max-width:640px){ .period-cols{ grid-template-columns:1fr !important; } }
</style>

<script>
import { LOCATIONS } from '../../lib/locations';
import { pakshiBirthBird, computePanchaPakshi } from '../../lib/jyotish';
import { formatMinutes12h } from '../../lib/time-format';
let LANG_HI = localStorage.getItem('pp-lang') === 'hi';
function tr(en, hi) { return LANG_HI ? hi : en; }
const WD_EN=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI=['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN=['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI=['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(y,m,d){const wd=new Date(Date.UTC(y,m-1,d,12)).getUTCDay();return tr(`${WD_EN[wd]}, ${d} ${MO_EN[m-1]} ${y}`,`${WD_HI[wd]}, ${d} ${MO_HI[m-1]} ${y}`);}
const LOCS=LOCATIONS.map(l=>({name:l.name,nameHi:l.nameHi,lat:l.lat,lng:l.lng,tz:l.tzOffset}));

const BIRDS=['Vulture','Owl','Crow','Cock','Peacock'];
const BIRDS_HI=['गिद्ध','उल्लू','कौआ','मुर्गा','मोर'];
const BIRD_EMOJI=['🦅','🦉','🐦‍⬛','🐓','🦚'];
const BIRD_DESC=[
'Powerful, far-sighted and commanding. Vulture-born are natural leaders with sharp vision, ambition and the ability to rise above obstacles.',
'Wise, introspective and patient. Owl-born possess deep intuition, work well at night, and excel in research and contemplation.',
'Clever, social and adaptable. Crow-born are resourceful communicators, quick learners and skilled at networking.',
'Energetic, disciplined and alert. Cock-born are punctual, courageous and thrive on routine, leadership and protection of others.',
'Charming, creative and graceful. Peacock-born are artistic, attractive and expressive, drawing admiration wherever they go.'];
const BIRD_DESC_HI=[
'शक्तिशाली, दूरदर्शी और प्रभावशाली। गिद्ध-जनित लोग तीक्ष्ण दृष्टि, महत्वाकांक्षा और बाधाओं से ऊपर उठने की क्षमता वाले स्वाभाविक नेता होते हैं।',
'बुद्धिमान, आत्मनिरीक्षक और धैर्यवान। उल्लू-जनित लोगों में गहरा अंतर्ज्ञान होता है, वे रात में अच्छा काम करते हैं और शोध व चिंतन में उत्कृष्ट होते हैं।',
'चतुर, मिलनसार और अनुकूलनशील। कौआ-जनित लोग साधनसंपन्न संचारक, तीव्र सीखने वाले और नेटवर्किंग में कुशल होते हैं।',
'ऊर्जावान, अनुशासित और सतर्क। मुर्गा-जनित लोग समयनिष्ठ, साहसी होते हैं और दिनचर्या, नेतृत्व व दूसरों की रक्षा में फलते-फूलते हैं।',
'आकर्षक, रचनात्मक और सुंदर। मोर-जनित लोग कलात्मक, आकर्षक और अभिव्यंजक होते हैं, जहां भी जाते हैं प्रशंसा बटोरते हैं।'];
const ACTIVITIES=['Ruling','Eating','Walking','Sleeping','Dying'];
const ACTIVITIES_HI=['शासन','भोजन','चलना','सोना','मरना'];
const ACT_Q=['Best','Good','Neutral','Unfavorable','Worst'];
const ACT_Q_HI=['सर्वश्रेष्ठ','अच्छा','सामान्य','प्रतिकूल','सबसे खराब'];
const ACT_COLOR=['#15803d','#65a30d','#b45309','#ea580c','#dc2626'];

const sel=document.getElementById('f-city');function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(LANG_HI?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();
document.getElementById('f-date').value=new Date().toISOString().split('T')[0];
document.getElementById('f-time').value='12:00';

const fmtMins = formatMinutes12h;

// Shared period-list renderer: PakshiPeriod[] from computePanchaPakshi() + the current
// instant's minutes-since-midnight (for the live "NOW" highlight, client-only by design).
function makePeriods(periods,nowMins){
  return periods.map(p=>{
    const s=p.start,e=p.end;
    const cur=(s>=1440?nowMins+1440:nowMins)>=s&&(s>=1440?nowMins+1440:nowMins)<e;
    return `<div style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:8px;background:${cur?'var(--color-ink)':'var(--color-canvas-soft-2)'};">
      <span style="width:8px;height:8px;border-radius:50%;background:${ACT_COLOR[p.activityIdx]};flex-shrink:0;"></span>
      <div style="flex:1;">
        <p style="font-size:13px;font-weight:600;color:${cur?'#fff':'var(--color-ink)'};margin:0;">${tr(ACTIVITIES[p.activityIdx],ACTIVITIES_HI[p.activityIdx])} <span style="font-size:11px;font-weight:500;color:${cur?'rgba(255,255,255,0.6)':ACT_COLOR[p.activityIdx]};">· ${tr(ACT_Q[p.activityIdx],ACT_Q_HI[p.activityIdx])}${cur?' · '+tr('NOW','अभी'):''}</span></p>
        <p style="font-size:11px;color:${cur?'rgba(255,255,255,0.6)':'var(--color-mute)'};margin:1px 0 0;font-family:var(--font-mono);">${fmtMins(s)} – ${fmtMins(e)}</p>
      </div>
    </div>`;
  }).join('');
}

function calculate(){
  try{
    const dateStr=document.getElementById('f-date').value;
    const timeStr=document.getElementById('f-time').value||'12:00';
    const loc=LOCS.find(l=>l.name===document.getElementById('f-city').value)||LOCS[0];
    const [y,m,d]=dateStr.split('-').map(Number);const [hh,mm]=timeStr.split(':').map(Number);
    const de=document.getElementById('date-echo');
    if(de){de.textContent=tr('Date of birth: ','जन्म तिथि: ')+formatLongDate(y,m,d);de.hidden=false;}
    const birthBird=pakshiBirthBird(y,m,d,hh+mm/60,loc.tz);

    document.getElementById('bird-emoji').textContent=BIRD_EMOJI[birthBird];
    document.getElementById('bird-name').textContent=`${BIRDS[birthBird]} · ${BIRDS_HI[birthBird]}`;
    document.getElementById('bird-desc').textContent=tr(BIRD_DESC[birthBird],BIRD_DESC_HI[birthBird]);

    // Today's periods -- "today"/"now" (calendar date, minutes-since-midnight) must be
    // evaluated in the SELECTED location's local time, not the visitor's own device
    // timezone (this page is location-selectable) and not UTC. Shift the real instant by
    // the same loc.tz computePanchaPakshi() uses internally, then read everything back
    // with UTC getters -- host-timezone-independent by construction, same pattern as the
    // daily Rashifal IST fix, but parameterized on the selected location instead of a
    // hardcoded +5:30.
    const now=new Date();
    const locNow=new Date(now.getTime()+loc.tz*3600000);
    const ty=locNow.getUTCFullYear(),tm=locNow.getUTCMonth()+1,td=locNow.getUTCDate();
    const result=computePanchaPakshi(ty,tm,td,loc.lat,loc.lng,loc.tz,birthBird);
    const nowMins=locNow.getUTCHours()*60+locNow.getUTCMinutes();
    document.getElementById('period-sub').textContent=`${formatLongDate(ty,tm,td)} · ${tr('Day ruling bird','दिन का शासक पक्षी')}: ${tr(BIRDS[result.dayBird],BIRDS_HI[result.dayBird])} · ${tr('Sunrise','सूर्योदय')} ${fmtMins(result.srMins)}, ${tr('Sunset','सूर्यास्त')} ${fmtMins(result.ssMins)}`;

    document.getElementById('day-periods').innerHTML=makePeriods(result.day,nowMins);
    document.getElementById('night-periods').innerHTML=makePeriods(result.night,nowMins);

    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){const er=document.getElementById('err');er.style.display='block';er.textContent='Calculation error: '+e.message;}
}
const NAK_NAMES=['Ashwini','Bharani','Krittika','Rohini','Mrigashira','Ardra','Punarvasu','Pushya','Ashlesha','Magha','Purva Phalguni','Uttara Phalguni','Hasta','Chitra','Swati','Vishakha','Anuradha','Jyeshtha','Mula','Purva Ashadha','Uttara Ashadha','Shravana','Dhanishtha','Shatabhisha','Purva Bhadrapada','Uttara Bhadrapada','Revati'];
document.getElementById('f-nak').innerHTML=NAK_NAMES.map((n,i)=>`<option value="${i}">${i+1}. ${n}</option>`).join('');
document.getElementById('f-city2').innerHTML=LOCS.map(l=>`<option>${l.name}</option>`).join('');
function calculateByNak(){
  try{
    const nakIdx=parseInt(document.getElementById('f-nak').value);
    const loc=LOCS.find(l=>l.name===document.getElementById('f-city2').value)||LOCS[0];
    const birthBird=nakIdx%5;
    document.getElementById('bird-emoji').textContent=BIRD_EMOJI[birthBird];
    document.getElementById('bird-name').textContent=`${BIRDS[birthBird]} \xb7 ${BIRDS_HI[birthBird]}`;
    document.getElementById('bird-desc').textContent=tr(BIRD_DESC[birthBird],BIRD_DESC_HI[birthBird]);
    // Same location-timezone anchoring as calculate() above -- see its comment.
    const now=new Date();
    const locNow=new Date(now.getTime()+loc.tz*3600000);
    const ty=locNow.getUTCFullYear(),tm=locNow.getUTCMonth()+1,td=locNow.getUTCDate();
    const result=computePanchaPakshi(ty,tm,td,loc.lat,loc.lng,loc.tz,birthBird);
    const nowMins=locNow.getUTCHours()*60+locNow.getUTCMinutes();
    document.getElementById('period-sub').textContent=`${formatLongDate(ty,tm,td)} \xb7 ${tr('Day ruling bird','दिन का शासक पक्षी')}: ${tr(BIRDS[result.dayBird],BIRDS_HI[result.dayBird])} \xb7 ${tr('Sunrise','सूर्योदय')} ${fmtMins(result.srMins)}, ${tr('Sunset','सूर्यास्त')} ${fmtMins(result.ssMins)}`;
    document.getElementById('day-periods').innerHTML=makePeriods(result.day,nowMins);
    document.getElementById('night-periods').innerHTML=makePeriods(result.night,nowMins);
    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){const er=document.getElementById('err');er.style.display='block';er.textContent='Calculation error: '+e.message;}
}
document.getElementById('f-calc-nak').addEventListener('click',calculateByNak);
document.getElementById('f-calc').addEventListener('click',calculate);
calculate();

function applyPageLang(hindi) {
  LANG_HI = hindi;
  renderCityOptions();
  document.querySelectorAll('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? el.dataset.hi : el.dataset.en;
  });
  calculate();
}
document.addEventListener('langchange', (e) => {
  applyPageLang(e.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
