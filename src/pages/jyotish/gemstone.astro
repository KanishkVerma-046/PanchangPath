---
import Layout from '../../layouts/Layout.astro';
import { PLANET_ICONS } from '../../lib/icons/planets';
---

<Layout title="Gemstone Calculator — Find Your Lucky Stone — PanchangPath" description="Find your lucky gemstone (ratna) based on your Vedic birth chart. Get the primary stone for your Lagna lord plus wearing instructions — metal, finger, day and substitutes.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">रत्न · GEMSTONE CALCULATOR</p>
      <h1 data-hi="रत्न कैलकुलेटर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Gemstone Calculator</h1>
      <p data-hi="अपनी जन्म कुंडली में लग्न और शुभ ग्रहों की स्थिति के आधार पर अपने लिए अनुशंसित रत्न जानें।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:520px;">Discover the gemstone (ratna) recommended for you based on your Lagna and the placement of benefic planets in your birth chart.</p>
    </div>
  </section>

  <section style="padding:28px 0 56px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div><label for="f-date" class="fld-label" data-hi="जन्म तिथि">Date of Birth</label><input type="date" id="f-date" class="input" style="height:38px;" /></div>
        <div><label for="f-time" class="fld-label" data-hi="जन्म समय">Time of Birth</label><input type="time" id="f-time" class="input" style="height:38px;" /></div>
        <div><label for="f-city" class="fld-label" data-hi="स्थान">Place</label><select id="f-city" class="input" style="height:38px;min-width:150px;"></select></div>
        <button id="f-calc" class="btn-primary" data-hi="गणना करें" style="height:38px;padding:0 20px;">Calculate</button>
      </div>

      <div id="result" style="display:none;">
        <div class="card" style="padding:20px;margin-bottom:24px;">
          <div id="birth-info" style="display:flex;gap:24px;flex-wrap:wrap;"></div>
        </div>
        <h3 data-hi="मुख्य अनुशंसा" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">Primary Recommendation</h3>
        <p data-hi="आपके लग्न स्वामी का जीवन रत्न — आमतौर पर आजीवन पहनने के लिए सुरक्षित।" style="font-size:12.5px;color:var(--color-mute);margin:0 0 14px;">The life-stone (Jeevan Ratna) for your Lagna lord — generally safe to wear lifelong.</p>
        <div id="primary-gem" style="margin-bottom:28px;"></div>
        <h3 data-hi="सहायक रत्न" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Supporting Gemstones</h3>
        <div id="secondary-gems" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;"></div>
      </div>
      <div id="err" style="display:none;padding:16px;background:var(--color-inauspicious-soft);border-radius:8px;color:#b91c1c;font-size:14px;"></div>

      <div class="card" style="padding:28px;margin-top:36px;">
        <h2 data-hi="रत्न चिकित्सा के बारे में" style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 12px;">About Gemstone Therapy</h2>
        <p data-hi="ज्योतिष में, नौ ग्रहों में से प्रत्येक एक मुख्य रत्न से जुड़ा होता है। सही रत्न पहनने से उस ग्रह की ऊर्जा मजबूत होने की मान्यता है। सबसे सामान्यतः अनुशंसित रत्न लग्न स्वामी का होता है, जो समग्र जीवनशक्ति और जीवन-दिशा का समर्थन करता है।" style="font-size:14px;color:var(--color-body-text);line-height:1.7;margin:0 0 10px;">In Jyotish, each of the nine grahas is associated with a primary gemstone. Wearing the right stone is believed to strengthen the energy of its planet. The most commonly recommended stone is that of the Lagna lord, which supports overall vitality and life direction.</p>
        <p data-hi="ध्यान दें: रत्न चयन अत्यंत व्यक्तिगत है। मजबूत अशुभ स्थितियों में सावधानी बरतनी चाहिए। नीलम जैसा शक्तिशाली रत्न पहनने से पहले किसी योग्य ज्योतिषी से परामर्श अवश्य लें।" style="font-size:13px;color:var(--color-mute);line-height:1.7;margin:0;">Note: Gemstone selection is highly individual. Strong malefic placements may call for caution. Please consult a qualified astrologer before wearing a powerful stone such as Blue Sapphire (Neelam).</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .fld-label { font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em; }
</style>

<script>
import { LOCATIONS } from '../../lib/locations';
import { PLANET_ICONS } from '../../lib/icons/planets';
import { sunTrueLongitude as sunLon, moonLongitude as moonLon, lahiriAyanamsha as ayanamsha } from '../../lib/panchang';
import { calcLagna } from '../../lib/astro-core';
function planetIconSvg(id,size,color){return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="${color||'currentColor'}" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${PLANET_ICONS[id]}</svg>`;}
let LANG_HI = localStorage.getItem('pp-lang') === 'hi';
function tr(en, hi) { return LANG_HI ? hi : en; }
const LOCS=LOCATIONS.map(l=>({name:l.name,lat:l.lat,lng:l.lng,tz:l.tzOffset}));
function toJD(y,m,d,h){h=h||0;if(m<=2){y--;m+=12;}const A=Math.floor(y/100),B=2-A+Math.floor(A/4);return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;}
const n360=a=>((a%360)+360)%360;
const toR=d=>d*Math.PI/180;
const toD=r=>r*180/Math.PI;

const RASHI=['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RASHI_EN=['Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius','Capricorn','Aquarius','Pisces'];
const LORD=['Mars','Venus','Mercury','Moon','Sun','Mercury','Venus','Mars','Jupiter','Saturn','Saturn','Jupiter'];
// Trikona (1,5,9) lords are most benefic for a Lagna; we recommend Lagna lord + 5th + 9th lords
const GEMS={
Sun:{p:'Surya',stone:'Ruby',h:'माणिक्य',sub:'Red Garnet',subHi:'लाल गार्नेट',metal:'Gold',metalHi:'सोना',finger:'Ring',fingerHi:'अनामिका',day:'Sunday',dayHi:'रविवार',color:'#dc2626',desc:'Enhances leadership, vitality, and confidence. Recommended for a weak Sun.',descHi:'नेतृत्व क्षमता, जीवनशक्ति और आत्मविश्वास बढ़ाता है। कमजोर सूर्य के लिए अनुशंसित।'},
Moon:{p:'Chandra',stone:'Pearl',h:'मोती',sub:'Moonstone',subHi:'मूनस्टोन',metal:'Silver',metalHi:'चांदी',finger:'Little',fingerHi:'कनिष्ठा',day:'Monday',dayHi:'सोमवार',color:'#6366f1',desc:'Brings emotional stability, clarity of mind, and strengthens intuition.',descHi:'भावनात्मक स्थिरता, मानसिक स्पष्टता लाता है और अंतर्ज्ञान को मजबूत करता है।'},
Mars:{p:'Mangal',stone:'Red Coral',h:'मूंगा',sub:'Red Carnelian',subHi:'लाल कार्नेलियन',metal:'Gold/Copper',metalHi:'सोना/तांबा',finger:'Ring',fingerHi:'अनामिका',day:'Tuesday',dayHi:'मंगलवार',color:'#f97316',desc:'Boosts courage, energy, and helps overcome obstacles and enemies.',descHi:'साहस और ऊर्जा बढ़ाता है, बाधाओं व शत्रुओं पर विजय पाने में सहायक है।'},
Mercury:{p:'Budha',stone:'Emerald',h:'पन्ना',sub:'Green Tourmaline',subHi:'हरा टूमलाइन',metal:'Gold',metalHi:'सोना',finger:'Little',fingerHi:'कनिष्ठा',day:'Wednesday',dayHi:'बुधवार',color:'#10b981',desc:'Improves intellect, communication, business acumen, and memory.',descHi:'बुद्धि, संचार, व्यापारिक कुशलता और स्मरण शक्ति में सुधार करता है।'},
Jupiter:{p:'Guru',stone:'Yellow Sapphire',h:'पुखराज',sub:'Yellow Topaz / Citrine',subHi:'येलो टोपाज़ / सिट्रीन',metal:'Gold',metalHi:'सोना',finger:'Index',fingerHi:'तर्जनी',day:'Thursday',dayHi:'गुरुवार',color:'#f59e0b',desc:'Brings wisdom, prosperity, good fortune, and spiritual growth.',descHi:'ज्ञान, समृद्धि, सौभाग्य और आध्यात्मिक विकास लाता है।'},
Venus:{p:'Shukra',stone:'Diamond',h:'हीरा',sub:'White Sapphire / Zircon',subHi:'व्हाइट सफायर / जिरकॉन',metal:'White Gold/Platinum',metalHi:'व्हाइट गोल्ड/प्लेटिनम',finger:'Middle',fingerHi:'मध्यमा',day:'Friday',dayHi:'शुक्रवार',color:'#a78bfa',desc:'Attracts love, luxury, beauty, and material comforts.',descHi:'प्रेम, वैभव, सौंदर्य और भौतिक सुख-सुविधाएं आकर्षित करता है।'},
Saturn:{p:'Shani',stone:'Blue Sapphire',h:'नीलम',sub:'Amethyst / Blue Spinel',subHi:'एमेथिस्ट / ब्लू स्पिनल',metal:'Gold/Silver',metalHi:'सोना/चांदी',finger:'Middle',fingerHi:'मध्यमा',day:'Saturday',dayHi:'शनिवार',color:'#3b82f6',desc:'Removes obstacles, brings discipline, longevity, and career stability.',descHi:'बाधाएं दूर करता है, अनुशासन, दीर्घायु और करियर स्थिरता लाता है।'}};

const sel=document.getElementById('f-city');sel.innerHTML=LOCS.map(l=>`<option>${l.name}</option>`).join('');
document.getElementById('f-date').value=new Date().toISOString().split('T')[0];
document.getElementById('f-time').value='12:00';

function gemCard(planet,big,roleLabel){
  const g=GEMS[planet];
  return `<div class="card" style="padding:18px;border-top:3px solid ${g.color};">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:10px;">
      <span style="width:${big?40:32}px;height:${big?40:32}px;border-radius:50%;background:${g.color};flex-shrink:0;box-shadow:0 0 0 4px ${g.color}22;display:flex;align-items:center;justify-content:center;color:#fff;">${planetIconSvg(g.p.toLowerCase(),big?22:18,'#fff')}</span>
      <div>
        <h4 style="font-size:${big?17:15}px;font-weight:700;color:var(--color-ink);margin:0;">${g.stone} · ${g.h}</h4>
        <p style="font-size:11.5px;color:var(--color-mute);margin:1px 0 0;">${roleLabel} · ${planet} (${g.p})</p>
      </div>
    </div>
    <p style="font-size:12.5px;color:var(--color-body-text);line-height:1.6;margin:0 0 12px;">${tr(g.desc,g.descHi)}</p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px 14px;font-size:12px;">
      ${[[tr('Metal','धातु'),tr(g.metal,g.metalHi)],[tr('Finger','उंगली'),tr(g.finger,g.fingerHi)],[tr('Day','दिन'),tr(g.day,g.dayHi)],[tr('Substitute','विकल्प'),tr(g.sub,g.subHi)]].map(r=>
        `<div><span style="color:var(--color-mute);">${r[0]}: </span><span style="color:var(--color-ink);font-weight:600;">${r[1]}</span></div>`).join('')}
    </div></div>`;
}

function calculate(){
  try{
    const dateStr=document.getElementById('f-date').value;
    const timeStr=document.getElementById('f-time').value||'12:00';
    const loc=LOCS.find(l=>l.name===document.getElementById('f-city').value)||LOCS[0];
    const [y,m,d]=dateStr.split('-').map(Number);const [hh,mm]=timeStr.split(':').map(Number);
    const jd=toJD(y,m,d,(hh+mm/60)-loc.tz);
    const ay=ayanamsha(jd);
    const lagnaSign=Math.floor(n360(calcLagna(jd,loc.lat,loc.lng)-ay)/30);
    const moonSign=Math.floor(n360(moonLon(jd)-ay)/30);
    const sunSign=Math.floor(n360(sunLon(jd)-ay)/30);

    document.getElementById('birth-info').innerHTML=[
      [tr('Lagna (Asc)','लग्न'),`${RASHI[lagnaSign]} (${RASHI_EN[lagnaSign]})`],
      [tr('Moon Rashi','चंद्र राशि'),`${RASHI[moonSign]} (${RASHI_EN[moonSign]})`],
      [tr('Sun Rashi','सूर्य राशि'),`${RASHI[sunSign]} (${RASHI_EN[sunSign]})`],
    ].map(r=>`<div><p class="caption-mono" style="color:var(--color-mute);margin:0 0 3px;">${r[0]}</p><p style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0;">${r[1]}</p></div>`).join('');

    const lagnaLord=LORD[lagnaSign];
    const fifthLord=LORD[(lagnaSign+4)%12];
    const ninthLord=LORD[(lagnaSign+8)%12];
    document.getElementById('primary-gem').innerHTML=gemCard(lagnaLord,true,tr('Lagna Lord (Life-Stone)','लग्न स्वामी (जीवन रत्न)'));

    const sec=[];const seen=new Set([lagnaLord]);
    if(!seen.has(fifthLord)){sec.push(gemCard(fifthLord,false,tr('5th Lord (Trikona)','पंचम स्वामी (त्रिकोण)')));seen.add(fifthLord);}
    if(!seen.has(ninthLord)){sec.push(gemCard(ninthLord,false,tr('9th Lord (Trikona)','नवम स्वामी (त्रिकोण)')));seen.add(ninthLord);}
    // Always offer Moon stone for the mind if not already there
    const moonLord='Moon';if(!seen.has(moonLord)){sec.push(gemCard(moonLord,false,tr('For Mind & Emotions','मन और भावनाओं हेतु')));seen.add(moonLord);}
    document.getElementById('secondary-gems').innerHTML=sec.join('');
    document.getElementById('result').style.display='block';
    document.getElementById('err').style.display='none';
  }catch(e){const er=document.getElementById('err');er.style.display='block';er.textContent='Calculation error: '+e.message;}
}
document.getElementById('f-calc').addEventListener('click',calculate);
calculate();

function applyPageLang(hindi) {
  LANG_HI = hindi;
  document.querySelectorAll('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? el.dataset.hi : el.dataset.en;
  });
  calculate();
}
document.addEventListener('langchange', (e) => {
  applyPageLang(e.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
