  @media (max-width: 1024px) {
    .panchang-grid { grid-template-columns: repeat(3, 1fr) !important; }
  }
  @media (max-width: 640px) {
    .panchang-grid { grid-template-columns: 1fr 1fr !important; }
    #pancha-grid > div:last-child { grid-column: span 2; }
  }
  @media (max-width: 768px) {
    #festivals-grid { grid-template-columns: 1fr 1fr !important; }
    #features-grid { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 480px) {
    #festivals-grid { grid-template-columns: 1fr !important; }
    #features-grid { grid-template-columns: 1fr !important; }
    #sun-moon-grid { grid-template-columns: 1fr 1fr !important; }
    #sun-abhijit-grid { grid-template-columns: 1fr !important; }
  }
</style>
</Layout>
