// Return i18n translations for the current lang (null for en/hi)
function getI18N() {
  if (currentLang === 'en' || currentLang === 'hi') return null;
  return clientI18N[currentLang] || null;
}

// Look up regional tithi name (tithiNumber 1-30)
function regionalTithi(tithiNumber: number, paksha: string): string | null {
  const i = getI18N(); if (!i) return null;
  const idx = (tithiNumber - 1) % 15;
  return (paksha === 'Shukla' ? i.tithiShukla[idx] : i.tithiKrishna[idx]) || null;
}

// Look up regional nakshatra name (0-based)
function regionalNakshatra(idx: number): string | null {
  const i = getI18N(); if (!i) return null;
  return i.nakshatras[idx] || null;
}

// Look up regional vara name (weekday 0=Sun)
function regionalVara(weekday: number): string | null {
  const i = getI18N(); if (!i) return null;
  return i.varas[weekday] || null;
}

// Look up regional month name using sun sidereal longitude
function regionalMonth(sunSidereal: number, amantaMonthName: string): string | null {
  const i = getI18N(); if (!i) return null;
  if (i.monthSystem === 'solar') {
    const sunRashiIdx = Math.floor(sunSidereal / 30) % 12;
    const monthIdx = (i.solarMonthMap as number[])[sunRashiIdx];
    return i.months[monthIdx] || null;
  }
  // Lunar: map amanta month name to 0-based index
  const AMANTA_IDX: Record<string, number> = {
    Chaitra:0,Vaishakha:1,Jyeshtha:2,Ashadha:3,Shravana:4,Bhadrapada:5,
    Ashwin:6,Kartika:7,Margashirsha:8,Pausha:9,Magha:10,Phalguna:11,
  };
  return i.months[AMANTA_IDX[amantaMonthName] ?? 0] || null;
}

// Regional paksha labels
function regionalPaksha(paksha: string): string | null {
  const i = getI18N(); if (!i) return null;
  return i.paksha[paksha === 'Shukla' ? 0 : 1] || null;
}

function calcPanchang(date: Date, loc: Location) {
  const year = date.getFullYear(), month = date.getMonth()+1, day = date.getDate();
  const hour = 6 - loc.tzOffset;
  const jd = julianDay(year, month, day, hour);
  const sLon = sunTrueLon(jd);
  const mLon = moonLon(jd);
  const ay = ayanamsha(jd);
  const sSid = norm360(sLon - ay);
  const mSid = norm360(mLon - ay);
  const elong = norm360(mLon - sLon);
  const tithiIdx = Math.floor(elong / 12) % 30;
  const paksha = tithiIdx < 15 ? 'Shukla' : 'Krishna';
  const nIdx = Math.floor(mSid / (360/27)) % 27;
  const pada = Math.floor((mSid % (360/27)) / (360/27/4)) + 1;
  const yLon = norm360(sSid + mSid);
  const yIdx = Math.floor(yLon / (360/27)) % 27;
  const kIdx = Math.floor(elong / 6) % 60;
  const wd = date.getDay();
  const srUTC = sunriseUTC(jd, loc.lat, loc.lng, true);
  const ssUTC = sunriseUTC(jd, loc.lat, loc.lng, false);
  const srMins = srUTC * 60 + loc.tzOffset * 60;
  const ssMins = ssUTC * 60 + loc.tzOffset * 60;
  const dayMins = ssMins - srMins;
  const slotDur = dayMins / 8;
  const slot = (s: number) => ({ start: minsToFmt(srMins + s * slotDur), end: minsToFmt(srMins + (s+1) * slotDur) });
  srMinsGlobal = srMins; // store for 24+ format

  const jd0 = jd - hour / 24;
  const moonAge = elong / 360 * 29.53;
  const moonriseSeedUTC = srUTC + moonAge * 0.8;
  const moonsetSeedUTC = moonriseSeedUTC + 12.42;
  const moonriseUTC = moonRiseSetUTC(jd0, loc.lat, loc.lng, true, moonriseSeedUTC);
  const moonsetUTC = moonRiseSetUTC(jd0, loc.lat, loc.lng, false, moonsetSeedUTC);
  const noonMins = (srMins + ssMins) / 2;
  const abStart = noonMins - dayMins / 30, abEnd = noonMins + dayMins / 30;
  return {
    vara: { name: VARAS[wd], nameHi: VARAS_HI[wd], lord: VARA_LORDS[wd] },
    tithi: { name: TITHIS[tithiIdx], nameHi: TITHIS_HI[tithiIdx], paksha, pakshaNi: paksha==='Shukla'?'शुक्ल':'कृष्ण', type: TITHI_TYPES[tithiIdx], endTime: estimateEnd(jd, 12, loc.tzOffset, j => norm360(moonLon(j) - sunTrueLon(j))) },
    nakshatra: { name: NAKSHATRAS[nIdx], nameHi: NAKSHATRAS_HI[nIdx], lord: NAKSHATRA_LORDS[nIdx], pada, endTime: estimateEnd(jd, 360/27, loc.tzOffset, j => norm360(moonLon(j) - ayanamsha(j))) },
    yoga: { name: YOGAS[yIdx], nameHi: YOGAS_HI[yIdx], type: YOGA_TYPES[yIdx], endTime: estimateEnd(jd, 360/27, loc.tzOffset, j => norm360(norm360(sunTrueLon(j) - ayanamsha(j)) + norm360(moonLon(j) - ayanamsha(j)))) },
    karana: { name: KARANAS[kIdx]||'Bava', nameHi: KARANAS_HI[kIdx]||'बव', endTime: estimateEnd(jd, 6, loc.tzOffset, j => norm360(moonLon(j) - sunTrueLon(j))) },
    sunrise: fmtTime(srUTC, loc.tzOffset),
    sunset: fmtTime(ssUTC, loc.tzOffset),
    moonrise: fmtTime(moonriseUTC, loc.tzOffset),
    moonset: fmtTime(moonsetUTC, loc.tzOffset),
    durationDay: `${Math.floor(dayMins/60)}h ${Math.round(dayMins%60)}m`,
    rahuKalam: slot(RAHU[wd]),
    gulikaKalam: slot(GULIKA[wd]),
    yamaganda: slot(YAMA[wd] < 8 ? YAMA[wd] : 7),
    abhijitMuhurta: { start: minsToFmt(abStart), end: minsToFmt(abEnd) },
    srMins, ssMins,
    sunSidereal: sSid,
    moonSidereal: mSid,
    tithiPaksha: paksha as 'Shukla' | 'Krishna',
  };
}

