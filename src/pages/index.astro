---
import Layout from '../layouts/Layout.astro';
import MandalaWatermark from '../components/motifs/MandalaWatermark.astro';
import LotusDivider from '../components/motifs/LotusDivider.astro';
import PanchangSummaryCard from '../components/PanchangSummaryCard.astro';
import KundaliWidget from '../components/KundaliWidget.astro';
import FestivalFeed from '../components/FestivalFeed.astro';
import PlanetaryEventsFeed from '../components/PlanetaryEventsFeed.astro';
import RashifalFeed from '../components/RashifalFeed.astro';
import VedicClock from '../components/VedicClock.astro';
import { calculatePanchang, getHinduCalendarInfo } from '../lib/panchang';
import { getUpcomingFestivals, getTodayFestivals, daysUntil } from '../lib/festivals';
import { computeUpcomingEvents } from '../lib/planetaryEvents';
import { getDefaultLocation } from '../lib/locations';
import { formatDateAtOffset } from '../lib/date-i18n';
import { parseMinutes12h } from '../lib/time-format';

const today = new Date();
const loc = getDefaultLocation(); // New Delhi, will be overridden client-side
const panchang = calculatePanchang(today, loc.lat, loc.lng, loc.tzOffset);
const hinduCal = getHinduCalendarInfo(today, panchang.sunLongitude, panchang.moonLongitude, panchang.tithi.paksha);
const todayFestivals = getTodayFestivals(today);
const upcoming = getUpcomingFestivals(today, 8);
const planetaryEvents = computeUpcomingEvents(today, 180);

// Build-time label for the default location's (New Delhi/IST) calendar day -- must read
// loc.tzOffset-shifted fields, not the build machine's own local calendar date (which is
// UTC on the daily-rebuild GitHub Actions runner, and therefore always ~1 day behind IST
// at the 00:17 IST build time). Matches the pattern panchang.vara/calculatePanchang()
// already used correctly via localCivilDate() -- see 2026-08-21 date-bug investigation.
const dateStr = formatDateAtOffset(today, loc.tzOffset, false, { weekday: 'long' });
const dateStrHi = formatDateAtOffset(today, loc.tzOffset, true, { weekday: 'long' });
const panchangDateLabel = formatDateAtOffset(today, loc.tzOffset, false, { month: 'short' });

// Day Timeline bar segments (Rahu/Gulika/Yama) — derived from the same panchang.rahuKalam/
// gulikaKalam/yamaganda/sunrise/sunset values already rendered as text above, so this can
// never disagree with them. The live "now" marker line stays client-only (see drawTimeline()
// in the <script> below) — a build-time snapshot of "now" would be stale by page-view time.
const tlSrMins = parseMinutes12h(panchang.sunrise);
const tlSsMins = parseMinutes12h(panchang.sunset);
const tlTotal = tlSsMins - tlSrMins;
const tlPct = (m: number) => Math.max(0, Math.min(100, ((m - tlSrMins) / tlTotal) * 100));
const TIMELINE_SEGMENTS = [
  { color: '#ef4444', label: 'Rahu', start: parseMinutes12h(panchang.rahuKalam.start), end: parseMinutes12h(panchang.rahuKalam.end) },
  { color: '#f59e0b', label: 'Gulika', start: parseMinutes12h(panchang.gulikaKalam.start), end: parseMinutes12h(panchang.gulikaKalam.end) },
  { color: '#8b5cf6', label: 'Yama', start: parseMinutes12h(panchang.yamaganda.start), end: parseMinutes12h(panchang.yamaganda.end) },
].map(s => ({ ...s, leftPct: tlPct(s.start), widthPct: tlPct(s.end) - tlPct(s.start) }));
---

<Layout
  title="Aaj Ka Panchang — Choghadiya & Rahu Kalam | PanchangPath"
  description="Free Hindu Panchang, Muhurta, Kundali, Rashifal and festival calendar — Tithi, Nakshatra, Rahu Kalam, Choghadiya and more. Drik calculations, Lahiri Ayanamsha."
  imageAlt="PanchangPath — today's Hindu Panchang with Tithi, Nakshatra, Rahu Kalam and Muhurat timings"
>
  <!-- HERO -->
  <section style="position:relative;overflow:hidden;background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);">
    <div class="gradient-mesh" style="position:absolute;inset:0;pointer-events:none;opacity:0.7;"></div>
    <MandalaWatermark />
    <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px;position:relative;padding-top:56px;padding-bottom:48px;">

      <!-- Festival badge -->
      {todayFestivals.length > 0 && (
        <div style="margin-bottom:20px;">
          <a href="/festivals" style="display:inline-flex;align-items:center;gap:8px;background:var(--color-saffron-soft);color:var(--color-saffron-deep);font-size:13px;font-weight:500;padding:5px 12px;border-radius:100px;text-decoration:none;border:1px solid rgba(255,153,51,0.3);">
            <span>🪔</span>
            <span class="en-text">{todayFestivals[0].name} today</span>
            <span class="hi-text" style="display:none">आज {todayFestivals[0].nameHi} है</span>
            <span style="opacity:0.6;">→</span>
          </a>
        </div>
      )}

      <!-- Headline -->
      <h1 style="font-size:42px;font-weight:600;letter-spacing:-1.6px;line-height:1.05;color:var(--color-ink);margin:0 0 16px;max-width:680px;" id="hero-title">
        <span class="en-text">Today's Panchang.</span>
        <span class="hi-text" style="display:none">आज का पंचांग.</span>
      </h1>
      <p style="font-size:17px;color:var(--color-body-text);margin:0 0 32px;line-height:1.6;max-width:520px;" id="hero-sub">
        <span class="en-text">Precise Hindu almanac for <strong id="loc-display" style="color:var(--color-ink);">{loc.name}</strong> — auto-detected from your location.</span>
        <span class="hi-text" style="display:none"><strong id="loc-display-hi" style="color:var(--color-ink);">{loc.nameHi ?? loc.name}</strong> के लिए सटीक हिंदू पंचांग — आपके स्थान से स्वतः पहचाना गया।</span>
      </p>

      <!-- Controls row -->
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
        <!-- Date picker -->
        <div style="display:flex;align-items:center;gap:8px;background:var(--color-canvas);border:1px solid var(--color-hairline);border-radius:8px;padding:6px 12px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-mute)" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          <input type="date" id="date-picker" aria-label="Select date" class="input" style="border:none;background:transparent;height:auto;padding:0;font-size:14px;width:140px;color:var(--color-ink);"
            value={today.toISOString().split('T')[0]} />
        </div>
        <!-- Location is set via 📍 pin in the header -->
      </div>

      <!-- Date display -->
      <p class="caption-mono" style="color:var(--color-mute);margin-top:20px;" id="date-display" data-hi={dateStrHi}>{dateStr}</p>
    </div>
  </section>

  <!-- PANCHANG SUMMARY CARD -->
  <PanchangSummaryCard
    city={loc.name}
    cityHi={loc.nameHi ?? loc.name}
    dateStr={dateStr}
    panchang={panchang}
    hinduCal={hinduCal}
  />

  <!-- VEDIC TIME CLOCK -->
  <VedicClock />

  <!-- LAGNA KUNDALI WIDGET -->
  <KundaliWidget />

  <!-- MAIN PANCHANG GRID -->
  <section style="padding:0 0 40px;" id="panchang-section">
    <h2 class="sr-only"><span class="en-text">Panchang Details</span><span class="hi-text" style="display:none">पंचांग विवरण</span></h2>
    <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <!-- Live indicator -->
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:24px;">
        <div style="position:relative;display:flex;align-items:center;justify-content:center;">
          <div class="live-pulse"></div>
          <div class="live-pulse-dot"></div>
        </div>
        <span class="caption-mono" style="color:var(--color-mute);"><span class="en-text">Panchang for</span><span class="hi-text" style="display:none">पंचांग</span> <span id="panchang-date-label">{panchangDateLabel}</span></span>
      </div>

      <!-- 5 Panchang elements -->
      <div style="display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:12px;" class="panchang-grid" id="pancha-grid">
        <!-- Vara -->
        <div class="card animate-in" style="padding:20px;animation-delay:0ms;">
          <p class="caption-mono" style="color:var(--color-data-label);margin:0 0 10px;"><span class="en-text">Vara</span><span class="hi-text" style="display:none">वार</span></p>
          <p class="en-text" style="font-size:22px;font-weight:600;letter-spacing:-0.5px;color:var(--color-data-value);margin:0 0 2px;" id="vara-name">{panchang.vara.name}</p>
          <p class="hi-text" style="font-size:18px;font-weight:600;color:var(--color-data-value);margin:0 0 2px;display:none;" id="vara-name-hi">{panchang.vara.nameHi}</p>
          <p style="font-size:12px;color:var(--color-mute);margin:0;"><span class="en-text">Lord: </span><span class="hi-text" style="display:none">स्वामी: </span><span id="vara-lord">{panchang.vara.lord}</span></p>
        </div>

        <!-- Tithi -->
        <div class="card animate-in" style="padding:20px;animation-delay:60ms;">
          <p class="caption-mono" style="color:var(--color-data-label);margin:0 0 10px;"><span class="en-text">Tithi</span><span class="hi-text" style="display:none">तिथि</span></p>
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:4px;">
            <div>
              <p class="en-text" style="font-size:20px;font-weight:600;letter-spacing:-0.5px;color:var(--color-data-value);margin:0 0 2px;" id="tithi-name">{panchang.tithi.paksha} {panchang.tithi.name}</p>
              <p class="hi-text" style="font-size:16px;font-weight:600;color:var(--color-data-value);margin:0 0 2px;display:none;" id="tithi-name-hi">{panchang.tithi.pakshaNi} {panchang.tithi.nameHi}</p>
            </div>
            <span class="badge" id="tithi-type" style="flex-shrink:0;font-size:10px;">{panchang.tithi.type}</span>
          </div>
          <p style="font-size:11px;color:var(--color-mute);margin:4px 0 0;font-family:var(--font-mono);font-variant-numeric:tabular-nums;"><span class="en-text">Ends: </span><span class="hi-text" style="display:none">समाप्ति: </span><span id="tithi-end">{panchang.tithi.endTime}</span></p>
        </div>

        <!-- Nakshatra -->
        <div class="card animate-in" style="padding:20px;animation-delay:120ms;">
          <p class="caption-mono" style="color:var(--color-data-label);margin:0 0 10px;"><span class="en-text">Nakshatra</span><span class="hi-text" style="display:none">नक्षत्र</span></p>
          <p class="en-text" style="font-size:20px;font-weight:600;letter-spacing:-0.5px;color:var(--color-data-value);margin:0 0 2px;" id="nakshatra-name">{panchang.nakshatra.name}</p>
          <p class="hi-text" style="font-size:16px;font-weight:600;color:var(--color-data-value);margin:0 0 2px;display:none;" id="nakshatra-name-hi">{panchang.nakshatra.nameHi}</p>
          <p style="font-size:11px;color:var(--color-mute);margin:2px 0;font-family:var(--font-mono);font-variant-numeric:tabular-nums;"><span class="en-text">Pada </span><span class="hi-text" style="display:none">पद </span><span id="nakshatra-meta">{panchang.nakshatra.pada} · {panchang.nakshatra.lord}</span></p>
          <p style="font-size:11px;color:var(--color-mute);margin:0;font-family:var(--font-mono);font-variant-numeric:tabular-nums;"><span class="en-text">Ends: </span><span class="hi-text" style="display:none">समाप्ति: </span><span id="nakshatra-end">{panchang.nakshatra.endTime}</span></p>
        </div>

        <!-- Yoga -->
        <div class="card animate-in" style="padding:20px;animation-delay:180ms;">
          <p class="caption-mono" style="color:var(--color-data-label);margin:0 0 10px;"><span class="en-text">Yoga</span><span class="hi-text" style="display:none">योग</span></p>
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:4px;">
            <div>
              <p class="en-text" style="font-size:20px;font-weight:600;letter-spacing:-0.5px;color:var(--color-data-value);margin:0 0 2px;" id="yoga-name">{panchang.yoga.name}</p>
              <p class="hi-text" style="font-size:16px;font-weight:600;color:var(--color-data-value);margin:0 0 2px;display:none;" id="yoga-name-hi">{panchang.yoga.nameHi}</p>
            </div>
            <span class="badge" id="yoga-type" style="flex-shrink:0;font-size:10px;">{panchang.yoga.type}</span>
          </div>
          <p style="font-size:11px;color:var(--color-mute);margin:4px 0 0;font-family:var(--font-mono);font-variant-numeric:tabular-nums;"><span class="en-text">Ends: </span><span class="hi-text" style="display:none">समाप्ति: </span><span id="yoga-end">{panchang.yoga.endTime}</span></p>
        </div>

        <!-- Karana -->
        <div class="card animate-in" style="padding:20px;animation-delay:240ms;">
          <p class="caption-mono" style="color:var(--color-data-label);margin:0 0 10px;"><span class="en-text">Karana</span><span class="hi-text" style="display:none">करण</span></p>
          <p class="en-text" style="font-size:20px;font-weight:600;letter-spacing:-0.5px;color:var(--color-data-value);margin:0 0 2px;" id="karana-name">{panchang.karana.name}</p>
          <p class="hi-text" style="font-size:16px;font-weight:600;color:var(--color-data-value);margin:0 0 2px;display:none;" id="karana-name-hi">{panchang.karana.nameHi}</p>
          <p style="font-size:11px;color:var(--color-mute);margin:4px 0 0;font-family:var(--font-mono);font-variant-numeric:tabular-nums;"><span class="en-text">Ends: </span><span class="hi-text" style="display:none">समाप्ति: </span><span id="karana-end">{panchang.karana.endTime}</span></p>
        </div>
      </div>

      <!-- Sun times + Muhurtas row -->
      <div id="sun-abhijit-grid" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
        <!-- Sun & Moon times -->
        <div class="card" style="padding:24px;min-width:0;">
          <p class="caption-mono" style="color:var(--color-data-label);margin:0 0 16px;"><span class="en-text">Sun & Moon</span><span class="hi-text" style="display:none">सूर्य व चन्द्र</span></p>
          <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:16px;">
            <div>
              <p style="font-size:11px;color:var(--color-data-label);margin:0 0 4px;font-family:var(--font-mono);"><span class="en-text">SUNRISE</span><span class="hi-text" style="display:none">सूर्योदय</span></p>
              <p style="font-size:18px;font-weight:600;letter-spacing:-0.3px;color:var(--color-data-value);font-variant-numeric:tabular-nums;margin:0;" id="sunrise">{panchang.sunrise}</p>
            </div>
            <div>
              <p style="font-size:11px;color:var(--color-data-label);margin:0 0 4px;font-family:var(--font-mono);"><span class="en-text">SUNSET</span><span class="hi-text" style="display:none">सूर्यास्त</span></p>
              <p style="font-size:18px;font-weight:600;letter-spacing:-0.3px;color:var(--color-data-value);font-variant-numeric:tabular-nums;margin:0;" id="sunset">{panchang.sunset}</p>
            </div>
            <div>
              <p style="font-size:11px;color:var(--color-data-label);margin:0 0 4px;font-family:var(--font-mono);"><span class="en-text">MOONRISE</span><span class="hi-text" style="display:none">चंद्रोदय</span></p>
              <p style="font-size:18px;font-weight:600;letter-spacing:-0.3px;color:var(--color-data-value);font-variant-numeric:tabular-nums;margin:0;" id="moonrise">{panchang.moonrise}</p>
            </div>
            <div>
              <p style="font-size:11px;color:var(--color-data-label);margin:0 0 4px;font-family:var(--font-mono);"><span class="en-text">DAY LENGTH</span><span class="hi-text" style="display:none">दिन की अवधि</span></p>
              <p style="font-size:18px;font-weight:600;letter-spacing:-0.3px;color:var(--color-data-value);font-variant-numeric:tabular-nums;margin:0;" id="day-duration">{panchang.durationDay}</p>
            </div>
          </div>
        </div>

        <!-- Abhijit Muhurta -->
        <div class="card" style="padding:24px;background:var(--color-canvas);min-width:0;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
            <p class="caption-mono" style="color:var(--color-data-label);margin:0;"><span class="en-text">Abhijit Muhurta</span><span class="hi-text" style="display:none">अभिजित मुहूर्त</span></p>
            <span class="badge-auspicious badge" style="font-size:10px;"><span class="en-text">Most Auspicious</span><span class="hi-text" style="display:none">सर्वाधिक शुभ</span></span>
          </div>
          <p class="en-text" style="font-size:26px;font-weight:600;letter-spacing:-0.8px;color:var(--color-data-value);font-variant-numeric:tabular-nums;margin:0 0 4px;" id="abhijit-time">{panchang.abhijitMuhurta.start} – {panchang.abhijitMuhurta.end}</p>
          <p style="font-size:13px;color:var(--color-body-text);margin:0;"><span class="en-text">Solar noon window — ideal for any important work, travel, or ceremony.</span><span class="hi-text" style="display:none">सूर्य के मध्याह्न का समय — किसी भी महत्वपूर्ण कार्य, यात्रा या समारोह के लिए उपयुक्त।</span></p>
        </div>
      </div>

      <!-- Inauspicious times -->
      <div class="card" style="padding:24px;margin-bottom:12px;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:20px;">
          <p class="caption-mono" style="color:var(--color-data-label);margin:0;"><span class="en-text">Inauspicious Periods</span><span class="hi-text" style="display:none">अशुभ काल</span></p>
          <span class="badge-inauspicious badge" style="font-size:10px;"><span class="en-text">Avoid important work</span><span class="hi-text" style="display:none">महत्वपूर्ण कार्य न करें</span></span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:24px;">
          <div>
            <p style="font-size:11px;color:var(--color-data-label);margin:0 0 6px;font-family:var(--font-mono);letter-spacing:0.06em;text-transform:uppercase;"><span class="en-text">Rahu Kalam</span><span class="hi-text" style="display:none;text-transform:none;">राहु काल</span></p>
            <p style="font-size:20px;font-weight:600;letter-spacing:-0.4px;color:var(--color-data-value);font-variant-numeric:tabular-nums;margin:0 0 2px;" id="rahu-time">{panchang.rahuKalam.start} – {panchang.rahuKalam.end}</p>
            <p style="font-size:12px;color:var(--color-mute);margin:0;"><span class="en-text">Shadow of Rahu — most inauspicious</span><span class="hi-text" style="display:none">राहु की छाया — सबसे अशुभ</span></p>
          </div>
          <div>
            <p style="font-size:11px;color:var(--color-data-label);margin:0 0 6px;font-family:var(--font-mono);letter-spacing:0.06em;text-transform:uppercase;"><span class="en-text">Gulika Kalam</span><span class="hi-text" style="display:none;text-transform:none;">गुलिक काल</span></p>
            <p style="font-size:20px;font-weight:600;letter-spacing:-0.4px;color:var(--color-data-value);font-variant-numeric:tabular-nums;margin:0 0 2px;" id="gulika-time">{panchang.gulikaKalam.start} – {panchang.gulikaKalam.end}</p>
            <p style="font-size:12px;color:var(--color-mute);margin:0;"><span class="en-text">Son of Saturn — avoid new ventures</span><span class="hi-text" style="display:none">शनि पुत्र — नए कार्य न करें</span></p>
          </div>
          <div>
            <p style="font-size:11px;color:var(--color-data-label);margin:0 0 6px;font-family:var(--font-mono);letter-spacing:0.06em;text-transform:uppercase;"><span class="en-text">Yamaganda</span><span class="hi-text" style="display:none;text-transform:none;">यमगण्ड</span></p>
            <p style="font-size:20px;font-weight:600;letter-spacing:-0.4px;color:var(--color-data-value);font-variant-numeric:tabular-nums;margin:0 0 2px;" id="yama-time">{panchang.yamaganda.start} – {panchang.yamaganda.end}</p>
            <p style="font-size:12px;color:var(--color-mute);margin:0;"><span class="en-text">Period of Yama — avoid travel</span><span class="hi-text" style="display:none">यम काल — यात्रा से बचें</span></p>
          </div>
        </div>
      </div>

      <!-- Day timeline bar -->
      <div class="card" style="padding:20px 24px;margin-bottom:12px;overflow:hidden;">
        <p class="caption-mono" style="color:var(--color-mute);margin:0 0 14px;"><span class="en-text">Day Timeline</span><span class="hi-text" style="display:none">दिन की समयरेखा</span></p>
        <div style="position:relative;height:32px;background:var(--color-canvas-soft-2);border-radius:4px;overflow:hidden;" id="timeline-bar">
          {TIMELINE_SEGMENTS.map(s => (
            <div style={`position:absolute;left:${s.leftPct}%;width:${s.widthPct}%;height:100%;background:${s.color};opacity:0.25;`} title={`${s.label} Kalam`}></div>
          ))}
          <!-- "Now" marker line added by client JS (see drawTimeline()) — live-clock-dependent. -->
        </div>
        <div style="display:flex;justify-content:space-between;margin-top:6px;">
          <span style="font-size:11px;color:var(--color-mute);font-family:var(--font-mono);" id="tl-sunrise">{panchang.sunrise}</span>
          <span style="font-size:11px;color:var(--color-mute);font-family:var(--font-mono);" id="tl-sunset">{panchang.sunset}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- UPCOMING FESTIVALS & VRATS FEED -->
  <FestivalFeed festivals={upcoming} today={today} />

  <!-- UPCOMING PLANETARY EVENTS FEED -->
  <PlanetaryEventsFeed events={planetaryEvents} today={today} />

  <!-- RASHIFAL SECTION -->
  <RashifalFeed today={today} />

  <div style="padding:8px 0 0;">
    <LotusDivider />
  </div>

