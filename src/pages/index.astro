<script>
// ─── Client-side Panchang engine ─────────────────────────────────────────
// Orchestration and formatting only — astronomy math imported from src/lib/panchang.ts,
// the same functions the server-rendered "today" values use at build time. Aliased to
// sunTrueLon/moonLon/ayanamsha below purely to keep every existing call site in this file
// unchanged.
import {
  julianDay,
  sunTrueLongitude as sunTrueLon,
  moonLongitude as moonLon,
  lahiriAyanamsha as ayanamsha,
  equationOfTimeMinutes,
  sunriseUTC,
  gmstDegrees,
  moonRiseSetUTC,
  findAngleCrossing,
  NO_MOONRISE,
  NO_MOONSET,
  localizeMoonEvent,
  localCivilDate,
  TITHIS,
  NAKSHATRAS,
  YOGAS,
  KARANAS,
  KARANAS_HI,
  VARAS,
  RASHIS,
  AMANTA_MONTHS,
  SAMVATSARA_NAMES,
  SAMVATSARA_NAMES_HI,
  YAMAGANDA_SLOTS,
} from '../lib/panchang';
import { formatDateHi } from '../lib/date-i18n';
import { formatMinutes12h, formatMinutes24h, formatMinutes24Plus, formatDurationMins } from '../lib/time-format';

// ── Global display state ──
let timeFormat: '12h' | '24h' | '24p' = '12h';
let calSchool: 'amanta' | 'purnimanta' = 'amanta';
let chartVisible = false;
let srMinsGlobal = 0; // sunrise (mins from midnight) for 24+ format

const norm360 = (a: number) => ((a % 360) + 360) % 360;

function minsToFmt(totalMins: number): string {
  if (timeFormat === '24h') return formatMinutes24h(totalMins);
  // Times before sunrise are part of the panchang day that started the previous sunrise;
  // display them as 24+ (e.g. 1:30 AM → 25:30 when sunrise is ~5:30 AM)
  if (timeFormat === '24p') return formatMinutes24Plus(totalMins, srMinsGlobal);
  return formatMinutes12h(totalMins); // 12h (default)
}

function fmtTime(h: number, tz: number): string {
  const local = ((h + tz) % 24 + 24) % 24;
  return minsToFmt(local * 60);
}

function estimateEnd(jd: number, step: number, tz: number, lonFn: (jd: number) => number): string {
  const lonNow = lonFn(jd);
  const boundary = (Math.floor(lonNow / step) + 1) * step;
  const targetLon = boundary % 360;
  const jdEnd = findAngleCrossing(jd, targetLon, lonFn);
  const hourUTC = (jdEnd - (Math.floor(jd - 0.5) + 0.5)) * 24;
  return fmtTime(hourUTC, tz);
}

const RAHU = [7,1,6,4,5,3,2]; // Fri/Sat swap fixed 2026-08-14
const GULIKA = [6,5,4,3,2,1,0];
// Yamaganda: imported YAMAGANDA_SLOTS from panchang.ts (Issue #1) — no local copy, so this
// can never drift from the server-rendered value again.

interface Location { name: string; nameHi?: string; lat: number; lng: number; tzOffset: number; tz?: string; elevation?: number; country: string; state?: string; }

// Default — overridden immediately by LocationPicker's locationchange event
let currentLoc: Location = { name:'New Delhi', nameHi:'नई दिल्ली', lat:28.6139, lng:77.2090, tzOffset:5.5, tz:'Asia/Kolkata', elevation:216, country:'India' };
let currentDate = new Date();
let currentLang: string = localStorage.getItem('pp-lang') || 'en';
let isHindi = currentLang === 'hi';

function calcPanchang(date: Date, loc: Location) {
  // Calendar date AND weekday in the selected city's timezone, not the visitor's browser
  // timezone — otherwise someone in New York viewing Delhi gets the previous day's Panchang
  // and, worse, the previous day's Rahu Kalam / Gulika / Yamaganda slots. See localCivilDate.
  const { year, month, day, weekday: wd } = localCivilDate(date, loc.tzOffset);
  const hour = 6 - loc.tzOffset;
  const jd = julianDay(year, month, day, hour);
  const sLon = sunTrueLon(jd);
  const mLon = moonLon(jd);
  const ay = ayanamsha(jd);
  const sSid = norm360(sLon - ay);
  const mSid = norm360(mLon - ay);
  const elong = norm360(mLon - sLon);
  const tithiIdx = Math.floor(elong / 12) % 30;
  const paksha = tithiIdx < 15 ? 'Shukla' : 'Krishna';
  const nIdx = Math.floor(mSid / (360/27)) % 27;
  const pada = Math.floor((mSid % (360/27)) / (360/27/4)) + 1;
  const yLon = norm360(sSid + mSid);
  const yIdx = Math.floor(yLon / (360/27)) % 27;
  const kIdx = Math.floor(elong / 6) % 60;
  const srUTC = sunriseUTC(jd, loc.lat, loc.lng, true);
  const ssUTC = sunriseUTC(jd, loc.lat, loc.lng, false);
  const srMins = srUTC * 60 + loc.tzOffset * 60;
  const ssMins = ssUTC * 60 + loc.tzOffset * 60;
  const dayMins = ssMins - srMins;
  const slotDur = dayMins / 8;
  const slot = (s: number) => ({ start: minsToFmt(srMins + s * slotDur), end: minsToFmt(srMins + (s+1) * slotDur) });
  srMinsGlobal = srMins; // store for 24+ format

  const jd0 = jd - hour / 24;
  // Either can be null on the ~1 day a month with no moonrise (or no moonset) — see moonRiseSetUTC.
  const moonriseUTC = moonRiseSetUTC(jd0, loc.lat, loc.lng, true, loc.tzOffset);
  const moonsetUTC = moonRiseSetUTC(jd0, loc.lat, loc.lng, false, loc.tzOffset);
  const noonMins = (srMins + ssMins) / 2;
  const abStart = noonMins - dayMins / 30, abEnd = noonMins + dayMins / 30;
  return {
    vara: VARAS[wd],
    tithi: { ...TITHIS[tithiIdx], paksha, pakshaNi: paksha==='Shukla'?'शुक्ल':'कृष्ण', endTime: estimateEnd(jd, 12, loc.tzOffset, j => norm360(moonLon(j) - sunTrueLon(j))) },
    nakshatra: { ...NAKSHATRAS[nIdx], pada, endTime: estimateEnd(jd, 360/27, loc.tzOffset, j => norm360(moonLon(j) - ayanamsha(j))) },
    yoga: { ...YOGAS[yIdx], endTime: estimateEnd(jd, 360/27, loc.tzOffset, j => norm360(norm360(sunTrueLon(j) - ayanamsha(j)) + norm360(moonLon(j) - ayanamsha(j)))) },
    karana: { name: KARANAS[kIdx]||'Bava', nameHi: KARANAS_HI[kIdx]||'बव', endTime: estimateEnd(jd, 6, loc.tzOffset, j => norm360(moonLon(j) - sunTrueLon(j))) },
    sunrise: fmtTime(srUTC, loc.tzOffset),
    sunset: fmtTime(ssUTC, loc.tzOffset),
    moonrise: moonriseUTC === null ? NO_MOONRISE : fmtTime(moonriseUTC, loc.tzOffset),
    moonset: moonsetUTC === null ? NO_MOONSET : fmtTime(moonsetUTC, loc.tzOffset),
    durationDay: formatDurationMins(dayMins),
    rahuKalam: slot(RAHU[wd]),
    gulikaKalam: slot(GULIKA[wd]),
    yamaganda: slot(YAMAGANDA_SLOTS[wd]),
    abhijitMuhurta: { start: minsToFmt(abStart), end: minsToFmt(abEnd) },
    srMins, ssMins,
    sunSidereal: sSid,
    moonSidereal: mSid,
    tithiPaksha: paksha as 'Shukla' | 'Krishna',
  };
}

function getHinduCalInfo(date: Date, sunSidereal: number, moonSidereal: number, paksha: 'Shukla' | 'Krishna') {
  const sunRashiIdx  = Math.floor(sunSidereal  / 30) % 12;
  const moonRashiIdx = Math.floor(moonSidereal / 30) % 12;
  // Amanta month = Sun's rashi at the UPCOMING Amavasya (see panchang.ts#getHinduCalendarInfo
  // for the full explanation and Navratri/Diwali verification) — not the Sun's current rashi.
  const jdRef = julianDay(date.getFullYear(), date.getMonth() + 1, date.getDate(), 12);
  const elongationNow = norm360(moonSidereal - sunSidereal);
  const MOON_SUN_RATE = 12.19;
  let jdAmavasya = jdRef + (360 - elongationNow) / MOON_SUN_RATE;
  for (let i = 0; i < 3; i++) {
    const elongAtGuess = norm360(moonLon(jdAmavasya) - sunTrueLon(jdAmavasya));
    const signedErr = elongAtGuess > 180 ? elongAtGuess - 360 : elongAtGuess;
    jdAmavasya -= signedErr / MOON_SUN_RATE;
  }
  const amantaIdx = Math.floor(norm360(sunTrueLon(jdAmavasya) - ayanamsha(jdAmavasya)) / 30) % 12;
  const purnimantaIdx = paksha === 'Shukla' ? amantaIdx : (amantaIdx + 1) % 12;
  const year = date.getFullYear();
  const dayOfYear = Math.floor((Date.UTC(year, date.getMonth(), date.getDate()) - Date.UTC(year, 0, 0)) / 86400000);
  const vsYear = dayOfYear >= 91 ? year + 57 : year + 56;
  const ssYear = vsYear - 135;
  // Offset verified against drikpanchang.com (see Issue #16 fix note in panchang.ts).
  const vsName = SAMVATSARA_NAMES[(vsYear + 9) % 60];
  const vsNameHi = SAMVATSARA_NAMES_HI[(vsYear + 9) % 60];
  return { vsYear, ssYear, vsName, vsNameHi, sunRashi: RASHIS[sunRashiIdx], moonRashi: RASHIS[moonRashiIdx], amantaMonth: AMANTA_MONTHS[amantaIdx], purnimantaMonth: AMANTA_MONTHS[purnimantaIdx] };
}

function setText(id: string, val: string) {
  const el = document.getElementById(id);
  if (el) el.textContent = val;
}

// Shared long-date formatter for #date-display — uses the centralized
// site-wide Hindi day/month-name convention (src/lib/date-i18n.ts), Arabic
// numerals throughout (matches jyotish/horoscope-match.astro's convention).
function formatDateDisplay(date: Date, hindi: boolean): string {
  return formatDateHi(date, hindi, { weekday: 'long' });
}

const PLANET_LORD_HI: Record<string, string> = {
  Sun: 'सूर्य', Moon: 'चंद्र', Mars: 'मंगल', Mercury: 'बुध',
  Jupiter: 'बृहस्पति', Venus: 'शुक्र', Saturn: 'शनि', Rahu: 'राहु', Ketu: 'केतु',
};
function lordLabel(lord: string): string {
  return isHindi ? (PLANET_LORD_HI[lord] ?? lord) : lord;
}
function auspiciousLabel(type: string): string {
  return isHindi ? (type === 'Auspicious' ? 'शुभ' : 'अशुभ') : type;
}

function updateUI(p: ReturnType<typeof calcPanchang>) {
  // Vara
  setText('vara-name', p.vara.name); setText('vara-name-hi', p.vara.nameHi);
  setText('vara-lord', lordLabel(p.vara.lord));
  // Tithi
  setText('tithi-name', `${p.tithi.paksha} ${p.tithi.name}`);
  setText('tithi-name-hi', `${p.tithi.pakshaNi} ${p.tithi.nameHi}`);
  setText('tithi-type', isHindi ? p.tithi.typeHi : p.tithi.type); setText('tithi-end', p.tithi.endTime);
  // Nakshatra
  setText('nakshatra-name', p.nakshatra.name); setText('nakshatra-name-hi', p.nakshatra.nameHi);
  setText('nakshatra-meta', `${p.nakshatra.pada} · ${lordLabel(p.nakshatra.lord)}`);
  setText('nakshatra-end', p.nakshatra.endTime);
  // Yoga
  setText('yoga-name', p.yoga.name); setText('yoga-name-hi', p.yoga.nameHi);
  setText('yoga-type', auspiciousLabel(p.yoga.type)); setText('yoga-end', p.yoga.endTime);
  // Karana
  setText('karana-name', p.karana.name); setText('karana-name-hi', p.karana.nameHi);
  setText('karana-end', p.karana.endTime);
  // Sun times
  setText('sunrise', p.sunrise); setText('sunset', p.sunset);
  setText('moonrise', localizeMoonEvent(p.moonrise, currentLang === 'hi')); setText('day-duration', p.durationDay);
  // Abhijit
  setText('abhijit-time', `${p.abhijitMuhurta.start} – ${p.abhijitMuhurta.end}`);
  // Kalam
  setText('rahu-time', `${p.rahuKalam.start} – ${p.rahuKalam.end}`);
  setText('gulika-time', `${p.gulikaKalam.start} – ${p.gulikaKalam.end}`);
  setText('yama-time', `${p.yamaganda.start} – ${p.yamaganda.end}`);
  // Timeline
  setText('tl-sunrise', p.sunrise); setText('tl-sunset', p.sunset);
  drawTimeline(p);
  // Yoga badge color
  const yogaBadge = document.getElementById('yoga-type');
  if (yogaBadge) {
    yogaBadge.className = p.yoga.type === 'Auspicious' ? 'badge badge-auspicious' : 'badge badge-inauspicious';
  }
}

function drawTimeline(p: ReturnType<typeof calcPanchang>) {
  const bar = document.getElementById('timeline-bar');
  if (!bar) return;
  const sr = p.srMins, ss = p.ssMins, total = ss - sr;
  if (total <= 0) return;
  const pct = (m: number) => Math.max(0, Math.min(100, ((m - sr) / total) * 100));
  // "Now" on this timeline must be evaluated in the SELECTED location's local time, not
  // the visitor's own device timezone -- this widget is location-aware (currentLoc), so
  // those are often different. Shift the real instant by currentLoc.tzOffset (the same
  // value calcPanchang already used to produce p.srMins/p.ssMins), then read it back with
  // UTC getters -- host-timezone-independent by construction, same pattern as the daily
  // Rashifal IST fix, but parameterized on the selected location instead of a hardcoded
  // +5:30.
  const now = new Date();
  const locNow = new Date(now.getTime() + currentLoc.tzOffset * 3600000);
  const nowMins = locNow.getUTCHours() * 60 + locNow.getUTCMinutes();
  const segments = [
    { color: '#ef4444', label: 'Rahu', startM: sr + RAHU[currentDate.getDay()] * (total/8) },
    { color: '#f59e0b', label: 'Gulika', startM: sr + GULIKA[currentDate.getDay()] * (total/8) },
    { color: '#8b5cf6', label: 'Yama', startM: sr + YAMAGANDA_SLOTS[currentDate.getDay()] * (total/8) },
  ];
  const nowPct = pct(nowMins);
  bar.innerHTML = segments.map(s => {
    const sp = pct(s.startM);
    const ep = pct(s.startM + total/8);
    return `<div style="position:absolute;left:${sp}%;width:${ep-sp}%;height:100%;background:${s.color};opacity:0.25;" title="${s.label} Kalam"></div>`;
  }).join('') + `<div style="position:absolute;left:${nowPct}%;top:0;width:2px;height:100%;background:var(--color-ink);border-radius:1px;" title="Now"></div>`;
}

function applyLang(langCode: string) {
  currentLang = langCode;
  isHindi = langCode === 'hi';
  const showHindi = isHindi;
  document.querySelectorAll('.en-text').forEach(el => (el as HTMLElement).style.display = showHindi ? 'none' : '');
  document.querySelectorAll('.hi-text').forEach(el => (el as HTMLElement).style.display = showHindi ? '' : 'none');
  const locDisplay = document.getElementById('loc-display');
  if (locDisplay) locDisplay.textContent = currentLoc.name;
  const locDisplayHi = document.getElementById('loc-display-hi');
  if (locDisplayHi) locDisplayHi.textContent = currentLoc.nameHi ?? currentLoc.name;
  setText('date-display', formatDateDisplay(currentDate, isHindi));
  // Refresh summary card and main grid (vara-lord, yoga-type, nakshatra-meta,
  // etc.) so language-dependent auxiliary fields update together, not just
  // on the next date/location change.
  const p = calcPanchang(currentDate, currentLoc);
  updateUI(p);
  updateSummaryCard(p, currentDate, currentLoc);
}

function updateSummaryCard(p: ReturnType<typeof calcPanchang>, date: Date, loc: Location) {
  const cal = getHinduCalInfo(date, p.sunSidereal, p.moonSidereal, p.tithiPaksha);

  // Header
  setText('ps-city', loc.name); setText('ps-city-hi', loc.nameHi ?? loc.name);
  setText('ps-date', formatDateHi(date, isHindi, { weekday: 'long' }));

  // Reference-time subnote: values on this card are anchored to the viewed
  // date's sunrise (see calcPanchang), not the live current moment.
  const nowForSubnote = new Date();
  const isViewingToday = date.getFullYear() === nowForSubnote.getFullYear()
    && date.getMonth() === nowForSubnote.getMonth()
    && date.getDate() === nowForSubnote.getDate();
  setText('ps-date-subnote', isViewingToday ? "As of today's sunrise" : "As of that day's sunrise");
  setText('ps-date-subnote-hi', isViewingToday ? 'आज सूर्योदय के अनुसार' : 'उस दिन के सूर्योदय के अनुसार');

  // Vikrama / Shaka
  setText('ps-vs-year', String(cal.vsYear));
  setText('ps-vs-name', isHindi ? cal.vsNameHi : cal.vsName);
  setText('ps-ss-year', String(cal.ssYear));

  // Hindu month (Amanta / Purnimanta)
  const month = calSchool === 'purnimanta' ? cal.purnimantaMonth : cal.amantaMonth;
  const monthLbl = document.getElementById('ps-month-lbl');
  if (monthLbl) {
    monthLbl.textContent = isHindi
      ? (calSchool === 'purnimanta' ? 'पूर्णिमांत मास' : 'अमांत मास')
      : (calSchool === 'purnimanta' ? 'Purnimanta Month' : 'Amanta Month');
  }
  setText('ps-month', month.name);
  setText('ps-month-hi', month.nameHi);

  // Vara
  setText('ps-vara', p.vara.name);
  setText('ps-vara-hi', p.vara.nameHi);

  // Sun / moon times
  setText('ps-sunrise', p.sunrise); setText('ps-sunset', p.sunset);
  setText('ps-tl-sunrise', p.sunrise); setText('ps-tl-sunset', p.sunset);

  // Rashis
  const enMode = !isHindi;
  if (enMode) {
    setText('ps-sunsign', `${cal.sunRashi.name} (${cal.sunRashi.en})`);
    setText('ps-moonsign', `${cal.moonRashi.name} (${cal.moonRashi.en})`);
  } else {
    setText('ps-sunsign-hi', cal.sunRashi.nameHi);
    setText('ps-moonsign-hi', cal.moonRashi.nameHi);
  }

  // Paksha badge
  const pakshaBadge = document.getElementById('ps-paksha-badge');
  if (pakshaBadge) {
    pakshaBadge.dataset.isShukla = p.tithiPaksha === 'Shukla' ? 'true' : 'false';
    const isShukla = p.tithiPaksha === 'Shukla';
    const pakshaLabel = p.tithiPaksha + ' Paksha';
    pakshaBadge.innerHTML = `${isShukla ? '🌕' : '🌑'}
      <span class="en-text" style="${isHindi ? 'display:none' : ''}">${pakshaLabel}</span>
      <span class="hi-text" style="${isHindi ? '' : 'display:none'}">${p.tithi.pakshaNi} पक्ष</span>`;
    pakshaBadge.style.cssText = isShukla
      ? 'background:rgba(255,153,51,0.12);color:var(--color-saffron-deep);border:1px solid rgba(255,153,51,0.25);display:inline-flex;align-items:center;gap:5px;padding:2px 10px 2px 6px;border-radius:var(--radius-pill);font-size:12.5px;font-weight:600;'
      : 'background:var(--color-canvas-soft-2);color:var(--color-body-text);border:1px solid var(--color-hairline);display:inline-flex;align-items:center;gap:5px;padding:2px 10px 2px 6px;border-radius:var(--radius-pill);font-size:12.5px;font-weight:600;';
  }

  // Tithi
  setText('ps-tithi', p.tithi.name); setText('ps-tithi-hi', p.tithi.nameHi);
  setText('ps-tithi-ends', `${isHindi ? 'समाप्ति' : 'ends'} ${p.tithi.endTime}`);

  // Nakshatra
  setText('ps-nakshatra', p.nakshatra.name); setText('ps-nakshatra-hi', p.nakshatra.nameHi);
  setText('ps-nakshatra-sub', isHindi
    ? `, पद ${p.nakshatra.pada} · ${lordLabel(p.nakshatra.lord)}`
    : `, Pada ${p.nakshatra.pada} · ${p.nakshatra.lord}`);
  setText('ps-nakshatra-ends', `${isHindi ? 'समाप्ति' : 'ends'} ${p.nakshatra.endTime}`);

  // Yoga
  setText('ps-yoga', p.yoga.name); setText('ps-yoga-hi', p.yoga.nameHi);
  setText('ps-yoga-ends', `${isHindi ? 'समाप्ति' : 'ends'} ${p.yoga.endTime}`);
  const yogaBadge = document.getElementById('ps-yoga-badge');
  if (yogaBadge) {
    yogaBadge.textContent = auspiciousLabel(p.yoga.type);
    yogaBadge.style.cssText = p.yoga.type === 'Auspicious'
      ? 'background:var(--color-auspicious-soft);color:#15803d;border-color:rgba(34,197,94,0.3);display:inline-flex;align-items:center;font-size:10px;font-weight:600;padding:2px 7px;border-radius:9999px;border:1px solid;'
      : 'background:var(--color-inauspicious-soft);color:#b91c1c;border-color:rgba(239,68,68,0.3);display:inline-flex;align-items:center;font-size:10px;font-weight:600;padding:2px 7px;border-radius:9999px;border:1px solid;';
  }

  // Karana
  setText('ps-karana', p.karana.name); setText('ps-karana-hi', p.karana.nameHi);
  setText('ps-karana-ends', `${isHindi ? 'समाप्ति' : 'ends'} ${p.karana.endTime}`);

  // Kalam + Abhijit
  setText('ps-rahu-kalam', `${p.rahuKalam.start} – ${p.rahuKalam.end}`);
  setText('ps-abhijit', `${p.abhijitMuhurta.start} – ${p.abhijitMuhurta.end}`);
  setText('ps-day-length', p.durationDay);

  // Draw chart if visible
  if (chartVisible) drawSummaryTimeline(p);
}

function drawSummaryTimeline(p: ReturnType<typeof calcPanchang>) {
  const bar = document.getElementById('ps-timeline');
  if (!bar) return;
  const sr = p.srMins, ss = p.ssMins, total = ss - sr;
  if (total <= 0) return;
  const pct = (m: number) => Math.max(0, Math.min(100, ((m - sr) / total) * 100));
  // Same location-timezone anchoring as drawTimeline() above -- see its comment.
  const now = new Date();
  const locNow = new Date(now.getTime() + currentLoc.tzOffset * 3600000);
  const nowMins = locNow.getUTCHours() * 60 + locNow.getUTCMinutes();
  const wd = currentDate.getDay();
  const RAHU_S = [7,1,6,4,5,3,2], GULIKA_S = [6,5,4,3,2,1,0]; // Fri/Sat swap fixed 2026-08-14
  const slotDur = total / 8;
  const segments = [
    { s: pct(sr + RAHU_S[wd] * slotDur), e: pct(sr + (RAHU_S[wd]+1) * slotDur), color: '#ef4444' },
    { s: pct(sr + GULIKA_S[wd] * slotDur), e: pct(sr + (GULIKA_S[wd]+1) * slotDur), color: '#f59e0b' },
    { s: pct(sr + YAMAGANDA_SLOTS[wd] * slotDur), e: pct(sr + (YAMAGANDA_SLOTS[wd]+1) * slotDur), color: '#8b5cf6' },
  ];
  const nowPct = pct(nowMins);
  bar.innerHTML =
    `<div style="position:absolute;inset:0;background:linear-gradient(90deg,#fef3c7 0%,#fed7aa 50%,#fde68a 100%);opacity:0.3;"></div>` +
    segments.map(sg =>
      `<div style="position:absolute;left:${sg.s}%;width:${sg.e - sg.s}%;height:100%;background:${sg.color};opacity:0.35;"></div>`
    ).join('') +
    `<div style="position:absolute;left:${nowPct}%;top:0;width:2px;height:100%;background:var(--color-ink);border-radius:1px;" title="Now"></div>` +
    `<div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:9px;color:var(--color-mute);font-family:var(--font-mono);pointer-events:none;">Noon</div>`;
}

function renderWithLoc(loc: Location, date: Date) {
  currentLoc = loc; currentDate = date;
  const p = calcPanchang(date, loc);
  updateUI(p);
  updateSummaryCard(p, date, loc);
  // Keep the date-picker's displayed value in sync with whatever date is actually
  // rendered. Its initial value is server-rendered from build-time `today` (frozen at
  // last `astro build`/deploy on this static site) which goes stale between deploys —
  // without this, the picker can show yesterday's date while the page already
  // rendered today's real Panchang, making it look unresponsive to selection.
  const dpEl = document.getElementById('date-picker') as HTMLInputElement | null;
  if (dpEl) {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, '0');
    const d = String(date.getDate()).padStart(2, '0');
    dpEl.value = `${y}-${m}-${d}`;
  }
  // Update Kundali widget
  if (typeof (window as any).updateKundaliWidget === 'function') {
    (window as any).updateKundaliWidget(loc.lat, loc.lng, isHindi ? (loc.nameHi ?? loc.name) : loc.name);
  }
  // Update Vedic Clock
  if (typeof (window as any).updateVedicClock === 'function') {
    const cal = getHinduCalInfo(date, p.sunSidereal, p.moonSidereal, p.tithiPaksha);
    const tithiStr = cal.amantaMonth.name + " " + p.tithi.paksha + " " + p.tithi.name;
    const vsStr = "VS " + cal.vsYear;
    const weekStr = formatDateHi(date, isHindi, { weekday: 'long' });
    (window as any).updateVedicClock({
      srMins: p.srMins,
      ssMins: p.ssMins,
      cityName: isHindi ? (loc.nameHi ?? loc.name) : loc.name,
      tithi: tithiStr,
      vs: vsStr,
      weekday: weekStr,
      srFormatted: p.sunrise,
      ssFormatted: p.sunset,
      dayLen: p.durationDay,
    });
  }
  // Update date label
  setText('date-display', formatDateDisplay(date, isHindi));
  setText('panchang-date-label', formatDateHi(date, isHindi, { month: 'short' }));
  const locDisplay = document.getElementById('loc-display');
  if (locDisplay) locDisplay.textContent = loc.name;
  const locDisplayHi = document.getElementById('loc-display-hi');
  if (locDisplayHi) locDisplayHi.textContent = loc.nameHi || loc.name;
}

// Date picker
const dp = document.getElementById('date-picker') as HTMLInputElement;
dp?.addEventListener('change', () => {
  const d = new Date(dp.value + 'T12:00:00');
  currentDate = d;
  renderWithLoc(currentLoc, d);
});

// Listen for location changes broadcast by the header LocationPicker
window.addEventListener('locationchange', (e: Event) => {
  const loc = (e as CustomEvent<Location>).detail;
  if (loc) renderWithLoc(loc, currentDate);
});

// Language change
document.addEventListener('langchange', (e: Event) => {
  const evt = e as CustomEvent;
  // LanguagePicker dispatches { langCode }; old toggle dispatched { hindi }
  const langCode: string = evt.detail.langCode ?? (evt.detail.hindi ? 'hi' : 'en');
  applyLang(langCode);
});

// Re-derive "now" and re-render when the page comes back from the browser's back/forward
// cache (bfcache) or when a long-lived tab becomes visible again on a new calendar day —
// otherwise currentDate/the displayed Panchang stay frozen at whatever they were when the
// script last ran, since renderWithLoc() below only ever runs once per navigation.
function refreshForNow() {
  currentDate = new Date();
  renderWithLoc(currentLoc, currentDate);
}

window.addEventListener('pageshow', (e: PageTransitionEvent) => {
  if (e.persisted) refreshForNow();
});

document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'visible' && currentDate.toDateString() !== new Date().toDateString()) {
    refreshForNow();
  }
});

// ── Toolbar: time format ──
document.querySelectorAll<HTMLButtonElement>('.ps-seg-btn[data-fmt]').forEach(btn => {
  btn.addEventListener('click', () => {
    timeFormat = btn.dataset.fmt as '12h' | '24h' | '24p';
    document.querySelectorAll<HTMLButtonElement>('.ps-seg-btn[data-fmt]').forEach(b => {
      b.classList.toggle('active', b.dataset.fmt === timeFormat);
      b.setAttribute('aria-pressed', String(b.dataset.fmt === timeFormat));
    });
    renderWithLoc(currentLoc, currentDate);
  });
});

// ── Toolbar: calendar school ──
document.querySelectorAll<HTMLButtonElement>('.ps-seg-btn[data-school]').forEach(btn => {
  btn.addEventListener('click', () => {
    calSchool = btn.dataset.school as 'amanta' | 'purnimanta';
    document.querySelectorAll<HTMLButtonElement>('.ps-seg-btn[data-school]').forEach(b => {
      b.classList.toggle('active', b.dataset.school === calSchool);
      b.setAttribute('aria-pressed', String(b.dataset.school === calSchool));
    });
    // Re-render summary card only (month label changes)
    const p = calcPanchang(currentDate, currentLoc);
    updateSummaryCard(p, currentDate, currentLoc);
  });
});

// ── Toolbar: chart toggle ──
const chartToggleBtn = document.getElementById('ps-chart-toggle');
const chartWrap = document.getElementById('ps-chart-wrap');
chartToggleBtn?.addEventListener('click', () => {
  chartVisible = !chartVisible;
  if (chartWrap) chartWrap.hidden = !chartVisible;
  chartToggleBtn.classList.toggle('active', chartVisible);
  chartToggleBtn.setAttribute('aria-expanded', String(chartVisible));
  if (chartVisible) {
    const p = calcPanchang(currentDate, currentLoc);
    drawSummaryTimeline(p);
  }
});

// Honor a ?date=YYYY-MM-DD deep link (calendar.astro's day-cell links and festival detail
// pages both point here) -- previously silently ignored, so those links always showed
// today regardless of which date was clicked/linked. Parsed with T12:00:00 like the
// date-picker's own change handler above, to avoid UTC-midnight rolling to the wrong
// local calendar day.
const dateParam = new URLSearchParams(window.location.search).get('date');
if (dateParam && /^\d{4}-\d{2}-\d{2}$/.test(dateParam)) {
  const parsed = new Date(dateParam + 'T12:00:00');
  if (!isNaN(parsed.getTime())) currentDate = parsed;
}

// Initial render — use location already set by LocationPicker (fires before this script)
renderWithLoc(((window as any).__initLoc as Location) || currentLoc, currentDate);

// Draw timeline every minute
setInterval(() => { const p = calcPanchang(currentDate, currentLoc); drawTimeline(p); }, 60000);
</script>

