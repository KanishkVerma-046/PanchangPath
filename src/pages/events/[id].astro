---
import Layout from '../../layouts/Layout.astro';
import { metaDescription } from '../../lib/meta';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import { computeUpcomingEvents, getPastSignificantEvents, formatCountdownLabel, formatEventDateTime, INDIA_VISIBILITY_LABEL, sutakNote } from '../../lib/planetaryEvents';
import { formatDateHi } from '../../lib/date-i18n';

export function getStaticPaths() {
  const today  = new Date();
  // Eclipses, Rahu/Ketu axis-shift transits, and Saturn sign transits stay reachable at
  // their original URL after the fact (comparable public interest to a festival page —
  // see getPastSignificantEvents). Every other routine event type (Sun/Mercury/Venus/Mars/
  // Jupiter sign transits, retrograde stations, conjunctions) is intentionally NOT included
  // here and keeps rolling off once it's in the past.
  const events = [...computeUpcomingEvents(today, 365), ...getPastSignificantEvents(today)];
  return events.map(ev => ({
    params: { id: ev.id },
    props:  { event: ev },
  }));
}

const { event: ev } = Astro.props;
const today = new Date();
const countdown = formatCountdownLabel(ev.daysAway);
const datetime  = formatEventDateTime(ev);
const isToday   = ev.daysAway === 0;
const sutak     = sutakNote(ev.indiaVisibility, ev.type);
const isPast    = ev.daysAway < 0;
const evDateObj = new Date(ev.dateISO + 'T00:00:00Z');
const evDateLong = formatDateHi(evDateObj, false, { weekday: 'long' });
const evDateLongHi = formatDateHi(evDateObj, true, { weekday: 'long' });
const evDateShort = formatDateHi(evDateObj, false, { month: 'short' });
const evDateShortHi = formatDateHi(evDateObj, true, { month: 'short' });
// Month + year only (no day). Every sign-transit/retrograde/conjunction `description`
// already spells out the full date on its own, so folding this in there would just be
// filler; solstice/equinox `description`s never carry a date at all (and are literally
// identical across different years, e.g. "Sun crosses celestial equator southward..."
// repeats verbatim every autumn), so that's the one type this label actually disambiguates.
const metaDateLabel = formatDateHi(evDateObj, false, { day: false, month: 'short' });
const metaSourceText = ev.type === 'solstice_equinox'
  ? `${ev.description} (${metaDateLabel}) ${ev.significance}`
  : `${ev.description} ${ev.significance}`;

function typeLabel(type: string): string {
  switch (type) {
    case 'sign_transit':     return 'Sign Transit';
    case 'retrograde_start': return 'Retrograde Station';
    case 'direct_start':     return 'Direct Station';
    case 'conjunction':      return 'Conjunction';
    case 'opposition':       return 'Opposition';
    case 'solar_eclipse':    return 'Solar Eclipse';
    case 'lunar_eclipse':    return 'Lunar Eclipse';
    case 'solstice_equinox': return 'Solstice / Equinox';
    default:                 return 'Planetary Event';
  }
}

function typeClass(type: string): string {
  switch (type) {
    case 'sign_transit':     return 'ed-tag-transit';
    case 'retrograde_start': return 'ed-tag-retro';
    case 'direct_start':     return 'ed-tag-direct';
    case 'conjunction':
    case 'opposition':       return 'ed-tag-aspect';
    case 'solar_eclipse':
    case 'lunar_eclipse':    return 'ed-tag-eclipse';
    case 'solstice_equinox': return 'ed-tag-season';
    default:                 return '';
  }
}

// The `timeUTC` field is a single instant per event, but what that instant *means*
// differs by type — for eclipses it is the moment of greatest eclipse, not the start
// of the eclipse. Label it explicitly so the headline time can't be misread.
// "IST" is India Standard Time (UTC+5:30) — spelled out because several eclipses in
// this feed are European events, where IST would otherwise read as Irish Standard Time.
function timeLabel(type: string): string {
  return type === 'solar_eclipse' || type === 'lunar_eclipse'
    ? 'Greatest Eclipse (India, IST)'
    : 'Time (India, IST)';
}

function timeLabelHi(type: string): string {
  return type === 'solar_eclipse' || type === 'lunar_eclipse'
    ? 'ग्रहण मध्यकाल (भारत, IST)'
    : 'समय (भारत, IST)';
}

function typeLabelHi(type: string): string {
  switch (type) {
    case 'sign_transit':     return 'राशि परिवर्तन';
    case 'retrograde_start': return 'वक्री स्थिति';
    case 'direct_start':     return 'मार्गी स्थिति';
    case 'conjunction':      return 'युति';
    case 'opposition':       return 'प्रतियुति';
    case 'solar_eclipse':    return 'सूर्य ग्रहण';
    case 'lunar_eclipse':    return 'चंद्र ग्रहण';
    case 'solstice_equinox': return 'संक्रांति / विषुव';
    default:                 return 'ग्रह घटना';
  }
}

function heroBg(type: string): string {
  switch (type) {
    case 'sign_transit':     return 'linear-gradient(135deg,#431407 0%,#c2410c 100%)';
    case 'retrograde_start': return 'linear-gradient(135deg,#450a0a 0%,#991b1b 100%)';
    case 'direct_start':     return 'linear-gradient(135deg,#052e16 0%,#166534 100%)';
    case 'conjunction':
    case 'opposition':       return 'linear-gradient(135deg,#2e1065 0%,#5b21b6 100%)';
    case 'solar_eclipse':
    case 'lunar_eclipse':    return 'linear-gradient(135deg,#0f172a 0%,#1e1b4b 100%)';
    case 'solstice_equinox': return 'linear-gradient(135deg,#0c4a6e 0%,#0369a1 100%)';
    default:                 return 'linear-gradient(135deg,#18181b 0%,#3f3f46 100%)';
  }
}
---

<Layout
  title={`${ev.title} — PanchangPath`}
  description={metaDescription(metaSourceText, `${ev.title} — date, time and significance.`)}
>
  <BreadcrumbSchema items={[
    { name: 'Home', url: '/' },
    { name: 'Planetary Events', url: '/events' },
    { name: ev.title, url: `/events/${ev.id}` },
  ]} />

  <!-- ── Hero ── -->
  <section class="ed-hero" style={`background:${heroBg(ev.type)}`}>
    <div class="ed-hero-inner">
      <nav class="ed-breadcrumb" aria-label="Breadcrumb">
        <a href="/" data-hi="होम">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/events" data-hi="ग्रह घटनाएं">Planetary Events</a>
        <span aria-hidden="true">›</span>
        <span data-hi="घटना">Event</span>
      </nav>

      <div class="ed-hero-body">
        <div class="ed-icon-wrap" aria-hidden="true">
          <span class="ed-big-icon">{ev.icon}</span>
        </div>
        <div class="ed-hero-text">
          <h1 class="ed-heading en-text">{ev.title}</h1>
          <h1 class="ed-heading hi-text" style="display:none">{ev.titleHi}</h1>
          <div class="ed-hero-meta">
            <span class={`ed-tag ${typeClass(ev.type)}`} data-hi={typeLabelHi(ev.type)}>{typeLabel(ev.type)}</span>
            <span id="ed-hero-countdown" class={`ed-countdown ${isToday ? 'ed-now' : ''}`} style={isPast ? 'display:none' : ''}>
              <span id="ed-hero-pulse" class="ed-pulse" aria-hidden="true" style={isToday ? '' : 'display:none'}></span>
              <span id="ed-hero-countdown-text">{countdown}</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Main layout ── -->
  <div class="ed-wrapper">
    <div class="ed-grid">

      <!-- Main column -->
      <article class="ed-main">

        <!-- Date / time card -->
        <div class="ed-date-card">
          <div class="ed-date-col">
            <p class="ed-label" data-hi="दिनांक">Date</p>
            <p class="ed-value" data-hi={evDateLongHi}>
              {evDateLong}
            </p>
          </div>
          <div class="ed-sep"></div>
          <div class="ed-date-col">
            <p class="ed-label" data-hi={timeLabelHi(ev.type)}>{timeLabel(ev.type)}</p>
            <p class="ed-value">{datetime.split('·')[1]?.trim() ?? '—'}</p>
          </div>
          <div class="ed-sep"></div>
          <div class="ed-date-col">
            <p class="ed-label" data-hi="उलटी गिनती">Countdown</p>
            <p id="ed-date-countdown" class="ed-value" style={isPast ? 'color:var(--color-mute)' : isToday ? 'color:var(--color-saffron-deep)' : ''}>
              {isPast ? `${Math.abs(ev.daysAway)}d ago` : countdown}
            </p>
          </div>
        </div>

        <!-- Description -->
        <div class="ed-section">
          <h2 class="ed-section-title" data-hi="इस घटना के बारे में">About this Event</h2>
          <p class="ed-body" data-hi={ev.descriptionHi}>{ev.description}</p>
        </div>

        <!-- Jyotish significance -->
        <div class="ed-section">
          <h2 class="ed-section-title" data-hi="ज्योतिष महत्व">Jyotish Significance</h2>
          <p class="ed-body" data-hi={ev.significanceHi}>{ev.significance}</p>
        </div>

        <!-- Sutak: derived from indiaVisibility, never written per entry -->
        {sutak && (
          <div class="ed-section">
            <h2 class="ed-section-title" data-hi="सूतक काल">Sutak Kaal</h2>
            <p class="ed-body" data-hi={sutak.hi}>{sutak.en}</p>
          </div>
        )}

        <!-- Planets involved -->
        {ev.planets.length > 0 && (
          <div class="ed-section">
            <h2 class="ed-section-title" data-hi="शामिल ग्रह">Planets Involved</h2>
            <div class="ed-planets">
              {ev.planets.map(p => (
                <span class="ed-planet-chip" data-hi={
                  p === 'surya'   ? '☉ सूर्य'          :
                  p === 'chandra' ? '☽ चंद्रमा'        :
                  p === 'mangal'  ? '♂ मंगल'           :
                  p === 'budha'   ? '☿ बुध'            :
                  p === 'guru'    ? '♃ गुरु'           :
                  p === 'shukra'  ? '♀ शुक्र'          :
                  p === 'shani'   ? '♄ शनि'            :
                  p === 'rahu'    ? '☊ राहु (उत्तर नोड)' :
                  p === 'ketu'    ? '☋ केतु (दक्षिण नोड)' : p
                }>
                  {p === 'surya'   ? '☉ Surya (Sun)'         :
                   p === 'chandra' ? '☽ Chandra (Moon)'       :
                   p === 'mangal'  ? '♂ Mangal (Mars)'        :
                   p === 'budha'   ? '☿ Budha (Mercury)'      :
                   p === 'guru'    ? '♃ Guru (Jupiter)'       :
                   p === 'shukra'  ? '♀ Shukra (Venus)'       :
                   p === 'shani'   ? '♄ Shani (Saturn)'       :
                   p === 'rahu'    ? '☊ Rahu (North Node)'    :
                   p === 'ketu'    ? '☋ Ketu (South Node)'    : p}
                </span>
              ))}
            </div>
          </div>
        )}

      </article>

      <!-- Sidebar -->
      <aside class="ed-sidebar">

        <div class="ed-side-card">
          <h3 class="ed-side-title" data-hi="त्वरित जानकारी">Quick Info</h3>
          <dl class="ed-facts">
            <div class="ed-fact-row">
              <dt data-hi="प्रकार">Type</dt>
              <dd data-hi={typeLabelHi(ev.type)}>{typeLabel(ev.type)}</dd>
            </div>
            <div class="ed-fact-row">
              <dt data-hi="दिनांक">Date</dt>
              <dd data-hi={evDateShortHi}>{evDateShort}</dd>
            </div>
            <div class="ed-fact-row">
              <dt data-hi={timeLabelHi(ev.type)}>{timeLabel(ev.type)}</dt>
              <dd>{datetime.split('·')[1]?.trim() ?? '—'}</dd>
            </div>
            {ev.indiaVisibility && (
              <div class="ed-fact-row">
                <dt data-hi="भारत में दृश्यता">Visible in India</dt>
                <dd data-hi={INDIA_VISIBILITY_LABEL[ev.indiaVisibility].hi}>
                  {INDIA_VISIBILITY_LABEL[ev.indiaVisibility].en}
                </dd>
              </div>
            )}
            <div id="ed-sidebar-countdown-row" class="ed-fact-row" style={isPast ? 'display:none' : ''}>
              <dt data-hi="उलटी गिनती">Countdown</dt>
              <dd id="ed-sidebar-countdown-text" style={isToday ? 'color:var(--color-saffron-deep);font-weight:700' : ''}>{countdown}</dd>
            </div>
          </dl>
        </div>

        <div class="ed-side-card">
          <h3 class="ed-side-title" data-hi="और घटनाएं">More Events</h3>
          <p class="ed-side-body" data-hi="सभी आगामी राशि परिवर्तन, वक्री, ग्रहण, और ऋतु परिवर्तन देखें।">Browse all upcoming transits, retrogrades, eclipses, and seasonal crossings.</p>
          <a href="/events" class="ed-side-btn" data-hi="सभी ग्रह घटनाएं →">All Planetary Events →</a>
        </div>

        <div class="ed-side-card">
          <h3 class="ed-side-title" data-hi="आज का पंचांग">Today's Panchang</h3>
          <p class="ed-side-body" data-hi="पूरा पंचांग देखें — तिथि, नक्षत्र, योग, करण, और मुहूर्त।">View the full Panchang — Tithi, Nakshatra, Yoga, Karana, and Muhurtas.</p>
          <a href="/" class="ed-side-btn" data-hi="पंचांग देखें →">View Panchang →</a>
        </div>

      </aside>

    </div><!-- .ed-grid -->

    <!-- Back link -->
    <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--color-hairline);">
      <a href="/events" data-hi="← ग्रह घटनाओं पर वापस जाएं" style="font-size:13px;font-weight:500;color:var(--color-saffron-deep);text-decoration:none;">
        ← Back to Planetary Events
      </a>
    </div>

  </div><!-- .ed-wrapper -->
</Layout>

<script define:vars={{ dateISO: ev.dateISO, timeUTC: ev.timeUTC }}>
  function formatCountdown(daysAway, hindi) {
    if (!hindi) {
      if (daysAway === 0) return 'Today';
      if (daysAway === 1) return 'Tomorrow';
      if (daysAway < 0)   return `${Math.abs(daysAway)}d ago`;
      if (daysAway < 7)   return `${daysAway} Days`;
      if (daysAway < 30)  return `${Math.floor(daysAway / 7)}w ${daysAway % 7}d`;
      const months = Math.floor(daysAway / 30);
      const rem = daysAway % 30;
      return rem > 0 ? `${months}m ${rem}d` : `${months} Month${months > 1 ? 's' : ''}`;
    }
    if (daysAway === 0) return 'आज';
    if (daysAway === 1) return 'कल';
    if (daysAway < 0)   return `${Math.abs(daysAway)} दिन पहले`;
    if (daysAway < 7)   return `${daysAway} दिन`;
    if (daysAway < 30)  return `${Math.floor(daysAway / 7)} सप्ताह ${daysAway % 7} दिन`;
    const months = Math.floor(daysAway / 30);
    const rem = daysAway % 30;
    return rem > 0 ? `${months} माह ${rem} दिन` : `${months} माह`;
  }

  const eventMs = Date.parse(dateISO + 'T00:00:00Z') + timeUTC * 3600 * 1000;
  const daysAway = Math.round((eventMs - Date.now()) / 86400000);
  const isToday = daysAway === 0;
  const isPast = daysAway < 0;

  function updateCountdowns(hindi) {
    const countdown = formatCountdown(daysAway, hindi);

    const heroBadge = document.getElementById('ed-hero-countdown');
    if (heroBadge) {
      heroBadge.style.display = isPast ? 'none' : '';
      heroBadge.classList.toggle('ed-now', isToday);
    }
    const heroPulse = document.getElementById('ed-hero-pulse');
    if (heroPulse) heroPulse.style.display = isToday ? '' : 'none';
    const heroText = document.getElementById('ed-hero-countdown-text');
    if (heroText) heroText.textContent = countdown;

    const dateCountdown = document.getElementById('ed-date-countdown');
    if (dateCountdown) {
      dateCountdown.textContent = isPast ? (hindi ? `${Math.abs(daysAway)} दिन पहले` : `${Math.abs(daysAway)}d ago`) : countdown;
      dateCountdown.style.color = isPast ? 'var(--color-mute)' : isToday ? 'var(--color-saffron-deep)' : '';
    }

    const sideRow = document.getElementById('ed-sidebar-countdown-row');
    if (sideRow) sideRow.style.display = isPast ? 'none' : '';
    const sideText = document.getElementById('ed-sidebar-countdown-text');
    if (sideText) {
      sideText.textContent = countdown;
      sideText.style.color = isToday ? 'var(--color-saffron-deep)' : '';
      sideText.style.fontWeight = isToday ? '700' : '';
    }
  }
  updateCountdowns(false);

  function applyPageLang(hindi) {
    document.querySelectorAll('.en-text').forEach(el => (el).style.display = hindi ? 'none' : 'block');
    document.querySelectorAll('.hi-text').forEach(el => (el).style.display = hindi ? 'block' : 'none');
    document.querySelectorAll('[data-hi]').forEach(el => {
      if (!el.dataset.en) el.dataset.en = el.textContent || '';
      el.textContent = hindi ? el.dataset.hi : el.dataset.en;
    });
    updateCountdowns(hindi);
  }
  document.addEventListener('langchange', (e) => {
    applyPageLang((e).detail.langCode === 'hi');
  });
  if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>

<style>
/* ── Hero ── */
.ed-hero {
  padding: 48px 0 40px;
  position: relative;
  overflow: hidden;
}
.ed-hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.06) 0%, rgba(0,0,0,0.2) 100%);
  pointer-events: none;
}
.ed-hero-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
  position: relative;
  z-index: 1;
}
.ed-breadcrumb {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: rgba(255,255,255,0.6);
  margin-bottom: 18px;
}
.ed-breadcrumb a { color: rgba(255,255,255,0.6); text-decoration: none; }
.ed-breadcrumb a:hover { color: #fff; }

.ed-hero-body {
  display: flex;
  align-items: center;
  gap: 22px;
}
.ed-icon-wrap {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  border: 1px solid rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
}
.ed-big-icon {
  font-size: 34px;
  line-height: 1;
}
.ed-hero-text { flex: 1; }
.ed-heading {
  font-size: 28px;
  font-weight: 800;
  color: #fff;
  margin: 0 0 10px;
  line-height: 1.2;
  letter-spacing: -0.7px;
  text-shadow: 0 2px 12px rgba(0,0,0,0.22);
}
@media (max-width: 640px) {
  .ed-heading { font-size: 20px; }
  .ed-big-icon { font-size: 24px; }
  .ed-icon-wrap { width: 52px; height: 52px; }
  .ed-hero-body { gap: 14px; }
}
.ed-hero-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.ed-countdown {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  font-family: var(--font-mono, monospace);
  background: rgba(255,255,255,0.18);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.28);
}
.ed-now { background: rgba(255,153,51,0.35); border-color: rgba(255,153,51,0.5); }
.ed-pulse {
  display: inline-block;
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #fff;
  animation: edp 1.4s ease-in-out infinite;
}
@keyframes edp { 0%,100%{opacity:1} 50%{opacity:0.3} }

/* ── Tags ── */
.ed-tag {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  padding: 3px 9px;
  border-radius: 4px;
  background: rgba(255,255,255,0.18);
  color: #fff;
  border: 1px solid rgba(255,255,255,0.26);
}

/* ── Wrapper ── */
.ed-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 24px 60px;
}
.ed-grid {
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 32px;
  align-items: start;
}
@media (max-width: 760px) {
  .ed-grid { grid-template-columns: 1fr; }
}

/* ── Date card ── */
.ed-date-card {
  display: flex;
  border: 1px solid var(--color-hairline);
  border-radius: 10px;
  box-shadow: var(--shadow-elevation);
  overflow: hidden;
  margin-bottom: 28px;
}
.ed-date-col { flex: 1; padding: 16px 18px; }
.ed-sep { width: 1px; background: var(--color-hairline); flex-shrink: 0; }
.ed-label {
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-mute);
  margin: 0 0 5px;
}
.ed-value {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--color-ink);
  margin: 0;
  line-height: 1.4;
}
@media (max-width: 500px) {
  .ed-date-card { flex-direction: column; }
  .ed-sep { width: auto; height: 1px; }
}

/* ── Sections ── */
.ed-section { margin-bottom: 28px; }
.ed-section-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--color-ink);
  margin: 0 0 12px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--color-hairline);
}
.ed-body {
  font-size: 16px;
  line-height: 1.75;
  color: var(--color-body-text);
  margin: 0;
}

/* ── Planet chips ── */
.ed-planets { display: flex; flex-wrap: wrap; gap: 8px; }
.ed-planet-chip {
  display: inline-block;
  font-size: 13px;
  font-weight: 500;
  color: var(--color-ink);
  background: var(--color-canvas-soft);
  border: 1px solid var(--color-hairline);
  border-radius: 999px;
  padding: 4px 12px;
}

/* ── Sidebar ── */
.ed-side-card {
  border: 1px solid var(--color-hairline);
  border-radius: 10px;
  box-shadow: var(--shadow-elevation);
  padding: 18px;
  margin-bottom: 14px;
