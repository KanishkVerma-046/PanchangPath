---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found — PanchangPath" description="The page you're looking for doesn't exist. Explore Panchang, Jyotish calculators, Muhurta tools and more on PanchangPath.">
  <section style="padding:80px 0;text-align:center;">
    <div class="container">
      <p class="caption-mono" style="color:var(--color-mute);margin:0 0 12px;">404</p>
      <h1 style="font-size:28px;font-weight:600;letter-spacing:-1px;color:var(--color-ink);margin:0 0 12px;">Page Not Found</h1>
      <p style="font-size:15px;color:var(--color-body-text);margin:0 0 28px;">The page you're looking for doesn't exist or has moved.</p>
      <a href="/" class="btn-primary" style="display:inline-block;padding:10px 24px;text-decoration:none;">Back to Home</a>
    </div>
  </section>
</Layout>
