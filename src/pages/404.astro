  <ErrorState
    code="404"
    heading="Page Not Found"
    headingHi="पृष्ठ नहीं मिला"
    message="The page you're looking for doesn't exist or has moved."
    messageHi="जिस पृष्ठ को आप खोज रहे हैं वह मौजूद नहीं है या स्थानांतरित कर दिया गया है।"
  />
</Layout>
