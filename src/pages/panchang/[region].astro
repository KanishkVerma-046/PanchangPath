---
import Layout from '../../layouts/Layout.astro';
import {
  REGIONS, getRegionBySlug, getSolarMonthIndex,
  getRegionalTithiName, getRegionalNakshatraName, getRegionalVaraName,
} from '../../lib/panchang-i18n';
import { calculatePanchang, getHinduCalendarInfo, localCivilDate } from '../../lib/panchang';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import { formatDateAtOffset } from '../../lib/date-i18n';

export function getStaticPaths() {
  return REGIONS.map(r => ({ params: { region: r.slug } }));
}

const { region: slug } = Astro.params;
const regionDef = getRegionBySlug(slug!)!;

// Hindi names for each script, sourced from Hindi Wikipedia's own article titles for
// each script (e.g. "बंगाली लिपि", "तमिल लिपि") rather than invented. For most of these
// languages the script genuinely shares its name with the language in Hindi (unlike
// Devanagari, which isn't tied to one language) — this is linguistically correct, not
// a translation gap, and mirrors the English UI, which already shows the same word
// twice for these regions (regionDef.name === regionDef.script for all of them, e.g.
// name: 'Bengali', script: 'Bengali'). This map replaces the old blanket
// `?? regionDef.nameHi` fallback with explicit, sourced entries for every script value
// instead of relying on an implicit coincidence.
const SCRIPT_HI: Record<string, string> = {
  'Devanagari': 'देवनागरी',
  'Devanagari / English': 'देवनागरी / अंग्रेज़ी',
  'Bengali': 'बंगाली',
  'Assamese': 'असमिया',
  'Tamil': 'तमिल',
  'Malayalam': 'मलयालम',
  'Gujarati': 'गुजराती',
  'Kannada': 'कन्नड़',
  'Telugu': 'तेलुगु',
  'Odia': 'ओड़िया',
};
const scriptHi = SCRIPT_HI[regionDef.script] ?? regionDef.nameHi;

// Compute Panchang for this tradition's default city
const today = new Date();
// Calendar date/weekday resolved in THIS tradition's own default-city offset (not raw
// build-machine-local time, which is UTC on the daily-rebuild GH Actions runner and
// therefore ~1 day behind every non-negative-UTC-offset region at the 00:17 IST build
// time) -- same fix as homepage/rashifal hub, parameterized per-region since Nepal
// (+5:45) differs from the other 10 traditions (+5:30). See 2026-08-21 date-bug
// investigation (Tasks 2 & 4 share this one root cause).
const civil = localCivilDate(today, regionDef.defaultTzOffset);
const p = calculatePanchang(today, regionDef.defaultLat, regionDef.defaultLng, regionDef.defaultTzOffset);
const cal = getHinduCalendarInfo(today, p.sunLongitude, p.moonLongitude, p.tithi.paksha);

// Regional element names
const varName  = getRegionalVaraName(regionDef, civil.weekday);
const tithiName = getRegionalTithiName(regionDef, p.tithi.number, p.tithi.paksha);
const nakName  = getRegionalNakshatraName(regionDef, p.nakshatra.number - 1);
const pakshaName = regionDef.paksha[p.tithi.paksha === 'Shukla' ? 0 : 1];

// Month
const solarMonthIdx = getSolarMonthIndex(regionDef, p.sunLongitude);
const AMANTA_TO_IDX: Record<string,number> = {
  Chaitra:0,Vaishakha:1,Jyeshtha:2,Ashadha:3,Shravana:4,Bhadrapada:5,
  Ashwin:6,Kartika:7,Margashirsha:8,Pausha:9,Magha:10,Phalguna:11,
};
const monthName = regionDef.monthSystem === 'solar'
  ? (regionDef.months[solarMonthIdx] ?? regionDef.months[0])
  : (regionDef.months[AMANTA_TO_IDX[cal.amantaMonth.name] ?? 0]);

// Same day-of-year convention as panchang.ts's getHinduCalendarInfo() (Issue #17), but
// computed from the region-shifted calendar date (civil), not the raw build-local one.
const dayOfYear = Math.floor(
  (Date.UTC(civil.year, civil.month - 1, civil.day) - Date.UTC(civil.year, 0, 0)) / 86_400_000,
);
const yearInfo = regionDef.getYear(p.sunLongitude, civil.year, cal.vikramaSamvat, cal.shakaSamvat, dayOfYear);

// Date label
const dateLabel = formatDateAtOffset(today, regionDef.defaultTzOffset, false, { weekday: 'long' });
const dateLabelHi = formatDateAtOffset(today, regionDef.defaultTzOffset, true, { weekday: 'long' });

const TRADITION_COLORS: Record<string, string> = {
  bn: '#e8622a', as: '#d4800f', ta: '#0f766e', ml: '#065f46',
  mr: '#7c3aed', gu: '#b45309', kn: '#1d4ed8', te: '#be185d',
  or: '#dc2626', ne: '#4f46e5', iskcon: '#92400e',
};
const accent = TRADITION_COLORS[regionDef.code] || 'var(--color-saffron)';

// "Today's Panchang" per-region override for a region-specific real search term
// (Task 3, 2026-08-22 audit: "Aajche Panchang" verified as a common real Marathi query,
// e.g. marathimati.com, bhaktibharat.org both title pages exactly this).
const TODAY_PHRASE: Record<string, string> = { mr: 'Aajche Panchang' };
const todayPhrase = TODAY_PHRASE[regionDef.code] ?? "Today's Panchang";

// yearInfo.displayLabel already carries its own trailing abbreviation period for some
// traditions (e.g. Malayalam "കൊ.വ."); avoid stacking a second sentence-ending period.
const yearLabelClean = yearInfo.displayLabel.replace(/\.$/, '');
---

<Layout
  title={`${regionDef.calendarName} — ${todayPhrase} | PanchangPath`}
  description={`${todayPhrase} in ${regionDef.name} (${regionDef.nativeName}) — ${monthName} ${yearLabelClean}. Tithi, Nakshatra, Yoga, Karana, Rahu Kalam & Muhurtas for ${regionDef.defaultCity}, updated daily.`}
>
  <BreadcrumbSchema items={[
    { name: 'Home', url: '/' },
    { name: 'Regional Panchang', url: '/panchang/regional' },
    { name: regionDef.name, url: `/panchang/${slug}` },
  ]} />
  <!-- ── Hero ────────────────────────────────────────────────────────── -->
  <section style={`background:var(--color-canvas);border-bottom:4px solid ${accent};padding:48px 0 40px;`}>
    <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <!-- Breadcrumb -->
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;font-size:13px;">
        <a href="/" data-hi="होम" style="color:var(--color-mute);text-decoration:none;">Home</a>
        <span style="color:var(--color-hairline);">/</span>
        <a href="/panchang/regional" data-hi="क्षेत्रीय पंचांग" style="color:var(--color-mute);text-decoration:none;">Regional Panchang</a>
        <span style="color:var(--color-hairline);">/</span>
        <span style="color:var(--color-body-text);" data-hi={regionDef.calendarNameHi}>{regionDef.calendarName}</span>
      </div>

      <div class="rp-hero">
        <!-- Left: identity -->
        <div>
          <h1 style="display:flex;align-items:center;gap:14px;margin:0 0 10px;">
            <span class="rp-native-big" style={`color:${accent};`}>{regionDef.nativeName}</span>
            <span class="rp-calendar-name" data-hi={regionDef.calendarNameHi}>{regionDef.calendarName}</span>
          </h1>
          <!-- Date in regional calendar -->
          <div class="rp-date-display">
            <span class="rp-month-big">{monthName}</span>
            <span class="rp-year-tag">{yearInfo.displayLabel}</span>
          </div>
          <p class="rp-greg-date" data-hi={`${varName} · ${dateLabelHi}`}>{varName} · {dateLabel}</p>
          <p class="rp-city-note">
            <span data-hi={`📍 ${regionDef.defaultCityHi} के लिए गणना`}>📍 Calculated for {regionDef.defaultCity}</span>
            <span style="color:var(--color-mute);font-size:11px;"> ({regionDef.defaultLat.toFixed(2)}°, {regionDef.defaultLng.toFixed(2)}°)</span>
          </p>
        </div>

        <!-- Right: quick stats pill row -->
        <div class="rp-pills">
          <div class="rp-pill">
            <span class="rp-pill-label" data-hi="तिथि">Tithi</span>
            <span class="rp-pill-val" style={`color:${accent};`}>{tithiName}</span>
          </div>
          <div class="rp-pill">
            <span class="rp-pill-label" data-hi="पक्ष">Paksha</span>
            <span class="rp-pill-val">{pakshaName}</span>
          </div>
          <div class="rp-pill">
            <span class="rp-pill-label" data-hi="नक्षत्र">Nakshatra</span>
            <span class="rp-pill-val">{nakName}</span>
          </div>
          <div class="rp-pill">
            <span class="rp-pill-label" data-hi="वार">Vara</span>
            <span class="rp-pill-val">{varName}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Main Panchang table ───────────────────────────────────────────── -->
  <section style="padding:40px 0 56px;">
    <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <div class="rp-layout">

        <!-- ── LEFT: Panchang elements ──────────────────────────────── -->
        <div class="rp-main">
          <h2 class="section-head" style={`border-left:3px solid ${accent};`}>
            {regionDef.nativeName} — आज का पञ्चाङ्ग
          </h2>

          <!-- 5 angas grid -->
          <div class="rp-anga-grid">
            <!-- Vara -->
            <div class="rp-anga-card">
              <div class="rp-anga-icon">☀️</div>
              <div class="rp-anga-content">
                <p class="rp-anga-label">वार / Vara</p>
                <p class="rp-anga-regional">{varName}</p>
                <p class="rp-anga-en">{p.vara.name} · Lord: {p.vara.lord}</p>
              </div>
            </div>

            <!-- Tithi -->
            <div class="rp-anga-card">
              <div class="rp-anga-icon">🌙</div>
              <div class="rp-anga-content">
                <p class="rp-anga-label">तिथि / Tithi</p>
                <p class="rp-anga-regional">{tithiName}</p>
                <p class="rp-anga-en">{pakshaName} · {p.tithi.name} · ends {p.tithi.endTime}</p>
              </div>
            </div>

            <!-- Nakshatra -->
            <div class="rp-anga-card">
              <div class="rp-anga-icon">⭐</div>
              <div class="rp-anga-content">
                <p class="rp-anga-label">नक्षत्र / Nakshatra</p>
                <p class="rp-anga-regional">{nakName}</p>
                <p class="rp-anga-en">Pada {p.nakshatra.pada} · Lord: {p.nakshatra.lord} · ends {p.nakshatra.endTime}</p>
              </div>
            </div>

            <!-- Yoga -->
            <div class="rp-anga-card">
              <div class="rp-anga-icon">🔯</div>
              <div class="rp-anga-content">
                <p class="rp-anga-label">योग / Yoga</p>
                <p class="rp-anga-regional">{p.yoga.name}</p>
                <p class="rp-anga-en">{p.yoga.type} · ends {p.yoga.endTime}</p>
              </div>
            </div>

            <!-- Karana -->
            <div class="rp-anga-card">
              <div class="rp-anga-icon">🌀</div>
              <div class="rp-anga-content">
                <p class="rp-anga-label">करण / Karana</p>
                <p class="rp-anga-regional">{p.karana.name}</p>
                <p class="rp-anga-en">ends {p.karana.endTime}</p>
              </div>
            </div>

            <!-- Month (regional) -->
            <div class="rp-anga-card" style={`border-left:3px solid ${accent};`}>
              <div class="rp-anga-icon">📅</div>
              <div class="rp-anga-content">
                <p class="rp-anga-label">माह / Month</p>
                <p class="rp-anga-regional" style={`color:${accent};`}>{monthName}</p>
                <p class="rp-anga-en">{yearInfo.displayLabel}</p>
              </div>
            </div>
          </div>

          <!-- ── Sun / Moon timings ─────────────────────────────────── -->
          <h2 class="section-head" data-hi="सूर्य और चंद्र समय" style={`border-left:3px solid ${accent};margin-top:32px;`}>
            Sun & Moon Timings
          </h2>
          <div class="rp-timing-grid">
            <div class="rp-timing-card">
              <span class="rp-timing-icon">🌅</span>
              <div>
                <p class="rp-timing-label" data-hi="सूर्योदय">Sunrise</p>
                <p class="rp-timing-val">{p.sunrise}</p>
              </div>
            </div>
            <div class="rp-timing-card">
              <span class="rp-timing-icon">🌇</span>
              <div>
                <p class="rp-timing-label" data-hi="सूर्यास्त">Sunset</p>
                <p class="rp-timing-val">{p.sunset}</p>
              </div>
            </div>
            <div class="rp-timing-card">
              <span class="rp-timing-icon">🌕</span>
              <div>
                <p class="rp-timing-label" data-hi="चंद्रोदय">Moonrise</p>
                <p class="rp-timing-val">{p.moonrise}</p>
              </div>
            </div>
            <div class="rp-timing-card">
              <span class="rp-timing-icon">⏱️</span>
              <div>
                <p class="rp-timing-label" data-hi="दिन की अवधि">Day Duration</p>
                <p class="rp-timing-val">{p.durationDay}</p>
              </div>
            </div>
          </div>

          <!-- ── Inauspicious periods ───────────────────────────────── -->
          <h2 class="section-head" data-hi="अशुभ काल" style={`border-left:3px solid ${accent};margin-top:32px;`}>
            Inauspicious Periods
          </h2>
          <div class="rp-kalam-grid">
            <div class="rp-kalam-card">
              <p class="rp-kalam-name" data-hi="🚫 राहु काल">🚫 Rahu Kalam</p>
              <p class="rp-kalam-time">{p.rahuKalam.start} – {p.rahuKalam.end}</p>
            </div>
            <div class="rp-kalam-card">
              <p class="rp-kalam-name" data-hi="⚠️ गुलिक काल">⚠️ Gulika Kalam</p>
              <p class="rp-kalam-time">{p.gulikaKalam.start} – {p.gulikaKalam.end}</p>
            </div>
            <div class="rp-kalam-card">
              <p class="rp-kalam-name" data-hi="⚠️ यमगण्ड">⚠️ Yamaganda</p>
              <p class="rp-kalam-time">{p.yamaganda.start} – {p.yamaganda.end}</p>
            </div>
            <div class="rp-kalam-card" style="border-color:var(--color-saffron);">
              <p class="rp-kalam-name" data-hi="✨ अभिजीत मुहूर्त">✨ Abhijit Muhurta</p>
              <p class="rp-kalam-time">{p.abhijitMuhurta.start} – {p.abhijitMuhurta.end}</p>
            </div>
          </div>

          <!-- ── All nakshatra names ─────────────────────────────────── -->
          <details class="rp-naksha-details">
            <summary class="rp-naksha-summary" data-hi={`${regionDef.nameHi} में 27 नक्षत्र · ${scriptHi}`}>
              27 Nakshatras in {regionDef.name} · <span style={`color:${accent};`}>{regionDef.script}</span>
            </summary>
            <div class="rp-naksha-grid">
              {regionDef.nakshatras.map((n, i) => (
                <div class={`rp-naksha-item ${i === p.nakshatra.number - 1 ? 'rp-naksha-current' : ''}`}
                  style={i === p.nakshatra.number - 1 ? `border-color:${accent};background:var(--color-saffron-soft);` : ''}>
                  <span class="rp-naksha-num">{i + 1}</span>
                  <span class="rp-naksha-name">{n}</span>
                </div>
              ))}
            </div>
          </details>
        </div>

        <!-- ── RIGHT: sidebar ────────────────────────────────────────── -->
        <aside class="rp-sidebar">

          <!-- Tradition info card -->
          <div class="rp-info-card" style={`border-top:4px solid ${accent};`}>
            <h3 class="rp-info-title" data-hi={regionDef.calendarNameHi}>{regionDef.calendarName}</h3>
            <p class="rp-info-body" data-hi={regionDef.descriptionHi}>{regionDef.description}</p>
            <div class="rp-info-row">
              <span class="rp-info-key" data-hi="लिपि">Script</span>
              <span class="rp-info-val" data-hi={scriptHi}>{regionDef.script}</span>
            </div>
            <div class="rp-info-row">
              <span class="rp-info-key" data-hi="कैलेंडर">Calendar</span>
              <span class="rp-info-val" data-hi={regionDef.monthSystem === 'solar' ? 'सौर (सौरमान)' : 'चंद्र (चांद्रमान)'}>{regionDef.monthSystem === 'solar' ? 'Solar (Sauramana)' : 'Lunar (Chandramana)'}</span>
            </div>
            <div class="rp-info-row">
              <span class="rp-info-key" data-hi="युग">Year era</span>
              <span class="rp-info-val">{yearInfo.era}</span>
            </div>
            <div class="rp-info-row">
              <span class="rp-info-key" data-hi="वर्तमान वर्ष">Current year</span>
              <span class="rp-info-val" style={`color:${accent};font-weight:700;`}>{yearInfo.num}</span>
            </div>
          </div>

          <!-- Special note -->
          <div class="rp-note-card">
            <p class="rp-note-icon">💡</p>
            <p class="rp-note-body" data-hi={regionDef.specialNoteHi}>{regionDef.specialNote}</p>
          </div>

          <!-- Month names list -->
          <div class="rp-months-card">
            <h3 class="rp-months-title" data-hi={`${regionDef.nameHi} में 12 महीने`}>12 Months in {regionDef.name}</h3>
            <div class="rp-months-list">
              {regionDef.months.map((m, i) => (
                <div class={`rp-month-item ${m === monthName ? 'rp-month-current' : ''}`}
                  style={m === monthName ? `border-color:${accent};background:var(--color-saffron-soft);` : ''}>
                  <span class="rp-month-num">{i + 1}</span>
                  <span class="rp-month-name">{m}</span>
                  {m === monthName && <span class="rp-month-badge" data-hi="अभी" style={`background:${accent};`}>Now</span>}
                </div>
              ))}
            </div>
          </div>

          <!-- Link back + other traditions -->
          <div class="rp-other-card">
            <a href="/panchang/regional" class="rp-back-link" data-hi="← सभी क्षेत्रीय पंचांग">
              ← All Regional Panchangs
            </a>
            <p class="rp-other-head" data-hi="अन्य परंपराएँ">Other traditions</p>
            <div class="rp-other-list">
              {REGIONS.filter(r => r.slug !== slug).slice(0, 5).map(r => (
                <a href={`/panchang/${r.slug}`} class="rp-other-link">
                  <span class="rp-other-native" style={`color:${TRADITION_COLORS[r.code]};`}>{r.nativeName}</span>
                  <span class="rp-other-name" data-hi={r.calendarNameHi}>{r.calendarName}</span>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</Layout>

<script>
// ── Hindi UI coverage ──
// LanguagePicker.astro dispatches 'langchange' on document with { langCode }.
// This page's own static chrome (breadcrumb, section headings, pill/sidebar labels)
// responds; the regional tradition's own name/month/tithi/nakshatra data is a
// separate, intentional axis (see CLAUDE.md) and is left untouched here.
function applyPageLang(hindi: boolean) {
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
  });
}
document.addEventListener('langchange', (e: Event) => {
  const evt = e as CustomEvent;
  applyPageLang(evt.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>

<style>
/* ── Hero ── */
.rp-hero { display: flex; align-items: flex-start; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
.rp-native-big { font-size: 28px; font-weight: 800; font-family: sans-serif; letter-spacing: -0.5px; }
.rp-calendar-name { font-size: 14px; font-weight: 600; color: var(--color-mute); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; }
.rp-date-display { display: flex; align-items: baseline; gap: 12px; margin-bottom: 8px; flex-wrap: wrap; }
.rp-month-big { font-size: 36px; font-weight: 800; color: var(--color-ink); letter-spacing: -1px; font-family: sans-serif; }
.rp-year-tag { font-size: 13px; font-weight: 600; color: var(--color-mute); font-family: var(--font-mono); }
.rp-greg-date { font-size: 14px; color: var(--color-body-text); margin: 0 0 4px; }
.rp-city-note { font-size: 13px; color: var(--color-body-text); margin: 0; }

.rp-pills { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; min-width: 260px; }
.rp-pill { background: var(--color-canvas-soft); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); box-shadow: var(--shadow-elevation); padding: 12px 14px; }
.rp-pill-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-mute); font-family: var(--font-mono); margin: 0 0 4px; }
.rp-pill-val { font-size: 15px; font-weight: 700; color: var(--color-ink); margin: 0; font-family: sans-serif; overflow-wrap: anywhere; }

/* ── Layout ── */
.rp-layout { display: grid; grid-template-columns: 1fr 340px; gap: 32px; align-items: start; }
@media (max-width: 960px) { .rp-layout { grid-template-columns: 1fr; } .rp-sidebar { order: -1; } }

.section-head { font-size: 14px; font-weight: 700; color: var(--color-ink); letter-spacing: 0.02em; text-transform: uppercase; margin: 0 0 16px; padding-left: 10px; font-family: var(--font-mono); }

/* ── Anga cards ── */
.rp-anga-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
@media (max-width: 540px) { .rp-anga-grid { grid-template-columns: 1fr; } }
.rp-anga-card { display: flex; gap: 12px; background: var(--color-canvas); border: 1px solid var(--color-hairline); border-radius: var(--radius-lg); box-shadow: var(--shadow-elevation); padding: 14px 16px; }
.rp-anga-icon { font-size: 20px; flex-shrink: 0; margin-top: 2px; }
.rp-anga-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-data-label); font-family: var(--font-mono); margin: 0 0 4px; }
.rp-anga-regional { font-size: 18px; font-weight: 700; color: var(--color-data-value); margin: 0 0 3px; font-family: sans-serif; line-height: 1.2; }
.rp-anga-en { font-size: 11px; color: var(--color-mute); margin: 0; }

/* ── Timings ── */
