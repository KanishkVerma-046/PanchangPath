---
import Layout from '../layouts/Layout.astro';
import StaticPage from '../components/StaticPage.astro';
---

<Layout title="Contact Us — PanchangPath" description="Contact PanchangPath — use the quick form to share feedback, report an error in a Panchang or Kundali calculation, ask a question, or just say hello to us.">
  <StaticPage title="Contact Us" titleHi="संपर्क करें">
    <p data-hi="प्रतिक्रिया है, किसी गणना में त्रुटि देखी है, या बस नमस्ते कहना चाहते हैं? नीचे दिया गया फॉर्म भरें और यह सीधे पहुंच जाएगा।">Have feedback, spotted an error in a calculation, or just want to say hello? Fill out the form below and it'll come straight through.</p>
    <div style="margin-top:24px;">
      <iframe
        src="https://docs.google.com/forms/d/e/1FAIpQLSddXjUtNJUJKhjFPAwOKBqzHYHvMWIkvO5YWrXnG6w_GlY20w/viewform?embedded=true"
        title="PanchangPath contact form"
        width="100%"
        height="1200"
        style="border:1px solid var(--color-hairline);border-radius:8px;max-width:100%;"
        loading="lazy"
      >Loading…</iframe>
    </div>
  </StaticPage>
</Layout>
