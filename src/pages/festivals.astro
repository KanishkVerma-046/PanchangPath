---
import Layout from '../layouts/Layout.astro';
import { FESTIVALS_2025_2027, daysUntil } from '../lib/festivals';

const today = new Date();
const festivalYears = FESTIVALS_2025_2027.map(f => +f.date.slice(0, 4));
const yearRange = `${Math.min(...festivalYears)}-${Math.max(...festivalYears)}`;
const upcoming = FESTIVALS_2025_2027.filter(f => f.date >= today.toISOString().split('T')[0])
  .sort((a, b) => a.date.localeCompare(b.date));
const past = FESTIVALS_2025_2027.filter(f => f.date < today.toISOString().split('T')[0])
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 6);

// Group upcoming by month
const byMonth: Record<string, typeof upcoming> = {};
for (const f of upcoming) {
  const key = f.date.slice(0, 7);
  if (!byMonth[key]) byMonth[key] = [];
  byMonth[key].push(f);
}

function monthLabel(key: string) {
  const [y, m] = key.split('-');
  return new Date(+y, +m - 1, 1).toLocaleDateString('en-IN', { month: 'long', year: 'numeric' });
}

const MONTH_HI = ['जनवरी', 'फरवरी', 'मार्च', 'अप्रैल', 'मई', 'जून', 'जुलाई', 'अगस्त', 'सितंबर', 'अक्टूबर', 'नवंबर', 'दिसंबर'];
const WEEKDAY_HI = ['रविवार', 'सोमवार', 'मंगलवार', 'बुधवार', 'गुरुवार', 'शुक्रवार', 'शनिवार'];
function monthLabelHi(key: string) {
  const [y, m] = key.split('-');
  return `${MONTH_HI[+m - 1]} ${y}`;
}
function typeLabelHi(type: string) {
  return type === 'major' ? '✦ प्रमुख' : type === 'vrat' ? 'व्रत' : 'क्षेत्रीय';
}
---

<Layout title={`Hindu Festival Calendar ${yearRange} — PanchangPath`} description={`Complete Hindu festival and vrat calendar for ${yearRange.replace('-', ' to ')}. All major festivals with dates, descriptions, and countdowns.`}>
  <!-- Hero -->
  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:48px 0 40px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.5;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <p class="caption-mono" data-hi="पूर्ण कैलेंडर" style="color:var(--color-mute);margin:0 0 10px;">Complete Calendar</p>
      <h1 style="font-size:36px;font-weight:600;letter-spacing:-1.4px;color:var(--color-ink);margin:0 0 12px;"><span class="en-text">Hindu Festivals &amp; Vrats.</span><span class="hi-text" style="display:none">हिंदू त्योहार और व्रत।</span></h1>
      <p style="font-size:16px;color:var(--color-body-text);margin:0;max-width:480px;"><span class="en-text">All major Hindu festivals, vrats, and auspicious days for {yearRange.replace('-', '–')} with detailed information.</span><span class="hi-text" style="display:none">{yearRange.replace('-', '–')} के लिए सभी प्रमुख हिंदू त्योहार, व्रत और शुभ दिन विस्तृत जानकारी के साथ।</span></p>
    </div>
  </section>

  <!-- Filter row -->
  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:12px 0;position:sticky;top:60px;z-index:40;">
    <div class="container" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
      <button class="filter-btn active" data-filter="all" data-hi="सभी" style="font-size:13px;font-weight:500;padding:5px 14px;border-radius:100px;border:1px solid var(--color-hairline);background:var(--color-ink);color:var(--color-on-primary);cursor:pointer;">All</button>
      <button class="filter-btn" data-filter="major" data-hi="✦ प्रमुख" style="font-size:13px;font-weight:500;padding:5px 14px;border-radius:100px;border:1px solid var(--color-hairline);background:var(--color-canvas);color:var(--color-ink);cursor:pointer;">✦ Major</button>
      <button class="filter-btn" data-filter="vrat" data-hi="व्रत" style="font-size:13px;font-weight:500;padding:5px 14px;border-radius:100px;border:1px solid var(--color-hairline);background:var(--color-canvas);color:var(--color-ink);cursor:pointer;">Vrat</button>
      <button class="filter-btn" data-filter="regional" data-hi="क्षेत्रीय" style="font-size:13px;font-weight:500;padding:5px 14px;border-radius:100px;border:1px solid var(--color-hairline);background:var(--color-canvas);color:var(--color-ink);cursor:pointer;">Regional</button>
    </div>
  </section>

  <!-- Festival list by month -->
  <section style="padding:40px 0;">
    <div class="container" id="festival-list">
      {Object.entries(byMonth).map(([key, festivals]) => (
        <div class="month-section" style="margin-bottom:40px;">
          <h2 style="font-size:13px;font-weight:500;color:var(--color-mute);letter-spacing:0.06em;text-transform:uppercase;font-family:var(--font-mono);margin:0 0 16px;padding-bottom:12px;border-bottom:1px solid var(--color-hairline);" data-hi={monthLabelHi(key)}>{monthLabel(key)}</h2>
          <div style="display:flex;flex-direction:column;gap:8px;">
            {festivals.map(f => {
              const fd = new Date(f.date);
              const days = daysUntil(today, f.date);
              return (
                <div class={`festival-item card`} data-type={f.type} style="padding:16px 20px;display:flex;align-items:center;gap:16px;">
                  <!-- Date box -->
                  <div style="width:52px;flex-shrink:0;text-align:center;background:var(--color-canvas-soft-2);border-radius:8px;padding:8px 4px;">
                    <p style="font-size:20px;font-weight:700;line-height:1;color:var(--color-ink);margin:0;">{fd.getDate()}</p>
                    <p style="font-size:10px;color:var(--color-mute);margin:2px 0 0;font-family:var(--font-mono);text-transform:uppercase;">{fd.toLocaleDateString('en-IN',{month:'short'})}</p>
                  </div>
                  <!-- Info -->
                  <div style="flex:1;min-width:0;">
                    <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px;flex-wrap:wrap;">
                      <p class="en-text" style="font-size:16px;font-weight:600;color:var(--color-ink);margin:0;">{f.name}</p>
                      <p class="hi-text" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0;display:none;">{f.nameHi}</p>
                      <span class={f.type === 'major' ? 'badge badge-saffron' : 'badge'} style="font-size:10px;" data-hi={typeLabelHi(f.type)}>{f.type === 'major' ? '✦ Major' : f.type === 'vrat' ? 'Vrat' : 'Regional'}</span>
                    </div>
                    <p style="font-size:12px;color:var(--color-mute);margin:0;font-family:var(--font-mono);" data-hi={WEEKDAY_HI[fd.getDay()]}>{fd.toLocaleDateString('en-IN',{weekday:'long'})}</p>
                    <p style="font-size:13px;color:var(--color-body-text);margin:4px 0 0;" data-hi={f.descriptionHi}>{f.description}</p>
                  </div>
                  <!-- Countdown -->
                  <div style="flex-shrink:0;text-align:right;">
                    {days === 0 ? (
                      <span class="badge badge-saffron" style="font-size:12px;" data-hi="आज 🎉">Today 🎉</span>
                    ) : days === 1 ? (
                      <span class="badge badge-auspicious" style="font-size:12px;" data-hi="कल">Tomorrow</span>
                    ) : (
                      <div>
                        <p style="font-size:22px;font-weight:700;color:var(--color-ink);margin:0;letter-spacing:-0.5px;line-height:1;">{days}</p>
                        <p style="font-size:10px;color:var(--color-mute);margin:0;font-family:var(--font-mono);" data-hi="दिन शेष">days away</p>
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Recently Celebrated -->
  {past.length > 0 && (
    <section style="padding:0 0 48px;">
      <div class="container">
        <h2 style="font-size:13px;font-weight:500;color:var(--color-mute);letter-spacing:0.06em;text-transform:uppercase;font-family:var(--font-mono);margin:0 0 16px;padding-bottom:12px;border-bottom:1px solid var(--color-hairline);" data-hi="हाल ही में मनाए गए">Recently Celebrated</h2>
        <div style="display:flex;flex-direction:column;gap:8px;">
          {past.map(f => {
            const fd = new Date(f.date);
            const daysAgo = -daysUntil(today, f.date);
            return (
              <div class="card" data-type={f.type} style="padding:16px 20px;display:flex;align-items:center;gap:16px;opacity:0.82;">
                <!-- Date box -->
                <div style="width:52px;flex-shrink:0;text-align:center;background:var(--color-canvas-soft-2);border-radius:8px;padding:8px 4px;">
                  <p style="font-size:20px;font-weight:700;line-height:1;color:var(--color-ink);margin:0;">{fd.getDate()}</p>
                  <p style="font-size:10px;color:var(--color-mute);margin:2px 0 0;font-family:var(--font-mono);text-transform:uppercase;">{fd.toLocaleDateString('en-IN',{month:'short'})}</p>
                </div>
                <!-- Info -->
                <div style="flex:1;min-width:0;">
                  <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px;flex-wrap:wrap;">
                    <p class="en-text" style="font-size:16px;font-weight:600;color:var(--color-ink);margin:0;">{f.name}</p>
                    <p class="hi-text" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0;display:none;">{f.nameHi}</p>
                    <span class={f.type === 'major' ? 'badge badge-saffron' : 'badge'} style="font-size:10px;" data-hi={typeLabelHi(f.type)}>{f.type === 'major' ? '✦ Major' : f.type === 'vrat' ? 'Vrat' : 'Regional'}</span>
                  </div>
                  <p style="font-size:12px;color:var(--color-mute);margin:0;font-family:var(--font-mono);" data-hi={WEEKDAY_HI[fd.getDay()]}>{fd.toLocaleDateString('en-IN',{weekday:'long'})}</p>
                  <p style="font-size:13px;color:var(--color-body-text);margin:4px 0 0;" data-hi={f.descriptionHi}>{f.description}</p>
                </div>
                <!-- Days ago -->
                <div style="flex-shrink:0;text-align:right;">
                  <p style="font-size:22px;font-weight:700;color:var(--color-mute);margin:0;letter-spacing:-0.5px;line-height:1;">{daysAgo}</p>
                  <p style="font-size:10px;color:var(--color-mute);margin:0;font-family:var(--font-mono);" data-hi="दिन पहले">{daysAgo === 1 ? 'day ago' : 'days ago'}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}
</Layout>

<script>
  // Filter buttons
  const btns = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.festival-item');

  function hideEmptyMonthSections() {
    document.querySelectorAll('.month-section').forEach(sec => {
      const visible = sec.querySelectorAll('.festival-item:not([style*="none"])').length;
      (sec as HTMLElement).style.display = visible ? 'block' : 'none';
    });
  }

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => {
        (b as HTMLElement).style.background = 'var(--color-canvas)';
        (b as HTMLElement).style.color = 'var(--color-ink)';
      });
      (btn as HTMLElement).style.background = 'var(--color-ink)';
      (btn as HTMLElement).style.color = 'var(--color-on-primary)';
      const filter = btn.getAttribute('data-filter');
      items.forEach(item => {
        const type = item.getAttribute('data-type');
        (item as HTMLElement).style.display = (filter === 'all' || type === filter) ? 'flex' : 'none';
      });
      hideEmptyMonthSections();
    });
  });

  // Deep-link support: /festivals?filter=vrat|major|regional (header nav "Vrat Calendar")
  const filterParam = new URLSearchParams(location.search).get('filter');
  if (filterParam) {
    (document.querySelector(`.filter-btn[data-filter="${filterParam}"]`) as HTMLElement | null)?.click();
  }

  // Language toggle
  function applyPageLang(hindi: boolean) {
    document.querySelectorAll('.en-text').forEach(el => (el as HTMLElement).style.display = hindi ? 'none' : 'block');
    document.querySelectorAll('.hi-text').forEach(el => (el as HTMLElement).style.display = hindi ? 'block' : 'none');
    document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
      if (!el.dataset.en) el.dataset.en = el.textContent || '';
      el.textContent = hindi ? (el.dataset.hi ?? '') : el.dataset.en;
    });
  }
  document.addEventListener('langchange', (e: Event) => {
    const evt = e as CustomEvent;
    applyPageLang(evt.detail.langCode === 'hi');
  });
  if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
</Layout>
