---
import Layout from '../../layouts/Layout.astro';
import { computeAbhijitWindows } from '../../lib/muhurta';
import { formatMinutes12h } from '../../lib/time-format';

// Build-time default: today (IST, matching the daily-rebuild cron's clock) at New Delhi, the
// site's default location. Uses the exact same computeAbhijitWindows() the client <script>
// below calls for date/location changes, so server and client can never disagree — see
// CLAUDE.md's 2026-08-18 SEO-prerender rollout note.
const NEW_DELHI = { name: 'New Delhi', lat: 28.6139, lng: 77.209, tz: 5.5 };
const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
const istNow = new Date(Date.now() + IST_OFFSET_MS);
const defY = istNow.getUTCFullYear();
const defM = istNow.getUTCMonth() + 1;
const defD = istNow.getUTCDate();

const defaultAb = computeAbhijitWindows(defY, defM, defD, NEW_DELHI.lat, NEW_DELHI.lng, NEW_DELHI.tz);
const fmt = formatMinutes12h;

const AB_CARDS = [
  {
    name: 'Abhijit Muhurat', nameHi: 'अभिजित मुहूर्त',
    start: defaultAb.abhijit.start, end: defaultAb.abhijit.end,
    icon: '☀️', color: '#b45309', bg: '#fef3c7',
    note: defaultAb.isWednesday ? '⚠️ Wednesday — Abhijit is weaker today' : 'Universally auspicious — overrides most doshas',
    disabled: defaultAb.isWednesday,
  },
  {
    name: 'Do Ghati Muhurat', nameHi: 'दो घटी मुहूर्त',
    start: defaultAb.doGhati.start, end: defaultAb.doGhati.end,
    icon: '⏱️', color: '#b45309', bg: '#fef9eb',
    note: '48-minute window centered on solar noon (1 Ghati each side)',
    disabled: false,
  },
  {
    name: 'Brahma Muhurta', nameHi: 'ब्रह्म मुहूर्त',
    start: defaultAb.brahma.start, end: defaultAb.brahma.end,
    icon: '🌅', color: '#16803D', bg: '#DCF3E3',
    note: 'Best for meditation, spiritual practice & study',
    disabled: false,
  },
];
---

<Layout title="Abhijit Muhurat, Do Ghati & Brahma Muhurta — PanchangPath" description="Abhijit Muhurat (midday auspicious window), Do Ghati Muhurat, and Brahma Muhurta (pre-dawn) for any date and location.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/muhurta" data-hi="← मुहूर्त उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Muhurta Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">अभिजित मुहूर्त</p>
      <h1 data-hi="अभिजित मुहूर्त" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Abhijit Muhurat</h1>
      <p data-hi="सबसे सार्वभौमिक शुभ समय अवधि — सौर मध्याह्न पर केंद्रित। साथ ही दो घटी मुहूर्त और ब्रह्म मुहूर्त भी दिखाए गए हैं।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:500px;">The most universally auspicious time window — centered on solar noon. Also shows Do Ghati (2-Ghati) Muhurat and Brahma Muhurta.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div>
          <label for="ab-date" data-hi="दिनांक" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Date</label>
          <input type="date" id="ab-date" class="input" style="height:38px;" />
        </div>
        <div>
          <label for="ab-city" data-hi="स्थान" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Location</label>
          <select id="ab-city" class="input" style="height:38px;min-width:160px;"></select>
        </div>
        <button id="ab-calc" data-hi="गणना करें" class="btn-primary" style="height:38px;padding:0 20px;">Calculate</button>
      </div>

      <!-- Default-location note: prerendered alongside the New Delhi defaults below; client JS
           hides it once a non-default city is selected. -->
      <p id="ab-default-note" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;">Showing Abhijit Muhurat for New Delhi — select your city above for your location.</p>

      <!-- Three special muhurta cards -->
      <div id="ab-cards" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;margin-bottom:48px;">
        {AB_CARDS.map(item => (
          <div class="card" style="padding:22px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
              <div style="display:flex;align-items:center;gap:10px;">
                <span style="font-size:28px;">{item.icon}</span>
                <div>
                  <p style="font-size:15px;font-weight:700;color:var(--color-ink);margin:0 0 2px;">{item.name}</p>
                  <p style="font-size:11px;color:var(--color-mute);margin:0;font-family:var(--font-mono);">{item.nameHi}</p>
                </div>
              </div>
            </div>
            <div style={`background:${item.bg};border-radius:10px;padding:14px 16px;margin-bottom:12px;`}>
              <p style={`font-size:22px;font-weight:700;color:${item.color};margin:0;font-family:var(--font-mono);`}>{fmt(item.start)} – {fmt(item.end)}</p>
              <p style="font-size:11px;color:var(--color-mute);margin:4px 0 0;">Duration: {Math.round(item.end - item.start)} minutes</p>
            </div>
            <p style={`font-size:12px;color:${item.disabled?'#dc2626':'var(--color-body-text)'};margin:0;line-height:1.5;`}>{item.note}</p>
          </div>
        ))}
      </div>

      <!-- What is section -->
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px;">
        {[
          { title:'Abhijit Muhurat', titleHi:'अभिजित मुहूर्त', icon:'☀️', text:'Named after the Nakshatra Abhijit (Vega), this is the 8th Muhurta of the day — centered on true solar noon, spanning half a Muhurta (day length ÷ 30) on each side. It is considered so auspicious that it can override most other restrictions. Works on all days except Wednesday (when Abhijit is weak).', textHi:'नक्षत्र अभिजित (वेगा) के नाम पर रखा गया, यह दिन का 8वां मुहूर्त है — सही सौर मध्याह्न पर केंद्रित, जो प्रत्येक ओर आधा मुहूर्त (दिन की लंबाई ÷ 30) फैला होता है। यह इतना शुभ माना जाता है कि यह अधिकांश अन्य बाधाओं को निष्प्रभावी कर सकता है। बुधवार को छोड़कर सभी दिनों में कार्य करता है (जब अभिजित कमजोर होता है)।' },
          { title:'Do Ghati Muhurat', titleHi:'दो घटी मुहूर्त', icon:'⏱️', text:'Two Ghatis (48 minutes) spanning solar noon. 1 Ghati = 24 minutes. This is the core of Abhijit — the most concentrated auspicious window of the day. Ideal for starting important ceremonies that could not find another Muhurta.', textHi:'सौर मध्याह्न के चारों ओर फैली दो घटी (48 मिनट)। 1 घटी = 24 मिनट। यह अभिजित का मूल है — दिन की सबसे सघन शुभ अवधि। महत्वपूर्ण समारोहों के लिए आदर्श जिन्हें कोई अन्य मुहूर्त नहीं मिल पाया।' },
          { title:'Brahma Muhurta', titleHi:'ब्रह्म मुहूर्त', icon:'🌅', text:'The "Creator\'s Hour" — 1 hour 36 minutes before sunrise (specifically 3 Muhurtas: 96 min before sunrise to 48 min before sunrise). Best for spiritual practice, meditation, study, and early morning rituals. Associated with clarity, memory, and divine connection.', textHi:'‘सृष्टिकर्ता का समय’ — सूर्योदय से 1 घंटा 36 मिनट पहले (विशेष रूप से 3 मुहूर्त: सूर्योदय से 96 मिनट पहले से 48 मिनट पहले तक)। आध्यात्मिक साधना, ध्यान, अध्ययन और प्रातःकालीन अनुष्ठानों के लिए सर्वोत्तम। स्पष्टता, स्मरण शक्ति और दिव्य संबंध से जुड़ा हुआ।' },
        ].map(item => (
          <div class="card" style="padding:20px;">
            <div style="font-size:24px;margin-bottom:10px;">{item.icon}</div>
            <p data-hi={item.titleHi} style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 8px;">{item.title}</p>
            <p data-hi={item.textHi} style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.7;">{item.text}</p>
          </div>
        ))}
      </div>

      <!-- How it's calculated -->
      <div class="card" style="padding:24px;max-width:780px;margin-top:16px;">
        <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 10px;">How These Windows Are Calculated</h3>
        <p style="font-size:14px;color:var(--color-body-text);margin:0 0 10px;line-height:1.7;">A full day-night cycle is traditionally divided into 30 Muhurtas — 15 across daylight, 15 across the night. Abhijit is the 8th of the 15 daytime Muhurtas: since 15 is odd, the 8th is the exact middle one, which is why Abhijit lands on true solar noon — the moment the Sun actually crosses the local meridian, which shifts through the year with the equation of time, not clock noon. Its width equals day length ÷ 15, roughly 40 to 55 minutes depending on the season and location rather than a fixed span.</p>
        <p style="font-size:14px;color:var(--color-body-text);margin:0 0 10px;line-height:1.7;">Do Ghati Muhurat is different by definition: a Ghati is a fixed traditional unit of 24 minutes, unrelated to day length, so two Ghatis centered on the same solar noon always total exactly 48 minutes — the most concentrated slice of Abhijit. Brahma Muhurta is calculated backward from that day's sunrise instead: the third-from-last Muhurta of the night, spanning 96 to 48 minutes before sunrise.</p>
        <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.7;">Classical muhurta tradition treats Wednesday as an exception to Abhijit's usual strength, which is why this calculator marks that day's window as reduced rather than fully auspicious. <a href="https://astrobix.com/articles/Abhijit-Muhurat-Gives-Auspicious-Results.aspx" style="color:var(--color-saffron-deep);">AstroBix: Abhijit Muhurat</a></p>
      </div>
    </div>
  </section>
</Layout>

<script>
import { computeAbhijitWindows } from '../../lib/muhurta';
import { formatMinutes12h } from '../../lib/time-format';

const LOCS = [
  {name:'New Delhi',nameHi:'नई दिल्ली',lat:28.6139,lng:77.209,tz:5.5},
  {name:'Mumbai',nameHi:'मुंबई',lat:19.076,lng:72.8777,tz:5.5},
  {name:'Bengaluru',nameHi:'बेंगलुरू',lat:12.9716,lng:77.5946,tz:5.5},
  {name:'Chennai',nameHi:'चेन्नई',lat:13.0827,lng:80.2707,tz:5.5},
  {name:'Kolkata',nameHi:'कोलकाता',lat:22.5726,lng:88.3639,tz:5.5},
  {name:'Hyderabad',nameHi:'हैदराबाद',lat:17.385,lng:78.4867,tz:5.5},
  {name:'Jaipur',nameHi:'जयपुर',lat:26.9124,lng:75.7873,tz:5.5},
  {name:'Varanasi',nameHi:'वाराणसी',lat:25.3176,lng:82.9739,tz:5.5},
  {name:'Dubai',nameHi:'दुबई',lat:25.2048,lng:55.2708,tz:4},
  {name:'New York',nameHi:'न्यूयॉर्क',lat:40.7128,lng:-74.006,tz:-4},
  {name:'London',nameHi:'लंदन',lat:51.5074,lng:-0.1278,tz:1},
];

let isHindi = false;
const fmtMins = formatMinutes12h;

const sel=document.getElementById('ab-city') as HTMLSelectElement;
function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(isHindi?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();
const dateInput=document.getElementById('ab-date') as HTMLInputElement;
dateInput.value=new Date().toISOString().split('T')[0];

// Pre-fill from the header's location picker (same "today, my location" scope as the homepage)
function applyHeaderLoc(loc:any){
  if(!loc||!loc.name)return;
  const norm=(s:string)=>s.trim().toLowerCase();
  let match=LOCS.find(l=>norm(l.name)===norm(loc.name));
  if(!match){
    match={name:loc.name,nameHi:loc.nameHi,lat:loc.lat,lng:loc.lng,tz:loc.tzOffset};
    LOCS.unshift(match);
    renderCityOptions();
  }
  sel.value=match.name;
}
if((window as any).__initLoc) applyHeaderLoc((window as any).__initLoc);
window.addEventListener('locationchange',(e:Event)=>{
  applyHeaderLoc((e as CustomEvent).detail);
  calculate();
});

function calculate(){
  const dateStr=(document.getElementById('ab-date') as HTMLInputElement).value;
  const cityName=(document.getElementById('ab-city') as HTMLSelectElement).value;
  const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
  const [y,m,d]=dateStr.split('-').map(Number);
  const result=computeAbhijitWindows(y,m,d,loc.lat,loc.lng,loc.tz);

  const noteEl=document.getElementById('ab-default-note');
  if(noteEl) (noteEl as HTMLElement).style.display = loc.name==='New Delhi' ? '' : 'none';

  // "Today" and "now" must be evaluated in the SELECTED location's local time, not the
  // visitor's own device timezone (this page is location-selectable) and not UTC
  // (toISOString() always returns UTC). Shift the real instant by the same loc.tz already
  // used for srMins/ssMins above, then read it back with UTC getters -- host-timezone-
  // independent by construction, same pattern as the daily Rashifal IST fix, but
  // parameterized on the selected location instead of a hardcoded +5:30.
  const now=new Date();
  const locNow=new Date(now.getTime()+loc.tz*3600000);
  const isToday=dateStr===`${locNow.getUTCFullYear()}-${String(locNow.getUTCMonth()+1).padStart(2,'0')}-${String(locNow.getUTCDate()).padStart(2,'0')}`;
  const nowMins=isToday?locNow.getUTCHours()*60+locNow.getUTCMinutes():-1;

  const isWednesday=result.isWednesday;

  const cards=document.getElementById('ab-cards');
  if(cards){
    const items=[
      {
        name:'Abhijit Muhurat',nameHi:'अभिजित मुहूर्त',
        start:result.abhijit.start,end:result.abhijit.end,
        icon:'☀️',color:'#b45309',bg:'#fef3c7',
        note:isWednesday?'⚠️ Wednesday — Abhijit is weaker today':'Universally auspicious — overrides most doshas',
        noteHi:isWednesday?'⚠️ बुधवार — आज अभिजित कमजोर है':'सार्वभौमिक रूप से शुभ — अधिकांश दोषों को निष्प्रभावी करता है',
        disabled:isWednesday,
      },
      {
        name:'Do Ghati Muhurat',nameHi:'दो घटी मुहूर्त',
        start:result.doGhati.start,end:result.doGhati.end,
        icon:'⏱️',color:'#b45309',bg:'#fef9eb',
        note:'48-minute window centered on solar noon (1 Ghati each side)',
        noteHi:'सौर मध्याह्न के चारों ओर 48 मिनट की अवधि (प्रत्येक ओर 1 घटी)',
        disabled:false,
      },
      {
        name:'Brahma Muhurta',nameHi:'ब्रह्म मुहूर्त',
        start:result.brahma.start,end:result.brahma.end,
        icon:'🌅',color:'#16803D',bg:'#DCF3E3',
        note:'Best for meditation, spiritual practice & study',
        noteHi:'ध्यान, आध्यात्मिक साधना और अध्ययन के लिए सर्वोत्तम',
        disabled:false,
      },
    ];
    cards.innerHTML=items.map(item=>{
      const active=nowMins>=item.start&&nowMins<item.end;
      const border=active?`border:2px solid ${item.color};`:'';
      return `<div class="card" style="padding:22px;${border}">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
          <div style="display:flex;align-items:center;gap:10px;">
            <span style="font-size:28px;">${item.icon}</span>
            <div>
              <p style="font-size:15px;font-weight:700;color:var(--color-ink);margin:0 0 2px;">${item.name}</p>
              <p style="font-size:11px;color:var(--color-mute);margin:0;font-family:var(--font-mono);">${item.nameHi}</p>
            </div>
          </div>
          ${active?`<span style="background:${item.color};color:#fff;font-size:10px;font-weight:700;padding:3px 10px;border-radius:100px;">${isHindi?'सक्रिय':'ACTIVE'}</span>`:''}
        </div>
        <div style="background:${item.bg};border-radius:10px;padding:14px 16px;margin-bottom:12px;">
          <p style="font-size:22px;font-weight:700;color:${item.color};margin:0;font-family:var(--font-mono);">${fmtMins(item.start)} – ${fmtMins(item.end)}</p>
          <p style="font-size:11px;color:var(--color-mute);margin:4px 0 0;">${isHindi?'अवधि':'Duration'}: ${item.end-item.start} ${isHindi?'मिनट':'minutes'}</p>
        </div>
        <p style="font-size:12px;color:${item.disabled?'#dc2626':'var(--color-body-text)'};margin:0;line-height:1.5;">${isHindi?item.noteHi:item.note}</p>
      </div>`;
    }).join('');
  }
}

document.getElementById('ab-calc')?.addEventListener('click',calculate);
calculate();

function applyPageLang(hindi: boolean) {
  isHindi = hindi;
  renderCityOptions();
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
  });
  calculate();
}
document.addEventListener('langchange', (e: Event) => {
  applyPageLang((e as CustomEvent).detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
