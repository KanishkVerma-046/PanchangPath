---
import Layout from '../../layouts/Layout.astro';
import { computeChoghadiyaSlots, CHOGHADIYA_INFO } from '../../lib/muhurta';
import { formatMinutes12h } from '../../lib/time-format';

// Build-time default: today (IST, matching the daily-rebuild cron's clock) at New Delhi, the
// site's default location. Uses the exact same computeChoghadiyaSlots() the client <script>
// below calls for date/location changes, so server and client can never disagree — see
// CLAUDE.md's 2026-08-18 SEO-prerender rollout note.
const NEW_DELHI = { name: 'New Delhi', lat: 28.6139, lng: 77.209, tz: 5.5 };
const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
const istNow = new Date(Date.now() + IST_OFFSET_MS);
const defY = istNow.getUTCFullYear();
const defM = istNow.getUTCMonth() + 1;
const defD = istNow.getUTCDate();

const defaultChog = computeChoghadiyaSlots(defY, defM, defD, NEW_DELHI.lat, NEW_DELHI.lng, NEW_DELHI.tz);
const fmt = formatMinutes12h;
---

<Layout title="Choghadiya Today — Auspicious Time Slots — PanchangPath" description="Today's Choghadiya for your city — all 16 day & night slots (Amrit, Shubh, Labh, Char, Udveg, Kaal, Rog) with the current slot highlighted live.">

  <!-- Hero -->
  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/muhurta" data-hi="← मुहूर्त उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Muhurta Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">चौघड़िया · Choghadiya</p>
      <h1 data-hi="चौघड़िया" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Choghadiya</h1>
      <p data-hi="दिन और रात के लिए 8-8 बराबर समय अवधि। अमृत, शुभ या लाभ चौघड़िया में कार्य करें; रोग, काल और उद्वेग से बचें।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:480px;">8 equal time slots each for day and night. Plan activities in Amrit, Shubh or Labh choghadiya; avoid Rog, Kaal and Udveg.</p>
    </div>
  </section>

  <!-- Controls -->
  <section style="padding:28px 0 0;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div>
          <label for="chog-date" data-hi="दिनांक" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Date</label>
          <input type="date" id="chog-date" class="input" style="height:38px;" />
        </div>
        <div>
          <label for="chog-city" data-hi="स्थान" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Location</label>
          <select id="chog-city" class="input" style="height:38px;min-width:160px;"></select>
        </div>
        <button id="chog-calc" data-hi="गणना करें" class="btn-primary" style="height:38px;padding:0 20px;">Calculate</button>
      </div>

      <!-- Default-location note: prerendered alongside the New Delhi defaults below; client JS
           hides it once a non-default city is selected. -->
      <p id="chog-default-note" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;">Showing Choghadiya for New Delhi — select your city above for your location.</p>

      <!-- Day choghadiya -->
      <div style="margin-bottom:36px;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <h2 data-hi="दिन चौघड़िया" style="font-size:16px;font-weight:600;color:var(--color-ink);margin:0;">Day Choghadiya</h2>
          <span style="font-size:11px;color:var(--color-mute);font-family:var(--font-mono);" id="sr-label">Sunrise {fmt(defaultChog.srMins)} → Sunset {fmt(defaultChog.ssMins)}</span>
        </div>
        <div id="day-chog-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;">
          {defaultChog.day.map(slot => {
            const info = CHOGHADIYA_INFO[slot.name];
            const qLabel = info.quality === 'best' ? 'Best' : info.quality === 'good' ? 'Good' : info.quality === 'neutral' ? 'Neutral' : 'Avoid';
            const qColor = info.quality === 'best' ? '#16803D' : info.quality === 'good' ? '#97690F' : info.quality === 'neutral' ? '#8C7660' : '#C81E1E';
            return (
              <div style={`background:${info.bgColor};border-radius:10px;padding:14px 16px;border:1px solid var(--color-hairline);`}>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
                  <span style={`font-size:15px;font-weight:700;color:${info.color};`}>{slot.name}</span>
                  <span style={`font-size:10px;font-weight:600;color:${qColor};background:${info.bgColor};padding:1px 6px;border-radius:100px;border:1px solid ${info.color}33;`}>{qLabel}</span>
                </div>
                <p style={`font-size:11px;color:${info.color};margin:0 0 2px;font-family:var(--font-mono);`}>{fmt(slot.start)} – {fmt(slot.end)}</p>
                <p style="font-size:10px;color:var(--color-mute);margin:2px 0 0;">{info.nameHi} · {info.planet}</p>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Night choghadiya -->
      <div style="margin-bottom:48px;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <h2 data-hi="रात्रि चौघड़िया" style="font-size:16px;font-weight:600;color:var(--color-ink);margin:0;">Night Choghadiya</h2>
          <span style="font-size:11px;color:var(--color-mute);font-family:var(--font-mono);" id="ss-label">Sunset {fmt(defaultChog.ssMins)} → Next Sunrise</span>
        </div>
        <div id="night-chog-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;">
          {defaultChog.night.map(slot => {
            const info = CHOGHADIYA_INFO[slot.name];
            const qLabel = info.quality === 'best' ? 'Best' : info.quality === 'good' ? 'Good' : info.quality === 'neutral' ? 'Neutral' : 'Avoid';
            const qColor = info.quality === 'best' ? '#16803D' : info.quality === 'good' ? '#97690F' : info.quality === 'neutral' ? '#8C7660' : '#C81E1E';
            return (
              <div style={`background:${info.bgColor};border-radius:10px;padding:14px 16px;border:1px solid var(--color-hairline);`}>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
                  <span style={`font-size:15px;font-weight:700;color:${info.color};`}>{slot.name}</span>
                  <span style={`font-size:10px;font-weight:600;color:${qColor};background:${info.bgColor};padding:1px 6px;border-radius:100px;border:1px solid ${info.color}33;`}>{qLabel}</span>
                </div>
                <p style={`font-size:11px;color:${info.color};margin:0 0 2px;font-family:var(--font-mono);`}>{fmt(slot.start)} – {fmt(slot.end)}</p>
                <p style="font-size:10px;color:var(--color-mute);margin:2px 0 0;">{info.nameHi} · {info.planet}</p>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Legend + info -->
      <div style="margin-bottom:48px;">
        <h3 data-hi="चौघड़िया गाइड" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Choghadiya Guide</h3>
        <div id="chog-legend" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:10px;"></div>
      </div>

      <!-- How it's calculated -->
      <div class="card" style="padding:24px;max-width:760px;">
        <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 10px;">How Choghadiya Is Calculated</h3>
        <p style="font-size:14px;color:var(--color-body-text);margin:0 0 10px;line-height:1.7;">Choghadiya splits daylight and night into eight equal parts each, timed from that day's real sunrise and sunset rather than the clock. Because day length shifts with the seasons and with latitude, each slot's duration changes through the year too — it isn't a fixed span. Which of the seven types falls in each slot follows a fixed weekly rotation keyed to the ruling planet of that weekday: the first daytime slot of Sunday is Udveg (Sun's own influence, considered mixed), while Thursday's day opens with Shubh (Jupiter). Night follows its own related rotation.</p>
        <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.7;">The three "best" types — Amrit, Shubh and Labh — are traditionally ruled by benefic planets (Moon, Jupiter, Mercury); the three to avoid — Udveg, Kaal and Rog — by malefic ones (Sun, Saturn, Mars); Char (Venus) is treated as neutral, fine for travel and movement but not for starting major undertakings. <a href="https://en.wikipedia.org/wiki/Choghadiya" style="color:var(--color-saffron-deep);">Wikipedia: Choghadiya</a></p>
      </div>
    </div>
  </section>
</Layout>

<script>
import { computeChoghadiyaSlots } from '../../lib/muhurta';
import { formatMinutes12h } from '../../lib/time-format';

const LOCS = [
  {name:'New Delhi',nameHi:'नई दिल्ली',lat:28.6139,lng:77.209,tz:5.5},
  {name:'Mumbai',nameHi:'मुंबई',lat:19.076,lng:72.8777,tz:5.5},
  {name:'Bengaluru',nameHi:'बेंगलुरू',lat:12.9716,lng:77.5946,tz:5.5},
  {name:'Chennai',nameHi:'चेन्नई',lat:13.0827,lng:80.2707,tz:5.5},
  {name:'Kolkata',nameHi:'कोलकाता',lat:22.5726,lng:88.3639,tz:5.5},
  {name:'Hyderabad',nameHi:'हैदराबाद',lat:17.385,lng:78.4867,tz:5.5},
  {name:'Jaipur',nameHi:'जयपुर',lat:26.9124,lng:75.7873,tz:5.5},
  {name:'Varanasi',nameHi:'वाराणसी',lat:25.3176,lng:82.9739,tz:5.5},
  {name:'Haridwar',nameHi:'हरिद्वार',lat:29.9457,lng:78.1642,tz:5.5},
  {name:'Ahmedabad',nameHi:'अहमदाबाद',lat:23.0225,lng:72.5714,tz:5.5},
  {name:'Pune',nameHi:'पुणे',lat:18.5204,lng:73.8567,tz:5.5},
  {name:'Dubai',nameHi:'दुबई',lat:25.2048,lng:55.2708,tz:4},
  {name:'New York',nameHi:'न्यूयॉर्क',lat:40.7128,lng:-74.006,tz:-4},
  {name:'London',nameHi:'लंदन',lat:51.5074,lng:-0.1278,tz:1},
  {name:'Singapore',nameHi:'सिंगापुर',lat:1.3521,lng:103.8198,tz:8},
];

let isHindi = false;
const QUALITY_HI: Record<string,string> = { Best:'सर्वोत्तम', Good:'शुभ', Neutral:'सामान्य', Avoid:'अशुभ' };
const trQ = (q:string) => isHindi ? QUALITY_HI[q] : q;
const CHOG_DATA: Record<string,{hi:string;q:string;planet:string;bg:string;fg:string;suitable:string;suitableHi:string}> = {
  Amrit: {hi:'अमृत',q:'Best',planet:'Moon',bg:'#DCF3E3',fg:'#16803D',suitable:'All activities · Travel · Business · Marriage · Medicine',suitableHi:'सभी कार्य · यात्रा · व्यापार · विवाह · चिकित्सा'},
  Shubh: {hi:'शुभ',q:'Good',planet:'Jupiter',bg:'#FBF0D9',fg:'#97690F',suitable:'Marriage · Religious ceremonies · Education · Ventures',suitableHi:'विवाह · धार्मिक अनुष्ठान · शिक्षा · नए उद्यम'},
  Labh:  {hi:'लाभ',q:'Good',planet:'Mercury',bg:'#FBE4D2',fg:'#B5390A',suitable:'Business · Trade · Financial dealings · Accounts',suitableHi:'व्यापार · वाणिज्य · वित्तीय लेन-देन · लेखा-जोखा'},
  Char:  {hi:'चर',q:'Neutral',planet:'Venus',bg:'#F5E7C8',fg:'#8C7660',suitable:'Travel · Movement · Shopping',suitableHi:'यात्रा · आवागमन · खरीदारी'},
  Udveg: {hi:'उद्वेग',q:'Avoid',planet:'Sun',bg:'#FBE0DE',fg:'#C81E1E',suitable:'Avoid — Government work only',suitableHi:'बचें — केवल सरकारी कार्य'},
  Kaal:  {hi:'काल',q:'Avoid',planet:'Saturn',bg:'#E8D9BE',fg:'#3A2712',suitable:'Avoid all auspicious activities',suitableHi:'सभी शुभ कार्यों से बचें'},
  Rog:   {hi:'रोग',q:'Avoid',planet:'Mars',bg:'#FBE4D2',fg:'#7F2700',suitable:'Avoid — especially surgery & medicine',suitableHi:'बचें — विशेष रूप से शल्य चिकित्सा व औषधि'},
};

const fmtMins = formatMinutes12h;

const sel=document.getElementById('chog-city') as HTMLSelectElement;
function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(isHindi?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();

// Pre-fill from the header's location picker (same "today, my location" scope as the homepage)
function applyHeaderLoc(loc:any){
  if(!loc||!loc.name)return;
  const norm=(s:string)=>s.trim().toLowerCase();
  let match=LOCS.find(l=>norm(l.name)===norm(loc.name));
  if(!match){
    match={name:loc.name,nameHi:loc.nameHi,lat:loc.lat,lng:loc.lng,tz:loc.tzOffset};
    LOCS.unshift(match);
    renderCityOptions();
  }
  sel.value=match.name;
}
if((window as any).__initLoc) applyHeaderLoc((window as any).__initLoc);
window.addEventListener('locationchange',(e:Event)=>{
  applyHeaderLoc((e as CustomEvent).detail);
  calculate();
});

const dateInput=document.getElementById('chog-date') as HTMLInputElement;
// Default to the resolved location's own local calendar date, not the visitor's raw UTC
// date (toISOString() always returns UTC) -- wrong specifically during 00:00-05:30 IST
// each day (UTC hasn't rolled to the new date yet), defaulting the picker to yesterday.
// Same locNow pattern calculate() below already uses for its "is this today" check.
{
  const initLoc=LOCS.find(l=>l.name===sel.value)||LOCS[0];
  const locNow=new Date(Date.now()+initLoc.tz*3600000);
  dateInput.value=`${locNow.getUTCFullYear()}-${String(locNow.getUTCMonth()+1).padStart(2,'0')}-${String(locNow.getUTCDate()).padStart(2,'0')}`;
}

function makeSlot(name:string,startMins:number,endMins:number,isCurrent:boolean){
  const d=CHOG_DATA[name];
  const bg=isCurrent?'var(--color-ink)':d.bg;
  const fg=isCurrent?'var(--color-on-primary)':d.fg;
  const muted=isCurrent?'color-mix(in srgb, var(--color-on-primary), transparent 40%)':'var(--color-mute)';
  const qColor=isCurrent?'color-mix(in srgb, var(--color-on-primary), transparent 50%)':(d.q==='Best'?'#16803D':d.q==='Good'?'#97690F':d.q==='Neutral'?'#8C7660':'#C81E1E');
  return `<div style="background:${bg};border-radius:10px;padding:14px 16px;border:1px solid ${isCurrent?'transparent':'var(--color-hairline)'};">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
      <span style="font-size:15px;font-weight:700;color:${fg};">${name}</span>
      <span style="font-size:10px;font-weight:600;color:${qColor};${isCurrent?'':'background:'+d.bg+';padding:1px 6px;border-radius:100px;border:1px solid '+d.fg+'33;'}">${trQ(d.q)}${isCurrent?(isHindi?' · अभी':' · NOW'):''}</span>
    </div>
    <p style="font-size:11px;color:${fg};margin:0 0 2px;font-family:var(--font-mono);">${fmtMins(startMins)} – ${fmtMins(endMins)}</p>
    <p style="font-size:10px;color:${muted};margin:2px 0 0;">${d.hi} · ${d.planet}</p>
  </div>`;
}

function calculate(){
  const dateStr=(document.getElementById('chog-date') as HTMLInputElement).value;
  const cityName=(document.getElementById('chog-city') as HTMLSelectElement).value;
  const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
  const [y,m,d]=dateStr.split('-').map(Number);
  const result=computeChoghadiyaSlots(y,m,d,loc.lat,loc.lng,loc.tz);
  const srMins=result.srMins, ssMins=result.ssMins;

  const noteEl=document.getElementById('chog-default-note');
  if(noteEl) (noteEl as HTMLElement).style.display = loc.name==='New Delhi' ? '' : 'none';

  // "Today" and "now" must be evaluated in the SELECTED location's local time, not the
  // visitor's own device timezone (this page is location-selectable, so those are often
  // different) and not UTC (toISOString() always returns UTC). Shift the real instant by
  // the same loc.tz already used for srMins/ssMins above, then read it back with UTC
  // getters -- host-timezone-independent by construction, same pattern as the daily
  // Rashifal IST fix, but parameterized on the selected location instead of a hardcoded
  // +5:30.
  const now=new Date();
  const locNow=new Date(now.getTime()+loc.tz*3600000);
  const isToday=dateStr===`${locNow.getUTCFullYear()}-${String(locNow.getUTCMonth()+1).padStart(2,'0')}-${String(locNow.getUTCDate()).padStart(2,'0')}`;
  const nowMins=isToday?locNow.getUTCHours()*60+locNow.getUTCMinutes():-1;

  const srEl=document.getElementById('sr-label');
  const ssEl=document.getElementById('ss-label');
  if(srEl) srEl.textContent=isHindi?`सूर्योदय ${fmtMins(srMins)} → सूर्यास्त ${fmtMins(ssMins)}`:`Sunrise ${fmtMins(srMins)} → Sunset ${fmtMins(ssMins)}`;
  if(ssEl) ssEl.textContent=isHindi?`सूर्यास्त ${fmtMins(ssMins)} → अगला सूर्योदय`:`Sunset ${fmtMins(ssMins)} → Next Sunrise`;

  const dayGrid=document.getElementById('day-chog-grid');
  if(dayGrid){
    dayGrid.innerHTML=result.day.map(slot=>makeSlot(slot.name,slot.start,slot.end,isToday&&nowMins>=slot.start&&nowMins<slot.end)).join('');
  }

  const nightGrid=document.getElementById('night-chog-grid');
  if(nightGrid){
    nightGrid.innerHTML=result.night.map(slot=>makeSlot(slot.name,slot.start,slot.end,isToday&&nowMins>=slot.start&&nowMins<slot.end)).join('');
  }
}

function renderLegend(){
  const legend=document.getElementById('chog-legend');
  if(!legend) return;
  legend.innerHTML=Object.entries(CHOG_DATA).map(([name,d])=>`
    <div class="card" style="padding:14px;">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
        <span style="width:10px;height:10px;border-radius:50%;background:${d.fg};flex-shrink:0;"></span>
        <span style="font-size:13px;font-weight:600;color:var(--color-ink);">${name}</span>
        <span style="font-size:10px;color:var(--color-mute);font-family:var(--font-mono);">${d.hi}</span>
        <span style="margin-left:auto;font-size:10px;font-weight:600;color:${d.q==='Best'?'#15803d':d.q==='Good'?'#b45309':d.q==='Neutral'?'#6d28d9':'#dc2626'};">${trQ(d.q)}</span>
      </div>
      <p style="font-size:11px;color:var(--color-mute);margin:0 0 4px;font-family:var(--font-mono);">${isHindi?'ग्रह':'Planet'}: ${d.planet}</p>
      <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.5;">${isHindi?d.suitableHi:d.suitable}</p>
    </div>
  `).join('');
}
renderLegend();

document.getElementById('chog-calc')?.addEventListener('click',calculate);
calculate();

function applyPageLang(hindi: boolean) {
  isHindi = hindi;
  renderCityOptions();
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
  });
  calculate();
  renderLegend();
}
document.addEventListener('langchange', (e: Event) => {
  applyPageLang((e as CustomEvent).detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
