---
import Layout from '../../layouts/Layout.astro';
import { computePanchakaGowri, GOWRI_INFO } from '../../lib/muhurta';
import { formatMinutes12h } from '../../lib/time-format';
import { istDateParts } from '../../lib/ist-date';

// Build-time default: today (IST, matching the daily-rebuild cron's clock) at New Delhi, the
// site's default location. Uses the exact same computePanchakaGowri() the client <script>
// below calls for date/location changes, so server and client can never disagree — see
// CLAUDE.md's 2026-08-18 SEO-prerender rollout note.
const NEW_DELHI = { name: 'New Delhi', lat: 28.6139, lng: 77.209, tz: 5.5 };
const { year: defY, month: defM, day: defD } = istDateParts();

const defaultPk = computePanchakaGowri(defY, defM, defD, NEW_DELHI.lat, NEW_DELHI.lng, NEW_DELHI.tz);
const fmt = formatMinutes12h;

const NAK_NAMES = ['Ashwini','Bharani','Krittika','Rohini','Mrigashira','Ardra','Punarvasu','Pushya','Ashlesha','Magha','Purva Phalguni','Uttara Phalguni','Hasta','Chitra','Swati','Vishakha','Anuradha','Jyeshtha','Mula','Purva Ashadha','Uttara Ashadha','Shravana','Dhanishtha','Shatabhisha','Purva Bhadrapada','Uttara Bhadrapada','Revati'];

// Presentation-only styling (bg/fg per Gowri type) — matches the client <script>'s GOWRI_DATA
// below. Not calculation logic (that lives solely in computePanchakaGowri/GOWRI_DAY/GOWRI_NIGHT
// in muhurta.ts), so kept local to each render path like the rest of this page's card styling.
const GOWRI_STYLE: Record<string,{bg:string;fg:string}> = {
  Amrutham: {bg:'#DCF3E3',fg:'#16803D'},
  Sudham:   {bg:'#FBF0D9',fg:'#97690F'},
  Uthamam:  {bg:'#FBE4D2',fg:'#B5390A'},
  Labham:   {bg:'#FBE4D2',fg:'#7F2700'},
  Dhanam:   {bg:'#F5E7C8',fg:'#8C7660'},
  Charam:   {bg:'#E8D9BE',fg:'#5A4636'},
  Rogam:    {bg:'#FBE0DE',fg:'#C81E1E'},
  Visha:    {bg:'#E8D9BE',fg:'#3A2712'},
};
const gowriQLabel = (q: string) => q==='best'?'Best':q==='good'?'Good':q==='neutral'?'Neutral':'Avoid';

// Static reference content (not date/location-dependent) — prerendered directly at build
// time instead of client-JS-injected, same pattern as the Abhijit "What is" panel. Also
// backs the FAQPage schema below, so the two stay in sync by construction.
const PANCHAKA_INFO = [
  { title: 'What is Panchaka?', titleHi: 'पंचक क्या है?', text: 'Panchaka means "group of five." It occurs when Moon transits the last 5 Nakshatras: Dhanishtha (2nd half), Shatabhisha, Purva Bhadrapada, Uttara Bhadrapada, and Revati — which span Aquarius and Pisces. Duration: about 5 days each month.', textHi: 'पंचक का अर्थ है "पांच का समूह।" यह तब होता है जब चंद्रमा अंतिम 5 नक्षत्रों से गुजरता है: धनिष्ठा (उत्तरार्ध), शतभिषा, पूर्वाभाद्रपद, उत्तराभाद्रपद और रेवती — जो कुंभ और मीन राशियों में फैले हैं। अवधि: प्रत्येक माह लगभग 5 दिन।' },
  { title: 'What to avoid in Panchaka?', titleHi: 'पंचक में क्या टालें?', text: "Five activities are traditionally avoided through any Panchaka: cremation/last rites, roofing or roof construction, buying/storing firewood, travel toward the south, and buying a cot or bed. Which of the five named sub-types is active — Mrityu, Agni, Raja, Chora, or Roga Panchak — depends on the weekday the current Panchaka span began on (Saturday, Tuesday, Monday, Friday, and Sunday respectively; a Wednesday/Thursday start is milder Samanya Panchak). Routine daily activities are generally unaffected.", textHi: 'किसी भी पंचक के दौरान पारंपरिक रूप से पांच कार्यों से बचा जाता है: अंतिम संस्कार, छत निर्माण, लकड़ी खरीदना/संग्रहण, दक्षिण दिशा की यात्रा, और पलंग/खाट खरीदना। पांच नामित उप-प्रकारों में से कौन सक्रिय है — मृत्यु, अग्नि, राज, चोर, या रोग पंचक — यह इस बात पर निर्भर करता है कि वर्तमान पंचक अवधि किस सप्ताह के दिन शुरू हुई (क्रमशः शनिवार, मंगलवार, सोमवार, शुक्रवार, और रविवार; बुधवार/गुरुवार को शुरू होने वाला पंचक हल्का सामान्य पंचक होता है)। सामान्य दैनिक कार्य प्रायः प्रभावित नहीं होते।' },
  { title: 'How is Panchak different from Rahu Kaal?', titleHi: 'पंचक, राहु काल से कैसे अलग है?', text: "They're unrelated systems on different time scales. Rahu Kaal is a short daily window (roughly 75-105 minutes) that occurs once every single day, timed off that day's sunrise-to-sunset span. Panchaka is a lunar-calendar period of about 5 consecutive days each month, set by which Nakshatra the Moon occupies. A date can fall in both, either, or neither — checking one doesn't tell you anything about the other.", textHi: 'ये अलग-अलग समयावधि की स्वतंत्र प्रणालियां हैं। राहु काल एक छोटी दैनिक अवधि (लगभग 75-105 मिनट) है जो हर दिन उस दिन के सूर्योदय-सूर्यास्त के अनुसार तय होती है। पंचक चंद्र-आधारित लगभग 5 दिनों की मासिक अवधि है, जो चंद्रमा के नक्षत्र पर निर्भर करती है। कोई तिथि दोनों में, किसी एक में, या किसी में भी नहीं पड़ सकती — एक की जांच दूसरे के बारे में कुछ नहीं बताती।' },
];

const panchakaFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PANCHAKA_INFO.map(item => ({
    '@type': 'Question',
    name: item.title,
    acceptedAnswer: { '@type': 'Answer', text: item.text },
  })),
};
---

<Layout title="Panchaka & Gowri Panchangam — PanchangPath" description="Check today's Panchaka status, Gowri Panchangam's 8 day & night slots for South India, and how Panchak differs from daily Rahu Kala.">
  <script type="application/ld+json" set:html={JSON.stringify(panchakaFaqJsonLd)} />

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/muhurta" style="display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--color-mute);text-decoration:none;">
        <span class="arrow-chip"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></span>
        <span data-hi="मुहूर्त उपकरण">Muhurta Tools</span>
      </a>
      <p class="eyebrow reveal" style="margin:12px 0 8px;">पंचक · गौरी पंचांग</p>
      <h1 class="reveal" data-hi="पंचक और गौरी पंचांगम" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;transition-delay:60ms;">Panchaka &amp; Gowri Panchangam</h1>
      <p class="reveal" data-hi="पंचक तब सक्रिय होता है जब चंद्रमा अंतिम 5 नक्षत्रों (कुंभ और मीन राशियों) से गुजरता है। गौरी पंचांगम दक्षिण भारत की 8-स्लॉट दैनिक मुहूर्त प्रणाली है।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:540px;transition-delay:120ms;">Panchaka is active when Moon transits the last 5 Nakshatras (Aquarius and Pisces signs). Gowri Panchangam is a South Indian 8-slot daily muhurta system.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div>
          <label for="pk-date" data-hi="दिनांक" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Date</label>
          <input type="date" id="pk-date" class="input" style="height:38px;" />
        </div>
        <div>
          <label for="pk-city" data-hi="स्थान" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Location</label>
          <select id="pk-city" class="input" style="height:38px;min-width:160px;"></select>
        </div>
        <button id="pk-calc" data-hi="गणना करें" class="btn-primary" style="height:38px;padding:0 20px;">Calculate</button>
      </div>

      <!-- Default-location note: prerendered alongside the New Delhi defaults below; client JS
           hides it once a non-default city is selected. -->
      <p id="pk-default-note" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;">Showing Panchaka &amp; Gowri Panchangam for New Delhi — select your city above for your location.</p>

      <!-- Panchaka status -->
      <div id="pk-status" class="bezel-outer reveal" style="margin-bottom:32px;">
        {defaultPk.isPanchaka ? (
          <div class="bezel-inner" style="background:#fee2e2;padding:16px 20px;">
            <p style="font-size:14px;font-weight:700;color:#dc2626;margin:0 0 4px;">⚠️ {defaultPk.panchakaType || 'Panchaka'} Active Today</p>
            <p style="font-size:13px;color:#991b1b;margin:0 0 6px;">Moon is in <strong>{NAK_NAMES[defaultPk.nakIdx]}</strong> nakshatra (Nakshatra {defaultPk.nakIdx+1}). Panchaka is active.</p>
            <p style="font-size:12px;color:#7f1d1d;margin:0;">Avoid: funeral rites, roof construction, travel south, buying cots/beds, and storing firewood. Panchaka Shanti puja can be performed to mitigate effects.</p>
          </div>
        ) : (
          <div class="bezel-inner" style="background:#dcfce7;padding:16px 20px;">
            <p style="font-size:14px;font-weight:700;color:#15803d;margin:0 0 4px;">✓ No Panchaka Today</p>
            <p style="font-size:13px;color:#166534;margin:0;">Moon is in <strong>{NAK_NAMES[defaultPk.nakIdx]}</strong> — outside the Panchaka zone (Nakshatras 23–27).</p>
          </div>
        )}
      </div>

      <!-- Gowri Panchangam -->
      <div style="margin-bottom:36px;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <h2 data-hi="गौरी पंचांगम" style="font-size:16px;font-weight:600;color:var(--color-ink);margin:0;">Gowri Panchangam</h2>
          <span data-hi="दिन स्लॉट (सूर्योदय से सूर्यास्त तक)" style="font-size:11px;color:var(--color-mute);font-family:var(--font-mono);">Day slots (sunrise to sunset)</span>
        </div>
        <div id="gowri-day" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-bottom:24px;">
          {defaultPk.gowriDay.map(slot => {
            const style = GOWRI_STYLE[slot.name];
            const q = GOWRI_INFO[slot.name].quality;
            return (
              <div style={`background:${style.bg};border-radius:10px;padding:12px 14px;border:1px solid var(--color-hairline);`}>
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
                  <span style={`font-size:13px;font-weight:700;color:${style.fg};`}>{slot.name}</span>
                </div>
                <p style="font-size:11px;color:var(--color-mute);margin:0;">{fmt(slot.start)} – {fmt(slot.end)}</p>
                <p style={`font-size:11px;color:${style.fg};margin:2px 0 0;`}>{gowriQLabel(q)}</p>
              </div>
            );
          })}
        </div>
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <h2 data-hi="रात्रि गौरी" style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0;">Night Gowri</h2>
          <span data-hi="सूर्यास्त से अगले सूर्योदय तक" style="font-size:11px;color:var(--color-mute);font-family:var(--font-mono);">Sunset to next sunrise</span>
        </div>
        <div id="gowri-night" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px;margin-bottom:36px;">
          {defaultPk.gowriNight.map(slot => {
            const style = GOWRI_STYLE[slot.name];
            const q = GOWRI_INFO[slot.name].quality;
            return (
              <div style={`background:${style.bg};border-radius:10px;padding:12px 14px;border:1px solid var(--color-hairline);`}>
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
                  <span style={`font-size:13px;font-weight:700;color:${style.fg};`}>{slot.name}</span>
                </div>
                <p style="font-size:11px;color:var(--color-mute);margin:0;">{fmt(slot.start)} – {fmt(slot.end)}</p>
                <p style={`font-size:11px;color:${style.fg};margin:2px 0 0;`}>{gowriQLabel(q)}</p>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Panchaka info: static reference content, prerendered at build time (not
           date/location-dependent) so it's visible to no-JS crawlers, same pattern as
           Abhijit's "What is" panel. Language toggle handled by the generic [data-hi] walker. -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:32px;" id="pk-info-grid">
        {PANCHAKA_INFO.map(item => (
          <div class="card" style="padding:16px;">
            <p data-hi={item.titleHi} style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 6px;">{item.title}</p>
            <p data-hi={item.textHi} style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.6;">{item.text}</p>
          </div>
        ))}
      </div>

      <!-- Gowri legend -->
      <h3 data-hi="गौरी पंचांगम गाइड" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Gowri Panchangam Guide</h3>
      <div id="gowri-legend" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;margin-bottom:48px;"></div>

      <!-- How it's calculated -->
      <div class="card" style="padding:24px;max-width:780px;">
        <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 10px;">How Panchaka &amp; Gowri Panchangam Are Calculated</h3>
        <p style="font-size:14px;color:var(--color-body-text);margin:0 0 10px;line-height:1.7;">Panchaka's window is set purely by the Moon's nakshatra. This calculator computes the Moon's current sidereal longitude and checks whether it falls in one of the zodiac's final five nakshatras — the second half of Dhanishtha through Revati, spanning the tail of Kumbha (Aquarius) and all of Meena (Pisces). Since the Moon takes about 27.3 days to complete one nakshatra circuit and each nakshatra spans roughly a day, five consecutive nakshatras work out to close to five days of Panchaka every lunar month. Which of the five sub-types is active — Mrityu, Agni, Raja, Chora, or Roga Panchaka — depends on exactly which of those five nakshatras the Moon occupies at the time.</p>
        <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.7;">Gowri Panchangam, the parallel South Indian system, is built the same way Choghadiya and Rahu Kala are: sunrise-to-sunset and sunset-to-next-sunrise are each split into eight equal slots, and which of the eight named Gowri types falls in each slot follows a fixed weekly rotation table rooted in the Tamil Panchangam tradition. <a href="https://www.prokerala.com/astrology/gowri-nalla-neram.php" style="color:var(--color-saffron-deep);">Prokerala: Gowri Nalla Neram</a></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (max-width: 640px) {
    #pk-info-grid { grid-template-columns: 1fr !important; }
  }
</style>

<script>
import { computePanchakaGowri } from '../../lib/muhurta';
import { formatMinutes12h } from '../../lib/time-format';

const LOCS = [
  {name:'New Delhi',nameHi:'नई दिल्ली',lat:28.6139,lng:77.209,tz:5.5},
  {name:'Mumbai',nameHi:'मुंबई',lat:19.076,lng:72.8777,tz:5.5},
  {name:'Bengaluru',nameHi:'बेंगलुरू',lat:12.9716,lng:77.5946,tz:5.5},
  {name:'Chennai',nameHi:'चेन्नई',lat:13.0827,lng:80.2707,tz:5.5},
  {name:'Kolkata',nameHi:'कोलकाता',lat:22.5726,lng:88.3639,tz:5.5},
  {name:'Hyderabad',nameHi:'हैदराबाद',lat:17.385,lng:78.4867,tz:5.5},
  {name:'Jaipur',nameHi:'जयपुर',lat:26.9124,lng:75.7873,tz:5.5},
  {name:'Varanasi',nameHi:'वाराणसी',lat:25.3176,lng:82.9739,tz:5.5},
  {name:'Dubai',nameHi:'दुबई',lat:25.2048,lng:55.2708,tz:4},
  {name:'New York',nameHi:'न्यूयॉर्क',lat:40.7128,lng:-74.006,tz:-4},
  {name:'London',nameHi:'लंदन',lat:51.5074,lng:-0.1278,tz:1},
];

const NAK_NAMES=['Ashwini','Bharani','Krittika','Rohini','Mrigashira','Ardra','Punarvasu','Pushya','Ashlesha','Magha','Purva Phalguni','Uttara Phalguni','Hasta','Chitra','Swati','Vishakha','Anuradha','Jyeshtha','Mula','Purva Ashadha','Uttara Ashadha','Shravana','Dhanishtha','Shatabhisha','Purva Bhadrapada','Uttara Bhadrapada','Revati'];
let isHindi = false;
const QUALITY_HI: Record<string,string> = { Best:'सर्वोत्तम', Good:'शुभ', Neutral:'सामान्य', Avoid:'अशुभ' };
const trQ = (q:string) => isHindi ? (QUALITY_HI[q]||q) : q;
const GOWRI_DATA: Record<string,{q:string;bg:string;fg:string;suitable:string;suitableHi:string}> = {
  Amrutham: {q:'Best',    bg:'#DCF3E3',fg:'#16803D',suitable:'All auspicious activities', suitableHi:'सभी शुभ कार्य'},
  Sudham:   {q:'Good',    bg:'#FBF0D9',fg:'#97690F',suitable:'Religious & spiritual work', suitableHi:'धार्मिक व आध्यात्मिक कार्य'},
  Uthamam:  {q:'Good',    bg:'#FBE4D2',fg:'#B5390A',suitable:'Education, new ventures', suitableHi:'शिक्षा, नए उद्यम'},
  Labham:   {q:'Good',    bg:'#FBE4D2',fg:'#7F2700',suitable:'Business and financial work', suitableHi:'व्यापार व वित्तीय कार्य'},
  Dhanam:   {q:'Neutral', bg:'#F5E7C8',fg:'#8C7660',suitable:'Wealth activities — OK', suitableHi:'धन संबंधी कार्य — ठीक है'},
  Charam:   {q:'Neutral', bg:'#E8D9BE',fg:'#5A4636',suitable:'Travel and movement', suitableHi:'यात्रा व आवागमन'},
  Rogam:    {q:'Avoid',   bg:'#FBE0DE',fg:'#C81E1E',suitable:'Avoid all auspicious activities', suitableHi:'सभी शुभ कार्यों से बचें'},
  Visha:    {q:'Avoid',   bg:'#E8D9BE',fg:'#3A2712',suitable:'Avoid — inauspicious', suitableHi:'बचें — अशुभ'},
};

const fmtMins = formatMinutes12h;

const sel=document.getElementById('pk-city') as HTMLSelectElement;
function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(isHindi?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();
const dateInput=document.getElementById('pk-date') as HTMLInputElement;
// Default to the resolved location's own local calendar date, not the visitor's raw UTC
// date (toISOString() always returns UTC) -- wrong specifically during 00:00-05:30 IST
// each day (UTC hasn't rolled to the new date yet), defaulting the picker to yesterday.
// Same locNow pattern calculate() below already uses for its "is this today" check.
{
  const initLoc=LOCS.find(l=>l.name===sel.value)||LOCS[0];
  const locNow=new Date(Date.now()+initLoc.tz*3600000);
  dateInput.value=`${locNow.getUTCFullYear()}-${String(locNow.getUTCMonth()+1).padStart(2,'0')}-${String(locNow.getUTCDate()).padStart(2,'0')}`;
}

// Pre-fill from the header's location picker (same "today, my location" scope as the homepage)
function applyHeaderLoc(loc:any){
  if(!loc||!loc.name)return;
  const norm=(s:string)=>s.trim().toLowerCase();
  let match=LOCS.find(l=>norm(l.name)===norm(loc.name));
  if(!match){
    match={name:loc.name,nameHi:loc.nameHi,lat:loc.lat,lng:loc.lng,tz:loc.tzOffset};
    LOCS.unshift(match);
    renderCityOptions();
  }
  sel.value=match.name;
}
if((window as any).__initLoc) applyHeaderLoc((window as any).__initLoc);
window.addEventListener('locationchange',(e:Event)=>{
  applyHeaderLoc((e as CustomEvent).detail);
  calculate();
});

function makeGowriSlot(name:string,s:number,e:number,isCurrent:boolean){
  const d=GOWRI_DATA[name]||{q:'—',bg:'#f3f4f6',fg:'#374151',suitable:'',suitableHi:''};
  const bg=isCurrent?'var(--color-ink)':d.bg;
  const fg=isCurrent?'var(--color-on-primary)':d.fg;
  return `<div style="background:${bg};border-radius:10px;padding:12px 14px;border:1px solid ${isCurrent?'transparent':'var(--color-hairline)'};">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
      <span style="font-size:13px;font-weight:700;color:${fg};">${name}</span>
      ${isCurrent?`<span style="font-size:9px;font-weight:700;background:color-mix(in srgb, var(--color-on-primary), transparent 80%);color:var(--color-on-primary);padding:1px 6px;border-radius:100px;">${isHindi?'अभी':'NOW'}</span>`:''}
    </div>
    <p style="font-size:11px;color:${isCurrent?'color-mix(in srgb, var(--color-on-primary), transparent 40%)':'var(--color-mute)'};margin:0;">${fmtMins(s)} – ${fmtMins(e)}</p>
    <p style="font-size:11px;color:${isCurrent?'color-mix(in srgb, var(--color-on-primary), transparent 50%)':d.fg};margin:2px 0 0;">${trQ(d.q)}</p>
  </div>`;
}

function calculate(){
  const dateStr=(document.getElementById('pk-date') as HTMLInputElement).value;
  const cityName=(document.getElementById('pk-city') as HTMLSelectElement).value;
  const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
  const [y,m,d]=dateStr.split('-').map(Number);
  const result=computePanchakaGowri(y,m,d,loc.lat,loc.lng,loc.tz);
  const nakIdx=result.nakIdx;
  const isPanchaka=result.isPanchaka;

  const noteEl=document.getElementById('pk-default-note');
  if(noteEl) (noteEl as HTMLElement).style.display = loc.name==='New Delhi' ? '' : 'none';

  // "Today" and "now" must be evaluated in the SELECTED location's local time, not the
  // visitor's own device timezone (this page is location-selectable) and not UTC
  // (toISOString() always returns UTC). Shift the real instant by the same loc.tz already
  // used for srMins/ssMins above, then read it back with UTC getters -- host-timezone-
  // independent by construction, same pattern as the daily Rashifal IST fix, but
  // parameterized on the selected location instead of a hardcoded +5:30.
  const now=new Date();
  const locNow=new Date(now.getTime()+loc.tz*3600000);
  const isToday=dateStr===`${locNow.getUTCFullYear()}-${String(locNow.getUTCMonth()+1).padStart(2,'0')}-${String(locNow.getUTCDate()).padStart(2,'0')}`;
  const nowMins=isToday?locNow.getUTCHours()*60+locNow.getUTCMinutes():-1;

  // Panchaka status
  const pkEl=document.getElementById('pk-status');
  if(pkEl){
    if(isPanchaka){
      const pkType=result.panchakaType||'Panchaka';
      const line2=isHindi?`चंद्रमा <strong>${NAK_NAMES[nakIdx]}</strong> नक्षत्र (नक्षत्र ${nakIdx+1}) में है। पंचक सक्रिय है।`:`Moon is in <strong>${NAK_NAMES[nakIdx]}</strong> nakshatra (Nakshatra ${nakIdx+1}). Panchaka is active.`;
      const line3=isHindi?'बचें: अंतिम संस्कार, छत निर्माण, दक्षिण दिशा यात्रा, पलंग/खाट खरीदना, और लकड़ी संग्रहण। प्रभाव कम करने के लिए पंचक शांति पूजा की जा सकती है।':'Avoid: funeral rites, roof construction, travel south, buying cots/beds, and storing firewood. Panchaka Shanti puja can be performed to mitigate effects.';
      pkEl.innerHTML=`<div class="bezel-inner" style="background:#fee2e2;padding:16px 20px;">
        <p style="font-size:14px;font-weight:700;color:#dc2626;margin:0 0 4px;">⚠️ ${pkType} ${isHindi?'आज सक्रिय':'Active Today'}</p>
        <p style="font-size:13px;color:#991b1b;margin:0 0 6px;">${line2}</p>
        <p style="font-size:12px;color:#7f1d1d;margin:0;">${line3}</p>
      </div>`;
    } else {
      const line2=isHindi?`चंद्रमा <strong>${NAK_NAMES[nakIdx]}</strong> में है — पंचक क्षेत्र (नक्षत्र 23–27) से बाहर।`:`Moon is in <strong>${NAK_NAMES[nakIdx]}</strong> — outside the Panchaka zone (Nakshatras 23–27).`;
      pkEl.innerHTML=`<div class="bezel-inner" style="background:#dcfce7;padding:16px 20px;">
        <p style="font-size:14px;font-weight:700;color:#15803d;margin:0 0 4px;">✓ ${isHindi?'आज कोई पंचक नहीं':'No Panchaka Today'}</p>
        <p style="font-size:13px;color:#166534;margin:0;">${line2}</p>
      </div>`;
    }
  }

  // Gowri day
  const dayEl=document.getElementById('gowri-day');
  if(dayEl){
    dayEl.innerHTML=result.gowriDay.map(slot=>makeGowriSlot(slot.name,slot.start,slot.end,nowMins>=slot.start&&nowMins<slot.end)).join('');
  }

  // Gowri night
  const nightEl=document.getElementById('gowri-night');
  if(nightEl){
    nightEl.innerHTML=result.gowriNight.map(slot=>makeGowriSlot(slot.name,slot.start,slot.end,nowMins>=slot.start&&nowMins<slot.end)).join('');
  }
}

function renderGowriLegend(){
  const gowriLegend=document.getElementById('gowri-legend');
  if(!gowriLegend) return;
  gowriLegend.innerHTML=Object.entries(GOWRI_DATA).map(([name,d])=>`
    <div class="card" style="padding:12px 14px;">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
        <span style="width:8px;height:8px;border-radius:50%;background:${d.fg};flex-shrink:0;"></span>
        <span style="font-size:12px;font-weight:600;color:var(--color-ink);">${name}</span>
        <span style="margin-left:auto;font-size:11px;font-weight:600;color:${d.q==='Best'||d.q==='Good'?d.fg:'#dc2626'};">${trQ(d.q)}</span>
      </div>
      <p style="font-size:11px;color:var(--color-body-text);margin:0;">${isHindi?d.suitableHi:d.suitable}</p>
    </div>
  `).join('');
}
renderGowriLegend();

document.getElementById('pk-calc')?.addEventListener('click',calculate);
calculate();

function applyPageLang(hindi: boolean) {
  isHindi = hindi;
  renderCityOptions();
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
  });
  calculate();
  renderGowriLegend();
}
document.addEventListener('langchange', (e: Event) => {
  applyPageLang((e as CustomEvent).detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
