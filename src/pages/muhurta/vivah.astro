---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Vivah Muhurat 2025-2026 — Marriage Auspicious Dates — PanchangPath" description="Find the best auspicious marriage dates (Vivah Muhurat) for 2025-2026 using strict Vedic Panchang criteria.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/muhurta" data-hi="← मुहूर्त उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Muhurta Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">विवाह मुहूर्त · Vivah Muhurat</p>
      <h1 data-hi="विवाह मुहूर्त" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Vivah Muhurat</h1>
      <p data-hi="वैदिक मानदंडों का उपयोग कर शुभ विवाह तिथियां खोजें — शुभ नक्षत्र, तिथि, वार, और पंचक, राहु काल तथा अशुभ योगों से मुक्त।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:520px;">Find auspicious marriage dates using Vedic criteria — auspicious Nakshatra, Tithi, Vara, and freedom from Panchaka, Rahu Kala, and malefic yogas.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container" style="max-width:900px;margin:0 auto;">
      <!-- Search form -->
      <div class="card" style="padding:28px;margin-bottom:32px;">
        <h2 data-hi="शुभ विवाह तिथियां खोजें" style="font-size:16px;font-weight:600;color:var(--color-ink);margin:0 0 20px;">Find Auspicious Marriage Dates</h2>
        <div class="finder-form-grid" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:20px;">
          <div>
            <label for="vivah-from" data-hi="प्रारंभ तिथि" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">From Date</label>
            <input type="date" id="vivah-from" class="input" style="height:38px;" />
          </div>
          <div>
            <label for="vivah-to" data-hi="अंतिम तिथि" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">To Date</label>
            <input type="date" id="vivah-to" class="input" style="height:38px;" />
          </div>
          <div>
            <label for="vivah-city" data-hi="स्थान" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Location</label>
            <select id="vivah-city" class="input" style="height:38px;"></select>
          </div>
        </div>
        <button id="vivah-find" data-hi="विवाह मुहूर्त तिथियां खोजें →" class="btn-primary" style="width:100%;height:44px;justify-content:center;font-size:15px;">Find Vivah Muhurat Dates →</button>
      </div>

      <!-- Results -->
      <div id="vivah-results" style="display:none;">
        <h2 id="vivah-results-title" style="font-size:16px;font-weight:600;color:var(--color-ink);margin:0 0 16px;"></h2>
        <div id="vivah-list" style="display:flex;flex-direction:column;gap:10px;margin-bottom:40px;"></div>
      </div>

      <!-- Criteria -->
      <div style="margin-top:8px;">
        <h3 data-hi="विवाह मुहूर्त मानदंड" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Vivah Muhurat Criteria</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px;">
          {[
            {label:'Auspicious Nakshatras',labelHi:'शुभ नक्षत्र',desc:'Rohini, Mrigashira, Magha, Uttara Phalguni, Hasta, Swati, Anuradha, Mula, Uttara Ashadha, Uttara Bhadrapada, Revati',descHi:'रोहिणी, मृगशिरा, मघा, उत्तर फाल्गुनी, हस्त, स्वाति, अनुराधा, मूल, उत्तराषाढ़ा, उत्तर भाद्रपदा, रेवती'},
            {label:'Auspicious Tithis',labelHi:'शुभ तिथियां',desc:'Dwitiya, Tritiya, Panchami, Saptami, Dashami, Ekadashi, Dwadashi, Trayodashi in Shukla Paksha',descHi:'शुक्ल पक्ष में द्वितीया, तृतीया, पंचमी, सप्तमी, दशमी, एकादशी, द्वादशी, त्रयोदशी'},
            {label:'Auspicious Varas',labelHi:'शुभ वार',desc:'Monday, Wednesday, Thursday, Friday — these weekdays are ruled by Moon, Mercury, Jupiter, and Venus respectively.',descHi:'सोमवार, बुधवार, गुरुवार, शुक्रवार — इन वारों पर क्रमशः चंद्र, बुध, गुरु और शुक्र का आधिपत्य है।'},
            {label:'Avoided periods',labelHi:'त्याज्य अवधियां',desc:'Panchaka, Kharmas (sun in Sagittarius/Pisces), Adhika Masa, eclipse periods, Rikta tithis (Chaturthi, Navami, Chaturdashi), Purnima, Amavasya.',descHi:'पंचक, खरमास (सूर्य धनु/मीन राशि में), अधिक मास, ग्रहण काल, रिक्ता तिथियां (चतुर्थी, नवमी, चतुर्दशी), पूर्णिमा, अमावस्या।'},
          ].map(c => (
            <div class="card" style="padding:14px;">
              <p data-hi={c.labelHi} style="font-size:12px;font-weight:600;color:var(--color-ink);margin:0 0 5px;">{c.label}</p>
              <p data-hi={c.descHi} style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.5;">{c.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (max-width: 640px) {
    .finder-form-grid { grid-template-columns: 1fr !important; }
  }
</style>

<script>
import { sunTrueLongitude, moonLongitude, lahiriAyanamsha } from '../../lib/panchang';
import { planetLongitude, isCombust } from '../../lib/astro-core';
import { MUHURTA_CRITERIA, sunRashiVoidCheck, KHARMAS_RASHIS } from '../../lib/muhurta';

const LOCS = [
  {name:'New Delhi',lat:28.6139,lng:77.209,tz:5.5},
  {name:'Mumbai',lat:19.076,lng:72.8777,tz:5.5},
  {name:'Bengaluru',lat:12.9716,lng:77.5946,tz:5.5},
  {name:'Chennai',lat:13.0827,lng:80.2707,tz:5.5},
  {name:'Kolkata',lat:22.5726,lng:88.3639,tz:5.5},
  {name:'Hyderabad',lat:17.385,lng:78.4867,tz:5.5},
  {name:'Jaipur',lat:26.9124,lng:75.7873,tz:5.5},
  {name:'Varanasi',lat:25.3176,lng:82.9739,tz:5.5},
  {name:'Haridwar',lat:29.9457,lng:78.1642,tz:5.5},
  {name:'Dubai',lat:25.2048,lng:55.2708,tz:4},
  {name:'New York',lat:40.7128,lng:-74.006,tz:-4},
  {name:'London',lat:51.5074,lng:-0.1278,tz:1},
];

let isHindi = false;
// Sourced from the shared MUHURTA_CRITERIA table (Issue #15) instead of a local duplicate —
// verified against drikpanchang.com's Vivah Nakshatra list.
const VIVAH_GOOD_NAKS = MUHURTA_CRITERIA.vivah.goodNakshatras;
const VIVAH_GOOD_TITHIS = MUHURTA_CRITERIA.vivah.goodTithis; // 0-indexed
const VIVAH_GOOD_VARAS = MUHURTA_CRITERIA.vivah.goodVaras;
const VIVAH_AVOID_TITHIS = MUHURTA_CRITERIA.vivah.avoidTithis;
const PANCHAKA_NAKS = [22,23,24,25,26];
const GOOD_YOGAS = [1,2,3,4,6,7,10,11,13,15,19,20,21,22,23,24,25];
const NAK_NAMES=['Ashwini','Bharani','Krittika','Rohini','Mrigashira','Ardra','Punarvasu','Pushya','Ashlesha','Magha','Purva Phalguni','Uttara Phalguni','Hasta','Chitra','Swati','Vishakha','Anuradha','Jyeshtha','Mula','Purva Ashadha','Uttara Ashadha','Shravana','Dhanishtha','Shatabhisha','Purva Bhadrapada','Uttara Bhadrapada','Revati'];
const TITHI_NAMES=['Pratipada','Dwitiya','Tritiya','Chaturthi','Panchami','Shashthi','Saptami','Ashtami','Navami','Dashami','Ekadashi','Dwadashi','Trayodashi','Chaturdashi','Purnima','Pratipada','Dwitiya','Tritiya','Chaturthi','Panchami','Shashthi','Saptami','Ashtami','Navami','Dashami','Ekadashi','Dwadashi','Trayodashi','Chaturdashi','Amavasya'];
const VARA_NAMES=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
// Rahu slots
const RAHU_SLOTS=[7,1,6,4,5,2,3];

function toJD(y:number,m:number,d:number,h=0){
  if(m<=2){y--;m+=12;}
  const A=Math.floor(y/100),B=2-A+Math.floor(A/4);
  return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;
}
const n360=(a:number)=>((a%360)+360)%360;
const toRad=(d:number)=>d*Math.PI/180;
const toDeg=(r:number)=>r*180/Math.PI;

function calcDay(y:number,m:number,d:number,loc:{lat:number;lng:number;tz:number}){
  const jd=toJD(y,m,d,6-loc.tz);
  const T=(jd-2451545)/36525;
  const sunLon=sunTrueLongitude(jd);
  const moonLon=moonLongitude(jd);
  const ay=lahiriAyanamsha(jd);
  const sunSid=n360(sunLon-ay), moonSid=n360(moonLon-ay);
  const elong=n360(moonLon-sunLon);
  const tithiIdx=Math.floor(elong/12)%30;
  const nakIdx=Math.floor(moonSid/(360/27))%27;
  const yogaIdx=Math.floor(n360(sunSid+moonSid)/(360/27))%27;
  const date=new Date(y,m-1,d);
  const wd=date.getDay();
  // Sunrise for Rahu
  const M2=n360(357.52911+35999.05029*T);
  const L02=n360(280.46646+36000.76983*T);
  const C2=(1.914602-0.004817*T)*Math.sin(toRad(M2))+0.019993*Math.sin(2*toRad(M2));
  const sunL2=L02+C2;
  const sinDec=Math.sin(toRad(23.4393))*Math.sin(toRad(sunL2));
  const dec=Math.asin(sinDec);
  const cosHA=(Math.sin(toRad(-0.8333))-Math.sin(toRad(loc.lat))*Math.sin(dec))/(Math.cos(toRad(loc.lat))*Math.cos(dec));
  const ha=toDeg(Math.acos(Math.max(-1,Math.min(1,cosHA))));
  const noon=12-loc.lng/15;
  const srMins=(noon-ha/15)*60+loc.tz*60;
  const ssMins=(noon+ha/15)*60+loc.tz*60;
  const rahuSlot=RAHU_SLOTS[wd];
  const dur=(ssMins-srMins)/8;
  const rahuStart=srMins+rahuSlot*dur, rahuEnd=rahuStart+dur;
  // Venus (Shukra) combustion — traditionally voids all Vivah Muhurats (Issue #12).
  const venusLon=planetLongitude('venus',jd);
  const venusCombust=isCombust(sunLon,venusLon,10);
  return {tithiIdx,nakIdx,yogaIdx,wd,rahuStart,rahuEnd,paksha:tithiIdx<15?'S':'K',venusCombust};
}

function scoreVivah(res:{tithiIdx:number;nakIdx:number;yogaIdx:number;wd:number;rahuStart:number;rahuEnd:number;paksha:string;venusCombust:boolean},y:number,m:number,d:number,loc:{lat:number;lng:number;tz:number}){
  let score=0;
  const notes:string[]=[];
  const bad:string[]=[];
  // Vara
  if(VIVAH_GOOD_VARAS.includes(res.wd)){score+=3;notes.push(VARA_NAMES[res.wd]+' (good weekday)');}
  else bad.push(VARA_NAMES[res.wd]+' (unfavourable day)');
  // Nakshatra
  if(VIVAH_GOOD_NAKS.includes(res.nakIdx)){score+=4;notes.push(NAK_NAMES[res.nakIdx]+' (vivah nakshatra)');}
  else if(PANCHAKA_NAKS.includes(res.nakIdx)){score-=3;bad.push('Panchaka ('+NAK_NAMES[res.nakIdx]+')');}
  else bad.push(NAK_NAMES[res.nakIdx]+' (not ideal)');
  // Tithi
  if(VIVAH_AVOID_TITHIS.includes(res.tithiIdx)){score-=4;bad.push(TITHI_NAMES[res.tithiIdx]+' (avoid)');}
  else if(VIVAH_GOOD_TITHIS.includes(res.tithiIdx)&&res.paksha==='S'){score+=3;notes.push('Shukla '+TITHI_NAMES[res.tithiIdx]);}
  else if(VIVAH_GOOD_TITHIS.includes(res.tithiIdx)){score+=1;notes.push(TITHI_NAMES[res.tithiIdx]);}
  // Yoga
  if(GOOD_YOGAS.includes(res.yogaIdx)){score+=2;notes.push('Good yoga');}
  // Kharmas: Sun in Sagittarius (8) or Pisces (11) — dual-endpoint (start-of-day + end-of-day)
  // Sun-rashi check (Issue #35/#13) so a same-day Sankranti crossing can't slip past a fixed
  // 6 AM snapshot.
  const kharmas=sunRashiVoidCheck(y,m,d,loc.tz,KHARMAS_RASHIS);
  if(kharmas.isVoid){score-=5;bad.push('Kharmas (Sun in '+(kharmas.rashiIdx===8?'Dhanu':'Meena')+')');}
  // Venus combust (Shukra Ast) — hard gate: no Vivah Muhurat exists on a combust-Venus date,
  // regardless of how favourable everything else scores (Issue #12).
  if(res.venusCombust){bad.push('Venus combust (Shukra Ast) — voids Vivah Muhurat');score=-99;}
  // Rahu Kala note (informational)
  return {score,notes,bad};
}

function fmtMins(m:number){
  const h=Math.floor(((m/60)%24+24)%24),mn=Math.round(((m%60)+60)%60);
  return `${h%12||12}:${String(mn).padStart(2,'0')} ${h<12?'AM':'PM'}`;
}

// Init
const sel=document.getElementById('vivah-city') as HTMLSelectElement;
sel.innerHTML=LOCS.map(l=>`<option value="${l.name}">${l.name}</option>`).join('');

// Pre-fill from the header's location picker (same "today, my location" scope as the homepage)
function applyHeaderLoc(loc:any){
  if(!loc||!loc.name)return;
  const norm=(s:string)=>s.trim().toLowerCase();
  let match=LOCS.find(l=>norm(l.name)===norm(loc.name));
  if(!match){
    match={name:loc.name,lat:loc.lat,lng:loc.lng,tz:loc.tzOffset};
    LOCS.unshift(match);
    sel.innerHTML=LOCS.map(l=>`<option value="${l.name}">${l.name}</option>`).join('');
  }
  sel.value=match.name;
}
if((window as any).__initLoc) applyHeaderLoc((window as any).__initLoc);
window.addEventListener('locationchange',(e:Event)=>applyHeaderLoc((e as CustomEvent).detail));

const now=new Date();
const fromInput=document.getElementById('vivah-from') as HTMLInputElement;
const toInput=document.getElementById('vivah-to') as HTMLInputElement;
fromInput.value=now.toISOString().split('T')[0];
const sixMonths=new Date(now); sixMonths.setMonth(sixMonths.getMonth()+6);
toInput.value=sixMonths.toISOString().split('T')[0];

document.getElementById('vivah-find')?.addEventListener('click',()=>{
  const fromStr=fromInput.value, toStr=toInput.value;
  const cityName=sel.value;
  const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
  const [fy,fm,fd]=fromStr.split('-').map(Number);
  const [ty,tm,td]=toStr.split('-').map(Number);
  const fromD=new Date(fy,fm-1,fd), toD=new Date(ty,tm-1,td);
  if(toD<=fromD||((toD.getTime()-fromD.getTime())>365*24*3600*1000)){
    alert(isHindi?'कृपया 1 वर्ष तक की तिथि सीमा चुनें।':'Please select a date range up to 1 year.');return;
  }

  const results:any[]=[];
  const cur=new Date(fromD);
  while(cur<=toD){
    const y=cur.getFullYear(),m=cur.getMonth()+1,d=cur.getDate();
    const res=calcDay(y,m,d,loc);
    const {score,notes,bad}=scoreVivah(res,y,m,d,loc);
    if(score>=4) results.push({date:new Date(cur),score,notes,bad,res});
    cur.setDate(cur.getDate()+1);
  }
  results.sort((a,b)=>b.score-a.score);
  const top=results.slice(0,20);

  const listEl=document.getElementById('vivah-list');
  const titleEl=document.getElementById('vivah-results-title');
  const secEl=document.getElementById('vivah-results');
  if(!listEl||!titleEl||!secEl)return;

  titleEl.textContent=isHindi?`${top.length} शुभ तिथियां मिलीं`:`${top.length} auspicious dates found`;
  if(!top.length){
    listEl.innerHTML=`<div class="card" style="padding:20px;text-align:center;"><p style="color:var(--color-mute);">${isHindi?'इस सीमा में कोई मजबूत विवाह मुहूर्त तिथि नहीं मिली। तिथि सीमा बढ़ाकर देखें।':'No strong Vivah Muhurat dates found in this range. Try extending the date range.'}</p></div>`;
  } else {
    listEl.innerHTML=top.map((r,i)=>{
      const label=isHindi?(r.score>=9?'उत्कृष्ट':r.score>=7?'बहुत अच्छा':'अच्छा'):(r.score>=9?'Excellent':r.score>=7?'Very Good':'Good');
      const labelColor=r.score>=9?'#16803D':r.score>=7?'#97690F':'#B5390A';
      const isTop=i===0;
      const bg=isTop?'var(--color-ink)':'';
      const tc=isTop?'#fff':'var(--color-ink)';
      const mut=isTop?'rgba(255,255,255,0.6)':'var(--color-mute)';
      return `<div class="card" style="padding:18px;${bg?'background:'+bg+';':''}">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
          <div>
            <p style="font-size:16px;font-weight:700;color:${tc};margin:0;">${r.date.toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</p>
            <p style="font-size:11px;color:${mut};margin:3px 0 0;font-family:var(--font-mono);">${NAK_NAMES[r.res.nakIdx]} · ${TITHI_NAMES[r.res.tithiIdx]} · Score: ${r.score}/12</p>
          </div>
          <span style="font-size:11px;font-weight:700;padding:4px 12px;border-radius:100px;background:${isTop?'rgba(255,255,255,0.15)':labelColor+'18'};color:${isTop?'#fff':labelColor};border:1px solid ${isTop?'rgba(255,255,255,0.2)':labelColor+'44'};">${label}</span>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:${r.bad.length?'8px':'0'};">
          ${r.notes.map((n:string)=>`<span style="font-size:10px;padding:2px 8px;border-radius:100px;background:${isTop?'rgba(255,255,255,0.15)':'var(--color-canvas-soft-2)'};color:${isTop?'rgba(255,255,255,0.85)':'var(--color-body-text)'};border:1px solid ${isTop?'rgba(255,255,255,0.2)':'var(--color-hairline)'};">✓ ${n}</span>`).join('')}
        </div>
        ${r.bad.length?`<div style="display:flex;flex-wrap:wrap;gap:6px;">
          ${r.bad.map((n:string)=>`<span style="font-size:10px;padding:2px 8px;border-radius:100px;background:#fee2e2;color:#dc2626;border:1px solid #fecaca;">✗ ${n}</span>`).join('')}
        </div>`:''}
        ${isTop?`<div style="margin-top:12px;padding-top:12px;border-top:1px solid rgba(255,255,255,0.15);">
          <p style="font-size:10px;color:rgba(255,255,255,0.5);margin:0 0 2px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.05em;">${isHindi?'राहु काल से बचें':'Avoid Rahu Kala'}</p>
          <p style="font-size:12px;color:rgba(255,255,255,0.85);margin:0;">${fmtMins(r.res.rahuStart)} – ${fmtMins(r.res.rahuEnd)}</p>
        </div>`:''}
      </div>`;
    }).join('');
  }
  secEl.style.display='block';
  secEl.scrollIntoView({behavior:'smooth',block:'start'});
});

function applyPageLang(hindi: boolean) {
  isHindi = hindi;
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
  });
}
document.addEventListener('langchange', (e: Event) => {
  applyPageLang((e as CustomEvent).detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
