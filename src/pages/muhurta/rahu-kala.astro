---
import Layout from '../../layouts/Layout.astro';
import { computeRahuKalaSlots } from '../../lib/muhurta';
import { formatMinutes12h } from '../../lib/time-format';

// Build-time default: today (IST, matching the daily-rebuild cron's clock — see CLAUDE.md
// "Orbital mechanics"/daily-rebuild notes) at New Delhi, the site's default location. Uses the
// exact same computeRahuKalaSlots() the client <script> below calls for date/location changes,
// so server and client can never disagree — see CLAUDE.md's 2026-08-18 SEO-prerender pilot note.
const NEW_DELHI = { name: 'New Delhi', lat: 28.6139, lng: 77.209, tz: 5.5 };
const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
const istNow = new Date(Date.now() + IST_OFFSET_MS);
const defY = istNow.getUTCFullYear();
const defM = istNow.getUTCMonth() + 1;
const defD = istNow.getUTCDate();

const defaultSlots = computeRahuKalaSlots(defY, defM, defD, NEW_DELHI.lat, NEW_DELHI.lng, NEW_DELHI.tz);

const VARA_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

const KALAM_META = [
  { key: 'rahu', slot: defaultSlots.rahu, name: 'Rahu Kala', lord: 'Rahu', color: '#dc2626', bg: '#fee2e2', desc: 'Most inauspicious — ruled by Rahu (shadow planet). Never start new work.' },
  { key: 'gulika', slot: defaultSlots.gulika, name: 'Gulika Kala', lord: "Saturn's son", color: '#b45309', bg: '#fef3c7', desc: "Inauspicious — ruled by Mandi (Saturn's son). Avoid auspicious activities." },
  { key: 'yamaganda', slot: defaultSlots.yamaganda, name: 'Yamaganda', lord: 'Yama', color: '#374151', bg: '#f3f4f6', desc: 'Inauspicious — ruled by Yama. Avoid new ventures and travel.' },
];

// Static reference content (not date/location-dependent) — prerendered directly at build
// time instead of client-JS-injected, same pattern as the Abhijit "What is" panel. Also
// backs the FAQPage schema below, so the two stay in sync by construction.
const KALAM_INFO = [
  { title: 'What is Rahu Kala?', titleHi: 'राहु काल क्या है?', text: 'Rahu is the north lunar node — a shadow planet in Jyotish. During Rahu Kala (roughly one-eighth of daylight hours, typically 75-105 minutes depending on season and location), Rahu\'s malefic influence is strongest. Auspicious activities started during this time are believed to be obstructed.', textHi: 'राहु उत्तरी चंद्र नोड है — ज्योतिष में एक छाया ग्रह। राहु काल (दिन की लंबाई का लगभग आठवां हिस्सा, आमतौर पर मौसम और स्थान के अनुसार 75-105 मिनट) के दौरान राहु का अशुभ प्रभाव सबसे प्रबल होता है। इस दौरान शुरू किए गए शुभ कार्यों में बाधा आने की मान्यता है।' },
  { title: 'What to avoid during Rahu Kala?', titleHi: 'राहु काल में क्या टालें?', text: 'Do not start new work, travel, sign contracts, or conduct ceremonies during Rahu Kala, Gulika Kala, or Yamaganda. Routine activities already in progress are unaffected.', textHi: 'राहु काल, गुलिक काल, या यमगण्ड के दौरान नया कार्य आरंभ न करें, यात्रा न करें, अनुबंध पर हस्ताक्षर न करें, या समारोह आयोजित न करें। पहले से चल रहे नियमित कार्य प्रभावित नहीं होते।' },
  { title: 'What are the remedies for Rahu Kala?', titleHi: 'राहु काल के उपाय क्या हैं?', text: 'If you must work during Rahu Kala, pray to Lord Ganesha or chant "Om Rahave Namah" 108 times before starting. Alternatively, begin the work a minute before Rahu Kala starts.', textHi: 'यदि राहु काल के दौरान कार्य करना आवश्यक हो, तो आरंभ करने से पहले भगवान गणेश की प्रार्थना करें या "ॐ राहवे नमः" का 108 बार जप करें। वैकल्पिक रूप से, राहु काल शुरू होने से एक मिनट पहले कार्य आरंभ करें।' },
];

const rahuKalaFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: KALAM_INFO.map(item => ({
    '@type': 'Question',
    name: item.title,
    acceptedAnswer: { '@type': 'Answer', text: item.text },
  })),
};
---

<Layout title="Rahu Kala Today — Inauspicious Period — PanchangPath" description="Today's Rahu Kala, Gulika Kala and Yamaganda for your city — live status, this week's timings, and what to avoid during each inauspicious period.">
  <script type="application/ld+json" set:html={JSON.stringify(rahuKalaFaqJsonLd)} />

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/muhurta" style="display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--color-mute);text-decoration:none;">
        <span class="arrow-chip"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></span>
        <span data-hi="मुहूर्त उपकरण">Muhurta Tools</span>
      </a>
      <p class="eyebrow reveal" style="margin:12px 0 8px;">राहु काल · Rahu Kala</p>
      <h1 class="reveal" data-hi="राहु काल" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;transition-delay:60ms;">Rahu Kala</h1>
      <p class="reveal" data-hi="हर दिन की एक अशुभ अवधि, जो दिन की लंबाई के लगभग आठवें हिस्से जितनी होती है (आमतौर पर 75-105 मिनट)। साथ ही गुलिक काल और यमगण्ड भी दिखाए गए हैं — तीन अशुभ ग्रहों द्वारा शासित अवधियां।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:500px;transition-delay:120ms;">An inauspicious period each day, roughly one-eighth of daylight hours long (typically 75-105 minutes). Also shows Gulika Kala and Yamaganda — three periods ruled by malefic influences.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div>
          <label for="rk-date" data-hi="दिनांक" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Date</label>
          <input type="date" id="rk-date" class="input" style="height:38px;" />
        </div>
        <div>
          <label for="rk-city" data-hi="स्थान" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Location</label>
          <select id="rk-city" class="input" style="height:38px;min-width:160px;"></select>
        </div>
        <button id="rk-calc" data-hi="गणना करें" class="btn-primary" style="height:38px;padding:0 20px;">Calculate</button>
      </div>

      <!-- Today's status banner: live-clock-dependent ("active now" / "starts in N min"), so it
           is intentionally left for client JS to fill in — a build-time snapshot of "now" would
           be stale by the time anyone sees it. -->
      <div id="rk-status" style="margin-bottom:28px;"></div>

      <!-- Default-location note: prerendered alongside the New Delhi defaults below; client JS
           hides it once a non-default city is selected (see calculate() in the script below). -->
      <p id="rk-default-note" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;">Showing Rahu Kala for New Delhi — select your city above for your location.</p>

      <!-- Three kalam cards: prerendered at build time for New Delhi/today so the page has real
           content before client JS runs (SEO/no-JS crawlers); client JS overwrites this on load
           with the live version (adds the "active now" badge, honors the visitor's date/location). -->
      <div id="kalam-cards" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px;margin-bottom:40px;">
        {KALAM_META.map(k => (
          <div class="card" style={`padding:20px;border:2px solid var(--color-hairline);`}>
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
              <div>
                <p style={`font-size:15px;font-weight:700;color:${k.color};margin:0 0 2px;`}>{k.name}</p>
                <p style="font-size:11px;color:var(--color-mute);margin:0;font-family:var(--font-mono);">Lord: {k.lord}</p>
              </div>
            </div>
            <div style={`background:${k.bg};border-radius:8px;padding:12px;margin-bottom:10px;`}>
              <p style={`font-size:20px;font-weight:700;color:${k.color};margin:0;font-family:var(--font-mono);`}>{formatMinutes12h(k.slot.start)} – {formatMinutes12h(k.slot.end)}</p>
            </div>
            <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.5;">{k.desc}</p>
          </div>
        ))}
      </div>

      <!-- Week view -->
      <h2 data-hi="राहु काल — इस सप्ताह" style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Rahu Kala — This Week</h2>
      <div id="rk-week" style="display:flex;flex-direction:column;gap:6px;max-width:600px;margin-bottom:48px;">
        {defaultSlots.week.map((w, i) => (
          <div style={`display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:8px;background:${i === defaultSlots.weekday ? 'var(--color-canvas-soft-2)' : 'transparent'};border:1px solid ${i === defaultSlots.weekday ? 'var(--color-hairline)' : 'transparent'};`}>
            <span style="font-size:12px;font-weight:600;color:var(--color-ink);width:90px;">{VARA_NAMES[i]}</span>
            <span style="flex:1;font-size:13px;font-weight:600;color:#dc2626;font-family:var(--font-mono);">{formatMinutes12h(w.rahu.start)} – {formatMinutes12h(w.rahu.end)}</span>
            {i === defaultSlots.weekday && <span style="font-size:10px;font-weight:700;color:var(--color-mute);font-family:var(--font-mono);">TODAY</span>}
          </div>
        ))}
      </div>

      <!-- Info: static reference content, prerendered at build time (not date/location-
           dependent) so it's visible to no-JS crawlers, same pattern as Abhijit's "What is"
           panel. Language toggle is handled by the generic [data-hi] walker in the script below. -->
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:24px;" id="kalam-info">
        {KALAM_INFO.map(item => (
          <div class="card" style="padding:16px;">
            <p data-hi={item.titleHi} style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 6px;">{item.title}</p>
            <p data-hi={item.textHi} style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.6;">{item.text}</p>
          </div>
        ))}
      </div>

      <!-- How it's calculated -->
      <div class="card" style="padding:24px;max-width:780px;">
        <h2 style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 10px;">How the Weekly Rotation Works</h2>
        <p style="font-size:14px;color:var(--color-body-text);margin:0 0 10px;line-height:1.7;">All three periods are computed the same way: sunrise-to-sunset is split into eight equal segments, and each weekday is permanently assigned one of those eight segments by a fixed table — which is why the clock time shifts daily with sunrise, but the segment number for a given weekday never does. For Rahu Kala specifically, counting segments 1 through 8 from sunrise, the assignment is Sunday the 8th segment, Monday the 2nd, Tuesday the 7th, Wednesday the 5th, Thursday the 6th, Friday the 4th, and Saturday the 3rd — verified against Wikipedia's Rahukaala article and cross-checked against DrikPanchang.</p>
        <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.7;">Gulika Kala and Yamaganda follow their own separate weekly tables (also sunrise-to-sunset ÷ 8), which is why all three inauspicious periods land at different times even on the same day — they're never the same segment. <a href="https://en.wikipedia.org/wiki/R%C4%81huk%C4%81la" style="color:var(--color-saffron-deep);">Wikipedia: Rahukaala</a></p>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (max-width: 640px) {
    #kalam-info { grid-template-columns: 1fr !important; }
  }
</style>

<script>
import { computeRahuKalaSlots } from '../../lib/muhurta';
import { formatMinutes12h } from '../../lib/time-format';

const LOCS = [
  {name:'New Delhi',nameHi:'नई दिल्ली',lat:28.6139,lng:77.209,tz:5.5},
  {name:'Mumbai',nameHi:'मुंबई',lat:19.076,lng:72.8777,tz:5.5},
  {name:'Bengaluru',nameHi:'बेंगलुरू',lat:12.9716,lng:77.5946,tz:5.5},
  {name:'Chennai',nameHi:'चेन्नई',lat:13.0827,lng:80.2707,tz:5.5},
  {name:'Kolkata',nameHi:'कोलकाता',lat:22.5726,lng:88.3639,tz:5.5},
  {name:'Hyderabad',nameHi:'हैदराबाद',lat:17.385,lng:78.4867,tz:5.5},
  {name:'Jaipur',nameHi:'जयपुर',lat:26.9124,lng:75.7873,tz:5.5},
  {name:'Varanasi',nameHi:'वाराणसी',lat:25.3176,lng:82.9739,tz:5.5},
  {name:'Dubai',nameHi:'दुबई',lat:25.2048,lng:55.2708,tz:4},
  {name:'New York',nameHi:'न्यूयॉर्क',lat:40.7128,lng:-74.006,tz:-4},
  {name:'London',nameHi:'लंदन',lat:51.5074,lng:-0.1278,tz:1},
];

const VARA_NAMES = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const VARA_HI = ['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
let isHindi = false;
const fmtMins = formatMinutes12h;

const sel=document.getElementById('rk-city') as HTMLSelectElement;
function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(isHindi?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();
const dateInput=document.getElementById('rk-date') as HTMLInputElement;
// Default to the resolved location's own local calendar date, not the visitor's raw UTC
// date (toISOString() always returns UTC) -- wrong specifically during 00:00-05:30 IST
// each day (UTC hasn't rolled to the new date yet), defaulting the picker to yesterday.
// Same locNow pattern calculate() below already uses for its "is this today" check.
{
  const initLoc=LOCS.find(l=>l.name===sel.value)||LOCS[0];
  const locNow=new Date(Date.now()+initLoc.tz*3600000);
  dateInput.value=`${locNow.getUTCFullYear()}-${String(locNow.getUTCMonth()+1).padStart(2,'0')}-${String(locNow.getUTCDate()).padStart(2,'0')}`;
}

// Pre-fill from the header's location picker (same "today, my location" scope as the homepage)
function applyHeaderLoc(loc:any){
  if(!loc||!loc.name)return;
  const norm=(s:string)=>s.trim().toLowerCase();
  let match=LOCS.find(l=>norm(l.name)===norm(loc.name));
  if(!match){
    match={name:loc.name,nameHi:loc.nameHi,lat:loc.lat,lng:loc.lng,tz:loc.tzOffset};
    LOCS.unshift(match);
    renderCityOptions();
  }
  sel.value=match.name;
}
if((window as any).__initLoc) applyHeaderLoc((window as any).__initLoc);
window.addEventListener('locationchange',(e:Event)=>{
  applyHeaderLoc((e as CustomEvent).detail);
  calculate();
});

function calculate(){
  const dateStr=(document.getElementById('rk-date') as HTMLInputElement).value;
  const cityName=(document.getElementById('rk-city') as HTMLSelectElement).value;
  const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
  const [y,m,d]=dateStr.split('-').map(Number);
  const result=computeRahuKalaSlots(y,m,d,loc.lat,loc.lng,loc.tz);
  const wd=result.weekday;
  const rahu=result.rahu, gulika=result.gulika, yamag=result.yamaganda;

  const noteEl=document.getElementById('rk-default-note');
  if(noteEl) (noteEl as HTMLElement).style.display = loc.name==='New Delhi' ? '' : 'none';

  // "Today" and "now" must be evaluated in the SELECTED location's local time, not the
  // visitor's own device timezone (this page is location-selectable) and not UTC
  // (toISOString() always returns UTC). Shift the real instant by the same loc.tz already
  // used for srMins/ssMins above, then read it back with UTC getters -- host-timezone-
  // independent by construction, same pattern as the daily Rashifal IST fix, but
  // parameterized on the selected location instead of a hardcoded +5:30.
  const now=new Date();
  const locNow=new Date(now.getTime()+loc.tz*3600000);
  const isToday=dateStr===`${locNow.getUTCFullYear()}-${String(locNow.getUTCMonth()+1).padStart(2,'0')}-${String(locNow.getUTCDate()).padStart(2,'0')}`;
  const nowMins=isToday?locNow.getUTCHours()*60+locNow.getUTCMinutes():-1;

  const inRahu=nowMins>=rahu.start&&nowMins<rahu.end;
  const inGulika=nowMins>=gulika.start&&nowMins<gulika.end;
  const inYamag=nowMins>=yamag.start&&nowMins<yamag.end;

  // Status banner
  const statusEl=document.getElementById('rk-status');
  if(statusEl&&isToday){
    if(inRahu){
      const title=isHindi?'राहु काल अभी सक्रिय है':'Rahu Kala is active now';
      const body=isHindi?`अभी कोई नया या शुभ कार्य शुरू करने से बचें। समाप्ति ${fmtMins(rahu.end)} पर।`:`Avoid starting any new or auspicious work. Ends at ${fmtMins(rahu.end)}.`;
      statusEl.innerHTML=`<div style="background:#fee2e2;border:1px solid #fecaca;border-radius:10px;padding:14px 18px;display:flex;align-items:center;gap:12px;"><span style="font-size:20px;">⚠️</span><div><p style="font-size:14px;font-weight:600;color:#dc2626;margin:0 0 2px;">${title}</p><p style="font-size:12px;color:#991b1b;margin:0;">${body}</p></div></div>`;
    } else if(inGulika){
      const title=isHindi?'गुलिक काल अभी सक्रिय है':'Gulika Kala is active now';
      const body=isHindi?`अशुभ अवधि। समाप्ति ${fmtMins(gulika.end)} पर।`:`Inauspicious period. Ends at ${fmtMins(gulika.end)}.`;
      statusEl.innerHTML=`<div style="background:#fef3c7;border:1px solid #fde68a;border-radius:10px;padding:14px 18px;display:flex;align-items:center;gap:12px;"><span style="font-size:20px;">⚠️</span><div><p style="font-size:14px;font-weight:600;color:#b45309;margin:0 0 2px;">${title}</p><p style="font-size:12px;color:#92400e;margin:0;">${body}</p></div></div>`;
    } else {
      // Find next Rahu
      const minutesUntilRahu = rahu.start > nowMins ? rahu.start-nowMins : null;
      const msg = isHindi
        ? (minutesUntilRahu ? `राहु काल ${Math.round(minutesUntilRahu)} मिनट में शुरू होगा (${fmtMins(rahu.start)})।` : `आज के लिए राहु काल समाप्त हो चुका है (${fmtMins(rahu.start)}–${fmtMins(rahu.end)})।`)
        : (minutesUntilRahu ? `Rahu Kala starts in ${Math.round(minutesUntilRahu)} min (${fmtMins(rahu.start)}).` : `Rahu Kala has passed for today (${fmtMins(rahu.start)}–${fmtMins(rahu.end)}).`);
      const title=isHindi?'अभी कोई अशुभ काल सक्रिय नहीं है':'No inauspicious Kala active now';
      statusEl.innerHTML=`<div style="background:#dcfce7;border:1px solid #bbf7d0;border-radius:10px;padding:14px 18px;display:flex;align-items:center;gap:12px;"><span style="font-size:20px;">✓</span><div><p style="font-size:14px;font-weight:600;color:#15803d;margin:0 0 2px;">${title}</p><p style="font-size:12px;color:#166534;margin:0;">${msg}</p></div></div>`;
    }
  } else if(statusEl) { statusEl.innerHTML=''; }

  // Kalam cards
  const cards=document.getElementById('kalam-cards');
  if(cards){
    const kalamList=[
      {name:'Rahu Kala',nameHi:'राहु काल',lord:'Rahu',lordHi:'राहु',color:'#dc2626',bg:'#fee2e2',slot:rahu,active:inRahu,desc:'Most inauspicious — ruled by Rahu (shadow planet). Never start new work.',descHi:'सबसे अशुभ — राहु (छाया ग्रह) द्वारा शासित। कभी भी नया कार्य आरंभ न करें।'},
      {name:'Gulika Kala',nameHi:'गुलिक काल',lord:'Saturn\'s son',lordHi:'शनि पुत्र (मांदी)',color:'#b45309',bg:'#fef3c7',slot:gulika,active:inGulika,desc:'Inauspicious — ruled by Mandi (Saturn\'s son). Avoid auspicious activities.',descHi:'अशुभ — मांदी (शनि पुत्र) द्वारा शासित। शुभ कार्यों से बचें।'},
      {name:'Yamaganda',nameHi:'यमगण्ड',lord:'Yama',lordHi:'यम',color:'#374151',bg:'#f3f4f6',slot:yamag,active:inYamag,desc:'Inauspicious — ruled by Yama. Avoid new ventures and travel.',descHi:'अशुभ — यम द्वारा शासित। नए उद्यम और यात्रा से बचें।'},
    ];
    cards.innerHTML=kalamList.map(k=>`
      <div class="card" style="padding:20px;border:2px solid ${k.active?k.color:'var(--color-hairline)'};">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
          <div>
            <p style="font-size:15px;font-weight:700;color:${k.color};margin:0 0 2px;">${k.name}</p>
            <p style="font-size:11px;color:var(--color-mute);margin:0;font-family:var(--font-mono);">${k.nameHi} · ${isHindi?'स्वामी':'Lord'}: ${isHindi?k.lordHi:k.lord}</p>
          </div>
          ${k.active?`<span style="background:${k.color};color:#fff;font-size:10px;font-weight:700;padding:3px 10px;border-radius:100px;">${isHindi?'सक्रिय':'ACTIVE'}</span>`:''}
        </div>
        <div style="background:${k.bg};border-radius:8px;padding:12px;margin-bottom:10px;">
          <p style="font-size:20px;font-weight:700;color:${k.color};margin:0;font-family:var(--font-mono);">${fmtMins(k.slot.start)} – ${fmtMins(k.slot.end)}</p>
        </div>
        <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.5;">${isHindi?k.descHi:k.desc}</p>
      </div>
    `).join('');
  }

  // Week view
  const weekEl=document.getElementById('rk-week');
  if(weekEl){
    weekEl.innerHTML=VARA_NAMES.map((dayName,i)=>{
      const r=result.week[i].rahu;
      const isCurrentDay=i===wd&&isToday;
      return `<div style="display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:8px;background:${isCurrentDay?'var(--color-canvas-soft-2)':'transparent'};border:1px solid ${isCurrentDay?'var(--color-hairline)':'transparent'};">
        <span style="font-size:12px;font-weight:600;color:var(--color-ink);width:90px;">${isHindi?VARA_HI[i]:dayName}</span>
        <span style="flex:1;font-size:13px;font-weight:600;color:#dc2626;font-family:var(--font-mono);">${fmtMins(r.start)} – ${fmtMins(r.end)}</span>
        ${isCurrentDay?`<span style="font-size:10px;font-weight:700;color:var(--color-mute);font-family:var(--font-mono);">${isHindi?'आज':'TODAY'}</span>`:''}
      </div>`;
    }).join('');
  }
}

document.getElementById('rk-calc')?.addEventListener('click',calculate);
calculate();

function applyPageLang(hindi: boolean) {
  isHindi = hindi;
  renderCityOptions();
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
  });
  calculate();
}
document.addEventListener('langchange', (e: Event) => {
  applyPageLang((e as CustomEvent).detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
