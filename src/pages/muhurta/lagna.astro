---
import Layout from '../../layouts/Layout.astro';
import { computeLagnaTable } from '../../lib/muhurta';
import { formatMinutes12h } from '../../lib/time-format';

// Build-time default: today (IST, matching the daily-rebuild cron's clock) at New Delhi, the
// site's default location. Uses the exact same computeLagnaTable() the client <script> below
// calls for date/location changes, so server and client can never disagree — see CLAUDE.md's
// 2026-08-18 SEO-prerender rollout note.
const NEW_DELHI = { name: 'New Delhi', lat: 28.6139, lng: 77.209, tz: 5.5 };
const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
const istNow = new Date(Date.now() + IST_OFFSET_MS);
const defY = istNow.getUTCFullYear();
const defM = istNow.getUTCMonth() + 1;
const defD = istNow.getUTCDate();

const defaultLagna = computeLagnaTable(defY, defM, defD, NEW_DELHI.lat, NEW_DELHI.lng, NEW_DELHI.tz);
const fmt = formatMinutes12h;

const RASHI_NAMES_L = ['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RASHI_HI_L = ['मेष','वृषभ','मिथुन','कर्क','सिंह','कन्या','तुला','वृश्चिक','धनु','मकर','कुम्भ','मीन'];
const SYMBOLS_L = ['♈','♉','♊','♋','♌','♍','♎','♏','♐','♑','♒','♓'];
---

<Layout title="Lagna Table Today — Rising Sign — PanchangPath" description="Today's Lagna (ascendant) table — the rising zodiac sign changes every ~2 hours. See when each Lagna begins and ends.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/muhurta" data-hi="← मुहूर्त उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Muhurta Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">लग्न तालिका · Lagna Table</p>
      <h1 data-hi="लग्न तालिका" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Lagna Table</h1>
      <p data-hi="उदय लग्न (लग्न / एसेंडेंट) पृथ्वी के घूर्णन के साथ हर ~2 घंटे में बदलता है। कुछ लग्न विशेष कार्यों के लिए शुभ माने जाते हैं।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:500px;">The rising sign (Lagna / Ascendant) changes every ~2 hours as Earth rotates. Certain Lagnas are auspicious for specific activities.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div>
          <label for="lg-date" data-hi="दिनांक" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Date</label>
          <input type="date" id="lg-date" class="input" style="height:38px;" />
        </div>
        <div>
          <label for="lg-city" data-hi="स्थान" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Location</label>
          <select id="lg-city" class="input" style="height:38px;min-width:160px;"></select>
        </div>
        <button id="lg-calc" data-hi="गणना करें" class="btn-primary" style="height:38px;padding:0 20px;">Calculate</button>
      </div>

      <!-- Default-location note: prerendered alongside the New Delhi defaults below; client JS
           hides it once a non-default city is selected. -->
      <p id="lg-default-note" style="font-size:12px;color:var(--color-mute);margin:-20px 0 20px;">Showing Lagna Table for New Delhi — select your city above for your location.</p>

      <!-- Current lagna banner: live-clock-dependent ("current" as of the visitor's moment),
           so it is intentionally left for client JS to fill in — a build-time snapshot of "now"
           would be stale by the time anyone sees it. -->
      <div id="lg-current" style="margin-bottom:24px;"></div>

      <!-- Lagna table: prerendered at build time for New Delhi/today so the page has real
           content before client JS runs; client JS overwrites this on load with the live
           version (adds the "NOW" highlight, honors the visitor's date/location). -->
      <div id="lg-table" style="display:flex;flex-direction:column;gap:6px;max-width:680px;margin-bottom:48px;">
        {defaultLagna.entries.map((e, i) => {
          const endMins = i+1 < defaultLagna.entries.length ? defaultLagna.entries[i+1].startMins : defaultLagna.entries[0].startMins + 1440;
          return (
            <div style="display:flex;align-items:center;gap:12px;padding:10px 16px;border-radius:8px;background:var(--color-canvas-soft-2);border:1px solid var(--color-hairline);">
              <span style="font-size:18px;">{SYMBOLS_L[e.rashi]}</span>
              <div style="flex:1;">
                <span style="font-size:13px;font-weight:600;color:var(--color-ink);">{RASHI_NAMES_L[e.rashi]}</span>
                <span style="font-size:11px;color:var(--color-mute);margin-left:6px;">{RASHI_HI_L[e.rashi]}</span>
              </div>
              <span style="font-size:12px;color:var(--color-body-text);font-family:var(--font-mono);">{fmt(e.startMins)} – {fmt(endMins)}</span>
            </div>
          );
        })}
      </div>

      <!-- Auspicious lagna guide -->
      <h3 data-hi="सामान्य कार्यों के लिए शुभ लग्न" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Auspicious Lagnas for Common Activities</h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px;margin-bottom:48px;" id="lg-guide"></div>

      <!-- How it's calculated -->
      <div class="card" style="padding:24px;max-width:780px;">
        <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 10px;">How Lagna Is Calculated</h3>
        <p style="font-size:14px;color:var(--color-body-text);margin:0 0 10px;line-height:1.7;">Lagna (the Ascendant) is the zodiac degree rising on the eastern horizon at a given moment, computed from the observer's exact latitude, longitude, and local sidereal time. This calculator derives it with the same sidereal-time and horizon-geometry math (<code>calcLagna</code> in astro-core.ts) used across the site's Kundali and Jyotish charts, then converts the tropical result to sidereal using the Lahiri ayanamsha so it lines up with every other chart on PanchangPath.</p>
        <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.7;">Because Earth completes one rotation roughly every 24 hours and the zodiac has 12 signs of 30° each, the Lagna cycles through all twelve rashis about once a day — averaging close to two hours per sign. The exact length of each sign's window isn't perfectly uniform, though: it depends on how steeply that stretch of the ecliptic meets the horizon at the observer's latitude, so some signs rise faster and others slower than the two-hour average, an effect that becomes more pronounced at higher latitudes. <a href="https://en.wikipedia.org/wiki/Ascendant_(astrology)" style="color:var(--color-saffron-deep);">Wikipedia: Ascendant (astrology)</a></p>
      </div>
    </div>
  </section>
</Layout>

<script>
import { computeLagnaTable } from '../../lib/muhurta';
import { formatMinutes12h } from '../../lib/time-format';

const LOCS = [
  {name:'New Delhi',nameHi:'नई दिल्ली',lat:28.6139,lng:77.209,tz:5.5},
  {name:'Mumbai',nameHi:'मुंबई',lat:19.076,lng:72.8777,tz:5.5},
  {name:'Bengaluru',nameHi:'बेंगलुरू',lat:12.9716,lng:77.5946,tz:5.5},
  {name:'Chennai',nameHi:'चेन्नई',lat:13.0827,lng:80.2707,tz:5.5},
  {name:'Kolkata',nameHi:'कोलकाता',lat:22.5726,lng:88.3639,tz:5.5},
  {name:'Hyderabad',nameHi:'हैदराबाद',lat:17.385,lng:78.4867,tz:5.5},
  {name:'Jaipur',nameHi:'जयपुर',lat:26.9124,lng:75.7873,tz:5.5},
  {name:'Varanasi',nameHi:'वाराणसी',lat:25.3176,lng:82.9739,tz:5.5},
  {name:'Dubai',nameHi:'दुबई',lat:25.2048,lng:55.2708,tz:4},
  {name:'New York',nameHi:'न्यूयॉर्क',lat:40.7128,lng:-74.006,tz:-4},
  {name:'London',nameHi:'लंदन',lat:51.5074,lng:-0.1278,tz:1},
  {name:'Singapore',nameHi:'सिंगापुर',lat:1.3521,lng:103.8198,tz:8},
];

let isHindi = false;
const RASHI_NAMES = ['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RASHI_HI = ['मेष','वृषभ','मिथुन','कर्क','सिंह','कन्या','तुला','वृश्चिक','धनु','मकर','कुम्भ','मीन'];
const RASHI_EN = ['Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius','Capricorn','Aquarius','Pisces'];
const RASHI_LORDS = ['Mars','Venus','Mercury','Moon','Sun','Mercury','Venus','Mars','Jupiter','Saturn','Saturn','Jupiter'];
const PLANET_HI = {Sun:'सूर्य',Moon:'चंद्रमा',Mars:'मंगल',Mercury:'बुध',Jupiter:'गुरु',Venus:'शुक्र',Saturn:'शनि'};
const EN_TO_RASHI_SANSKRIT = {};RASHI_EN.forEach((n,i)=>{EN_TO_RASHI_SANSKRIT[n]=RASHI_NAMES[i];});
const EN_TO_RASHI_HI = {};RASHI_EN.forEach((n,i)=>{EN_TO_RASHI_HI[n]=RASHI_HI[i];});
function trSigns(list){
  const map=isHindi?EN_TO_RASHI_HI:EN_TO_RASHI_SANSKRIT;
  return list.replace(/\b(Aries|Taurus|Gemini|Cancer|Leo|Virgo|Libra|Scorpio|Sagittarius|Capricorn|Aquarius|Pisces)\b/g,n=>map[n]||n);
}
const RASHI_QUALITY: Record<number,string> = {
  1:'Good', 2:'Best', 3:'Good', 4:'Avoid (Lagna Lord = Moon — ok for water activity)',
  5:'Good', 6:'Good', 7:'Best', 8:'Avoid', 9:'Good', 10:'Avoid', 11:'Good', 12:'Avoid',
};
const RASHI_SUITABLE: Record<number,string> = {
  0:'Courage, surgery, athletics', 1:'Marriage, luxury, finance', 2:'Communication, travel, education',
  3:'Home, family, water journeys', 4:'Leadership, authority, creative', 5:'Health, service, precision work',
  6:'Partnerships, legal, marriage', 7:'Research, occult — avoid auspicious', 8:'Long journeys, philosophy, teaching',
  9:'Career, structure, property', 10:'Community, innovation, technology', 11:'Spiritual retreat — avoid for material work',
};

const fmtMins = formatMinutes12h;

const sel=document.getElementById('lg-city') as HTMLSelectElement;
function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(isHindi?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();
const dateInput=document.getElementById('lg-date') as HTMLInputElement;
// Default to the resolved location's own local calendar date, not the visitor's raw UTC
// date (toISOString() always returns UTC) -- wrong specifically during 00:00-05:30 IST
// each day (UTC hasn't rolled to the new date yet), defaulting the picker to yesterday.
// Same locNow pattern calculate() below already uses for its "is this today" check.
{
  const initLoc=LOCS.find(l=>l.name===sel.value)||LOCS[0];
  const locNow=new Date(Date.now()+initLoc.tz*3600000);
  dateInput.value=`${locNow.getUTCFullYear()}-${String(locNow.getUTCMonth()+1).padStart(2,'0')}-${String(locNow.getUTCDate()).padStart(2,'0')}`;
}

// Pre-fill from the header's location picker (same "today, my location" scope as the homepage)
function applyHeaderLoc(loc:any){
  if(!loc||!loc.name)return;
  const norm=(s:string)=>s.trim().toLowerCase();
  let match=LOCS.find(l=>norm(l.name)===norm(loc.name));
  if(!match){
    match={name:loc.name,nameHi:loc.nameHi,lat:loc.lat,lng:loc.lng,tz:loc.tzOffset};
    LOCS.unshift(match);
    renderCityOptions();
  }
  sel.value=match.name;
}
if((window as any).__initLoc) applyHeaderLoc((window as any).__initLoc);
window.addEventListener('locationchange',(e:Event)=>{
  applyHeaderLoc((e as CustomEvent).detail);
  calculate();
});

function calculate(){
  const dateStr=(document.getElementById('lg-date') as HTMLInputElement).value;
  const cityName=(document.getElementById('lg-city') as HTMLSelectElement).value;
  const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
  const [y,m,d]=dateStr.split('-').map(Number);
  // "Today" and "now" must be evaluated in the SELECTED location's local time, not the
  // visitor's own device timezone (this page is location-selectable) and not UTC
  // (toISOString() always returns UTC). Shift the real instant by the same loc.tz used for
  // baseJD below, then read it back with UTC getters -- host-timezone-independent by
  // construction, same pattern as the daily Rashifal IST fix, but parameterized on the
  // selected location instead of a hardcoded +5:30.
  const now=new Date();
  const locNow=new Date(now.getTime()+loc.tz*3600000);
  const isToday=dateStr===`${locNow.getUTCFullYear()}-${String(locNow.getUTCMonth()+1).padStart(2,'0')}-${String(locNow.getUTCDate()).padStart(2,'0')}`;
  const nowMins=isToday?locNow.getUTCHours()*60+locNow.getUTCMinutes():-1;

  const noteEl=document.getElementById('lg-default-note');
  if(noteEl) (noteEl as HTMLElement).style.display = loc.name==='New Delhi' ? '' : 'none';

  const entries=computeLagnaTable(y,m,d,loc.lat,loc.lng,loc.tz).entries;

  // Current lagna
  let currentRashi=-1;
  for(let i=0;i<entries.length;i++){
    const e=entries[i];
    const end=i+1<entries.length?entries[i+1].startMins:1440;
    if(nowMins>=e.startMins&&nowMins<end){ currentRashi=e.rashi; break; }
  }

  const curEl=document.getElementById('lg-current');
  if(curEl&&isToday&&currentRashi>=0){
    curEl.innerHTML=`<div style="background:var(--color-canvas-soft-2);border:1px solid var(--color-hairline);border-radius:10px;box-shadow:var(--shadow-elevation);padding:16px 20px;display:flex;align-items:center;gap:16px;">
      <div style="font-size:28px;">${['♈','♉','♊','♋','♌','♍','♎','♏','♐','♑','♒','♓'][currentRashi]}</div>
      <div>
        <p style="font-size:12px;color:var(--color-mute);margin:0 0 2px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.05em;">${isHindi?'वर्तमान लग्न':'Current Lagna'}</p>
        <p style="font-size:18px;font-weight:700;color:var(--color-ink);margin:0;">${RASHI_NAMES[currentRashi]} <span style="font-weight:400;font-size:14px;color:var(--color-mute);">${RASHI_EN[currentRashi]}</span></p>
        <p style="font-size:12px;color:var(--color-mute);margin:4px 0 0;">${isHindi?'स्वामी':'Lord'}: ${isHindi?PLANET_HI[RASHI_LORDS[currentRashi]]:RASHI_LORDS[currentRashi]}</p>
      </div>
    </div>`;
  } else if(curEl){ curEl.innerHTML=''; }

  // Table
  const tableEl=document.getElementById('lg-table');
  if(tableEl){
    const SYMBOLS=['♈','♉','♊','♋','♌','♍','♎','♏','♐','♑','♒','♓'];
    tableEl.innerHTML=entries.map((e,i)=>{
      const endMins=i+1<entries.length?entries[i+1].startMins:entries[0].startMins+1440;
      const isCurrent=isToday&&nowMins>=e.startMins&&nowMins<endMins;
      return `<div style="display:flex;align-items:center;gap:12px;padding:10px 16px;border-radius:8px;background:${isCurrent?'var(--color-ink)':'var(--color-canvas-soft-2)'};border:1px solid ${isCurrent?'transparent':'var(--color-hairline)'};">
        <span style="font-size:18px;">${SYMBOLS[e.rashi]}</span>
        <div style="flex:1;">
          <span style="font-size:13px;font-weight:600;color:${isCurrent?'var(--color-on-primary)':'var(--color-ink)'};">${RASHI_NAMES[e.rashi]}</span>
          <span style="font-size:11px;color:${isCurrent?'color-mix(in srgb, var(--color-on-primary), transparent 50%)':'var(--color-mute)'};margin-left:6px;">${RASHI_HI[e.rashi]}</span>
        </div>
        <span style="font-size:12px;color:${isCurrent?'color-mix(in srgb, var(--color-on-primary), transparent 20%)':'var(--color-body-text)'};font-family:var(--font-mono);">${fmtMins(e.startMins)} – ${fmtMins(endMins)}</span>
        ${isCurrent?`<span style="font-size:9px;font-weight:700;background:color-mix(in srgb, var(--color-on-primary), transparent 80%);color:var(--color-on-primary);padding:2px 8px;border-radius:100px;">${isHindi?'अभी':'NOW'}</span>`:''}
      </div>`;
    }).join('');
  }
}

function renderGuide(){
  const guide=document.getElementById('lg-guide');
  if(!guide) return;
  guide.innerHTML=[
    {activity:'Marriage (Vivah)',activityHi:'विवाह',lagnas:'Taurus, Gemini, Cancer, Virgo, Libra, Sagittarius'},
    {activity:'Griha Pravesh',activityHi:'गृह प्रवेश',lagnas:'Taurus, Gemini, Leo, Virgo, Libra, Sagittarius'},
    {activity:'Business Start',activityHi:'व्यापार शुरुआत',lagnas:'Gemini, Virgo, Libra, Aquarius, Sagittarius'},
    {activity:'Travel / Yatra',activityHi:'यात्रा',lagnas:'Aries, Gemini, Libra, Sagittarius, Aquarius'},
    {activity:'Vehicle Purchase',activityHi:'वाहन खरीद',lagnas:'Taurus, Gemini, Libra, Sagittarius'},
    {activity:'Surgery / Medical',activityHi:'शल्य चिकित्सा',lagnas:'Aries, Scorpio — avoid Cancer, Capricorn',lagnasHi:'मेष, वृश्चिक — कर्क, मकर से बचें'},
  ].map(g=>`<div class="card" style="padding:14px;"><p style="font-size:12px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">${isHindi?g.activityHi:g.activity}</p><p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.5;">${isHindi&&g.lagnasHi?g.lagnasHi:trSigns(g.lagnas)}</p></div>`).join('');
}
renderGuide();

document.getElementById('lg-calc')?.addEventListener('click',calculate);
calculate();

function applyPageLang(hindi: boolean) {
  isHindi = hindi;
  renderCityOptions();
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
  });
  calculate();
  renderGuide();
}
document.addEventListener('langchange', (e: Event) => {
  applyPageLang((e as CustomEvent).detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
