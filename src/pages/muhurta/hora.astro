---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Shubha Hora — Planetary Hours Today — PanchangPath" description="Today's Shubha Hora — 24 planetary hours ruled by Sun, Moon, Mars, Mercury, Jupiter, Venus and Saturn.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/muhurta" data-hi="← मुहूर्त उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Muhurta Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">शुभ होरा · Shubha Hora</p>
      <h1 data-hi="शुभ होरा" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Shubha Hora</h1>
      <p data-hi="प्रत्येक दिन 24 ग्रह होराओं में विभाजित होता है। दिन का पहला होरा उस दिन के स्वामी का होता है, फिर कैल्डियन क्रम में आगे बढ़ता है।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:500px;">Each day is divided into 24 planetary hours (Horas). The first hour of the day belongs to the day's lord, then cycles through the Chaldean sequence.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container">
      <!-- Controls -->
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div>
          <label for="hora-date" data-hi="दिनांक" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Date</label>
          <input type="date" id="hora-date" class="input" style="height:38px;" />
        </div>
        <div>
          <label for="hora-city" data-hi="स्थान" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Location</label>
          <select id="hora-city" class="input" style="height:38px;min-width:160px;"></select>
        </div>
        <button id="hora-calc" data-hi="गणना करें" class="btn-primary" style="height:38px;padding:0 20px;">Calculate</button>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;margin-bottom:48px;" id="hora-cols">
        <div>
          <h2 style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 14px;" id="day-hora-title">Day Horas</h2>
          <div id="day-hora-list" style="display:flex;flex-direction:column;gap:6px;"></div>
        </div>
        <div>
          <h2 style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 14px;" id="night-hora-title">Night Horas</h2>
          <div id="night-hora-list" style="display:flex;flex-direction:column;gap:6px;"></div>
        </div>
      </div>

      <!-- Planet guide -->
      <h3 data-hi="ग्रह होरा गाइड" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Planetary Hora Guide</h3>
      <div id="hora-guide" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;"></div>
    </div>
  </section>
</Layout>

<style>
  @media (max-width: 640px) {
    #hora-cols { grid-template-columns: 1fr !important; }
  }
</style>

<script>
import { sunriseUTC } from '../../lib/panchang';
import { formatMinutes12h } from '../../lib/time-format';

const LOCS = [
  {name:'New Delhi',nameHi:'नई दिल्ली',lat:28.6139,lng:77.209,tz:5.5},
  {name:'Mumbai',nameHi:'मुंबई',lat:19.076,lng:72.8777,tz:5.5},
  {name:'Bengaluru',nameHi:'बेंगलुरू',lat:12.9716,lng:77.5946,tz:5.5},
  {name:'Chennai',nameHi:'चेन्नई',lat:13.0827,lng:80.2707,tz:5.5},
  {name:'Kolkata',nameHi:'कोलकाता',lat:22.5726,lng:88.3639,tz:5.5},
  {name:'Hyderabad',nameHi:'हैदराबाद',lat:17.385,lng:78.4867,tz:5.5},
  {name:'Jaipur',nameHi:'जयपुर',lat:26.9124,lng:75.7873,tz:5.5},
  {name:'Varanasi',nameHi:'वाराणसी',lat:25.3176,lng:82.9739,tz:5.5},
  {name:'Dubai',nameHi:'दुबई',lat:25.2048,lng:55.2708,tz:4},
  {name:'New York',nameHi:'न्यूयॉर्क',lat:40.7128,lng:-74.006,tz:-4},
  {name:'London',nameHi:'लंदन',lat:51.5074,lng:-0.1278,tz:1},
  {name:'Singapore',nameHi:'सिंगापुर',lat:1.3521,lng:103.8198,tz:8},
];

// Chaldean sequence: Sun→Venus→Mercury→Moon→Saturn→Jupiter→Mars
const HORA_SEQ = ['Sun','Venus','Mercury','Moon','Saturn','Jupiter','Mars'];
const HORA_START = [0,3,6,2,5,1,4]; // weekday → start index

let isHindi = false;
const QUALITY_HI: Record<string,string> = { Best:'सर्वोत्तम', Good:'शुभ', Neutral:'सामान्य', Avoid:'अशुभ' };
const trQ = (q:string) => isHindi ? QUALITY_HI[q] : q;
const HORA_DATA: Record<string,{hi:string;q:string;color:string;suitable:string;suitableHi:string}> = {
  Sun:     {hi:'सूर्य',  q:'Neutral', color:'#C8922A', suitable:'Govt matters · Authoritative decisions · Father-related work', suitableHi:'सरकारी कार्य · अधिकारिक निर्णय · पिता से संबंधित कार्य'},
  Venus:   {hi:'शुक्र', q:'Good',    color:'#97690F', suitable:'Romance · Arts · Luxury goods · Beauty · Partnerships', suitableHi:'प्रेम-प्रसंग · कला · विलासिता की वस्तुएं · सौंदर्य · साझेदारी'},
  Mercury: {hi:'बुध',   q:'Good',    color:'#16803D', suitable:'Writing · Education · Business · Trade · Communication', suitableHi:'लेखन · शिक्षा · व्यापार · वाणिज्य · संचार'},
  Moon:    {hi:'चंद्र', q:'Best',    color:'#B5390A', suitable:'All auspicious work · Travel · Agriculture · Emotional matters', suitableHi:'सभी शुभ कार्य · यात्रा · कृषि · भावनात्मक मामले'},
  Saturn:  {hi:'शनि',  q:'Avoid',   color:'#3A2712', suitable:'Avoid auspicious work — OK for manual labour & discipline', suitableHi:'शुभ कार्यों से बचें — शारीरिक श्रम व अनुशासन हेतु उपयुक्त'},
  Jupiter: {hi:'गुरु',  q:'Best',    color:'#7F2700', suitable:'Spiritual work · Teaching · Marriage · Investments · Prosperity', suitableHi:'आध्यात्मिक कार्य · शिक्षण · विवाह · निवेश · समृद्धि'},
  Mars:    {hi:'मंगल', q:'Neutral',  color:'#C81E1E', suitable:'Physical work · Competition · Surgery · Courage', suitableHi:'शारीरिक कार्य · प्रतिस्पर्धा · शल्य चिकित्सा · साहस'},
};

function toJD(y:number,m:number,d:number,h=0){
  if(m<=2){y--;m+=12;}
  const A=Math.floor(y/100),B=2-A+Math.floor(A/4);
  return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;
}
const n360=(a:number)=>((a%360)+360)%360;
const toRad=(d:number)=>d*Math.PI/180;
const toDeg=(r:number)=>r*180/Math.PI;
const fmtMins = formatMinutes12h;

const sel=document.getElementById('hora-city') as HTMLSelectElement;
function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(isHindi?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();
const dateInput=document.getElementById('hora-date') as HTMLInputElement;
dateInput.value=new Date().toISOString().split('T')[0];

// Pre-fill from the header's location picker (same "today, my location" scope as the homepage)
function applyHeaderLoc(loc:any){
  if(!loc||!loc.name)return;
  const norm=(s:string)=>s.trim().toLowerCase();
  let match=LOCS.find(l=>norm(l.name)===norm(loc.name));
  if(!match){
    match={name:loc.name,nameHi:loc.nameHi,lat:loc.lat,lng:loc.lng,tz:loc.tzOffset};
    LOCS.unshift(match);
    renderCityOptions();
  }
  sel.value=match.name;
}
if((window as any).__initLoc) applyHeaderLoc((window as any).__initLoc);
window.addEventListener('locationchange',(e:Event)=>{
  applyHeaderLoc((e as CustomEvent).detail);
  calculate();
});

function makeHoraRow(planet:string,startMins:number,endMins:number,isCurrent:boolean,idx:number){
  const d=HORA_DATA[planet];
  const qColor=d.q==='Best'?'#15803d':d.q==='Good'?'#1d4ed8':d.q==='Avoid'?'#dc2626':'#6b7280';
  return `<div style="display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:8px;background:${isCurrent?'var(--color-ink)':'var(--color-canvas-soft-2)'};border:1px solid ${isCurrent?'transparent':'var(--color-hairline)'};">
    <span style="font-size:11px;font-weight:700;color:${isCurrent?'color-mix(in srgb, var(--color-on-primary), transparent 50%)':'var(--color-mute)'};width:20px;text-align:center;">${idx+1}</span>
    <span style="width:8px;height:8px;border-radius:50%;background:${d.color};flex-shrink:0;"></span>
    <div style="flex:1;min-width:0;">
      <span style="font-size:13px;font-weight:600;color:${isCurrent?'var(--color-on-primary)':'var(--color-ink)'};">${planet}</span>
      <span style="font-size:10px;color:${isCurrent?'color-mix(in srgb, var(--color-on-primary), transparent 50%)':'var(--color-mute)'};margin-left:6px;font-family:var(--font-mono);">${d.hi}</span>
    </div>
    <div style="text-align:right;">
      <span style="font-size:11px;color:${isCurrent?'color-mix(in srgb, var(--color-on-primary), transparent 20%)':'var(--color-body-text)'};font-family:var(--font-mono);">${fmtMins(startMins)}</span>
      ${isCurrent?`<span style="display:block;font-size:9px;font-weight:700;color:var(--color-on-primary);">${isHindi?'अभी':'NOW'}</span>`:`<span style="display:block;font-size:9px;font-weight:600;color:${qColor};">${trQ(d.q)}</span>`}
    </div>
  </div>`;
}

function calculate(){
  const dateStr=(document.getElementById('hora-date') as HTMLInputElement).value;
  const cityName=(document.getElementById('hora-city') as HTMLSelectElement).value;
  const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
  const [y,m,d]=dateStr.split('-').map(Number);
  const date=new Date(dateStr+'T12:00:00');
  const wd=date.getDay();
  const jd=toJD(y,m,d,6-loc.tz);
  const jdNext=toJD(y,m,d+1,6-loc.tz);
  const srUTC=sunriseUTC(jd,loc.lat,loc.lng,true);
  const ssUTC=sunriseUTC(jd,loc.lat,loc.lng,false);
  const srNextUTC=sunriseUTC(jdNext,loc.lat,loc.lng,true);
  const srMins=srUTC*60+loc.tz*60;
  const ssMins=ssUTC*60+loc.tz*60;
  const srNextMins=srNextUTC*60+loc.tz*60+1440;
  const dayHoraDur=(ssMins-srMins)/12;
  const nightHoraDur=(srNextMins-ssMins)/12;
  const startIdx=HORA_START[wd];
  const isToday=dateStr===new Date().toISOString().split('T')[0];
  const now=new Date();
  const nowMins=isToday?now.getHours()*60+now.getMinutes():-1;

  document.getElementById('day-hora-title')!.textContent=isHindi?`दिन होरा (${HORA_SEQ[startIdx]} होरा पहले)`:`Day Horas (${HORA_SEQ[startIdx]} hour first)`;
  document.getElementById('night-hora-title')!.textContent=isHindi?'रात्रि होरा':'Night Horas';

  const dayList=document.getElementById('day-hora-list');
  if(dayList){
    dayList.innerHTML=Array.from({length:12},(_,i)=>{
      const planet=HORA_SEQ[(startIdx+i)%7];
      const s=srMins+i*dayHoraDur, e=s+dayHoraDur;
      return makeHoraRow(planet,s,e,nowMins>=s&&nowMins<e,i);
    }).join('');
  }

  const nightList=document.getElementById('night-hora-list');
  if(nightList){
    nightList.innerHTML=Array.from({length:12},(_,i)=>{
      const planet=HORA_SEQ[(startIdx+12+i)%7];
      const s=ssMins+i*nightHoraDur, e=s+nightHoraDur;
      return makeHoraRow(planet,s,e,nowMins>=s&&nowMins<e,i);
    }).join('');
  }
}

function renderGuide(){
  const guide=document.getElementById('hora-guide');
  if(!guide) return;
  guide.innerHTML=Object.entries(HORA_DATA).map(([planet,d])=>`
    <div class="card" style="padding:14px;">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
        <span style="width:10px;height:10px;border-radius:50%;background:${d.color};flex-shrink:0;"></span>
        <span style="font-size:13px;font-weight:600;color:var(--color-ink);">${planet}</span>
        <span style="font-size:10px;color:var(--color-mute);font-family:var(--font-mono);">${d.hi}</span>
        <span style="margin-left:auto;font-size:10px;font-weight:600;color:${d.q==='Best'?'#15803d':d.q==='Good'?'#1d4ed8':d.q==='Avoid'?'#dc2626':'#6b7280'};">${trQ(d.q)}</span>
      </div>
      <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.5;">${isHindi?d.suitableHi:d.suitable}</p>
    </div>
  `).join('');
}
renderGuide();

document.getElementById('hora-calc')?.addEventListener('click',calculate);
calculate();

function applyPageLang(hindi: boolean) {
  isHindi = hindi;
  renderCityOptions();
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
  });
  calculate();
  renderGuide();
}
document.addEventListener('langchange', (e: Event) => {
  applyPageLang((e as CustomEvent).detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>
