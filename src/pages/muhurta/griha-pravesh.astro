---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Griha Pravesh Muhurat 2026-2027 — House Entry — PanchangPath" description="Find auspicious Griha Pravesh (housewarming) dates for 2026-2027 by city — scored on Nakshatra, Tithi, Vara, Yoga, with Kharmas and Chaturmas exclusions.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/muhurta" style="display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--color-mute);text-decoration:none;">
        <span class="arrow-chip"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></span>
        <span data-hi="मुहूर्त उपकरण">Muhurta Tools</span>
      </a>
      <p class="eyebrow reveal" style="margin:12px 0 8px;">गृह प्रवेश मुहूर्त</p>
      <h1 class="reveal" data-hi="गृह प्रवेश मुहूर्त" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;transition-delay:60ms;">Griha Pravesh Muhurat</h1>
      <p class="reveal" data-hi="वैदिक पंचांग नियमों के आधार पर नए घर में प्रवेश या गृहप्रवेश समारोह के लिए सबसे शुभ तिथियां खोजें।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:520px;transition-delay:120ms;">Find the most auspicious dates to enter a new home or conduct a housewarming ceremony, based on Vedic Panchang rules.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container" style="max-width:900px;margin:0 auto;">
      <div class="card" style="padding:28px;margin-bottom:32px;">
        <h2 data-hi="गृह प्रवेश तिथियां खोजें" style="font-size:16px;font-weight:600;color:var(--color-ink);margin:0 0 20px;">Search Griha Pravesh Dates</h2>
        <div class="finder-form-grid" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:20px;">
          <div>
            <label for="gp-from" data-hi="प्रारंभ तिथि" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">From Date</label>
            <input type="date" id="gp-from" class="input" style="height:38px;" />
          </div>
          <div>
            <label for="gp-to" data-hi="अंतिम तिथि" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">To Date</label>
            <input type="date" id="gp-to" class="input" style="height:38px;" />
          </div>
          <div>
            <label for="gp-city" data-hi="स्थान" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Location</label>
            <select id="gp-city" class="input" style="height:38px;"></select>
          </div>
        </div>
        <button id="gp-find" data-hi="गृह प्रवेश तिथियां खोजें →" class="btn-primary" style="width:100%;height:44px;justify-content:center;font-size:15px;">Find Griha Pravesh Dates →</button>
      </div>

      <div id="gp-results" style="display:none;">
        <h2 id="gp-results-title" style="font-size:16px;font-weight:600;color:var(--color-ink);margin:0 0 16px;"></h2>
        <div id="gp-list" style="display:flex;flex-direction:column;gap:10px;margin-bottom:40px;"></div>
      </div>

      <!-- Muhurta timing form -->
      <div class="card" style="padding:20px;margin-bottom:24px;border-left:3px solid var(--color-saffron);">
        <p data-hi="💡 सुझाव: मुहूर्त समय" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 6px;">💡 Tip: Muhurta Timing</p>
        <p data-hi="शुभ तिथि तय करने के बाद, अमृत या शुभ चौघड़िया में, गुरु या चंद्र होरा में, और जब कोई शुभ लग्न उदय हो रहा हो तब घर में प्रवेश की योजना बनाएं। वास्तविक प्रवेश के लिए राहु काल से बचें। पूर्ण लग्न तालिका के लिए हमारी <a href='/muhurta/lagna' style='color:var(--color-saffron-deep);'>लग्न तालिका</a> देखें।" style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.6;">Once you identify an auspicious date, plan to enter the house during Amrit or Shubh Choghadiya, during Jupiter or Moon Hora, and when a benefic Lagna is rising. Avoid Rahu Kala timing for the actual entry. See our <a href="/muhurta/lagna" style="color:var(--color-saffron-deep);">Lagna Table</a> for the full day's timings.</p>
      </div>

      <!-- Vastu Shanti vs Griha Pravesh: commonly confused ceremonies -->
      <div class="card" style="padding:20px;margin-bottom:24px;">
        <p data-hi="गृह प्रवेश बनाम वास्तु शांति" style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 6px;">Griha Pravesh vs. Vastu Shanti</p>
        <p data-hi="गृह प्रवेश नए घर में औपचारिक प्रवेश का उत्सव है। वास्तु शांति एक अलग अनुष्ठान है जो वास्तु दोषों (भूमि या भवन में ऊर्जा असंतुलन) को शांत करता है, और इसे अक्सर गृह प्रवेश से पहले या साथ में किया जाता है — खासकर यदि भूमि की पूजा पहले नहीं हुई हो।" style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.6;">Griha Pravesh is the ceremony of formally entering a new home. Vastu Shanti is a separate ritual that appeases Vastu doshas (energy defects in the land or structure) and is often performed before or alongside Griha Pravesh, especially if the plot wasn't worshipped beforehand — the two are commonly confused but address different things.</p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px;">
        {[
          {label:'Good Nakshatras',labelHi:'शुभ नक्षत्र',desc:'Rohini, Mrigashira, Punarvasu, Pushya, Uttara Phalguni, Hasta, Chitra, Swati, Anuradha, Uttara Ashadha, Shravana, Dhanishtha, Revati',descHi:'रोहिणी, मृगशिरा, पुनर्वसु, पुष्य, उत्तर फाल्गुनी, हस्त, चित्रा, स्वाति, अनुराधा, उत्तराषाढ़ा, श्रावण, धनिष्ठा, रेवती'},
          {label:'Good Tithis',labelHi:'शुभ तिथियां',desc:'Dwitiya, Tritiya, Panchami, Saptami, Dashami, Ekadashi, Dwadashi, Trayodashi. Avoid Rikta tithis (4th, 9th, 14th) and Amavasya.',descHi:'द्वितीया, तृतीया, पंचमी, सप्तमी, दशमी, एकादशी, द्वादशी, त्रयोदशी। रिक्ता तिथियों (4, 9, 14) और अमावस्या से बचें।'},
          {label:'Good Weekdays',labelHi:'शुभ वार',desc:'Monday, Wednesday, Thursday, Friday. Avoid Sunday (Ravi Vara) for most auspicious activities.',descHi:'सोमवार, बुधवार, गुरुवार, शुक्रवार। अधिकांश शुभ कार्यों के लिए रविवार से बचें।'},
          {label:'Months to Avoid',labelHi:'त्याज्य महीने',desc:'Kharmas (Sun in Sagittarius or Pisces), Adhika Masa, Shraadh Paksha (Krishna Paksha of Ashwin). These periods weaken any Muhurta.',descHi:'खरमास (सूर्य धनु या मीन राशि में), अधिक मास, श्राद्ध पक्ष (आश्विन का कृष्ण पक्ष)। ये अवधियां किसी भी मुहूर्त को कमज़ोर करती हैं।'},
        ].map(c => (
          <div class="card" style="padding:14px;">
            <p data-hi={c.labelHi} style="font-size:12px;font-weight:600;color:var(--color-ink);margin:0 0 5px;">{c.label}</p>
            <p data-hi={c.descHi} style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.5;">{c.desc}</p>
          </div>
        ))}
      </div>

      <!-- How the score works -->
      <div class="card" style="padding:24px;margin-top:24px;">
        <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 10px;">How the Score Works</h3>
        <p style="font-size:14px;color:var(--color-body-text);margin:0 0 10px;line-height:1.7;">Each candidate date is scored from zero: +3 for a favourable weekday, +4 for one of thirteen auspicious Griha Pravesh nakshatras (or -2 if the Moon is in Panchaka instead), -3 for a Rikta tithi (4th, 9th, or 14th), or +3 for one of eight auspicious tithis (labeled Shukla when it falls in the bright fortnight), and +2 for an auspicious yoga.</p>
        <p style="font-size:14px;color:var(--color-body-text);margin:0 0 10px;line-height:1.7;">Two seasonal exclusions apply as point penalties rather than hard vetoes: Kharmas (Sun in Dhanu or Meena) subtracts 4 points, and Chaturmas (Sun in Simha, Kanya, or Tula — the four-month stretch traditionally considered unfit for housewarmings and other major beginnings) subtracts 10, heavily enough that a Chaturmas date essentially never clears the results threshold even if everything else about it is favourable. Both checks look at the Sun's sidereal position at the very start and very end of the civil day, so a Sankranti (sign change) partway through the day can't slip past the gate.</p>
        <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.7;">Only dates scoring 4 or above appear in the results, sorted best-first. The Rahu Kala window shown on the top result is a scheduling reminder for the entry itself — it's informational and isn't part of the numeric score above.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  @media (max-width: 640px) {
    .finder-form-grid { grid-template-columns: 1fr !important; }
  }
</style>

<script>
import { sunTrueLongitude, moonLongitude, lahiriAyanamsha } from '../../lib/panchang';
import { MUHURTA_CRITERIA, sunRashiVoidCheck, KHARMAS_RASHIS, CHATURMAS_RASHIS } from '../../lib/muhurta';
import { formatDateHi } from '../../lib/date-i18n';
import { formatMinutes12h } from '../../lib/time-format';

const LOCS = [
  {name:'New Delhi',nameHi:'नई दिल्ली',lat:28.6139,lng:77.209,tz:5.5},
  {name:'Mumbai',nameHi:'मुंबई',lat:19.076,lng:72.8777,tz:5.5},
  {name:'Bengaluru',nameHi:'बेंगलुरू',lat:12.9716,lng:77.5946,tz:5.5},
  {name:'Chennai',nameHi:'चेन्नई',lat:13.0827,lng:80.2707,tz:5.5},
  {name:'Kolkata',nameHi:'कोलकाता',lat:22.5726,lng:88.3639,tz:5.5},
  {name:'Hyderabad',nameHi:'हैदराबाद',lat:17.385,lng:78.4867,tz:5.5},
  {name:'Jaipur',nameHi:'जयपुर',lat:26.9124,lng:75.7873,tz:5.5},
  {name:'Varanasi',nameHi:'वाराणसी',lat:25.3176,lng:82.9739,tz:5.5},
  {name:'Dubai',nameHi:'दुबई',lat:25.2048,lng:55.2708,tz:4},
  {name:'New York',nameHi:'न्यूयॉर्क',lat:40.7128,lng:-74.006,tz:-4},
  {name:'London',nameHi:'लंदन',lat:51.5074,lng:-0.1278,tz:1},
];

let isHindi = localStorage.getItem('pp-lang') === 'hi';
// Sourced from the shared MUHURTA_CRITERIA table (Issue #15) instead of a local duplicate —
// values were already identical, so this is a consolidation, not a correctness fix.
const GP_GOOD_NAKS = MUHURTA_CRITERIA['griha-pravesh'].goodNakshatras;
const GP_GOOD_TITHIS = MUHURTA_CRITERIA['griha-pravesh'].goodTithis;
const GP_AVOID_TITHIS = MUHURTA_CRITERIA['griha-pravesh'].avoidTithis;
const GP_GOOD_VARAS = MUHURTA_CRITERIA['griha-pravesh'].goodVaras;
const PANCHAKA_NAKS = [22,23,24,25,26];
const GOOD_YOGAS = [1,2,3,4,6,7,10,11,13,15,19,20,21,22,23,24,25];
const NAK_NAMES=['Ashwini','Bharani','Krittika','Rohini','Mrigashira','Ardra','Punarvasu','Pushya','Ashlesha','Magha','Purva Phalguni','Uttara Phalguni','Hasta','Chitra','Swati','Vishakha','Anuradha','Jyeshtha','Mula','Purva Ashadha','Uttara Ashadha','Shravana','Dhanishtha','Shatabhisha','Purva Bhadrapada','Uttara Bhadrapada','Revati'];
const TITHI_NAMES=['Pratipada','Dwitiya','Tritiya','Chaturthi','Panchami','Shashthi','Saptami','Ashtami','Navami','Dashami','Ekadashi','Dwadashi','Trayodashi','Chaturdashi','Purnima','Pratipada','Dwitiya','Tritiya','Chaturthi','Panchami','Shashthi','Saptami','Ashtami','Navami','Dashami','Ekadashi','Dwadashi','Trayodashi','Chaturdashi','Amavasya'];
const VARA_NAMES=['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const VARA_NAMES_HI=['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const RASHI_NAMES=['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RAHU_SLOTS=[7,1,6,4,5,3,2]; // Fri/Sat swap fixed 2026-08-14

function toJD(y:number,m:number,d:number,h=0){
  if(m<=2){y--;m+=12;}
  const A=Math.floor(y/100),B=2-A+Math.floor(A/4);
  return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;
}
const n360=(a:number)=>((a%360)+360)%360;
const toRad=(d:number)=>d*Math.PI/180;
const toDeg=(r:number)=>r*180/Math.PI;

function calcDay(y:number,m:number,d:number,loc:{lat:number;lng:number;tz:number}){
  const jd=toJD(y,m,d,6-loc.tz);
  const T=(jd-2451545)/36525;
  const sunLon=sunTrueLongitude(jd);
  const moonLon=moonLongitude(jd);
  const ay=lahiriAyanamsha(jd);
  const sunSid=n360(sunLon-ay), moonSid=n360(moonLon-ay);
  const elong=n360(moonLon-sunLon);
  const tithiIdx=Math.floor(elong/12)%30;
  const nakIdx=Math.floor(moonSid/(360/27))%27;
  const yogaIdx=Math.floor(n360(sunSid+moonSid)/(360/27))%27;
  const date=new Date(y,m-1,d);
  const wd=date.getDay();
  const sinDec=Math.sin(toRad(23.4393))*Math.sin(toRad(sunLon));
  const dec=Math.asin(sinDec);
  const cosHA=(Math.sin(toRad(-0.8333))-Math.sin(toRad(loc.lat))*Math.sin(dec))/(Math.cos(toRad(loc.lat))*Math.cos(dec));
  const ha=toDeg(Math.acos(Math.max(-1,Math.min(1,cosHA))));
  const noon=12-loc.lng/15;
  const srMins=(noon-ha/15)*60+loc.tz*60, ssMins=(noon+ha/15)*60+loc.tz*60;
  const dur=(ssMins-srMins)/8;
  const rahuStart=srMins+RAHU_SLOTS[wd]*dur, rahuEnd=rahuStart+dur;
  return {tithiIdx,nakIdx,yogaIdx,wd,rahuStart,rahuEnd,paksha:tithiIdx<15?'S':'K'};
}

function scoreGP(res:{tithiIdx:number;nakIdx:number;yogaIdx:number;wd:number;rahuStart:number;rahuEnd:number;paksha:string},y:number,m:number,d:number,loc:{lat:number;lng:number;tz:number}){
  let score=0;
  const notes:string[]=[], bad:string[]=[];
  const varaName=isHindi?VARA_NAMES_HI[res.wd]:VARA_NAMES[res.wd];
  if(GP_GOOD_VARAS.includes(res.wd)){score+=3;notes.push(varaName+(isHindi?' (शुभ वार)':' (good weekday)'));}
  else bad.push(varaName+(isHindi?' (वर्जित)':' (avoid)'));
  if(GP_GOOD_NAKS.includes(res.nakIdx)){score+=4;notes.push(NAK_NAMES[res.nakIdx]+(isHindi?' (शुभ नक्षत्र)':' (good nakshatra)'));}
  else if(PANCHAKA_NAKS.includes(res.nakIdx)){score-=2;bad.push((isHindi?'पंचक — ':'Panchaka — ')+NAK_NAMES[res.nakIdx]);}
  else bad.push(NAK_NAMES[res.nakIdx]+(isHindi?' (उपयुक्त नहीं)':' (not ideal)'));
  if(GP_AVOID_TITHIS.includes(res.tithiIdx)){score-=3;bad.push(TITHI_NAMES[res.tithiIdx]+(isHindi?' रिक्ता तिथि (वर्जित)':' Rikta tithi (avoid)'));}
  else if(GP_GOOD_TITHIS.includes(res.tithiIdx)){score+=3;notes.push((res.paksha==='S'?(isHindi?'शुक्ल ':'Shukla '):'')+TITHI_NAMES[res.tithiIdx]);}
  if(GOOD_YOGAS.includes(res.yogaIdx)){score+=2;notes.push(isHindi?'शुभ योग':'Auspicious yoga');}
  // Kharmas/Chaturmas: dual-endpoint (start-of-day + end-of-day) Sun-rashi check (Issue #35/#13) —
  // a same-day Sankranti crossing no longer slips past a fixed 6 AM snapshot.
  const kharmas=sunRashiVoidCheck(y,m,d,loc.tz,KHARMAS_RASHIS);
  if(kharmas.isVoid){score-=4;bad.push(isHindi?'खरमास माह':'Kharmas month');}
  const chaturmas=sunRashiVoidCheck(y,m,d,loc.tz,CHATURMAS_RASHIS);
  if(chaturmas.isVoid){score-=10;bad.push((isHindi?'चातुर्मास (':'Chaturmas (')+RASHI_NAMES[chaturmas.rashiIdx]+')');}
  return {score,notes,bad};
}

const fmtMins = formatMinutes12h;

const sel=document.getElementById('gp-city') as HTMLSelectElement;
function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>'<option value="'+l.name+'">'+(isHindi?(l.nameHi||l.name):l.name)+'</option>').join('');
  if(selected) sel.value=selected;
}
renderCityOptions();

// Pre-fill from the header's location picker (same "today, my location" scope as the homepage)
function applyHeaderLoc(loc:any){
  if(!loc||!loc.name)return;
  const norm=(s:string)=>s.trim().toLowerCase();
  let match=LOCS.find(l=>norm(l.name)===norm(loc.name));
  if(!match){
    match={name:loc.name,nameHi:loc.nameHi,lat:loc.lat,lng:loc.lng,tz:loc.tzOffset};
    LOCS.unshift(match);
    renderCityOptions();
  }
  sel.value=match.name;
}
if((window as any).__initLoc) applyHeaderLoc((window as any).__initLoc);
window.addEventListener('locationchange',(e:Event)=>applyHeaderLoc((e as CustomEvent).detail));

// Shifted to the resolved location's own local calendar date, not raw UTC (toISOString()
// always returns UTC) -- wrong specifically during 00:00-05:30 IST each day (UTC hasn't
// rolled to the new date yet), defaulting the range start to yesterday.
const initLoc=LOCS.find(l=>l.name===sel.value)||LOCS[0];
const now=new Date(Date.now()+initLoc.tz*3600000);
const fromInput=document.getElementById('gp-from') as HTMLInputElement;
const toInput=document.getElementById('gp-to') as HTMLInputElement;
fromInput.value=now.toISOString().split('T')[0];
const sixMonths=new Date(now); sixMonths.setMonth(sixMonths.getMonth()+6);
toInput.value=sixMonths.toISOString().split('T')[0];

function findGPDates(scroll=true){
  const fromStr=fromInput.value, toStr=toInput.value;
  const cityName=sel.value;
  const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
  const [fy,fm,fd]=fromStr.split('-').map(Number);
  const [ty,tm,td]=toStr.split('-').map(Number);
  const fromD=new Date(fy,fm-1,fd), toD=new Date(ty,tm-1,td);
  if(toD<=fromD||((toD.getTime()-fromD.getTime())>365*24*3600*1000)){
    alert(isHindi?'कृपया 1 वर्ष तक की सीमा चुनें।':'Please select a range up to 1 year.');return;
  }

  const results:any[]=[];
  const cur=new Date(fromD);
  while(cur<=toD){
    const y=cur.getFullYear(),m=cur.getMonth()+1,d=cur.getDate();
    const res=calcDay(y,m,d,loc);
    const {score,notes,bad}=scoreGP(res,y,m,d,loc);
    if(score>=5) results.push({date:new Date(cur),score,notes,bad,res});
    cur.setDate(cur.getDate()+1);
  }
  results.sort((a,b)=>b.score-a.score);
  const top=results.slice(0,20);

  const listEl=document.getElementById('gp-list');
  const titleEl=document.getElementById('gp-results-title');
  const secEl=document.getElementById('gp-results');
  if(!listEl||!titleEl||!secEl)return;
  titleEl.textContent=isHindi?`${top.length} शुभ गृह प्रवेश तिथियां मिलीं`:`${top.length} auspicious Griha Pravesh dates found`;
  if(!top.length){
    listEl.innerHTML=`<div class="card" style="padding:20px;text-align:center;"><p style="color:var(--color-mute);">${isHindi?'कोई मजबूत तिथि नहीं मिली। सीमा बढ़ाकर देखें।':'No strong dates found. Try extending the range.'}</p></div>`;
  } else {
    listEl.innerHTML=top.map((r,i)=>{
      const label=isHindi?(r.score>=9?'उत्कृष्ट':r.score>=7?'बहुत अच्छा':'अच्छा'):(r.score>=9?'Excellent':r.score>=7?'Very Good':'Good');
      const lc=r.score>=9?'#16803D':r.score>=7?'#97690F':'#B5390A';
      const isTop=i===0;
      const tc=isTop?'var(--color-on-primary)':'var(--color-ink)';
      const mut=isTop?'color-mix(in srgb, var(--color-on-primary), transparent 40%)':'var(--color-mute)';
      const openTag=isTop?'<div class="bezel-outer"><div class="bezel-inner" style="padding:18px;background:var(--color-ink);">':'<div class="card" style="padding:18px;">';
      const closeTag=isTop?'</div></div>':'</div>';
      return `${openTag}
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
          <div>
            <p style="font-size:16px;font-weight:700;color:${tc};margin:0;">${formatDateHi(r.date, isHindi, { weekday: 'long' })}</p>
            <p style="font-size:11px;color:${mut};margin:3px 0 0;font-family:var(--font-mono);">${NAK_NAMES[r.res.nakIdx]} · ${TITHI_NAMES[r.res.tithiIdx]} · Score: ${r.score}/12</p>
          </div>
          <span style="font-size:11px;font-weight:700;padding:4px 12px;border-radius:100px;background:${isTop?'color-mix(in srgb, var(--color-on-primary), transparent 85%)':lc+'18'};color:${isTop?'var(--color-on-primary)':lc};border:1px solid ${isTop?'color-mix(in srgb, var(--color-on-primary), transparent 80%)':lc+'44'};">${label}</span>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:${r.bad.length?'8px':'0'};">
          ${r.notes.map((n:string)=>`<span style="font-size:10px;padding:2px 8px;border-radius:100px;background:${isTop?'color-mix(in srgb, var(--color-on-primary), transparent 85%)':'var(--color-canvas-soft-2)'};color:${isTop?'color-mix(in srgb, var(--color-on-primary), transparent 15%)':'var(--color-body-text)'};border:1px solid ${isTop?'color-mix(in srgb, var(--color-on-primary), transparent 80%)':'var(--color-hairline)'};">✓ ${n}</span>`).join('')}
        </div>
        ${r.bad.length?`<div style="display:flex;flex-wrap:wrap;gap:6px;">
          ${r.bad.map((n:string)=>`<span style="font-size:10px;padding:2px 8px;border-radius:100px;background:#fee2e2;color:#dc2626;border:1px solid #fecaca;">✗ ${n}</span>`).join('')}
        </div>`:''}
        ${isTop?`<div style="margin-top:12px;padding-top:12px;border-top:1px solid color-mix(in srgb, var(--color-on-primary), transparent 85%);">
          <p style="font-size:10px;color:color-mix(in srgb, var(--color-on-primary), transparent 50%);margin:0 0 2px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.05em;">Avoid Rahu Kala</p>
          <p style="font-size:12px;color:color-mix(in srgb, var(--color-on-primary), transparent 15%);margin:0;">${fmtMins(r.res.rahuStart)} – ${fmtMins(r.res.rahuEnd)}</p>
        </div>`:''}
      ${closeTag}`;
    }).join('');
  }
  secEl.style.display='block';
  if(scroll) secEl.scrollIntoView({behavior:'smooth',block:'start'});
}
document.getElementById('gp-find')?.addEventListener('click',()=>findGPDates());

function applyPageLang(hindi:boolean){
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el=>{
    if(!el.dataset.en) el.dataset.en=el.textContent||'';
    el.textContent=hindi?(el.dataset.hi as string):(el.dataset.en as string);
  });
  isHindi=hindi;
  renderCityOptions();
  const secEl=document.getElementById('gp-results');
  if(secEl && secEl.style.display!=='none' && secEl.style.display!=='') findGPDates(false);
}
document.addEventListener('langchange',(e:Event)=>{
  applyPageLang((e as CustomEvent).detail.langCode==='hi');
});
if(localStorage.getItem('pp-lang')==='hi') applyPageLang(true);
</script>
