---
import Layout from '../../layouts/Layout.astro';
import { RASHIS, getDailyPrediction, getWeeklyPrediction, getMonthlyPrediction, getYearlyPrediction } from '../../lib/rashifal';
import RashiIcon from '../../components/icons/RashiIcon.astro';
import { formatDateHi, WD_EN_LONG, WD_HI_LONG } from '../../lib/date-i18n';

const today = new Date();
const dateLabel = formatDateHi(today, false, { weekday: 'long' });
const dateLabelHi = formatDateHi(today, true, { weekday: 'long' });
---

<Layout
  title="Today's Rashifal — Daily Horoscope for All 12 Rashis | PanchangPath"
  description="Read today's Rashifal (daily horoscope) for all 12 Vedic rashis. Daily, weekly, monthly and yearly predictions based on Jyotish principles."
>

  <!-- Hero -->
  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:48px 0 36px;">
    <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <p class="caption-mono" data-hi="ज्योतिष · वैदिक ज्योतिष शास्त्र" style="color:var(--color-mute);margin:0 0 10px;">Jyotish · Vedic Astrology</p>
      <h1 style="font-size:36px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 12px;">
        <span class="en-text">Today's Rashifal</span>
        <span class="hi-text" style="display:none;">आज का राशिफल</span>
      </h1>
      <p data-hi="ग्रहों की स्थिति और ज्योतिष सिद्धांतों पर आधारित सभी 12 वैदिक राशियों का दैनिक राशिफल।" style="font-size:15px;color:var(--color-body-text);margin:0 0 24px;max-width:560px;line-height:1.6;">
        Daily horoscope for all 12 Vedic rashis based on planetary positions and Jyotish principles.
      </p>

      <p class="rf-disclosure" data-hi="भविष्यवाणियाँ पहले से लिखी गई कुछ प्रविष्टियों के एक छोटे संग्रह से ली जाती हैं, जो कुछ ही दिनों में दोहराई जाती हैं। ये आपकी जन्म कुंडली से गणना नहीं की जातीं।">
        Predictions are drawn from a small set of pre-written entries that repeats every few days. They are not calculated from your birth chart.
      </p>

      <!-- Period tabs -->
      <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap;">
        <button class="period-btn active" data-period="daily" data-hi="दैनिक">Daily</button>
        <button class="period-btn" data-period="weekly" data-hi="साप्ताहिक">Weekly</button>
        <button class="period-btn" data-period="monthly" data-hi="मासिक">Monthly</button>
        <button class="period-btn" data-period="yearly" data-hi="वार्षिक">Yearly</button>
        <span style="font-size:12px;color:var(--color-mute);margin-left:8px;font-family:var(--font-mono);" data-hi={dateLabelHi}>{dateLabel}</span>
      </div>
    </div>
  </section>

  <!-- Rashifal grid -->
  <section style="padding:40px 0 56px;">
    <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <div class="rfi-grid" id="rfi-grid">
        {RASHIS.map((rashi, idx) => {
          const daily = getDailyPrediction(rashi, today);
          const weekly = getWeeklyPrediction(rashi, today);
          const monthly = getMonthlyPrediction(rashi, today);
          const yearly = getYearlyPrediction(rashi, today);
          const dailyHi = getDailyPrediction(rashi, today, true);
          const weeklyHi = getWeeklyPrediction(rashi, today, true);
          const monthlyHi = getMonthlyPrediction(rashi, today, true);
          const yearlyHi = getYearlyPrediction(rashi, today, true);
          return (
            <div class="rfi-card animate-in" style={`animation-delay:${idx * 35}ms`} data-rashi={rashi.id}>
              <!-- Colored header strip -->
              <div class="rfi-strip" style={`background:${rashi.gradient}`}>
                <RashiIcon name={rashi.id} color="#fff" size={24} class="rfi-sym" />
                <div class="rfi-strip-text">
                  <span class="rfi-name-en en-text">{rashi.name}</span>
                  <span class="rfi-name-hi hi-text" style="display:none;">{rashi.nameHi}</span>
                  <span class="rfi-eng"> — {rashi.english}</span>
                </div>
                <span class="rfi-lord-pill" data-hi={rashi.lordHi}>{rashi.lord}</span>
              </div>

              <!-- Prediction content area — all periods pre-rendered, toggled by JS -->
              <div class="rfi-body">
                <p class="rfi-text" data-for="daily" data-lang="en">{daily}</p>
                <p class="rfi-text" data-for="daily" data-lang="hi" style="display:none">{dailyHi}</p>
                <p class="rfi-text" data-for="weekly" data-lang="en" style="display:none">{weekly}</p>
                <p class="rfi-text" data-for="weekly" data-lang="hi" style="display:none">{weeklyHi}</p>
                <p class="rfi-text" data-for="monthly" data-lang="en" style="display:none">{monthly}</p>
                <p class="rfi-text" data-for="monthly" data-lang="hi" style="display:none">{monthlyHi}</p>
                <p class="rfi-text" data-for="yearly" data-lang="en" style="display:none">{yearly}</p>
                <p class="rfi-text" data-for="yearly" data-lang="hi" style="display:none">{yearlyHi}</p>

                <div class="rfi-footer">
                  <div class="rfi-lucky">
                    <span class="rfi-lucky-item">
                      <span class="rfi-lucky-dot" style={`background:${rashi.luckyColorHex}`}></span>
                      <span data-hi={rashi.luckyColorHi}>{rashi.luckyColor}</span>
                    </span>
                    <span class="rfi-lucky-item">🔢 {rashi.luckyNumbers.join(', ')}</span>
                    <span class="rfi-lucky-item">📅 <span data-hi={WD_HI_LONG[WD_EN_LONG.indexOf(rashi.luckyDay)]}>{rashi.luckyDay}</span></span>
                  </div>
                  <a href={`/rashifal/${rashi.id}`} class="rfi-detail-link" data-hi="पूर्ण भविष्यवाणी →">
                    Full prediction →
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Prashnavali + Find Rashi tools -->
  <section style="background:var(--color-canvas);border-top:1px solid var(--color-hairline);padding:48px 0;">
    <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;" class="tools-grid">

        <!-- Prashnavali -->
        <a href="/prashnavali" class="tool-card prashnavali-card">
          <div style="font-size:40px;margin-bottom:12px;">🔮</div>
          <p data-hi="प्रश्नावली" style="font-size:16px;font-weight:600;color:var(--color-ink);margin:0 0 8px;">Prashnavali</p>
          <p data-hi="एक प्रश्न सोचें, अपना मन केंद्रित करें, और लौकिक दैवज्ञ से दिव्य उत्तर प्राप्त करें।" style="font-size:13px;color:var(--color-body-text);margin:0 0 16px;line-height:1.6;">Think of a question, focus your mind, and receive a divine answer from the cosmic oracle.</p>
          <span data-hi="दैवज्ञ खोलें →" style="font-size:13px;font-weight:600;color:var(--color-saffron-deep);">Open Oracle →</span>
        </a>

        <!-- Find by Name -->
        <div class="tool-card">
          <div style="font-size:40px;margin-bottom:12px;">🔤</div>
          <p style="font-size:16px;font-weight:600;color:var(--color-ink);margin:0 0 8px;">
            <span class="en-text">Find Rashi by Name</span>
            <span class="hi-text" style="display:none;">नाम से राशि</span>
          </p>
          <p data-hi="वैदिक परंपरा में, आपकी जन्म राशि आपके जन्म नाम के पहले अक्षर से जुड़ी होती है।" style="font-size:13px;color:var(--color-body-text);margin:0 0 12px;line-height:1.6;">
            In Vedic tradition, your Janma Rashi is linked to the first syllable of your birth name.
          </p>
          <div style="display:flex;gap:6px;">
            <input type="text" id="name-input-full" aria-label="First name" class="tool-input" placeholder="First name…" maxlength="40" />
            <button class="tool-btn" id="name-btn-full" data-hi="खोजें">Find</button>
          </div>
          <p id="name-res-full" class="tool-result" hidden></p>
        </div>

        <!-- Find by Birth Date -->
        <div class="tool-card">
          <div style="font-size:40px;margin-bottom:12px;">🗓️</div>
          <p style="font-size:16px;font-weight:600;color:var(--color-ink);margin:0 0 8px;">
            <span class="en-text">Find Rashi by Birth Date</span>
            <span class="hi-text" style="display:none;">जन्म तिथि से राशि</span>
          </p>
          <p data-hi="जन्म तिथि का उपयोग करते हुए वैदिक सायन गणनाओं के आधार पर अपनी सूर्य राशि जानें।" style="font-size:13px;color:var(--color-body-text);margin:0 0 12px;line-height:1.6;">
            Discover your Surya (Sun) Rashi based on Vedic sidereal calculations using your date of birth.
          </p>
          <div style="display:flex;gap:6px;">
            <input type="date" id="dob-input-full" lang="en-GB" aria-label="Date of birth" class="tool-input" />
            <button class="tool-btn" id="dob-btn-full" data-hi="खोजें">Find</button>
          </div>
          <p id="dob-res-full" class="tool-result" hidden></p>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
import { getRashiByNameLetter } from '../../lib/rashifal';

// Period toggle
let activePeriod = 'daily';
let isHindi = false;

// Each .rfi-text carries both a period (data-for) and a language (data-lang);
// visibility requires both to match the active period AND active language —
// driven from one place so setPeriod() and applyPageLang() can't disagree.
function updateRfiVisibility() {
  const lang = isHindi ? 'hi' : 'en';
  document.querySelectorAll<HTMLElement>('.rfi-text').forEach(el => {
    el.style.display = (el.dataset.for === activePeriod && el.dataset.lang === lang) ? '' : 'none';
  });
}

function setPeriod(period: string) {
  activePeriod = period;
  document.querySelectorAll<HTMLButtonElement>('.period-btn').forEach(b => {
    b.classList.toggle('active', b.dataset.period === period);
  });
  updateRfiVisibility();
}

document.querySelectorAll<HTMLButtonElement>('.period-btn').forEach(btn => {
  btn.addEventListener('click', () => setPeriod(btn.dataset.period ?? 'daily'));
});

// Honor ?period= from links like the homepage feed's Weekly/Monthly/Yearly tabs
const periodParam = new URLSearchParams(location.search).get('period');
if (periodParam && document.querySelector(`.period-btn[data-period="${periodParam}"]`)) {
  setPeriod(periodParam);
}

// Rashi finder — uses the shared, canonically-derived getRashiByNameLetter() from lib/rashifal.ts
// instead of a locally duplicated map, so this can no longer drift out of sync with each rashi's
// nameLetters array (previously duplicated identically in RashifalFeed.astro; both now share one source).
const RASHI_HI: Record<string, string> = {
  Mesha:"मेष",Vrishabha:"वृषभ",Mithuna:"मिथुन",Karka:"कर्क",Simha:"सिंह",Kanya:"कन्या",
  Tula:"तुला",Vrishchika:"वृश्चिक",Dhanu:"धनु",Makara:"मकर",Kumbha:"कुम्भ",Meena:"मीन",
};
const RASHI_SLUG: Record<string, string> = {
  Mesha:"mesha",Vrishabha:"vrishabha",Mithuna:"mithuna",Karka:"karka",Simha:"simha",Kanya:"kanya",
  Tula:"tula",Vrishchika:"vrishchika",Dhanu:"dhanu",Makara:"makara",Kumbha:"kumbha",Meena:"meena",
};

function findByName(n: string): string | undefined {
  const rashi = getRashiByNameLetter(n);
  return rashi?.name; // e.g. "Mesha" — keeps the capitalized-name contract RASHI_HI/RASHI_SLUG below expect
}
function findByDate(ds: string): string {
  const d = new Date(ds + 'T12:00:00');
  const md = (d.getMonth() + 1) * 100 + d.getDate();
  if (md >= 414 && md <= 514) return "Mesha";
  if (md >= 515 && md <= 614) return "Vrishabha";
  if (md >= 615 && md <= 715) return "Mithuna";
  if (md >= 716 && md <= 816) return "Karka";
  if (md >= 817 && md <= 916) return "Simha";
  if (md >= 917 && md <= 1017) return "Kanya";
  if (md >= 1018 && md <= 1115) return "Tula";
  if (md >= 1116 && md <= 1214) return "Vrishchika";
  if (md >= 1215 || md <= 113) return "Dhanu";
  if (md >= 114 && md <= 212) return "Makara";
  if (md >= 213 && md <= 313) return "Kumbha";
  return "Meena";
}
// Parsed-date echo: a native <input type="date"> always yields an unambiguous
// YYYY-MM-DD value, but the picker's visually-displayed segment order is
// locale-dependent (commonly mm/dd/yyyy for non-India locales), so an
// India-first visitor typing day-first can land in the wrong segment. Echoing
// the parsed date back in unambiguous long form lets them catch a misparse.
const WD_EN = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const WD_HI = ['रविवार','सोमवार','मंगलवार','बुधवार','गुरुवार','शुक्रवार','शनिवार'];
const MO_EN = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const MO_HI = ['जनवरी','फरवरी','मार्च','अप्रैल','मई','जून','जुलाई','अगस्त','सितंबर','अक्टूबर','नवंबर','दिसंबर'];
function formatLongDate(dateStr: string, hindi: boolean): string {
  const [y, m, d] = dateStr.split('-').map(Number);
  const wd = new Date(Date.UTC(y, m - 1, d, 12)).getUTCDay();
  return hindi ? `${WD_HI[wd]}, ${d} ${MO_HI[m - 1]} ${y}` : `${WD_EN[wd]}, ${d} ${MO_EN[m - 1]} ${y}`;
}

function showRes(el: HTMLElement, rashi: string, dateStr?: string) {
  const slug = RASHI_SLUG[rashi] ?? rashi.toLowerCase();
  const label = isHindi ? 'आपकी राशि: ' : 'Your Rashi: ';
  const linkText = isHindi ? 'भविष्यवाणी देखें →' : 'View prediction →';
  const dateEcho = dateStr
    ? `<br/><span style="font-size:12px;color:var(--color-mute);">${isHindi ? 'दर्ज तिथि' : 'Date entered'}: ${formatLongDate(dateStr, isHindi)}</span>`
    : '';
  el.innerHTML = `${label}<strong>${rashi} (${RASHI_HI[rashi] ?? ''})</strong> — <a href="/rashifal/${slug}" style="color:var(--color-saffron-deep);font-weight:600;">${linkText}</a>${dateEcho}`;
  el.hidden = false;
}

document.getElementById('name-btn-full')?.addEventListener('click', () => {
  const val = (document.getElementById('name-input-full') as HTMLInputElement)?.value ?? '';
  const res = document.getElementById('name-res-full') as HTMLElement;
  const r = findByName(val);
  if (r) showRes(res, r); else {
    res.textContent = isHindi ? 'राशि निर्धारित नहीं हो सकी। जन्म तिथि टूल आज़माएं।' : 'Could not determine Rashi. Try the birth date tool.';
    res.hidden = false;
  }
});
document.getElementById('dob-btn-full')?.addEventListener('click', () => {
  const val = (document.getElementById('dob-input-full') as HTMLInputElement)?.value ?? '';
  const res = document.getElementById('dob-res-full') as HTMLElement;
  if (!val) {
    res.textContent = isHindi ? 'कृपया एक तिथि चुनें।' : 'Please select a date.';
    res.hidden = false;
    return;
  }
  showRes(res, findByDate(val), val);
});
document.getElementById('name-input-full')?.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') document.getElementById('name-btn-full')?.click(); });
document.getElementById('dob-input-full')?.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') document.getElementById('dob-btn-full')?.click(); });

// ── Hindi UI coverage ──
// LanguagePicker.astro dispatches 'langchange' on document with { langCode }.
// Toggles every [data-hi] element's text and every .en-text/.hi-text pair
// (rashi card names, tool card headings) already present in this page's markup.
function applyPageLang(hindi: boolean) {
  isHindi = hindi;
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
  });
  document.querySelectorAll<HTMLElement>('.en-text').forEach(el => { el.style.display = hindi ? 'none' : ''; });
  document.querySelectorAll<HTMLElement>('.hi-text').forEach(el => { el.style.display = hindi ? '' : 'none'; });
  updateRfiVisibility();
  const nameInput = document.getElementById('name-input-full') as HTMLInputElement | null;
  if (nameInput) nameInput.placeholder = hindi ? 'पहला नाम…' : 'First name…';
}
document.addEventListener('langchange', (e: Event) => {
  const evt = e as CustomEvent;
  applyPageLang(evt.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>

<style>
  /* Transparency note: the predictions are a fixed rotating set, not per-user astrology.
     Deliberately legible rather than fine print, but visually subordinate to the content. */
  .rf-disclosure {
    font-size: 12.5px;
    color: var(--color-mute);
    margin: -14px 0 22px;
    max-width: 560px;
    line-height: 1.55;
    padding-left: 10px;
    border-left: 2px solid var(--color-hairline-strong);
  }

.period-btn {
  height: 34px;
  padding: 0 16px;
  background: var(--color-canvas);
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-pill);
  font-family: var(--font-sans);
  font-size: 13px;
  font-weight: 500;
  color: var(--color-body-text);
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
}
.period-btn:hover { border-color: var(--color-saffron); color: var(--color-saffron-deep); }
.period-btn.active { background: var(--color-ink); color: var(--color-on-primary); border-color: var(--color-ink); }

.rfi-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.rfi-card {
  background: var(--color-canvas);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  transition: box-shadow 0.15s;
}
.rfi-card:hover { box-shadow: var(--shadow-card-hover); }

.rfi-strip {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
}
.rfi-sym { flex-shrink: 0; }
.rfi-strip-text { flex: 1; }
.rfi-name-en, .rfi-name-hi {
  font-size: 15px;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.3px;
}
.rfi-eng {
  font-size: 12px;
  color: rgba(255,255,255,0.75);
  font-weight: 400;
}
.rfi-lord-pill {
  font-size: 10.5px;
  font-weight: 600;
  background: rgba(255,255,255,0.2);
  color: #fff;
  padding: 2px 9px;
  border-radius: var(--radius-pill);
  white-space: nowrap;
}

.rfi-body { padding: 16px; }
.rfi-text {
  font-size: 13.5px;
  color: var(--color-body-text);
  line-height: 1.7;
  margin: 0 0 14px;
}
.rfi-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  flex-wrap: wrap;
  padding-top: 12px;
  border-top: 1px solid var(--color-hairline);
}
.rfi-lucky { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.rfi-lucky-item {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  color: var(--color-mute);
  font-family: var(--font-mono);
}
.rfi-lucky-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.rfi-detail-link {
  font-size: 12px;
  font-weight: 600;
  color: var(--color-saffron-deep);
  text-decoration: none;
  white-space: nowrap;
}
.rfi-detail-link:hover { text-decoration: underline; }

/* Tools section */
.tool-card {
  background: var(--color-canvas-soft);
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-elevation);
  padding: 28px 24px;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  transition: box-shadow 0.15s;
}
.tool-card:hover { box-shadow: var(--shadow-card); }
.prashnavali-card { background: linear-gradient(135deg, var(--color-saffron-soft) 0%, var(--color-canvas) 100%); }
.tool-input {
  flex: 1;
  min-width: 0;
  height: 34px;
  padding: 0 10px;
  background: var(--color-canvas);
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-sm);
  font-family: var(--font-sans);
  font-size: 13px;
  color: var(--color-ink);
  outline: none;
}
.tool-input:focus { border-color: var(--color-saffron); }
.tool-btn {
  height: 34px;
  padding: 0 14px;
  background: var(--color-saffron);
  border: none;
  border-radius: var(--radius-sm);
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: opacity 0.15s;
}
.tool-btn:hover { opacity: 0.85; }
.tool-result {
  font-size: 13px;
  color: var(--color-body-text);
  margin: 10px 0 0;
  line-height: 1.5;
}

@media (max-width: 1024px) {
  .rfi-grid { grid-template-columns: repeat(2, 1fr); }
  .tools-grid { grid-template-columns: 1fr 1fr !important; }
}
@media (max-width: 640px) {
  .rfi-grid { grid-template-columns: 1fr; }
  .tools-grid { grid-template-columns: 1fr !important; }
}
</style>
