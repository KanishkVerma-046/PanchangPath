---
import Layout from '../../layouts/Layout.astro';
import { RASHIS, getDailyPrediction, getWeeklyPrediction, getMonthlyPrediction, getYearlyPrediction, type Rashi } from '../../lib/rashifal';
import RashiIcon from '../../components/icons/RashiIcon.astro';
import BreadcrumbSchema from '../../components/seo/BreadcrumbSchema.astro';
import { formatDateHi, formatMonthYearHi, WD_EN_LONG, WD_HI_LONG } from '../../lib/date-i18n';

export function getStaticPaths() {
  return RASHIS.map(r => ({ params: { rashi: r.id }, props: { rashi: r } }));
}

interface Props { rashi: Rashi; }
const { rashi } = Astro.props;

const today = new Date();
const dateLabel = formatDateHi(today, false, { weekday: 'long' });
const dateLabelHi = formatDateHi(today, true, { weekday: 'long' });
const monthYearLabel = formatMonthYearHi(today, false);
const monthYearLabelHi = formatMonthYearHi(today, true);
const ELEMENT_HI: Record<string, string> = { Fire: 'अग्नि', Earth: 'पृथ्वी', Air: 'वायु', Water: 'जल' };
const QUALITY_HI: Record<string, string> = { Cardinal: 'चर', Fixed: 'स्थिर', Mutable: 'द्विस्वभाव' };
const daily = getDailyPrediction(rashi, today);
const weekly = getWeeklyPrediction(rashi, today);
const monthly = getMonthlyPrediction(rashi, today);
const yearly = getYearlyPrediction(rashi, today);
const dailyHi = getDailyPrediction(rashi, today, true);
const weeklyHi = getWeeklyPrediction(rashi, today, true);
const monthlyHi = getMonthlyPrediction(rashi, today, true);
const yearlyHi = getYearlyPrediction(rashi, today, true);

const allRashis = RASHIS;
const currentIdx = allRashis.findIndex(r => r.id === rashi.id);
const prevRashi = allRashis[(currentIdx - 1 + allRashis.length) % allRashis.length];
const nextRashi = allRashis[(currentIdx + 1) % allRashis.length];
---

<Layout
  title={`${rashi.name} (${rashi.english}) Rashifal — Daily Horoscope | PanchangPath`}
  description={`Read today's ${rashi.name} Rashifal. Daily, weekly, monthly and yearly horoscope for ${rashi.english} (${rashi.name}) based on Vedic Jyotish.`}
>
  <BreadcrumbSchema items={[
    { name: 'Home', url: '/' },
    { name: 'Rashifal', url: '/rashifal' },
    { name: rashi.name, url: `/rashifal/${rashi.id}` },
  ]} />

  <!-- Breadcrumb -->
  <div style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:10px 0;">
    <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <nav style="font-size:12.5px;color:var(--color-mute);">
        <a href="/" data-hi="होम" style="color:var(--color-mute);text-decoration:none;">Home</a>
        <span style="margin:0 6px;">›</span>
        <a href="/rashifal" data-hi="राशिफल" style="color:var(--color-mute);text-decoration:none;">Rashifal</a>
        <span style="margin:0 6px;">›</span>
        <span style="color:var(--color-ink);">{rashi.name}</span>
      </nav>
    </div>
  </div>

  <!-- Rashi hero banner -->
  <section style={`background:${rashi.gradient};padding:48px 0 40px;`}>
    <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap;">
        <div style="filter:drop-shadow(0 2px 8px rgba(0,0,0,0.2));">
          <RashiIcon name={rashi.id} color="#fff" size={64} />
        </div>
        <div>
          <p data-hi={`${ELEMENT_HI[rashi.element] ?? rashi.element} · ${QUALITY_HI[rashi.quality] ?? rashi.quality}`} style="font-size:12px;font-weight:600;color:rgba(255,255,255,0.7);text-transform:uppercase;letter-spacing:0.1em;margin:0 0 6px;font-family:var(--font-mono);">
            {rashi.element} · {rashi.quality}
          </p>
          <h1 style="font-size:40px;font-weight:700;letter-spacing:-1.5px;color:#fff;margin:0 0 4px;">
            <span class="en-text">{rashi.name} <span style="font-size:22px;opacity:0.8;font-weight:400;margin-left:8px;">({rashi.english})</span></span>
            <span class="hi-text" style="display:none">{rashi.nameHi}</span>
          </h1>
          <p style="font-size:20px;color:rgba(255,255,255,0.85);margin:0;font-weight:500;">
            <span class="en-text">{rashi.nameHi}</span>
            <span class="hi-text" style="display:none">{rashi.name} <span style="opacity:0.8;">({rashi.english})</span></span>
          </p>
        </div>
        <div style="margin-left:auto;display:flex;gap:10px;align-items:center;">
          <a href={`/rashifal/${prevRashi.id}`} class="rashi-nav-btn" title={`${prevRashi.name} Rashifal`}>
            ← <RashiIcon name={prevRashi.id} color="#fff" size={14} /> {prevRashi.name}
          </a>
          <a href={`/rashifal/${nextRashi.id}`} class="rashi-nav-btn" title={`${nextRashi.name} Rashifal`}>
            {nextRashi.name} <RashiIcon name={nextRashi.id} color="#fff" size={14} /> →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main content -->
  <section style="padding:40px 0 56px;">
    <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <div class="rd-layout">

        <!-- Left: Predictions -->
        <div class="rd-main">

          <!-- Period tabs -->
          <div style="display:flex;gap:4px;margin-bottom:24px;flex-wrap:wrap;">
            <button class="rp-tab active" data-period="daily" data-hi="📅 दैनिक">📅 Daily</button>
            <button class="rp-tab" data-period="weekly" data-hi="🗓️ साप्ताहिक">🗓️ Weekly</button>
            <button class="rp-tab" data-period="monthly" data-hi="📆 मासिक">📆 Monthly</button>
            <button class="rp-tab" data-period="yearly" data-hi="🌟 वार्षिक">🌟 Yearly</button>
          </div>

          <!-- Daily prediction -->
          <div class="rp-panel" data-period="daily">
            <div class="card" style="padding:28px;">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
                <span style="font-size:20px;">☀️</span>
                <div>
                  <p class="caption-mono" data-hi="दैनिक राशिफल" style="color:var(--color-mute);margin:0;">Daily Rashifal</p>
                  <p data-hi={dateLabelHi} style="font-size:13px;color:var(--color-body-text);margin:0;">{dateLabel}</p>
                </div>
              </div>
              <p style="font-size:16px;color:var(--color-body-text);line-height:1.8;margin:0;" data-hi={dailyHi}>{daily}</p>
            </div>
          </div>

          <!-- Weekly prediction -->
          <div class="rp-panel" data-period="weekly" hidden>
            <div class="card" style="padding:28px;">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
                <span style="font-size:20px;">🗓️</span>
                <div>
                  <p class="caption-mono" data-hi="साप्ताहिक राशिफल" style="color:var(--color-mute);margin:0;">Weekly Rashifal</p>
                  <p data-hi="वर्तमान सप्ताह का अवलोकन" style="font-size:13px;color:var(--color-body-text);margin:0;">Current week's overview</p>
                </div>
              </div>
              <p style="font-size:16px;color:var(--color-body-text);line-height:1.8;margin:0;" data-hi={weeklyHi}>{weekly}</p>
            </div>
          </div>

          <!-- Monthly prediction -->
          <div class="rp-panel" data-period="monthly" hidden>
            <div class="card" style="padding:28px;">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
                <span style="font-size:20px;">📆</span>
                <div>
                  <p class="caption-mono" data-hi="मासिक राशिफल" style="color:var(--color-mute);margin:0;">Monthly Rashifal</p>
                  <p data-hi={monthYearLabelHi} style="font-size:13px;color:var(--color-body-text);margin:0;">
                    {monthYearLabel}
                  </p>
                </div>
              </div>
              <p style="font-size:16px;color:var(--color-body-text);line-height:1.8;margin:0;" data-hi={monthlyHi}>{monthly}</p>
            </div>
          </div>

          <!-- Yearly prediction -->
          <div class="rp-panel" data-period="yearly" hidden>
            <div class="card" style="padding:28px;">
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
                <span style="font-size:20px;">🌟</span>
                <div>
                  <p class="caption-mono" data-hi="वार्षिक राशिफल" style="color:var(--color-mute);margin:0;">Yearly Rashifal</p>
                  <p data-hi={`${today.getFullYear()} अवलोकन`} style="font-size:13px;color:var(--color-body-text);margin:0;">{today.getFullYear()} Overview</p>
                </div>
              </div>
              <p style="font-size:16px;color:var(--color-body-text);line-height:1.8;margin:0;" data-hi={yearlyHi}>{yearly}</p>
            </div>
          </div>

          <!-- Prashnavali CTA -->
          <a href="/prashnavali" class="card" style="display:flex;align-items:center;gap:16px;padding:20px 24px;margin-top:12px;text-decoration:none;background:linear-gradient(135deg,var(--color-saffron-soft) 0%,var(--color-canvas) 100%);border:1px solid rgba(255,153,51,0.2);">
            <span style="font-size:32px;">🔮</span>
            <div>
              <p data-hi="प्रश्नावली दैवज्ञ से पूछें" style="font-size:14px;font-weight:600;color:var(--color-ink);margin:0 0 3px;">Ask the Prashnavali Oracle</p>
              <p data-hi="अपने गहनतम प्रश्न पर ध्यान केंद्रित करें और एक दिव्य लौकिक उत्तर प्राप्त करें" style="font-size:12.5px;color:var(--color-body-text);margin:0;">Focus on your deepest question and receive a divine cosmic answer</p>
            </div>
            <span data-hi="खोलें →" style="margin-left:auto;font-size:13px;font-weight:600;color:var(--color-saffron-deep);">Open →</span>
          </a>
        </div>

        <!-- Right sidebar: Rashi info -->
        <aside class="rd-sidebar">
          <!-- Rashi details -->
          <div class="card" style="padding:20px;margin-bottom:12px;">
            <p class="caption-mono" data-hi={`${rashi.name} · अवलोकन`} style="color:var(--color-mute);margin:0 0 16px;">{rashi.name} · Overview</p>
            <div class="rd-info-grid">
              <div class="rd-info-item">
                <span class="rd-info-label" data-hi="स्वामी ग्रह">Ruling Planet</span>
                <span class="rd-info-val">{rashi.lord} ({rashi.lordHi})</span>
              </div>
              <div class="rd-info-item">
                <span class="rd-info-label" data-hi="तत्व">Element</span>
                <span class="rd-info-val" data-hi={ELEMENT_HI[rashi.element] ?? rashi.element}>{rashi.element}</span>
              </div>
              <div class="rd-info-item">
                <span class="rd-info-label" data-hi="गुण">Quality</span>
                <span class="rd-info-val" data-hi={QUALITY_HI[rashi.quality] ?? rashi.quality}>{rashi.quality}</span>
              </div>
              <div class="rd-info-item">
                <span class="rd-info-label" data-hi="भाग्यशाली रंग">Lucky Color</span>
                <span class="rd-info-val" style="display:flex;align-items:center;gap:6px;">
                  <span style={`width:12px;height:12px;border-radius:50%;background:${rashi.luckyColorHex};flex-shrink:0;`}></span>
                  <span data-hi={rashi.luckyColorHi}>{rashi.luckyColor}</span>
                </span>
              </div>
              <div class="rd-info-item">
                <span class="rd-info-label" data-hi="भाग्यशाली अंक">Lucky Numbers</span>
                <span class="rd-info-val">{rashi.luckyNumbers.join(', ')}</span>
              </div>
              <div class="rd-info-item">
                <span class="rd-info-label" data-hi="भाग्यशाली दिन">Lucky Day</span>
                <span class="rd-info-val" data-hi={WD_HI_LONG[WD_EN_LONG.indexOf(rashi.luckyDay)]}>{rashi.luckyDay}</span>
              </div>
              <div class="rd-info-item">
                <span class="rd-info-label" data-hi="प्रतीक">Symbol</span>
                <span class="rd-info-val" style="display:flex;align-items:center;gap:5px;">
                  <RashiIcon name={rashi.id} size={14} /> <span data-hi={rashi.nameHi}>{rashi.english}</span>
                </span>
              </div>
              <div class="rd-info-item">
                <span class="rd-info-label" data-hi="नाम अक्षर">Name Letters</span>
                <span class="rd-info-val" style="font-size:11.5px;">{rashi.nameLetters.join(', ')}</span>
              </div>
            </div>
          </div>

          <!-- All 12 rashis quick nav -->
          <div class="card" style="padding:20px;">
            <p class="caption-mono" data-hi="सभी राशियाँ" style="color:var(--color-mute);margin:0 0 14px;">All Rashis</p>
            <div class="rd-rashi-nav">
              {allRashis.map(r => (
                <a
                  href={`/rashifal/${r.id}`}
                  class={`rd-rashi-link ${r.id === rashi.id ? 'rd-rashi-active' : ''}`}
                  title={r.english}
                >
                  <RashiIcon name={r.id} size={14} class="rd-rashi-sym" />
                  <span class="rd-rashi-nm en-text">{r.name}</span>
                  <span class="rd-rashi-nm hi-text" style="display:none;">{r.nameHi}</span>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

</Layout>

<script>
document.querySelectorAll<HTMLButtonElement>('.rp-tab').forEach(btn => {
  btn.addEventListener('click', () => {
    const period = btn.dataset.period ?? 'daily';
    document.querySelectorAll('.rp-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll<HTMLElement>('.rp-panel').forEach(p => {
      p.hidden = p.dataset.period !== period;
    });
  });
});

// ── Hindi UI coverage ──
// LanguagePicker.astro dispatches 'langchange' on document with { langCode }.
function applyPageLang(hindi: boolean) {
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
    if (!el.dataset.en) el.dataset.en = el.textContent || '';
    el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
  });
  document.querySelectorAll<HTMLElement>('.en-text').forEach(el => { el.style.display = hindi ? 'none' : ''; });
  document.querySelectorAll<HTMLElement>('.hi-text').forEach(el => { el.style.display = hindi ? '' : 'none'; });
}
document.addEventListener('langchange', (e: Event) => {
  const evt = e as CustomEvent;
  applyPageLang(evt.detail.langCode === 'hi');
});
if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>

<style>
.rd-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 24px;
  align-items: start;
}
.rd-sidebar { position: sticky; top: 100px; }

.rashi-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 6px 14px;
  background: rgba(255,255,255,0.15);
  color: #fff;
  border-radius: var(--radius-pill);
  font-size: 12.5px;
  font-weight: 600;
  text-decoration: none;
  transition: background 0.15s;
  -webkit-backdrop-filter: blur(4px);
  backdrop-filter: blur(4px);
  white-space: nowrap;
}
.rashi-nav-btn:hover { background: rgba(255,255,255,0.25); }

.rp-tab {
  height: 36px;
  padding: 0 16px;
  background: var(--color-canvas);
  border: 1px solid var(--color-hairline);
  border-radius: var(--radius-pill);
  font-family: var(--font-sans);
  font-size: 13px;
  font-weight: 500;
  color: var(--color-body-text);
  cursor: pointer;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
}
.rp-tab:hover { border-color: var(--color-saffron); color: var(--color-saffron-deep); }
.rp-tab.active { background: var(--color-ink); color: var(--color-on-primary); border-color: var(--color-ink); }

.rd-info-grid { display: flex; flex-direction: column; gap: 10px; }
.rd-info-item { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.rd-info-label { font-size: 11.5px; color: var(--color-mute); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.04em; }
.rd-info-val { font-size: 13px; color: var(--color-ink); font-weight: 500; text-align: right; }

.rd-rashi-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
.rd-rashi-link {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 8px;
  border-radius: var(--radius-sm);
  text-decoration: none;
  font-size: 12.5px;
  color: var(--color-body-text);
  transition: background 0.12s, color 0.12s;
}
.rd-rashi-link:hover { background: var(--color-canvas-soft-2); color: var(--color-ink); }
.rd-rashi-active { background: var(--color-saffron-soft) !important; color: var(--color-saffron-deep) !important; font-weight: 600; }
.rd-rashi-sym { flex-shrink: 0; }
.rd-rashi-nm { font-size: 12px; }

@media (max-width: 900px) {
  .rd-layout { grid-template-columns: 1fr; }
  .rd-sidebar { position: static; }
}
@media (max-width: 640px) {
  .rashi-nav-btn { display: none; }
}
</style>
