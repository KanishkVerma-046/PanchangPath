---
import Layout from '../../layouts/Layout.astro';
import { lahiriAyanamsha, julianDay, NAKSHATRAS } from '../../lib/panchang';
import { rahuLongitude } from '../../lib/astro-core';
import { RASHIS, houseFromMoon, classifyGochara, siderealNakshatraPada, formatDegMin } from '../../lib/kundali';
import { istWallClock } from '../../lib/ist-date';

// Build-time default: "now" (IST, matching the daily-rebuild cron's clock). This page is
// location-independent, so there's no "default city" concept — just a live snapshot,
// refreshed client-side every 60s. Uses the exact same houseFromMoon()/classifyGochara()/
// siderealNakshatraPada()/formatDegMin() the client <script> below calls, so server and
// client can never disagree — see CLAUDE.md's 2026-08-18 SEO-prerender rollout note.
// Positions come from the real build instant, read through its UTC fields exactly like the client
// <script>'s render(); the +05:30-shifted wall clock is only for the IST "Last updated" label.
const buildInstant = new Date();
const buildIst = istWallClock(buildInstant);
const buildJD = julianDay(buildInstant.getUTCFullYear(), buildInstant.getUTCMonth() + 1, buildInstant.getUTCDate(), buildInstant.getUTCHours() + buildInstant.getUTCMinutes() / 60);
const n360 = (a: number) => ((a % 360) + 360) % 360;
const buildAy = lahiriAyanamsha(buildJD);

const rahuTrop = rahuLongitude(buildJD);
const ketuTrop = n360(rahuTrop + 180);
const rahuSid = n360(rahuTrop - buildAy);
const ketuSid = n360(ketuTrop - buildAy);
const rahuSign = Math.floor(rahuSid / 30);
const ketuSign = Math.floor(ketuSid / 30);
const rahuNak = siderealNakshatraPada(rahuSid);
const ketuNak = siderealNakshatraPada(ketuSid);

const RK_CARDS = [
  { label: 'Rahu', sign: rahuSign, deg: rahuSid, nak: rahuNak, color: '#7c3aed' },
  { label: 'Ketu', sign: ketuSign, deg: ketuSid, nak: ketuNak, color: '#4338ca' },
];

const HOUSE_SUFFIX = (h: number) => h === 1 ? 'st' : h === 2 ? 'nd' : h === 3 ? 'rd' : 'th';

const rkRows = Array.from({ length: 12 }, (_, moonSign) => {
  const rahuHouse = houseFromMoon(moonSign, rahuSign);
  const ketuHouse = houseFromMoon(moonSign, ketuSign);
  return {
    moonSign,
    rahuHouse, ketuHouse,
    rahuCls: classifyGochara(rahuHouse, [3, 6, 11]),
    ketuCls: classifyGochara(ketuHouse, [3, 6, 11]),
  };
});
---

<Layout title="Rahu & Ketu Transit Today (2026) | PanchangPath" description="Live sidereal position of Rahu and Ketu today, the Dec 2026 sign change into Capricorn/Cancer, and the classical Gochara table for all 12 Moon signs.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" style="display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--color-mute);text-decoration:none;">
        <span class="arrow-chip"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></span>
        <span data-hi="ज्योतिष उपकरण">Jyotish Tools</span>
      </a>
      <p class="eyebrow reveal" style="margin:12px 0 8px;">राहु · केतु · Rahu &amp; Ketu</p>
      <h1 class="reveal" data-hi="राहु और केतु गोचर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;transition-delay:60ms;">Rahu &amp; Ketu Transit</h1>
      <p class="reveal" data-hi="राहु और केतु चंद्र-पात हैं — वे छाया बिंदु जहां चंद्रमा की कक्षा क्रांतिवृत्त को काटती है, हमेशा ठीक 180° दूरी पर। नीचे लाइव सायन स्थिति, साथ ही चंद्र राशि के अनुसार शास्त्रीय गोचर अनुकूल/प्रतिकूल तालिका।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:540px;transition-delay:120ms;">Rahu and Ketu are the lunar nodes — shadow points where the Moon's orbit crosses the ecliptic, always exactly 180° apart. Live sidereal position below, plus the classical Gochara (transit) favorable/challenging table by Moon sign.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container">
      <p id="rk-updated" style="font-size:11px;color:var(--color-mute);font-family:var(--font-mono);margin:0 0 16px;">Last updated: {buildIst.toLocaleTimeString('en-IN', { timeZone: 'UTC' })} (auto-refreshes every 60s)</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;margin-bottom:36px;" id="rk-current">
        {RK_CARDS.map(p => (
          <div class="card" style="padding:20px;">
            <p style={`font-size:14px;font-weight:700;color:${p.color};margin:0 0 6px;`}>{p.label}</p>
            <p style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">{RASHIS[p.sign].name} ({RASHIS[p.sign].en})</p>
            <p style="font-size:12px;color:var(--color-mute);margin:0;font-family:var(--font-mono);">{formatDegMin(p.deg)} · {NAKSHATRAS[p.nak.idx].name} Pada {p.nak.pada}</p>
          </div>
        ))}
      </div>

      <h3 data-hi="चंद्र राशि के अनुसार गोचर प्रभाव" style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 6px;">Gochara (Transit) Effect by Moon Sign</h3>
      <p data-hi="शास्त्रीय वैदिक गोचर सिद्धांत: राहु और केतु आपकी जन्म चंद्र राशि से गिनकर तीसरे, छठे, या ग्यारहवें भाव ('उपचय' भाव) से गोचर करते समय अनुकूल परिणाम देते हैं। अन्य सभी स्थितियां अधिक चुनौतीपूर्ण मानी जाती हैं।" style="font-size:12px;color:var(--color-mute);margin:0 0 14px;max-width:600px;">Classical Vedic transit theory: Rahu and Ketu give favorable results when transiting the 3rd, 6th, or 11th house counted from your natal Moon sign (the "Upachaya" houses). All other positions are considered more challenging.</p>
      <div class="bezel-outer reveal">
       <div class="bezel-inner" style="padding:20px;overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;" id="rk-table">
          <thead><tr>
            <th data-hi="आपकी चंद्र राशि" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Your Moon Sign</th>
            <th data-hi="राहु का भाव" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Rahu's House</th>
            <th data-hi="राहु प्रभाव" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Rahu Effect</th>
            <th data-hi="केतु का भाव" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Ketu's House</th>
            <th data-hi="केतु प्रभाव" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Ketu Effect</th>
          </tr></thead>
          <tbody id="rk-body">
            {rkRows.map(r => (
              <tr>
                <td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-ink);font-weight:600;">{RASHIS[r.moonSign].name} ({RASHIS[r.moonSign].en})</td>
                <td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">{r.rahuHouse}{HOUSE_SUFFIX(r.rahuHouse)} house</td>
                <td style={`padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${r.rahuCls.cls==='favorable'?'#15803d':'#dc2626'};font-weight:600;`}>{r.rahuCls.label}</td>
                <td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">{r.ketuHouse}{HOUSE_SUFFIX(r.ketuHouse)} house</td>
                <td style={`padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${r.ketuCls.cls==='favorable'?'#15803d':'#dc2626'};font-weight:600;`}>{r.ketuCls.label}</td>
              </tr>
            ))}
          </tbody>
        </table>
       </div>
      </div>

      <div class="card" style="padding:20px;margin-top:20px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;">
        <p data-hi="राहु का अगला राशि परिवर्तन: दिसंबर 2026 में राहु मकर और केतु कर्क राशि में प्रवेश करेंगे।" style="font-size:13px;color:var(--color-body-text);margin:0;">Rahu's next sign change: Rahu enters Capricorn and Ketu enters Cancer in December 2026.</p>
        <a href="/events/rahu-enters-makara-2026-12" style="display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:var(--color-saffron-deep);white-space:nowrap;text-decoration:none;">
          <span data-hi="विवरण देखें">View transit details</span>
          <span class="arrow-chip"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></span>
        </a>
      </div>
      <div class="card" style="padding:20px;margin-top:12px;display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;">
        <p data-hi="जब राहु और केतु आपकी कुंडली के सभी ग्रहों को दोनों ओर से घेर लेते हैं, तो कालसर्प योग बनता है — अपनी कुंडली जांचें।" style="font-size:13px;color:var(--color-body-text);margin:0;">When Rahu and Ketu hem in all other planets on either side, it forms Kalasarpa Yoga — check your own birth chart.</p>
        <a href="/jyotish/kalasarpa" data-hi="कालसर्प योग जांचें →" style="font-size:13px;font-weight:600;color:var(--color-saffron-deep);white-space:nowrap;text-decoration:none;">Check Kalasarpa Yoga →</a>
      </div>
    </div>
  </section>
</Layout>

<script>
import { lahiriAyanamsha, julianDay, NAKSHATRAS } from '../../lib/panchang';
import { rahuLongitude } from '../../lib/astro-core';
import { RASHIS, houseFromMoon, classifyGochara, siderealNakshatraPada, formatDegMin } from '../../lib/kundali';

const n360=(a:number)=>((a%360)+360)%360;
function trRashi(i:number){return hindiActive?RASHIS[i].nameHi:RASHIS[i].name;}
function trNak(i:number){return hindiActive?NAKSHATRAS[i].nameHi:NAKSHATRAS[i].name;}
function classify(house:number){ return classifyGochara(house,[3,6,11]); }
const HOUSE_ORDINAL_HI=['पहला','दूसरा','तीसरा','चौथा','पांचवां','छठा','सातवां','आठवां','नौवां','दसवां','ग्यारहवां','बारहवां'];
function houseLabel(house:number,hindi:boolean){
  if(hindi) return HOUSE_ORDINAL_HI[house-1]+' भाव';
  const suffix=house===1?'st':house===2?'nd':house===3?'rd':'th';
  return house+suffix+' house';
}

let hindiActive=false;

function render(){
  const now=new Date();
  const jd=julianDay(now.getUTCFullYear(),now.getUTCMonth()+1,now.getUTCDate(),now.getUTCHours()+now.getUTCMinutes()/60);
  const ay=lahiriAyanamsha(jd);
  const rahuTrop=rahuLongitude(jd);
  const ketuTrop=n360(rahuTrop+180);
  const rahuSid=n360(rahuTrop-ay);
  const ketuSid=n360(ketuTrop-ay);
  const rahuSign=Math.floor(rahuSid/30);
  const ketuSign=Math.floor(ketuSid/30);
  const rahuNak=siderealNakshatraPada(rahuSid);
  const ketuNak=siderealNakshatraPada(ketuSid);

  const updatedEl=document.getElementById('rk-updated');
  if(updatedEl)updatedEl.textContent=(hindiActive?'अंतिम अद्यतन: ':'Last updated: ')+now.toLocaleTimeString()+(hindiActive?' (हर 60 सेकंड में स्वतः अपडेट)':' (auto-refreshes every 60s)');

  const curEl=document.getElementById('rk-current');
  if(curEl){
    curEl.innerHTML=[
      {label:hindiActive?'राहु':'Rahu',sign:rahuSign,deg:rahuSid,nak:rahuNak,color:'#7c3aed'},
      {label:hindiActive?'केतु':'Ketu',sign:ketuSign,deg:ketuSid,nak:ketuNak,color:'#4338ca'},
    ].map(p=>`<div class="card" style="padding:20px;"><p style="font-size:14px;font-weight:700;color:${p.color};margin:0 0 6px;">${p.label}</p><p style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">${trRashi(p.sign)} (${RASHIS[p.sign].en})</p><p style="font-size:12px;color:var(--color-mute);margin:0;font-family:var(--font-mono);">${formatDegMin(p.deg)} · ${trNak(p.nak.idx)} Pada ${p.nak.pada}</p></div>`).join('');
  }

  let rows='';
  for(let moonSign=0;moonSign<12;moonSign++){
    const rahuHouse=houseFromMoon(moonSign,rahuSign);
    const ketuHouse=houseFromMoon(moonSign,ketuSign);
    const rahuCls=classify(rahuHouse);
    const ketuCls=classify(ketuHouse);
    const rahuLabel=hindiActive?(rahuCls.cls==='favorable'?'अनुकूल':'प्रतिकूल'):rahuCls.label;
    const ketuLabel=hindiActive?(ketuCls.cls==='favorable'?'अनुकूल':'प्रतिकूल'):ketuCls.label;
    rows+=`<tr><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-ink);font-weight:600;">${trRashi(moonSign)} (${RASHIS[moonSign].en})</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">${houseLabel(rahuHouse,hindiActive)}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${rahuCls.cls==='favorable'?'#15803d':'#dc2626'};font-weight:600;">${rahuLabel}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">${houseLabel(ketuHouse,hindiActive)}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${ketuCls.cls==='favorable'?'#15803d':'#dc2626'};font-weight:600;">${ketuLabel}</td></tr>`;
  }
  const body=document.getElementById('rk-body');
  if(body)body.innerHTML=rows;
}

render();
setInterval(render,60000);

function applyPageLang(hindi:boolean){
  hindiActive=hindi;
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el=>{
    if(!el.dataset.en) el.dataset.en=el.textContent||'';
    el.textContent=hindi?(el.dataset.hi as string):(el.dataset.en as string);
  });
  render();
}
document.addEventListener('langchange',(e:Event)=>{
  applyPageLang((e as CustomEvent).detail.langCode==='hi');
});
if(localStorage.getItem('pp-lang')==='hi') applyPageLang(true);
</script>
