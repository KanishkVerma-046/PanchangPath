---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Rahu & Ketu Transit Today — PanchangPath" description="Live sidereal position of Rahu and Ketu, plus the classical Gochara (transit) favorable/challenging table for all 12 Moon-sign rashis.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">राहु · केतु · RAHU &amp; KETU</p>
      <h1 data-hi="राहु और केतु गोचर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Rahu &amp; Ketu Transit</h1>
      <p data-hi="राहु और केतु चंद्र-पात हैं — वे छाया बिंदु जहां चंद्रमा की कक्षा क्रांतिवृत्त को काटती है, हमेशा ठीक 180° दूरी पर। नीचे लाइव सायन स्थिति, साथ ही चंद्र राशि के अनुसार शास्त्रीय गोचर अनुकूल/प्रतिकूल तालिका।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:540px;">Rahu and Ketu are the lunar nodes — shadow points where the Moon's orbit crosses the ecliptic, always exactly 180° apart. Live sidereal position below, plus the classical Gochara (transit) favorable/challenging table by Moon sign.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container">
      <p id="rk-updated" style="font-size:11px;color:var(--color-mute);font-family:var(--font-mono);margin:0 0 16px;"></p>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;margin-bottom:36px;" id="rk-current"></div>

      <h3 data-hi="चंद्र राशि के अनुसार गोचर प्रभाव" style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 6px;">Gochara (Transit) Effect by Moon Sign</h3>
      <p data-hi="शास्त्रीय वैदिक गोचर सिद्धांत: राहु और केतु आपकी जन्म चंद्र राशि से गिनकर तीसरे, छठे, या ग्यारहवें भाव ('उपचय' भाव) से गोचर करते समय अनुकूल परिणाम देते हैं। अन्य सभी स्थितियां अधिक चुनौतीपूर्ण मानी जाती हैं।" style="font-size:12px;color:var(--color-mute);margin:0 0 14px;max-width:600px;">Classical Vedic transit theory: Rahu and Ketu give favorable results when transiting the 3rd, 6th, or 11th house counted from your natal Moon sign (the "Upachaya" houses). All other positions are considered more challenging.</p>
      <div class="card" style="padding:20px;overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;" id="rk-table">
          <thead><tr>
            <th data-hi="आपकी चंद्र राशि" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Your Moon Sign</th>
            <th data-hi="राहु का भाव" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Rahu's House</th>
            <th data-hi="राहु प्रभाव" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Rahu Effect</th>
            <th data-hi="केतु का भाव" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Ketu's House</th>
            <th data-hi="केतु प्रभाव" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Ketu Effect</th>
          </tr></thead>
          <tbody id="rk-body"></tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>

<script>
import { lahiriAyanamsha } from '../../lib/panchang';
import { rahuLongitude } from '../../lib/astro-core';

const n360=(a:number)=>((a%360)+360)%360;
function toJD(y:number,m:number,d:number,h=0){
  if(m<=2){y--;m+=12;}
  const A=Math.floor(y/100),B=2-A+Math.floor(A/4);
  return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;
}
const RASHI=['Mesha','Vrishabha','Mithuna','Karka','Simha','Kanya','Tula','Vrishchika','Dhanu','Makara','Kumbha','Meena'];
const RASHI_EN=['Aries','Taurus','Gemini','Cancer','Leo','Virgo','Libra','Scorpio','Sagittarius','Capricorn','Aquarius','Pisces'];
const NAKS=['Ashwini','Bharani','Krittika','Rohini','Mrigashira','Ardra','Punarvasu','Pushya','Ashlesha','Magha','Purva Phalguni','Uttara Phalguni','Hasta','Chitra','Swati','Vishakha','Anuradha','Jyeshtha','Mula','Purva Ashadha','Uttara Ashadha','Shravana','Dhanishtha','Shatabhisha','Purva Bhadrapada','Uttara Bhadrapada','Revati'];
function fmtDMS(lon:number){const d=lon%30;const deg=Math.floor(d);const mn=Math.floor((d-deg)*60);return deg+'°'+String(mn).padStart(2,'0')+"'";}
function nakInfo(sid:number){const idx=Math.floor(sid/(360/27))%27;const pada=Math.floor((sid%(360/27))/((360/27)/4))+1;return {name:NAKS[idx],pada};}

// Classical Gochara ruleset — cross-verified against independent sources during planning (see plan Global Constraints). Do not modify without re-verifying.
const FAVORABLE_HOUSES=[3,6,11];
function houseFromMoon(moonSignIdx:number,planetSignIdx:number){
  return ((planetSignIdx-moonSignIdx+12)%12)+1;
}
function classify(house:number){
  return FAVORABLE_HOUSES.includes(house) ? {label:'Favorable',cls:'favorable'} : {label:'Challenging',cls:'challenging'};
}
const HOUSE_ORDINAL_HI=['पहला','दूसरा','तीसरा','चौथा','पांचवां','छठा','सातवां','आठवां','नौवां','दसवां','ग्यारहवां','बारहवां'];
function houseLabel(house:number,hindi:boolean){
  if(hindi) return HOUSE_ORDINAL_HI[house-1]+' भाव';
  const suffix=house===1?'st':house===2?'nd':house===3?'rd':'th';
  return house+suffix+' house';
}

let hindiActive=false;

function render(){
  const now=new Date();
  const jd=toJD(now.getUTCFullYear(),now.getUTCMonth()+1,now.getUTCDate(),now.getUTCHours()+now.getUTCMinutes()/60);
  const ay=lahiriAyanamsha(jd);
  const rahuTrop=rahuLongitude(jd);
  const ketuTrop=n360(rahuTrop+180);
  const rahuSid=n360(rahuTrop-ay);
  const ketuSid=n360(ketuTrop-ay);
  const rahuSign=Math.floor(rahuSid/30);
  const ketuSign=Math.floor(ketuSid/30);
  const rahuNak=nakInfo(rahuSid);
  const ketuNak=nakInfo(ketuSid);

  const updatedEl=document.getElementById('rk-updated');
  if(updatedEl)updatedEl.textContent=(hindiActive?'अंतिम अद्यतन: ':'Last updated: ')+now.toLocaleTimeString()+(hindiActive?' (हर 60 सेकंड में स्वतः अपडेट)':' (auto-refreshes every 60s)');

  const curEl=document.getElementById('rk-current');
  if(curEl){
    curEl.innerHTML=[
      {label:hindiActive?'राहु':'Rahu',sign:rahuSign,deg:rahuSid,nak:rahuNak,color:'#7c3aed'},
      {label:hindiActive?'केतु':'Ketu',sign:ketuSign,deg:ketuSid,nak:ketuNak,color:'#4338ca'},
    ].map(p=>`<div class="card" style="padding:20px;"><p style="font-size:14px;font-weight:700;color:${p.color};margin:0 0 6px;">${p.label}</p><p style="font-size:18px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">${RASHI[p.sign]} (${RASHI_EN[p.sign]})</p><p style="font-size:12px;color:var(--color-mute);margin:0;font-family:var(--font-mono);">${fmtDMS(p.deg)} · ${p.nak.name} Pada ${p.nak.pada}</p></div>`).join('');
  }

  let rows='';
  for(let moonSign=0;moonSign<12;moonSign++){
    const rahuHouse=houseFromMoon(moonSign,rahuSign);
    const ketuHouse=houseFromMoon(moonSign,ketuSign);
    const rahuCls=classify(rahuHouse);
    const ketuCls=classify(ketuHouse);
    const rahuLabel=hindiActive?(rahuCls.cls==='favorable'?'अनुकूल':'प्रतिकूल'):rahuCls.label;
    const ketuLabel=hindiActive?(ketuCls.cls==='favorable'?'अनुकूल':'प्रतिकूल'):ketuCls.label;
    rows+=`<tr><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-ink);font-weight:600;">${RASHI[moonSign]} (${RASHI_EN[moonSign]})</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">${houseLabel(rahuHouse,hindiActive)}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${rahuCls.cls==='favorable'?'#15803d':'#dc2626'};font-weight:600;">${rahuLabel}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">${houseLabel(ketuHouse,hindiActive)}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${ketuCls.cls==='favorable'?'#15803d':'#dc2626'};font-weight:600;">${ketuLabel}</td></tr>`;
  }
  const body=document.getElementById('rk-body');
  if(body)body.innerHTML=rows;
}

render();
setInterval(render,60000);

function applyPageLang(hindi:boolean){
  hindiActive=hindi;
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el=>{
    if(!el.dataset.en) el.dataset.en=el.textContent||'';
    el.textContent=hindi?(el.dataset.hi as string):(el.dataset.en as string);
  });
  render();
}
document.addEventListener('langchange',(e:Event)=>{
  applyPageLang((e as CustomEvent).detail.langCode==='hi');
});
if(localStorage.getItem('pp-lang')==='hi') applyPageLang(true);
</script>
