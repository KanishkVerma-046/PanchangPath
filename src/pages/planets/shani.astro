---
import Layout from '../../layouts/Layout.astro';
import { lahiriAyanamsha, julianDay, NAKSHATRAS } from '../../lib/panchang';
import { planetLongitude } from '../../lib/astro-core';
import { RASHIS, houseFromMoon, classifyShaniGochara, siderealNakshatraPada, formatDegMin } from '../../lib/kundali';

// Build-time default: "now" (IST, matching the daily-rebuild cron's clock). This page is
// location-independent, so there's no "default city" concept — just a live snapshot,
// refreshed client-side every 60s. Uses the exact same houseFromMoon()/classifyShaniGochara()/
// siderealNakshatraPada()/formatDegMin() the client <script> below calls, so server and
// client can never disagree — see CLAUDE.md's 2026-08-18 SEO-prerender rollout note.
const IST_OFFSET_MS = 5.5 * 60 * 60 * 1000;
const buildNow = new Date(Date.now() + IST_OFFSET_MS);
const buildJD = julianDay(buildNow.getUTCFullYear(), buildNow.getUTCMonth() + 1, buildNow.getUTCDate(), buildNow.getUTCHours() + buildNow.getUTCMinutes() / 60);
const n360 = (a: number) => ((a % 360) + 360) % 360;
const buildAy = lahiriAyanamsha(buildJD);

const saturnSid = n360(planetLongitude('saturn', buildJD) - buildAy);
const saturnSign = Math.floor(saturnSid / 30);
const saturnNak = siderealNakshatraPada(saturnSid);

const shRows = Array.from({ length: 12 }, (_, moonSign) => ({
  moonSign,
  house: houseFromMoon(moonSign, saturnSign),
  effect: classifyShaniGochara(houseFromMoon(moonSign, saturnSign)),
}));
const HOUSE_SUFFIX = (h: number) => h === 1 ? 'st' : h === 2 ? 'nd' : h === 3 ? 'rd' : 'th';
const shColor = (cls: string) => cls === 'favorable' ? '#15803d' : cls === 'challenging' ? '#dc2626' : 'var(--color-body-text)';
---

<Layout title="Shani (Saturn) Transit Today — Sade Sati Table — PanchangPath" description="Live sidereal position of Saturn plus the classical Sade Sati / Ashtam Shani / favorable transit table for all 12 Moon-sign rashis.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" data-hi="← ज्योतिष उपकरण" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Jyotish Tools</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">शनि · SHANI (SATURN)</p>
      <h1 data-hi="शनि गोचर" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Shani (Saturn) Transit</h1>
      <p style="font-size:15px;color:var(--color-body-text);margin:0;max-width:540px;"><span data-hi="शनि की लाइव सायन स्थिति, साथ ही चंद्र राशि के अनुसार शास्त्रीय साढ़े साती और अष्टम शनि गोचर तालिका। अपनी जन्म कुंडली के विरुद्ध व्यक्तिगत साढ़े साती चरण जांच के लिए,">Live sidereal position of Saturn, plus the classical Sade Sati and Ashtam Shani transit table by Moon sign. For a personalized Sade Sati phase check against your own birth chart, use the</span> <a href="/jyotish/sadesati" data-hi="शनि साढ़े साती कैलकुलेटर" style="color:var(--color-saffron-deep,#d97706);">Shani Sadesati Calculator</a><span data-hi="का उपयोग करें।">.</span></p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container">
      <p id="sh-updated" style="font-size:11px;color:var(--color-mute);font-family:var(--font-mono);margin:0 0 16px;">Last updated: {buildNow.toLocaleTimeString('en-IN')} (auto-refreshes every 60s)</p>
      <div class="card" style="padding:20px;max-width:320px;margin-bottom:36px;" id="sh-current">
        <p style="font-size:14px;font-weight:700;color:#374151;margin:0 0 6px;">Shani (Saturn)</p>
        <p style="font-size:20px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">{RASHIS[saturnSign].name} ({RASHIS[saturnSign].en})</p>
        <p style="font-size:12px;color:var(--color-mute);margin:0;font-family:var(--font-mono);">{formatDegMin(saturnSid)} · {NAKSHATRAS[saturnNak.idx].name} Pada {saturnNak.pada}</p>
      </div>

      <h3 data-hi="चंद्र राशि के अनुसार शनि गोचर प्रभाव" style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 6px;">Saturn Gochara (Transit) Effect by Moon Sign</h3>
      <p data-hi="साढ़े साती (आपकी चंद्र राशि से 12वें, 1ले, 2रे भाव) 7.5 वर्ष का प्रसिद्ध शनि गोचर चक्र है। अष्टम शनि (8वां भाव) भी विशेष रूप से चुनौतीपूर्ण माना जाता है। भाव 3, 6, और 11 अनुकूल हैं ('उपचय'); शेष तटस्थ हैं।" style="font-size:12px;color:var(--color-mute);margin:0 0 14px;max-width:600px;">Sade Sati (houses 12, 1, 2 from your Moon sign) is the well-known 7.5-year Saturn transit cycle. Ashtam Shani (house 8) is also considered particularly challenging. Houses 3, 6, and 11 are favorable ("Upachaya"); the rest are neutral.</p>
      <div class="card" style="padding:20px;overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;" id="sh-table">
          <thead><tr>
            <th data-hi="आपकी चंद्र राशि" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Your Moon Sign</th>
            <th data-hi="शनि का भाव" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Saturn's House</th>
            <th data-hi="प्रभाव" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Effect</th>
          </tr></thead>
          <tbody id="sh-body">
            {shRows.map(r => (
              <tr>
                <td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-ink);font-weight:600;">{RASHIS[r.moonSign].name} ({RASHIS[r.moonSign].en})</td>
                <td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">{r.house}{HOUSE_SUFFIX(r.house)} house</td>
                <td style={`padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${shColor(r.effect.cls)};font-weight:600;`}>{r.effect.label}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>

<script>
import { lahiriAyanamsha, julianDay, NAKSHATRAS } from '../../lib/panchang';
import { planetLongitude } from '../../lib/astro-core';
import { RASHIS, houseFromMoon, classifyShaniGochara, siderealNakshatraPada, formatDegMin } from '../../lib/kundali';

const n360=(a:number)=>((a%360)+360)%360;
function trRashi(i:number){return hindiActive?RASHIS[i].nameHi:RASHIS[i].name;}
function trNak(i:number){return hindiActive?NAKSHATRAS[i].nameHi:NAKSHATRAS[i].name;}
function classifyShani(house:number){ return classifyShaniGochara(house); }
const SHANI_LABEL_HI:any={'Sade Sati':'साढ़े साती','Ashtam Shani':'अष्टम शनि','Favorable':'अनुकूल','Neutral':'तटस्थ'};
const HOUSE_ORDINAL_HI=['पहला','दूसरा','तीसरा','चौथा','पांचवां','छठा','सातवां','आठवां','नौवां','दसवां','ग्यारहवां','बारहवां'];
function houseLabel(house:number,hindi:boolean){
  if(hindi) return HOUSE_ORDINAL_HI[house-1]+' भाव';
  const suffix=house===1?'st':house===2?'nd':house===3?'rd':'th';
  return house+suffix+' house';
}

let hindiActive=false;

function render(){
  const now=new Date();
  const jd=julianDay(now.getUTCFullYear(),now.getUTCMonth()+1,now.getUTCDate(),now.getUTCHours()+now.getUTCMinutes()/60);
  const ay=lahiriAyanamsha(jd);
  const saturnTrop=planetLongitude('saturn',jd);
  const saturnSid=n360(saturnTrop-ay);
  const saturnSign=Math.floor(saturnSid/30);
  const nak=siderealNakshatraPada(saturnSid);

  const updatedEl=document.getElementById('sh-updated');
  if(updatedEl)updatedEl.textContent=(hindiActive?'अंतिम अद्यतन: ':'Last updated: ')+now.toLocaleTimeString()+(hindiActive?' (हर 60 सेकंड में स्वतः अपडेट)':' (auto-refreshes every 60s)');

  const curEl=document.getElementById('sh-current');
  if(curEl){
    const shaniName=hindiActive?'शनि':'Shani (Saturn)';
    curEl.innerHTML=`<p style="font-size:14px;font-weight:700;color:#374151;margin:0 0 6px;">${shaniName}</p><p style="font-size:20px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">${trRashi(saturnSign)} (${RASHIS[saturnSign].en})</p><p style="font-size:12px;color:var(--color-mute);margin:0;font-family:var(--font-mono);">${formatDegMin(saturnSid)} · ${trNak(nak.idx)} Pada ${nak.pada}</p>`;
  }

  let rows='';
  for(let moonSign=0;moonSign<12;moonSign++){
    const house=houseFromMoon(moonSign,saturnSign);
    const c=classifyShani(house);
    const color=c.cls==='favorable'?'#15803d':c.cls==='challenging'?'#dc2626':'var(--color-body-text)';
    const label=hindiActive?SHANI_LABEL_HI[c.label]:c.label;
    rows+=`<tr><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-ink);font-weight:600;">${trRashi(moonSign)} (${RASHIS[moonSign].en})</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">${houseLabel(house,hindiActive)}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${color};font-weight:600;">${label}</td></tr>`;
  }
  const body=document.getElementById('sh-body');
  if(body)body.innerHTML=rows;
}

render();
setInterval(render,60000);

function applyPageLang(hindi:boolean){
  hindiActive=hindi;
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el=>{
    if(!el.dataset.en) el.dataset.en=el.textContent||'';
    el.textContent=hindi?(el.dataset.hi as string):(el.dataset.en as string);
  });
  render();
}
document.addEventListener('langchange',(e:Event)=>{
  applyPageLang((e as CustomEvent).detail.langCode==='hi');
});
if(localStorage.getItem('pp-lang')==='hi') applyPageLang(true);
</script>
