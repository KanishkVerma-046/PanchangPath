---
import Layout from '../../layouts/Layout.astro';
import { calculateKundali, siderealNakshatraPada, formatDegMin, RASHIS } from '../../lib/kundali';
import { NAKSHATRAS } from '../../lib/panchang';
import { istWallClock } from '../../lib/ist-date';

// Build-time default: "now" (IST, matching the daily-rebuild cron's clock). This page is
// location-independent (graha longitudes don't depend on an observer's lat/lng), so there's
// no "default city" concept here — just a live snapshot, refreshed client-side every 60s.
// calculateKundali() is the exact same function the client <script> below calls; lat/lng/tz
// are passed as 0 because only .grahas is used here, never .lagna (which is the only field
// they'd affect) — see CLAUDE.md's 2026-08-18 SEO-prerender rollout note.
// Positions come from the real build instant, exactly like the client <script>'s render(); the
// +05:30-shifted wall clock is only for the IST "Last updated" label.
const buildInstant = new Date();
const buildIst = istWallClock(buildInstant);
const initKundali = calculateKundali(buildInstant, 0, 0, 0);

const PLANET_SIGNIFICANCE: Record<string, { full: string; desc: string; nameHi: string; descHi: string }> = {
  surya:   { full: 'Surya (Sun)', desc: 'Soul, vitality, self-confidence, authority, father, government service, and overall health.', nameHi: 'सूर्य', descHi: 'आत्मा, जीवन शक्ति, आत्मविश्वास, अधिकार, पिता, सरकारी सेवा, और समग्र स्वास्थ्य।' },
  chandra: { full: 'Chandra (Moon)', desc: 'Mind, emotions, intuition, mother, and the emotional core used for daily Rashifal and Muhurta decisions.', nameHi: 'चंद्रमा', descHi: 'मन, भावनाएं, अंतर्ज्ञान, माता, और दैनिक राशिफल व मुहूर्त निर्णयों में प्रयुक्त भावनात्मक केंद्र।' },
  mangal:  { full: 'Mangal (Mars)', desc: 'Energy, courage, siblings, land and property, conflict, and drive to take action.', nameHi: 'मंगल', descHi: 'ऊर्जा, साहस, भाई-बहन, भूमि व संपत्ति, संघर्ष, और कार्य करने की प्रेरणा।' },
  budha:   { full: 'Budha (Mercury)', desc: 'Intellect, communication, business acumen, education, and analytical skill.', nameHi: 'बुध', descHi: 'बुद्धि, संचार, व्यावसायिक कुशलता, शिक्षा, और विश्लेषणात्मक क्षमता।' },
  guru:    { full: 'Guru (Jupiter)', desc: 'Wisdom, wealth, children, spirituality, teachers, and expansion or growth.', nameHi: 'गुरु', descHi: 'ज्ञान, धन, संतान, आध्यात्मिकता, गुरुजन, और विस्तार या विकास।' },
  shukra:  { full: 'Shukra (Venus)', desc: 'Love, marriage, beauty, luxury, art, and relationships.', nameHi: 'शुक्र', descHi: 'प्रेम, विवाह, सौंदर्य, विलासिता, कला, और रिश्ते।' },
  shani:   { full: 'Shani (Saturn)', desc: 'Discipline, longevity, hard work, career, delays, and karmic lessons.', nameHi: 'शनि', descHi: 'अनुशासन, दीर्घायु, कठोर परिश्रम, करियर, विलंब, और कर्म संबंधी सीख।' },
  rahu:    { full: 'Rahu', desc: 'Worldly desire, obsession, foreign connections, sudden change, and illusion.', nameHi: 'राहु', descHi: 'सांसारिक इच्छा, जुनून, विदेशी संबंध, अचानक परिवर्तन, और भ्रम।' },
  ketu:    { full: 'Ketu', desc: 'Detachment, spirituality, past-life karma, and liberation.', nameHi: 'केतु', descHi: 'वैराग्य, आध्यात्मिकता, पूर्वजन्म का कर्म, और मोक्ष।' },
};

const initRows = initKundali.grahas.map(g => {
  const nak = siderealNakshatraPada(g.siderealLon);
  return { g, nak: NAKSHATRAS[nak.idx], pada: nak.pada, sig: PLANET_SIGNIFICANCE[g.id] };
});
---

<Layout title="Planetary Positions Today (Graha Sphuta) | PanchangPath" description="Live sidereal positions of all 9 grahas (Sun to Ketu) with sign, nakshatra, degree, retrograde and combustion status, computed with Lahiri ayanamsha.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" style="display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--color-mute);text-decoration:none;">
        <span class="arrow-chip"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></span>
        <span data-hi="ज्योतिष उपकरण">Jyotish Tools</span>
      </a>
      <p class="eyebrow reveal" style="margin:12px 0 8px;">ग्रह स्फुट · Planetary Positions</p>
      <h1 class="reveal" data-hi="आज की ग्रह स्थिति" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;transition-delay:60ms;">Planetary Positions Today</h1>
      <p class="reveal" data-hi="सभी 9 ग्रहों की लाइव सायन (लाहिड़ी अयनांश) स्थिति, वास्तविक केप्लेरियन कक्षीय यांत्रिकी से पुनर्गणित — इस साइट के कुंडली जनरेटर के पीछे वही इंजन। ग्रहों की गति के साथ स्वतः अपडेट होता है।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:540px;transition-delay:120ms;">Live sidereal (Lahiri ayanamsha) positions of all 9 grahas, recomputed from real Keplerian orbital mechanics — the same engine behind this site's Kundali generator. Updates automatically as the planets move.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container">
      <p id="pp-updated" style="font-size:11px;color:var(--color-mute);font-family:var(--font-mono);margin:0 0 16px;">Last updated: {buildIst.toLocaleTimeString('en-IN', { timeZone: 'UTC' })} (auto-refreshes every 60s)</p>
      <div class="bezel-outer reveal" style="margin-bottom:32px;">
       <div class="bezel-inner" style="padding:20px;overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;" id="pp-table">
          <thead><tr>
            <th data-hi="ग्रह" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Graha</th>
            <th data-hi="राशि" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Rashi</th>
            <th data-hi="अंश" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Degree</th>
            <th data-hi="नक्षत्र" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Nakshatra</th>
            <th data-hi="पद" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Pada</th>
            <th data-hi="गति" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Motion</th>
            <th data-hi="अस्त/उदित" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Combustion</th>
          </tr></thead>
          <tbody id="pp-body">
            {initRows.map(({ g, nak, pada, sig }) => (
              <tr>
                <td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-ink);font-weight:600;">{sig.full}</td>
                <td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">{g.signName} ({RASHIS[g.sign].en})</td>
                <td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);font-family:var(--font-mono);">{formatDegMin(g.siderealLon)}</td>
                <td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">{nak.name}</td>
                <td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">{pada}</td>
                <td style={`padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${g.isRetrograde ? '#dc2626' : 'var(--color-body-text)'};`}>{g.isRetrograde ? 'Retrograde' : 'Direct'}</td>
                <td style={`padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${g.isCombust ? '#dc2626' : 'var(--color-body-text)'};`}>{(g.id === 'surya' || g.id === 'rahu' || g.id === 'ketu') ? '—' : (g.isCombust ? 'Asta (Combust)' : 'Udita')}</td>
              </tr>
            ))}
          </tbody>
        </table>
       </div>
      </div>

      <h2 data-hi="प्रत्येक ग्रह का अर्थ" style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">What Each Graha Signifies</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;" id="pp-significations">
        {initRows.map(({ g, sig }) => (
          <div class="card" style="padding:16px;">
            <p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 6px;">{sig.full}</p>
            <p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.6;">{sig.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
import { calculateKundali, siderealNakshatraPada, formatDegMin, RASHIS } from '../../lib/kundali';
import { NAKSHATRAS } from '../../lib/panchang';

function trRashi(i:number){return hindiActive?RASHIS[i].nameHi:RASHIS[i].name;}
function trNak(i:number){return hindiActive?NAKSHATRAS[i].nameHi:NAKSHATRAS[i].name;}
const PLANETS=[
  ['surya','Surya (Sun)','Soul, vitality, self-confidence, authority, father, government service, and overall health.'],
  ['chandra','Chandra (Moon)','Mind, emotions, intuition, mother, and the emotional core used for daily Rashifal and Muhurta decisions.'],
  ['mangal','Mangal (Mars)','Energy, courage, siblings, land and property, conflict, and drive to take action.'],
  ['budha','Budha (Mercury)','Intellect, communication, business acumen, education, and analytical skill.'],
  ['guru','Guru (Jupiter)','Wisdom, wealth, children, spirituality, teachers, and expansion or growth.'],
  ['shukra','Shukra (Venus)','Love, marriage, beauty, luxury, art, and relationships.'],
  ['shani','Shani (Saturn)','Discipline, longevity, hard work, career, delays, and karmic lessons.'],
  ['rahu','Rahu','Worldly desire, obsession, foreign connections, sudden change, and illusion.'],
  ['ketu','Ketu','Detachment, spirituality, past-life karma, and liberation.'],
];
const PLANETS_HI:any={
  surya:['सूर्य','आत्मा, जीवन शक्ति, आत्मविश्वास, अधिकार, पिता, सरकारी सेवा, और समग्र स्वास्थ्य।'],
  chandra:['चंद्रमा','मन, भावनाएं, अंतर्ज्ञान, माता, और दैनिक राशिफल व मुहूर्त निर्णयों में प्रयुक्त भावनात्मक केंद्र।'],
  mangal:['मंगल','ऊर्जा, साहस, भाई-बहन, भूमि व संपत्ति, संघर्ष, और कार्य करने की प्रेरणा।'],
  budha:['बुध','बुद्धि, संचार, व्यावसायिक कुशलता, शिक्षा, और विश्लेषणात्मक क्षमता।'],
  guru:['गुरु','ज्ञान, धन, संतान, आध्यात्मिकता, गुरुजन, और विस्तार या विकास।'],
  shukra:['शुक्र','प्रेम, विवाह, सौंदर्य, विलासिता, कला, और रिश्ते।'],
  shani:['शनि','अनुशासन, दीर्घायु, कठोर परिश्रम, करियर, विलंब, और कर्म संबंधी सीख।'],
  rahu:['राहु','सांसारिक इच्छा, जुनून, विदेशी संबंध, अचानक परिवर्तन, और भ्रम।'],
  ketu:['केतु','वैराग्य, आध्यात्मिकता, पूर्वजन्म का कर्म, और मोक्ष।'],
};
let hindiActive=false;

function render(){
  const now=new Date();
  const data=calculateKundali(now,0,0,0);

  const updatedEl=document.getElementById('pp-updated');
  if(updatedEl)updatedEl.textContent=(hindiActive?'अंतिम अद्यतन: ':'Last updated: ')+now.toLocaleTimeString()+(hindiActive?' (हर 60 सेकंड में स्वतः अपडेट)':' (auto-refreshes every 60s)');

  let rows='';
  PLANETS.forEach(([k,full])=>{
    const displayName=hindiActive?PLANETS_HI[k][0]:full;
    const g=data.grahas.find(x=>x.id===k)!;
    const nk=siderealNakshatraPada(g.siderealLon);
    const motion=g.isRetrograde?'Retrograde':'Direct';
    const motionLabel=hindiActive?(motion==='Retrograde'?'वक्री':'मार्गी'):motion;
    const combustNA=(k==='surya'||k==='rahu'||k==='ketu');
    const combustLabel=combustNA?'—':(g.isCombust?(hindiActive?'अस्त (दग्ध)':'Asta (Combust)'):(hindiActive?'उदित':'Udita'));
    rows+=`<tr><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-ink);font-weight:600;">${displayName}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">${trRashi(g.sign)} (${RASHIS[g.sign].en})</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);font-family:var(--font-mono);">${formatDegMin(g.siderealLon)}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">${trNak(nk.idx)}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);">${nk.pada}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${motion==='Retrograde'?'#dc2626':'var(--color-body-text)'};">${motionLabel}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${g.isCombust?'#dc2626':'var(--color-body-text)'};">${combustLabel}</td></tr>`;
  });
  const body=document.getElementById('pp-body');
  if(body)body.innerHTML=rows;

  const sigEl=document.getElementById('pp-significations');
  if(sigEl){
    sigEl.innerHTML=PLANETS.map(([k,full,desc])=>{
      const name=hindiActive?PLANETS_HI[k][0]:full;
      const text=hindiActive?PLANETS_HI[k][1]:desc;
      return `<div class="card" style="padding:16px;"><p style="font-size:13px;font-weight:600;color:var(--color-ink);margin:0 0 6px;">${name}</p><p style="font-size:14px;color:var(--color-body-text);margin:0;line-height:1.6;">${text}</p></div>`;
    }).join('');
  }
}

render();
setInterval(render,60000);

function applyPageLang(hindi:boolean){
  hindiActive=hindi;
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el=>{
    if(!el.dataset.en) el.dataset.en=el.textContent||'';
    el.textContent=hindi?(el.dataset.hi as string):(el.dataset.en as string);
  });
  render();
}
document.addEventListener('langchange',(e:Event)=>{
  applyPageLang((e as CustomEvent).detail.langCode==='hi');
});
if(localStorage.getItem('pp-lang')==='hi') applyPageLang(true);
</script>
