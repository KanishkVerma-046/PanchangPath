---
import Layout from '../../layouts/Layout.astro';
import { lahiriAyanamsha, julianDay } from '../../lib/panchang';
import { planetLongitude, rahuLongitude } from '../../lib/astro-core';
import { RASHIS, houseFromMoon, classifyGochara, classifyShaniGochara } from '../../lib/kundali';
import { istWallClock } from '../../lib/ist-date';

// Build-time default: "now" (IST, matching the daily-rebuild cron's clock). This page is
// location-independent (a planet's rashi doesn't depend on an observer's lat/lng), so there's
// no "default city" concept here — just a live snapshot, refreshed client-side every 60s.
// Uses the exact same houseFromMoon()/classifyGochara()/classifyShaniGochara() the client
// <script> below calls, so server and client can never disagree — see CLAUDE.md's
// 2026-08-18 SEO-prerender rollout note.
// Positions come from the real build instant, read through its UTC fields exactly like the client
// <script>'s render(); the +05:30-shifted wall clock is only for the IST "Last updated" label.
const buildInstant = new Date();
const buildIst = istWallClock(buildInstant);
const buildJD = julianDay(buildInstant.getUTCFullYear(), buildInstant.getUTCMonth() + 1, buildInstant.getUTCDate(), buildInstant.getUTCHours() + buildInstant.getUTCMinutes() / 60);
const n360 = (a: number) => ((a % 360) + 360) % 360;
const buildAy = lahiriAyanamsha(buildJD);

const mangalSign = Math.floor(n360(planetLongitude('mars', buildJD) - buildAy) / 30);
const guruSign = Math.floor(n360(planetLongitude('jupiter', buildJD) - buildAy) / 30);
const shaniSign = Math.floor(n360(planetLongitude('saturn', buildJD) - buildAy) / 30);
const rahuTrop = rahuLongitude(buildJD);
const rahuSign = Math.floor(n360(rahuTrop - buildAy) / 30);
const ketuSign = Math.floor(n360(n360(rahuTrop + 180) - buildAy) / 30);

const gcRows = Array.from({ length: 12 }, (_, moonSign) => ({
  moonSign,
  mangal: classifyGochara(houseFromMoon(moonSign, mangalSign), [3, 6, 11]),
  guru: classifyGochara(houseFromMoon(moonSign, guruSign), [2, 5, 7, 9, 11]),
  shani: classifyShaniGochara(houseFromMoon(moonSign, shaniSign)),
  rahu: classifyGochara(houseFromMoon(moonSign, rahuSign), [3, 6, 11]),
  ketu: classifyGochara(houseFromMoon(moonSign, ketuSign), [3, 6, 11]),
}));
const gcCellColor = (cls: string) => cls === 'favorable' ? '#15803d' : cls === 'challenging' ? '#dc2626' : 'var(--color-body-text)';
---

<Layout title="Gochara — Planetary Transit Table Today — PanchangPath" description="Live Gochara (transit) grid for Mars, Jupiter, Saturn, Rahu and Ketu across all 12 Moon-sign rashis, using the classical Vedic house-from-Moon framework.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/jyotish" style="display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--color-mute);text-decoration:none;">
        <span class="arrow-chip"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg></span>
        <span data-hi="ज्योतिष उपकरण">Jyotish Tools</span>
      </a>
      <p class="eyebrow reveal" style="margin:12px 0 8px;">गोचर · Gochara</p>
      <h1 class="reveal" data-hi="गोचर — पारगमन तालिका" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;transition-delay:60ms;">Gochara — Transit Table</h1>
      <p class="reveal" data-hi="शास्त्रीय वैदिक गोचर (ग्रह पारगमन) सिद्धांत पांच 'धीमी गति वाले' ग्रहों — मंगल, गुरु, शनि, राहु, और केतु — से संबंधित है, और क्या वे वर्तमान में आपकी जन्म चंद्र राशि से गिनकर अनुकूल या प्रतिकूल भाव में स्थित हैं। नीचे अपनी चंद्र राशि की पंक्ति खोजें।" style="font-size:15px;color:var(--color-body-text);margin:0 0 10px;max-width:560px;transition-delay:120ms;">Classical Vedic Gochara (planetary transit) theory concerns itself with the five "slow movers" — Mars, Jupiter, Saturn, Rahu, and Ketu — and whether they currently sit in a favorable or challenging house counted from your natal Moon sign. Find your Moon sign's row below.</p>
      <p data-hi="आपकी जन्म कुंडली एक स्थिर मानचित्र है — जन्म के समय आकाश का एक स्नैपशॉट, जो कभी नहीं बदलता। गोचर उस स्थिर मानचित्र के ऊपर से गुजरने वाला निरंतर बदलता 'मौसम' है: ग्रह आज जहां हैं। कुंडली आपकी क्षमता दिखाती है; गोचर दिखाता है कि उस क्षमता का कौन सा हिस्सा अभी सक्रिय हो रहा है।" style="font-size:13px;color:var(--color-mute);margin:0;max-width:560px;line-height:1.6;">Your Kundali (birth chart) is a fixed map — a snapshot of the sky at the moment you were born, and it never changes. Gochara is the constantly-changing "weather" moving over that fixed map: where the planets are today. The Kundali shows your potential; Gochara shows which part of that potential is being activated right now.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container">
      <p id="gc-updated" style="font-size:11px;color:var(--color-mute);font-family:var(--font-mono);margin:0 0 16px;">Last updated: {buildIst.toLocaleTimeString('en-IN', { timeZone: 'UTC' })} (auto-refreshes every 60s)</p>
      <div class="bezel-outer reveal">
       <div class="bezel-inner" style="padding:20px;overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;min-width:640px;" id="gc-table">
          <thead><tr>
            <th data-hi="आपकी चंद्र राशि" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Your Moon Sign</th>
            <th data-hi="मंगल" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Mars</th>
            <th data-hi="गुरु" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Jupiter</th>
            <th data-hi="शनि" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Saturn</th>
            <th data-hi="राहु" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Rahu</th>
            <th data-hi="केतु" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Ketu</th>
          </tr></thead>
          <tbody id="gc-body">
            {gcRows.map(r => (
              <tr>
                <td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-ink);font-weight:600;">{RASHIS[r.moonSign].name} ({RASHIS[r.moonSign].en})</td>
                <td style={`padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${gcCellColor(r.mangal.cls)};font-weight:600;font-size:12px;`}>{r.mangal.label}</td>
                <td style={`padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${gcCellColor(r.guru.cls)};font-weight:600;font-size:12px;`}>{r.guru.label}</td>
                <td style={`padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${gcCellColor(r.shani.cls)};font-weight:600;font-size:12px;`}>{r.shani.label}</td>
                <td style={`padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${gcCellColor(r.rahu.cls)};font-weight:600;font-size:12px;`}>{r.rahu.label}</td>
                <td style={`padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${gcCellColor(r.ketu.cls)};font-weight:600;font-size:12px;`}>{r.ketu.label}</td>
              </tr>
            ))}
          </tbody>
        </table>
       </div>
      </div>
      <p data-hi="मंगल/राहु/केतु/शनि: चंद्र राशि से भाव 3, 6, 11 में अनुकूल ('उपचय')। गुरु: भाव 2, 5, 7, 9, 11 में अनुकूल। शनि अतिरिक्त रूप से साढ़े साती (12, 1, 2) और अष्टम शनि (8) को प्रतिकूल दर्शाता है।" style="font-size:11px;color:var(--color-mute);margin:16px 0 0;max-width:600px;">Mars/Rahu/Ketu/Saturn: favorable in houses 3, 6, 11 from Moon sign ("Upachaya"). Jupiter: favorable in houses 2, 5, 7, 9, 11. Saturn additionally shows Sade Sati (12, 1, 2) and Ashtam Shani (8) as challenging.</p>
    </div>
  </section>
</Layout>

<script>
import { lahiriAyanamsha, julianDay } from '../../lib/panchang';
import { planetLongitude, rahuLongitude } from '../../lib/astro-core';
import { RASHIS, houseFromMoon, classifyGochara, classifyShaniGochara } from '../../lib/kundali';

const n360=(a:number)=>((a%360)+360)%360;
function trRashi(i:number){return hindiActive?RASHIS[i].nameHi:RASHIS[i].name;}
const LABEL_HI:any={'Favorable':'अनुकूल','Challenging':'प्रतिकूल','Sade Sati':'साढ़े साती','Ashtam Shani':'अष्टम शनि','Neutral':'तटस्थ'};
function cellHtml(c:{label:string,cls:string}){
  const color=c.cls==='favorable'?'#15803d':c.cls==='challenging'?'#dc2626':'var(--color-body-text)';
  const label=hindiActive?LABEL_HI[c.label]:c.label;
  return `<td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:${color};font-weight:600;font-size:12px;">${label}</td>`;
}

let hindiActive=false;

function render(){
  const now=new Date();
  const jd=julianDay(now.getUTCFullYear(),now.getUTCMonth()+1,now.getUTCDate(),now.getUTCHours()+now.getUTCMinutes()/60);
  const ay=lahiriAyanamsha(jd);

  const mangalSign=Math.floor(n360(planetLongitude('mars',jd)-ay)/30);
  const guruSign=Math.floor(n360(planetLongitude('jupiter',jd)-ay)/30);
  const shaniSign=Math.floor(n360(planetLongitude('saturn',jd)-ay)/30);
  const rahuTrop=rahuLongitude(jd);
  const rahuSign=Math.floor(n360(rahuTrop-ay)/30);
  const ketuSign=Math.floor(n360(n360(rahuTrop+180)-ay)/30);

  const updatedEl=document.getElementById('gc-updated');
  if(updatedEl)updatedEl.textContent=(hindiActive?'अंतिम अद्यतन: ':'Last updated: ')+now.toLocaleTimeString()+(hindiActive?' (हर 60 सेकंड में स्वतः अपडेट)':' (auto-refreshes every 60s)');

  let rows='';
  for(let moonSign=0;moonSign<12;moonSign++){
    const hMangal=houseFromMoon(moonSign,mangalSign);
    const hGuru=houseFromMoon(moonSign,guruSign);
    const hShani=houseFromMoon(moonSign,shaniSign);
    const hRahu=houseFromMoon(moonSign,rahuSign);
    const hKetu=houseFromMoon(moonSign,ketuSign);
    rows+=`<tr><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-ink);font-weight:600;">${trRashi(moonSign)} (${RASHIS[moonSign].en})</td>`
      +cellHtml(classifyGochara(hMangal,[3,6,11]))
      +cellHtml(classifyGochara(hGuru,[2,5,7,9,11]))
      +cellHtml(classifyShaniGochara(hShani))
      +cellHtml(classifyGochara(hRahu,[3,6,11]))
      +cellHtml(classifyGochara(hKetu,[3,6,11]))
      +'</tr>';
  }
  const body=document.getElementById('gc-body');
  if(body)body.innerHTML=rows;
}

render();
setInterval(render,60000);

function applyPageLang(hindi:boolean){
  hindiActive=hindi;
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el=>{
    if(!el.dataset.en) el.dataset.en=el.textContent||'';
    el.textContent=hindi?(el.dataset.hi as string):(el.dataset.en as string);
  });
  render();
}
document.addEventListener('langchange',(e:Event)=>{
  applyPageLang((e as CustomEvent).detail.langCode==='hi');
});
if(localStorage.getItem('pp-lang')==='hi') applyPageLang(true);
</script>
