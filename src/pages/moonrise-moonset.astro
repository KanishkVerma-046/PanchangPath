---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Moonrise & Moonset Times — PanchangPath" description="Today's moonrise and moonset time for your location plus current moon phase, computed from a real iterative topocentric altitude-crossing solver — not a rough heuristic.">

  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:40px 0 32px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.4;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <a href="/" data-hi="← आज का पंचांग" style="font-size:12px;color:var(--color-mute);text-decoration:none;">← Today's Panchang</a>
      <p class="caption-mono" style="color:var(--color-mute);margin:12px 0 8px;">चंद्रोदय · चंद्रास्त · MOONRISE &amp; MOONSET</p>
      <h1 data-hi="चंद्रोदय और चंद्रास्त" style="font-size:30px;font-weight:600;letter-spacing:-1.2px;color:var(--color-ink);margin:0 0 10px;">Moonrise &amp; Moonset</h1>
      <p data-hi="आपके स्थान के लिए आज का चंद्रोदय और चंद्रास्त समय, एक वास्तविक पुनरावृत्तीय टोपोसेंट्रिक ऊँचाई-क्रॉसिंग सॉल्वर से गणना (चंद्रमा एक दैनिक स्नैपशॉट के लिए बहुत तेज़ चलता है), साथ ही वर्तमान चंद्र कला।" style="font-size:15px;color:var(--color-body-text);margin:0;max-width:520px;">Today's moonrise and moonset time for your location, computed with a real iterative topocentric altitude-crossing solver (the Moon moves too fast for a single daily snapshot), plus the current moon phase.</p>
    </div>
  </section>

  <section style="padding:28px 0 48px;">
    <div class="container">
      <div style="display:flex;align-items:flex-end;gap:12px;flex-wrap:wrap;margin-bottom:32px;">
        <div>
          <label for="ms-city" data-hi="स्थान" style="font-size:11px;font-weight:500;color:var(--color-mute);display:block;margin-bottom:5px;font-family:var(--font-mono);text-transform:uppercase;letter-spacing:0.06em;">Location</label>
          <select id="ms-city" class="input" style="height:38px;min-width:160px;"></select>
        </div>
      </div>

      <div id="ms-today" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;margin-bottom:40px;"></div>

      <h3 data-hi="अगले 7 दिन" style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 14px;">Next 7 Days</h3>
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:13px;max-width:680px;" id="ms-week">
          <thead><tr>
            <th data-hi="दिनांक" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Date</th>
            <th data-hi="चंद्रोदय" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Moonrise</th>
            <th data-hi="चंद्रास्त" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Moonset</th>
            <th data-hi="कला" style="text-align:left;padding:6px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-mute);font-weight:600;font-size:11px;text-transform:uppercase;">Phase</th>
          </tr></thead>
          <tbody id="ms-week-body"></tbody>
        </table>
      </div>
    </div>
  </section>
</Layout>

<script>
import { moonLongitude, sunTrueLongitude, moonRiseSetUTC, sunriseUTC } from '../lib/panchang';
import { formatDateHi } from '../lib/date-i18n';

const LOCS = [
  {name:'New Delhi',nameHi:'नई दिल्ली',lat:28.6139,lng:77.209,tz:5.5},
  {name:'Mumbai',nameHi:'मुंबई',lat:19.076,lng:72.8777,tz:5.5},
  {name:'Bengaluru',nameHi:'बेंगलुरू',lat:12.9716,lng:77.5946,tz:5.5},
  {name:'Chennai',nameHi:'चेन्नई',lat:13.0827,lng:80.2707,tz:5.5},
  {name:'Kolkata',nameHi:'कोलकाता',lat:22.5726,lng:88.3639,tz:5.5},
  {name:'Hyderabad',nameHi:'हैदराबाद',lat:17.385,lng:78.4867,tz:5.5},
  {name:'Jaipur',nameHi:'जयपुर',lat:26.9124,lng:75.7873,tz:5.5},
  {name:'Varanasi',nameHi:'वाराणसी',lat:25.3176,lng:82.9739,tz:5.5},
  {name:'Dubai',nameHi:'दुबई',lat:25.2048,lng:55.2708,tz:4},
  {name:'New York',nameHi:'न्यूयॉर्क',lat:40.7128,lng:-74.006,tz:-4},
  {name:'London',nameHi:'लंदन',lat:51.5074,lng:-0.1278,tz:1},
];

function toJD(y:number,m:number,d:number,h=0){
  if(m<=2){y--;m+=12;}
  const A=Math.floor(y/100),B=2-A+Math.floor(A/4);
  return Math.floor(365.25*(y+4716))+Math.floor(30.6001*(m+1))+d+h/24+B-1524.5;
}
const n360=(a:number)=>((a%360)+360)%360;
const toRad=(d:number)=>d*Math.PI/180;
const toDeg=(r:number)=>r*180/Math.PI;

function decHoursToTime(h:number,tz:number){
  const local=h+tz;
  const hh=Math.floor(((local%24)+24)%24);
  const mm=Math.round((local-Math.floor(local))*60);
  const ap=hh<12?'AM':'PM';
  const h12=hh%12||12;
  return `${h12}:${String(mm).padStart(2,'0')} ${ap}`;
}
const PHASE_NAMES=['New Moon','Waxing Crescent','First Quarter','Waxing Gibbous','Full Moon','Waning Gibbous','Last Quarter','Waning Crescent'];
function moonPhase(jd:number){
  const elong=n360(moonLongitude(jd)-sunTrueLongitude(jd));
  const illumPct=Math.round((1-Math.cos(toRad(elong)))/2*100);
  const bin=Math.floor(((elong+22.5)%360)/45);
  return {illumPct,name:PHASE_NAMES[bin]};
}

const sel=document.getElementById('ms-city') as HTMLSelectElement;
let hindiActive=false;
function renderCityOptions(){
  const selected=sel.value;
  sel.innerHTML=LOCS.map(l=>`<option value="${l.name}">${hindiActive?(l.nameHi||l.name):l.name}</option>`).join('');
  if(selected) sel.value=selected;
}
renderCityOptions();

function applyHeaderLoc(loc:any){
  if(!loc||!loc.name)return;
  const norm=(s:string)=>s.trim().toLowerCase();
  let match=LOCS.find(l=>norm(l.name)===norm(loc.name));
  if(!match){
    match={name:loc.name,nameHi:loc.nameHi,lat:loc.lat,lng:loc.lng,tz:loc.tzOffset};
    LOCS.unshift(match);
    renderCityOptions();
  }
  sel.value=match.name;
}
if((window as any).__initLoc) applyHeaderLoc((window as any).__initLoc);
window.addEventListener('locationchange',(e:Event)=>{
  applyHeaderLoc((e as CustomEvent).detail);
  calculate();
});

function computeForDate(y:number,m:number,d:number,loc:any){
  const jd=toJD(y,m,d,6-loc.tz);
  const jdMidnightUTC=toJD(y,m,d,0);
  const srUTC=sunriseUTC(jd,loc.lat,loc.lng,true);
  const elong=n360(moonLongitude(jd)-sunTrueLongitude(jd));
  const moonAge=elong/360*29.53;
  const moonriseSeedUTC=srUTC+moonAge*0.8;
  const moonsetSeedUTC=moonriseSeedUTC+12.42;
  const moonriseUTC=moonRiseSetUTC(jdMidnightUTC,loc.lat,loc.lng,true,moonriseSeedUTC);
  const moonsetUTC=moonRiseSetUTC(jdMidnightUTC,loc.lat,loc.lng,false,moonsetSeedUTC);
  const phase=moonPhase(jd);
  return {moonriseUTC,moonsetUTC,phase};
}

function calculate(){
  const cityName=sel.value;
  const loc=LOCS.find(l=>l.name===cityName)||LOCS[0];
  const now=new Date();
  const y=now.getFullYear(),m=now.getMonth()+1,d=now.getDate();

  const {moonriseUTC,moonsetUTC,phase}=computeForDate(y,m,d,loc);

  const todayEl=document.getElementById('ms-today');
  if(todayEl){
    const moonPhaseLabel=hindiActive?'चंद्र कला':'Moon Phase';
    todayEl.innerHTML=[
      {label:hindiActive?'चंद्रोदय':'Moonrise',value:isNaN(moonriseUTC)?'—':decHoursToTime(moonriseUTC,loc.tz),color:'#6366f1'},
      {label:hindiActive?'चंद्रास्त':'Moonset',value:isNaN(moonsetUTC)?'—':decHoursToTime(moonsetUTC,loc.tz),color:'#4338ca'},
      {label:moonPhaseLabel,value:phase.name,color:'var(--color-ink)'},
      {label:hindiActive?'रोशनी':'Illumination',value:phase.illumPct+'%',color:'var(--color-ink)'},
    ].map(c=>`<div class="card" style="padding:20px;text-align:center;"><p style="font-size:11px;color:var(--color-mute);text-transform:uppercase;letter-spacing:0.06em;font-family:var(--font-mono);margin:0 0 8px;">${c.label}</p><p style="font-size:${c.label===moonPhaseLabel?'16':'24'}px;font-weight:700;color:${c.color};margin:0;font-family:var(--font-mono);">${c.value}</p></div>`).join('');
  }

  const weekBody=document.getElementById('ms-week-body');
  if(weekBody){
    let rows='';
    for(let i=0;i<7;i++){
      const dt=new Date(y,m-1,d+i);
      const r=computeForDate(dt.getFullYear(),dt.getMonth()+1,dt.getDate(),loc);
      const dayName=formatDateHi(dt, hindiActive, {weekday:'short',month:'short',year:false});
      const todayTag=i===0?(hindiActive?' (आज)':' (Today)'):'';
      rows+=`<tr><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-ink);font-weight:${i===0?'700':'400'};">${dayName}${todayTag}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-body-text);font-family:var(--font-mono);">${isNaN(r.moonriseUTC)?'—':decHoursToTime(r.moonriseUTC,loc.tz)}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-body-text);font-family:var(--font-mono);">${isNaN(r.moonsetUTC)?'—':decHoursToTime(r.moonsetUTC,loc.tz)}</td><td style="padding:7px 10px;border-bottom:1px solid var(--color-hairline);color:var(--color-body-text);">${r.phase.name} (${r.phase.illumPct}%)</td></tr>`;
    }
    weekBody.innerHTML=rows;
  }
}

sel.addEventListener('change',calculate);
calculate();

function applyPageLang(hindi:boolean){
  hindiActive=hindi;
  document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el=>{
    if(!el.dataset.en) el.dataset.en=el.textContent||'';
    el.textContent=hindi?(el.dataset.hi as string):(el.dataset.en as string);
  });
  renderCityOptions();
  calculate();
}
document.addEventListener('langchange',(e:Event)=>{
  applyPageLang((e as CustomEvent).detail.langCode==='hi');
});
if(localStorage.getItem('pp-lang')==='hi') applyPageLang(true);
</script>
