---
import Layout from '../layouts/Layout.astro';
import ErrorState from '../components/ErrorState.astro';
---

<Layout title="Something Went Wrong — PanchangPath" description="Something went wrong on our end. Head back to the PanchangPath homepage and try again.">
  <ErrorState
    code="500"
    heading="Something Went Wrong"
    headingHi="कुछ गलत हो गया"
    message="An unexpected error occurred on our end. Please try again, or head back to the homepage."
    messageHi="हमारी ओर से एक अप्रत्याशित त्रुटि हुई। कृपया पुनः प्रयास करें, या होमपेज पर वापस जाएं।"
  />
</Layout>
