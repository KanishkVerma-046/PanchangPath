---
import Layout from '../../../layouts/Layout.astro';
import DevotionalIndexGrid from '../../../components/DevotionalIndexGrid.astro';
import { NAMAVALIS } from '../../../lib/devotional/namavali';
import { CATEGORY_META } from '../../../lib/devotional/types';

const category = CATEGORY_META['namavali'];
---

<Layout
  title="Deity Namavali — 108 Names Lists for Archana — PanchangPath"
  description="Free collection of 108-name (Ashtottara Shatanamavali) lists for Shiva, Ganesha, Durga, Lakshmi, Saraswati, Krishna, Rama, Hanuman, Surya and Shani, for Archana and japa."
>
  <DevotionalIndexGrid category={category} items={NAMAVALIS} />

  <section style="padding:0 0 48px;">
    <div class="container">
      <p class="caption-mono" style="color:var(--color-mute);margin:0 0 12px;">1000-NAME SAHASRANAMAVALI</p>
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:14px;max-width:700px;">
        <a href="/devotional/stotram/vishnu-sahasranama-stotram" class="card" style="display:flex;align-items:flex-start;gap:12px;padding:18px;text-decoration:none;">
          <span style="font-size:26px;line-height:1;flex-shrink:0;">🪷</span>
          <div>
            <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">Vishnu Sahasranama</h3>
            <p style="font-size:12.5px;color:var(--color-mute);margin:0;">विष्णु सहस्रनाम — full 1000-name text under Stotram Collection →</p>
          </div>
        </a>
        <a href="/devotional/stotram/lalita-sahasranama-stotram" class="card" style="display:flex;align-items:flex-start;gap:12px;padding:18px;text-decoration:none;">
          <span style="font-size:26px;line-height:1;flex-shrink:0;">🌺</span>
          <div>
            <h3 style="font-size:15px;font-weight:600;color:var(--color-ink);margin:0 0 4px;">Lalita Sahasranama</h3>
            <p style="font-size:12.5px;color:var(--color-mute);margin:0;">ललिता सहस्रनाम — full 1000-name text under Stotram Collection →</p>
          </div>
        </a>
      </div>
    </div>
  </section>
</Layout>
