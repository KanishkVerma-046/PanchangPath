---
import Layout from '../../../layouts/Layout.astro';
import DevotionalIndexGrid from '../../../components/DevotionalIndexGrid.astro';
import { YANTRAS } from '../../../lib/devotional/yantra';
import { CATEGORY_META } from '../../../lib/devotional/types';

const category = CATEGORY_META['yantra'];
---

<Layout
  title="Vedic Yantras — Structure, Mantra &amp; Puja Vidhi — PanchangPath"
