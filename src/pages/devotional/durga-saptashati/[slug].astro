---
import Layout from '../../../layouts/Layout.astro';
import { metaDescription } from '../../../lib/meta';
import DevotionalDetail from '../../../components/DevotionalDetail.astro';
import { DURGA_SAPTASHATI } from '../../../lib/devotional/durgasaptashati';
import { CATEGORY_META } from '../../../lib/devotional/types';

export function getStaticPaths() {
  return DURGA_SAPTASHATI.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const category = CATEGORY_META['durga-saptashati'];

const idx = DURGA_SAPTASHATI.findIndex(a => a.slug === item.slug);
const prev = idx > 0 ? DURGA_SAPTASHATI[idx - 1] : null;
const next = idx < DURGA_SAPTASHATI.length - 1 ? DURGA_SAPTASHATI[idx + 1] : null;

/** item.title carries a long Sanskrit episode subtitle ("Chapter 1: Madhu-Kaitabha Vadha")
 *  that alone pushes every chapter's <title> tag past 60 chars; the chapter number
 *  extracted from the slug gives a short, search-matched title instead. */
const chapterNum = item.slug.match(/chapter-(\d+)/)?.[1] ?? '';
---

<Layout
  title={item.metaTitle ?? `Durga Saptashati Chapter ${chapterNum} — PanchangPath`}
  description={metaDescription(item.metaDesc ?? item.meaning, `${item.title} — full Sanskrit text, summary and significance.`)}
>
  <DevotionalDetail
    item={item} category={category} prev={prev} next={next}
    lyricsLabel="Sanskrit Text (Devanagari)"
    meaningLabel="Chapter Summary"
    benefitsLabel="Significance"
  />
</Layout>
