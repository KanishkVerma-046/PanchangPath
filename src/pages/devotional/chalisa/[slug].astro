---
import Layout from '../../../layouts/Layout.astro';
import { metaDescription } from '../../../lib/meta';
import DevotionalDetail from '../../../components/DevotionalDetail.astro';
import { CHALISAS } from '../../../lib/devotional/chalisa';
import { CATEGORY_META } from '../../../lib/devotional/types';

export function getStaticPaths() {
  return CHALISAS.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const category = CATEGORY_META['chalisa'];

const idx = CHALISAS.findIndex(a => a.slug === item.slug);
const prev = idx > 0 ? CHALISAS[idx - 1] : null;
const next = idx < CHALISAS.length - 1 ? CHALISAS[idx + 1] : null;

/** Cross-links to the Aarti-format hymn for the same deity, where one exists. */
const RELATED: Record<string, { label: string; labelHi?: string; href: string }[]> = {
  'ganesh-chalisa': [{ label: 'Jai Ganesh Deva Aarti', labelHi: 'जय गणेश देवा आरती', href: '/devotional/aarti/jai-ganesh-deva' }],
  'lakshmi-chalisa': [{ label: 'Om Jai Lakshmi Mata Aarti', labelHi: 'ॐ जय लक्ष्मी माता आरती', href: '/devotional/aarti/om-jai-lakshmi-mata' }],
  'durga-chalisa': [{ label: 'Jai Ambe Gauri Aarti', labelHi: 'जय अम्बे गौरी आरती', href: '/devotional/aarti/jai-ambe-gauri' }],
  'shiv-chalisa': [{ label: 'Om Jai Shiv Omkara Aarti', labelHi: 'ॐ जय शिव ओंकारा आरती', href: '/devotional/aarti/om-jai-shiv-omkara' }],
  'krishna-chalisa': [{ label: 'Aarti Kunj Bihari Ki', labelHi: 'आरती कुंज बिहारी की', href: '/devotional/aarti/aarti-kunj-bihari-ki' }],
  'sai-chalisa': [{ label: 'Sai Baba Aarti', labelHi: 'आरती साईं बाबा की', href: '/devotional/aarti/sai-baba-aarti' }],
  'kali-chalisa': [{ label: 'Aarti Shri Kali ji Ki', labelHi: 'आरती श्री काली जी की', href: '/devotional/aarti/aarti-shri-kali-ji-ki' }],
  'ram-chalisa': [{ label: 'Aarti Shri Ramchandra ji Ki', labelHi: 'आरती श्री रामचंद्र जी की', href: '/devotional/aarti/aarti-shri-ramchandra-ji-ki' }],
  'hanuman-chalisa': [{ label: 'Aarti Kije Hanuman Lala Ki', labelHi: 'आरती कीजै हनुमान लला की', href: '/devotional/aarti/aarti-kije-hanuman-lala-ki' }],
  'saraswati-chalisa': [{ label: 'Jai Saraswati Mata Aarti', labelHi: 'जय सरस्वती माता आरती', href: '/devotional/aarti/jai-saraswati-mata' }],
  'vaishno-devi-chalisa': [{ label: 'Vaishno Devi Aarti', labelHi: 'आरती श्री वैष्णो देवी जी की', href: '/devotional/aarti/vaishno-devi-aarti' }],
};
---

<Layout
  title={item.metaTitle ?? `${item.title} — Lyrics & Meaning — PanchangPath`}
  description={metaDescription(item.metaDesc ?? item.meaning, `${item.title} lyrics in Hindi with transliteration and meaning.`)}
>
  <DevotionalDetail item={item} category={category} prev={prev} next={next} relatedLinks={RELATED[item.slug]} />
</Layout>
