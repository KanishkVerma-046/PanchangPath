---
import Layout from '../../../layouts/Layout.astro';
import DevotionalDetail from '../../../components/DevotionalDetail.astro';
import { CHALISAS } from '../../../lib/devotional/chalisa';
import { CATEGORY_META } from '../../../lib/devotional/types';

export function getStaticPaths() {
  return CHALISAS.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const category = CATEGORY_META['chalisa'];

const idx = CHALISAS.findIndex(a => a.slug === item.slug);
const prev = idx > 0 ? CHALISAS[idx - 1] : null;
const next = idx < CHALISAS.length - 1 ? CHALISAS[idx + 1] : null;
---

<Layout
  title={`${item.title} — ${item.titleHi} — Chalisa Lyrics &amp; Meaning — PanchangPath`}
  description={item.meaning ?? `${item.title} lyrics in Hindi with transliteration and meaning.`}
>
  <DevotionalDetail item={item} category={category} prev={prev} next={next} />
</Layout>
