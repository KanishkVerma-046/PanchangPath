---
import Layout from '../../layouts/Layout.astro';
import MandalaWatermark from '../../components/motifs/MandalaWatermark.astro';
import { CATEGORY_META } from '../../lib/devotional/types';

// Only surface categories that actually have pages. Unbuilt ones stay in CATEGORY_META
// (flip `built` to true to bring the card back) rather than showing a permanent
// "Coming Soon" placeholder the visitor can't act on.
const categories = Object.values(CATEGORY_META).filter((c) => c.built);

// UI-chrome Hindi translations for the category blurbs on this hub page.
// (Category item content itself — lyricsHi/transliteration/meaning — is out of scope.)
const DESC_HI: Record<string, string> = {
  'aarti': 'पूजा के दौरान देवताओं की आरती में गाए जाने वाले भक्ति गीत, हिंदी बोल, लिप्यंतरण और अर्थ सहित।',
  'chalisa': 'देवता के गुणों और कार्यों की स्तुति में चालीस दोहों वाले भक्ति स्तोत्र, आशीर्वाद और सुरक्षा हेतु पाठ किए जाते हैं।',
  'stotram': 'ऋषियों द्वारा रचित संस्कृत स्तुति गीत, आध्यात्मिक पुण्य और ईश्वरीय कृपा हेतु पाठ किए जाते हैं।',
  'ashtakam': 'एक ही देवता को समर्पित आठ श्लोकों वाले संस्कृत स्तोत्र, अपनी संक्षिप्त भक्ति शक्ति के लिए विशेष।',
  'mantra': 'शब्दार्थ अनुवाद, अर्थ और जप विधि सहित पवित्र वैदिक मंत्र।',
  'yantra': 'पूजा हेतु पवित्र ज्यामितीय आकृतियां, प्रत्येक यंत्र की स्थापना, पूजा विधि और लाभ सहित।',
  'namavali': 'अर्चना और जप हेतु देवताओं की 108 (अष्टोत्तरशतनामावली) और 1000 नाम (सहस्रनामावली) की सूचियां।',
  'durga-saptashati': 'देवी माहात्म्य के सभी 13 अध्याय — देवी दुर्गा की असुरों पर विजय की गाथा।',
  'sundarkand': 'रामचरितमानस का पांचवां सोपान, हनुमान जी की लंका यात्रा का वर्णन — साहस और सुरक्षा हेतु पाठ किया जाता है।',
  'nama-ramayanam': 'श्री राम के नामों और महिमा के माध्यम से पूर्णतः वर्णित रामायण की कथा, भक्ति गीत के रूप में गाई जाती है।',
  'vrat-katha': 'व्रत के दौरान सुनाई जाने वाली पारंपरिक कथाएं, जो व्रत की उत्पत्ति और महत्व को समझाती हैं।',
  'puja-vidhi': 'प्रमुख त्योहारों के दौरान सही ढंग से पूजा करने हेतु चरणबद्ध विधि मार्गदर्शिका।',
};
---

<Layout
  title="Devotional Content Library — Aarti, Chalisa, Stotram &amp; More — PanchangPath"
  description="Free Hindu devotional text library — Aarti, Chalisa, Stotram, Ashtakam, Vedic Mantras, Yantras, Namavali, Durga Saptashati, Sundarkand, Vrat Katha and Puja Vidhi."
>
  <!-- Hero -->
  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:48px 0 40px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.5;pointer-events:none;"></div>
    <MandalaWatermark size={480} opacity={0.06} />
    <div class="container" style="position:relative;">
      <p class="caption-mono" style="color:var(--color-mute);margin:0 0 8px;">भक्ति साहित्य · DEVOTIONAL LIBRARY</p>
      <h1 data-hi="भक्ति सामग्री पुस्तकालय" style="font-size:34px;font-weight:600;letter-spacing:-1.4px;color:var(--color-ink);margin:0 0 12px;">Devotional Content Library</h1>
      <p data-hi="हिंदू भक्ति ग्रंथों का एक निःशुल्क, बढ़ता हुआ संग्रह — आरती, चालीसा, स्तोत्र, अष्टकम्, वैदिक मंत्र, यंत्र, नामावली, दुर्गा सप्तशती, सुंदरकांड, व्रत कथा और पूजा विधि मार्गदर्शिकाएं — प्रत्येक में देवनागरी बोल, लिप्यंतरण और अर्थ सहित।" style="font-size:16px;color:var(--color-body-text);margin:0;max-width:640px;line-height:1.6;">A free, growing collection of Hindu devotional texts — Aartis, Chalisas, Stotrams, Ashtakams, Vedic Mantras, Yantras, Namavalis, the Durga Saptashati, Sundarkand, Vrat Kathas and Puja Vidhi guides — each with Devanagari lyrics, transliteration and meaning.</p>
    </div>
  </section>

  <!-- Category grid -->
  <section style="padding:36px 0 48px;">
    <div class="container">
      <div class="dv-cat-grid">
        {categories.map((c) => (
          c.built ? (
            <a href={c.url} class="dv-cat-card card">
              <span class="dv-cat-icon" style={`background:${c.gradient}`}>{c.icon}</span>
              <div class="dv-cat-body">
                <h3 class="dv-cat-title"><span class="en-text">{c.label}</span><span class="hi-text" style="display:none">{c.labelHi}</span></h3>
                <p class="dv-cat-title-hi"><span class="en-text">{c.labelHi}</span><span class="hi-text" style="display:none">{c.label}</span></p>
                <p class="dv-cat-desc" data-hi={DESC_HI[c.id]}>{c.description}</p>
              </div>
            </a>
          ) : (
            <div class="dv-cat-card dv-cat-soon card">
              <span class="dv-cat-icon" style={`background:${c.gradient}`}>{c.icon}</span>
              <div class="dv-cat-body">
                <h3 class="dv-cat-title"><span class="en-text">{c.label}</span><span class="hi-text" style="display:none">{c.labelHi}</span></h3>
                <p class="dv-cat-title-hi"><span class="en-text">{c.labelHi}</span><span class="hi-text" style="display:none">{c.label}</span></p>
                <p class="dv-cat-desc" data-hi={DESC_HI[c.id]}>{c.description}</p>
                <span class="dv-soon-badge" data-hi="जल्द आ रहा है">Coming Soon</span>
              </div>
            </div>
          )
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  function applyPageLang(hindi: boolean) {
    document.querySelectorAll<HTMLElement>('[data-hi]').forEach(el => {
      if (!el.dataset.en) el.dataset.en = el.textContent || '';
      el.textContent = hindi ? (el.dataset.hi as string) : (el.dataset.en as string);
    });
    document.querySelectorAll<HTMLElement>('.en-text').forEach(el => { el.style.display = hindi ? 'none' : ''; });
    document.querySelectorAll<HTMLElement>('.hi-text').forEach(el => { el.style.display = hindi ? '' : 'none'; });
  }
  document.addEventListener('langchange', (e: Event) => {
    applyPageLang((e as CustomEvent).detail.langCode === 'hi');
  });
  if (localStorage.getItem('pp-lang') === 'hi') applyPageLang(true);
</script>

<style>
  .dv-cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media (max-width: 900px) { .dv-cat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .dv-cat-grid { grid-template-columns: 1fr; } }

  .dv-cat-card { display: flex; align-items: flex-start; gap: 14px; padding: 20px; text-decoration: none; position: relative; }
  .dv-cat-soon { opacity: 0.72; cursor: default; }
  .dv-cat-icon {
    font-size: 22px; width: 44px; height: 44px; border-radius: 10px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; color: #fff;
  }
  .dv-cat-body { min-width: 0; }
  .dv-cat-title { font-size: 15px; font-weight: 600; color: var(--color-ink); margin: 0 0 2px; }
  .dv-cat-title-hi { font-size: 12.5px; color: var(--color-mute); margin: 0 0 6px; }
  .dv-cat-desc { font-size: 12.5px; color: var(--color-mute); margin: 0; line-height: 1.55; }
  .dv-soon-badge {
    display: inline-block; margin-top: 8px; padding: 2px 8px; border-radius: 999px; font-size: 10px; font-weight: 700;
    background: var(--color-canvas-soft-2); border: 1px solid var(--color-hairline); color: var(--color-mute); letter-spacing: 0.04em;
  }
</style>
