---
import Layout from '../../layouts/Layout.astro';
import { CATEGORY_META } from '../../lib/devotional/types';

const categories = Object.values(CATEGORY_META);
---

<Layout
  title="Devotional Content Library — Aarti, Chalisa, Stotram &amp; More — PanchangPath"
  description="Free Hindu devotional text library — Aarti, Chalisa, Stotram, Ashtakam, Vedic Mantras, Yantras, Namavali, Durga Saptashati, Sundarkand, Nama Ramayanam, Vrat Katha and Puja Vidhi."
>
  <!-- Hero -->
  <section style="background:var(--color-canvas);border-bottom:1px solid var(--color-hairline);padding:48px 0 40px;position:relative;overflow:hidden;">
    <div class="gradient-mesh" style="position:absolute;inset:0;opacity:0.5;pointer-events:none;"></div>
    <div class="container" style="position:relative;">
      <p class="caption-mono" style="color:var(--color-mute);margin:0 0 8px;">भक्ति साहित्य · DEVOTIONAL LIBRARY</p>
      <h1 style="font-size:34px;font-weight:600;letter-spacing:-1.4px;color:var(--color-ink);margin:0 0 12px;">Devotional Content Library</h1>
      <p style="font-size:16px;color:var(--color-body-text);margin:0;max-width:640px;line-height:1.6;">A free, growing collection of Hindu devotional texts — Aartis, Chalisas, Stotrams, Ashtakams, Vedic Mantras, Yantras, Namavalis, the Durga Saptashati, Sundarkand, Nama Ramayanam, Vrat Kathas and Puja Vidhi guides — each with Devanagari lyrics, transliteration and meaning.</p>
    </div>
  </section>

  <!-- Category grid -->
  <section style="padding:36px 0 48px;">
    <div class="container">
      <div class="dv-cat-grid">
        {categories.map((c) => (
          c.built ? (
            <a href={c.url} class="dv-cat-card card">
              <span class="dv-cat-icon" style={`background:${c.gradient}`}>{c.icon}</span>
              <div class="dv-cat-body">
                <h3 class="dv-cat-title">{c.label}</h3>
                <p class="dv-cat-title-hi hi-text">{c.labelHi}</p>
                <p class="dv-cat-desc">{c.description}</p>
              </div>
            </a>
          ) : (
            <div class="dv-cat-card dv-cat-soon card">
              <span class="dv-cat-icon" style={`background:${c.gradient}`}>{c.icon}</span>
              <div class="dv-cat-body">
                <h3 class="dv-cat-title">{c.label}</h3>
                <p class="dv-cat-title-hi hi-text">{c.labelHi}</p>
                <p class="dv-cat-desc">{c.description}</p>
                <span class="dv-soon-badge">Coming Soon</span>
              </div>
            </div>
          )
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .dv-cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  @media (max-width: 900px) { .dv-cat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .dv-cat-grid { grid-template-columns: 1fr; } }

  .dv-cat-card { display: flex; align-items: flex-start; gap: 14px; padding: 20px; text-decoration: none; position: relative; }
  .dv-cat-soon { opacity: 0.72; cursor: default; }
  .dv-cat-icon {
    font-size: 22px; width: 44px; height: 44px; border-radius: 10px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; color: #fff;
  }
  .dv-cat-body { min-width: 0; }
  .dv-cat-title { font-size: 15px; font-weight: 600; color: var(--color-ink); margin: 0 0 2px; }
  .dv-cat-title-hi { font-size: 12.5px; color: var(--color-mute); margin: 0 0 6px; }
  .dv-cat-desc { font-size: 12.5px; color: var(--color-mute); margin: 0; line-height: 1.55; }
  .dv-soon-badge {
    display: inline-block; margin-top: 8px; padding: 2px 8px; border-radius: 999px; font-size: 10px; font-weight: 700;
    background: var(--color-canvas-soft-2); border: 1px solid var(--color-hairline); color: var(--color-mute); letter-spacing: 0.04em;
  }
</style>
