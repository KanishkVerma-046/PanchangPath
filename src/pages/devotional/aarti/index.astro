---
import Layout from '../../../layouts/Layout.astro';
import DevotionalIndexGrid from '../../../components/DevotionalIndexGrid.astro';
import { AARTIS } from '../../../lib/devotional/aarti';
import { CATEGORY_META } from '../../../lib/devotional/types';

const category = CATEGORY_META['aarti'];
---

<Layout
  title="Aarti Collection — Hindi Lyrics &amp; Meaning — PanchangPath"
  description="Free collection of 18 traditional Hindu aartis with Devanagari lyrics, transliteration and meaning — Om Jai Jagdish Hare, Jai Ganesh Deva and more."
>
  <DevotionalIndexGrid category={category} items={AARTIS} />
</Layout>
