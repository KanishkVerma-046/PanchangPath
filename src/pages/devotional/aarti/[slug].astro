---
import Layout from '../../../layouts/Layout.astro';
import { metaDescription } from '../../../lib/meta';
import DevotionalDetail from '../../../components/DevotionalDetail.astro';
import { AARTIS } from '../../../lib/devotional/aarti';
import { CATEGORY_META } from '../../../lib/devotional/types';

export function getStaticPaths() {
  return AARTIS.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const category = CATEGORY_META['aarti'];

const idx = AARTIS.findIndex(a => a.slug === item.slug);
const prev = idx > 0 ? AARTIS[idx - 1] : null;
const next = idx < AARTIS.length - 1 ? AARTIS[idx + 1] : null;

/** Cross-links to the Chalisa-format hymn for the same deity, where one exists. */
const RELATED: Record<string, { label: string; labelHi?: string; href: string }[]> = {
  'jai-ganesh-deva': [{ label: 'Ganesh Chalisa', labelHi: 'गणेश चालीसा', href: '/devotional/chalisa/ganesh-chalisa' }],
  'om-jai-lakshmi-mata': [{ label: 'Lakshmi Chalisa', labelHi: 'लक्ष्मी चालीसा', href: '/devotional/chalisa/lakshmi-chalisa' }],
};
---

<Layout
  title={item.metaTitle ?? `${item.title} — Aarti Lyrics & Meaning — PanchangPath`}
  description={metaDescription(item.metaDesc ?? item.meaning, `${item.title} aarti lyrics in Hindi with transliteration and meaning.`)}
>
  <DevotionalDetail item={item} category={category} prev={prev} next={next} relatedLinks={RELATED[item.slug]} />
</Layout>
