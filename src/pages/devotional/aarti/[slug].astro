---
import Layout from '../../../layouts/Layout.astro';
import { metaDescription } from '../../../lib/meta';
import DevotionalDetail from '../../../components/DevotionalDetail.astro';
import { AARTIS } from '../../../lib/devotional/aarti';
import { CATEGORY_META } from '../../../lib/devotional/types';

export function getStaticPaths() {
  return AARTIS.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const category = CATEGORY_META['aarti'];

const idx = AARTIS.findIndex(a => a.slug === item.slug);
const prev = idx > 0 ? AARTIS[idx - 1] : null;
const next = idx < AARTIS.length - 1 ? AARTIS[idx + 1] : null;
---

<Layout
  title={`${item.title} — ${item.titleHi} — Aarti Lyrics &amp; Meaning — PanchangPath`}
  description={metaDescription(item.meaning, `${item.title} aarti lyrics in Hindi with transliteration and meaning.`)}
>
  <DevotionalDetail item={item} category={category} prev={prev} next={next} />
</Layout>
