---
import Layout from '../../../layouts/Layout.astro';
import { metaDescription } from '../../../lib/meta';
import DevotionalDetail from '../../../components/DevotionalDetail.astro';
import { AARTIS } from '../../../lib/devotional/aarti';
import { CATEGORY_META } from '../../../lib/devotional/types';

export function getStaticPaths() {
  return AARTIS.map(item => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const category = CATEGORY_META['aarti'];

const idx = AARTIS.findIndex(a => a.slug === item.slug);
const prev = idx > 0 ? AARTIS[idx - 1] : null;
const next = idx < AARTIS.length - 1 ? AARTIS[idx + 1] : null;

/** Cross-links to the Chalisa-format hymn for the same deity, where one exists. */
const RELATED: Record<string, { label: string; labelHi?: string; href: string }[]> = {
  'jai-ganesh-deva': [{ label: 'Ganesh Chalisa', labelHi: 'गणेश चालीसा', href: '/devotional/chalisa/ganesh-chalisa' }],
  'om-jai-lakshmi-mata': [{ label: 'Lakshmi Chalisa', labelHi: 'लक्ष्मी चालीसा', href: '/devotional/chalisa/lakshmi-chalisa' }],
  'jai-ambe-gauri': [{ label: 'Durga Chalisa', labelHi: 'दुर्गा चालीसा', href: '/devotional/chalisa/durga-chalisa' }],
  'om-jai-shiv-omkara': [{ label: 'Shiv Chalisa', labelHi: 'शिव चालीसा', href: '/devotional/chalisa/shiv-chalisa' }],
  'aarti-kunj-bihari-ki': [{ label: 'Krishna Chalisa', labelHi: 'कृष्ण चालीसा', href: '/devotional/chalisa/krishna-chalisa' }],
  'sai-baba-aarti': [{ label: 'Sai Chalisa', labelHi: 'साईं चालीसा', href: '/devotional/chalisa/sai-chalisa' }],
  'aarti-shri-kali-ji-ki': [{ label: 'Kali Chalisa', labelHi: 'काली चालीसा', href: '/devotional/chalisa/kali-chalisa' }],
  'aarti-shri-ramchandra-ji-ki': [{ label: 'Ram Chalisa', labelHi: 'राम चालीसा', href: '/devotional/chalisa/ram-chalisa' }],
  'aarti-kije-hanuman-lala-ki': [{ label: 'Hanuman Chalisa', labelHi: 'हनुमान चालीसा', href: '/devotional/chalisa/hanuman-chalisa' }],
  'jai-saraswati-mata': [{ label: 'Saraswati Chalisa', labelHi: 'सरस्वती चालीसा', href: '/devotional/chalisa/saraswati-chalisa' }],
  'vaishno-devi-aarti': [{ label: 'Vaishno Devi Chalisa', labelHi: 'वैष्णो देवी चालीसा', href: '/devotional/chalisa/vaishno-devi-chalisa' }],
};
---

<Layout
  title={item.metaTitle ?? `${item.title} — Aarti Lyrics & Meaning — PanchangPath`}
  description={metaDescription(item.metaDesc ?? item.meaning, `${item.title} aarti lyrics in Hindi with transliteration and meaning.`)}
>
  <DevotionalDetail item={item} category={category} prev={prev} next={next} relatedLinks={RELATED[item.slug]} />
</Layout>
