---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Tooltip from '../components/Tooltip.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  noindex?: boolean;
}

const {
  title = 'PanchangPath — Hindu Almanac for Any Date & Location',
  description = 'Precise Panchang with Tithi, Nakshatra, Yoga, Karana, Rahu Kalam, festivals and muhurtas — clean, fast, and free to use.',
  image = '/og-image.png',
  imageAlt = 'PanchangPath — free online Hindu Panchang, Tithi, Nakshatra and Muhurat calculator',
  canonical,
  noindex = false,
} = Astro.props;

const siteUrl = 'https://panchangpath.com';
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="light">
<head>
  <script is:inline>
    // ── Hindi language toggle: re-enabled site-wide 2026-08-29 ──
    // Was disabled 2026-08-15 (Task 0) pending translation coverage; a dedicated
    // investigation + translation project on 2026-08-29 closed the remaining gaps
    // (regional script names, ~86 calculator FAQ pairs, 10 Jyotish prerender pages,
    // 13 blog posts) and verified the full site renders correctly with Hindi on.
    // ~70 pages/components each independently read localStorage.getItem('pp-lang')
    // on load to decide whether to render Hindi (see LanguagePicker.astro, Header.astro,
    // and every src/pages/**/*.astro / src/components/*.astro that calls
    // applyPageLang(true) / applyHeaderLang(true) when that key === 'hi'). While
    // HINDI_ENABLED is false, this shim transparently forces that key to 'en'; while
    // true (current state), it's a no-op and every page's own stored preference is honored.
    //
    // To disable again: flip HINDI_ENABLED back to false here AND in
    // src/components/LanguagePicker.astro (which independently hides the toggle
    // button/dropdown using its own copy of this same flag). Must run as the very
    // first synchronous script on the page (is:inline, first thing in <head>) so it
    // executes before Header.astro's and every page's own inline scripts read the key.
    (function () {
      var HINDI_ENABLED = true;
      if (HINDI_ENABLED) return;
      try {
        var nativeGetItem = Storage.prototype.getItem;
        Storage.prototype.getItem = function (key) {
          if (this === window.localStorage && key === 'pp-lang') return 'en';
          return nativeGetItem.call(this, key);
        };
      } catch (e) {}
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="PanchangPath" />
  <link rel="manifest" href="/site.webmanifest" />
  <title>{title}</title>
  <link rel="canonical" href={canonicalUrl} />
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="PanchangPath" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <!-- Self-hosted fonts (public/fonts.css + public/fonts/*.woff2) — same
       families/weights/styles as before, served same-origin. Was a Google
       Fonts <link>: that added an extra cross-origin CSS→font round trip and
       staggered each font's arrival, and each arrival forced a full-page
       reflow (measured ~300-600ms per font on a throttled mid-range phone,
       the dominant cost in a mobile perf audit). Preloading the two fonts
       used above the fold (body + heading) lets them start downloading
       immediately instead of waiting on fonts.css to parse. -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/Inter-latin.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/Cormorant-normal-latin.woff2" crossorigin />
  <!-- Loaded non-blocking (classic loadCSS media=print trick): fonts.css is
       just @font-face rules, not layout/visual CSS, so there's no
       flash-of-unstyled-content risk in deferring it — text already renders
       in its fallback font immediately via font-display:swap regardless of
       when this parses, and the two font files above are already fetching
       via preload independent of this file's load order. This was one of
       three render-blocking stylesheets a Lighthouse audit flagged; the
       other two (global.css and index.astro's own styles) are left blocking
       on purpose — deferring the site's actual layout/color CSS would cause
       a real unstyled flash across all 440 pages for a few hundred ms of
       gain, which isn't worth it on a site this design-invested. -->
  <link rel="stylesheet" href="/fonts.css" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="/fonts.css" /></noscript>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': `${siteUrl}/#organization`,
        name: 'PanchangPath',
        url: siteUrl,
        logo: `${siteUrl}/favicon.svg`,
        description: 'Free Hindu Panchang, festival calendar, muhurta timing and Jyotish calculators — Drik astronomical method, Lahiri Ayanamsha.',
      },
      {
        '@type': 'WebSite',
        '@id': `${siteUrl}/#website`,
        name: 'PanchangPath',
        url: siteUrl,
        publisher: { '@id': `${siteUrl}/#organization` },
      },
    ],
  })} />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TEKDTX8G8W"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-TEKDTX8G8W');
  </script>
  <!-- Google AdSense -->
  <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6181047851191158"
     crossorigin="anonymous"></script>
</head>
<body>
  <div class="grain-overlay" aria-hidden="true"></div>
  <Header />

  <!-- Page content -->
  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer style="background:var(--color-canvas);border-top:1px solid var(--color-hairline);padding:48px 0 32px;">
    <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;margin-bottom:40px;">
        <div>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
            <span style="font-size:18px;">🕉️</span>
            <span style="font-size:15px;font-weight:600;color:var(--color-ink);">PanchangPath</span>
          </div>
          <p data-hi="किसी भी तिथि और स्थान के लिए सटीक हिंदू पंचांग। स्वच्छ, तेज़ और पूर्णतः मुफ़्त।" style="color:var(--color-body-text);font-size:14px;line-height:22px;margin:0 0 16px;">Precise Hindu Panchang for any date and location. Clean, fast, and completely free.</p>
          <span class="badge" data-hi="द्रिक खगोलीय पद्धति · लाहिड़ी अयनांश" style="font-size:11px;">Drik Astronomical Method · Lahiri Ayanamsha</span>
        </div>
        <div>
          <p class="caption-mono" data-hi="पंचांग" style="color:var(--color-mute);margin:0 0 12px;">Panchang</p>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <a href="/" data-hi="आज" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">Today</a>
            <a href="/calendar" data-hi="कैलेंडर" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">Calendar</a>
            <a href="/festivals" data-hi="त्योहार" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">Festivals</a>
            <a href="/muhurta" data-hi="मुहूर्त खोजक" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">Muhurta Finder</a>
          </div>
        </div>
        <div>
          <p class="caption-mono" data-hi="ज्योतिष" style="color:var(--color-mute);margin:0 0 12px;">Jyotish</p>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <a href="/rashifal" data-hi="दैनिक राशिफल" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">Daily Rashifal</a>
            <a href="/rashifal/mesha" data-hi="मेष राशिफल" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">Mesha Rashifal</a>
            <a href="/rashifal/vrishabha" data-hi="वृषभ राशिफल" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">Vrishabha Rashifal</a>
            <a href="/prashnavali" data-hi="प्रश्नावली दैवज्ञ" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">Prashnavali Oracle</a>
          </div>
        </div>
        <div>
          <p class="caption-mono" data-hi="कंपनी" style="color:var(--color-mute);margin:0 0 12px;">Company</p>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <a href="/about" data-hi="हमारे बारे में" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">About Us</a>
            <a href="/blog" data-hi="ब्लॉग" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">Blog</a>
            <a href="/faq" data-hi="अक्सर पूछे जाने वाले प्रश्न" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">FAQ</a>
            <a href="/contact" data-hi="संपर्क करें" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">Contact Us</a>
            <a href="/privacy" data-hi="गोपनीयता नीति" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">Privacy Policy</a>
            <a href="/terms" data-hi="नियम और शर्तें" style="color:var(--color-body-text);font-size:14px;text-decoration:underline;">Terms &amp; Conditions</a>
          </div>
        </div>
      </div>
      <div class="divider"></div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding-top:24px;flex-wrap:wrap;gap:12px;">
        <p data-hi={`© ${currentYear} पंचांगपथ. सर्वाधिकार सुरक्षित।`} style="color:var(--color-mute);font-size:12px;margin:0;">© {currentYear} PanchangPath. All rights reserved.</p>
        <p style="color:var(--color-mute);font-size:12px;margin:0;">panchangpath.com</p>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width: 768px) {
      footer > div > div:first-child { grid-template-columns: 1fr 1fr !important; }
    }
  </style>

  <Tooltip />

  <script>
    // Opt-in scroll reveal — only touches elements explicitly marked
    // class="reveal" (see .reveal in global.css). No-op on pages that
    // don't use it, so this is safe to load on every page.
    (function () {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var els = document.querySelectorAll('.reveal');
      if (!('IntersectionObserver' in window) || !els.length) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
</body>
</html>
