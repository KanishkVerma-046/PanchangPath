---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Tooltip from '../components/Tooltip.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
}

const {
  title = 'PanchangPath — Hindu Almanac for Any Date & Location',
  description = 'Precise Panchang with Tithi, Nakshatra, Yoga, Karana, Rahu Kalam, festivals and muhurtas — clean, fast, and ad-free.',
  keywords = "Panchang, Today's Panchang, Hindu Panchang, Panchang Calculator, Tithi Today, Nakshatra Today, Rahu Kalam, Choghadiya, Hindu Calendar, Kundali, Rashifal, Muhurat",
  image = '/og-image.png',
  imageAlt = 'PanchangPath — free online Hindu Panchang, Tithi, Nakshatra and Muhurat calculator',
  canonical,
} = Astro.props;

const siteUrl = 'https://panchangpath.com';
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const imageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="robots" content="index, follow" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <link rel="canonical" href={canonicalUrl} />
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="PanchangPath" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&family=Tiro+Devanagari+Hindi:ital@0;1&family=JetBrains+Mono:wght@400&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': `${siteUrl}/#organization`,
        name: 'PanchangPath',
        url: siteUrl,
        logo: `${siteUrl}/favicon.svg`,
        description: 'Free Hindu Panchang, festival calendar, muhurta timing and Jyotish calculators — Drik astronomical method, Lahiri Ayanamsha.',
      },
      {
        '@type': 'WebSite',
        '@id': `${siteUrl}/#website`,
        name: 'PanchangPath',
        url: siteUrl,
        publisher: { '@id': `${siteUrl}/#organization` },
      },
    ],
  })} />
</head>
<body>
  <Header />

  <!-- Page content -->
  <main>
    <slot />
  </main>

  <!-- FOOTER -->
  <footer style="background:var(--color-canvas);border-top:1px solid var(--color-hairline);padding:48px 0 32px;">
    <div class="container" style="max-width:1200px;margin:0 auto;padding:0 24px;">
      <div style="display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;margin-bottom:40px;">
        <div>
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:16px;">
            <span style="font-size:18px;">🕉️</span>
            <span style="font-size:15px;font-weight:600;color:var(--color-ink);">PanchangPath</span>
          </div>
          <p data-hi="किसी भी तिथि और स्थान के लिए सटीक हिंदू पंचांग। स्वच्छ, तेज़ और पूर्णतः विज्ञापन-मुक्त।" style="color:var(--color-body-text);font-size:14px;line-height:22px;margin:0 0 16px;">Precise Hindu Panchang for any date and location. Clean, fast, and completely ad-free.</p>
          <span class="badge" data-hi="द्रिक खगोलीय पद्धति · लाहिड़ी अयनांश" style="font-size:11px;">Drik Astronomical Method · Lahiri Ayanamsha</span>
        </div>
        <div>
          <p class="caption-mono" data-hi="पंचांग" style="color:var(--color-mute);margin:0 0 12px;">Panchang</p>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <a href="/" data-hi="आज" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">Today</a>
            <a href="/calendar" data-hi="कैलेंडर" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">Calendar</a>
            <a href="/festivals" data-hi="त्योहार" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">Festivals</a>
            <a href="/muhurta" data-hi="मुहूर्त खोजक" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">Muhurta Finder</a>
          </div>
        </div>
        <div>
          <p class="caption-mono" data-hi="ज्योतिष" style="color:var(--color-mute);margin:0 0 12px;">Jyotish</p>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <a href="/rashifal" data-hi="दैनिक राशिफल" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">Daily Rashifal</a>
            <a href="/rashifal/mesha" data-hi="मेष राशिफल" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">Mesha Rashifal</a>
            <a href="/rashifal/vrishabha" data-hi="वृषभ राशिफल" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">Vrishabha Rashifal</a>
            <a href="/prashnavali" data-hi="प्रश्नावली दैवज्ञ" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">Prashnavali Oracle</a>
          </div>
        </div>
        <div>
          <p class="caption-mono" data-hi="कंपनी" style="color:var(--color-mute);margin:0 0 12px;">Company</p>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <a href="/about" data-hi="हमारे बारे में" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">About Us</a>
            <a href="/blog" data-hi="ब्लॉग" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">Blog</a>
            <a href="/contact" data-hi="संपर्क करें" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">Contact Us</a>
            <a href="/privacy" data-hi="गोपनीयता नीति" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">Privacy Policy</a>
            <a href="/terms" data-hi="नियम और शर्तें" style="color:var(--color-body-text);font-size:14px;text-decoration:none;">Terms &amp; Conditions</a>
          </div>
        </div>
      </div>
      <div class="divider"></div>
      <div style="display:flex;align-items:center;justify-content:space-between;padding-top:24px;flex-wrap:wrap;gap:12px;">
        <p data-hi={`© ${currentYear} पंचांगपथ. सर्वाधिकार सुरक्षित।`} style="color:var(--color-mute);font-size:12px;margin:0;">© {currentYear} PanchangPath. All rights reserved.</p>
        <p style="color:var(--color-mute);font-size:12px;margin:0;">panchangpath.com</p>
      </div>
    </div>
  </footer>

  <style>
    @media (max-width: 768px) {
      footer > div > div:first-child { grid-template-columns: 1fr 1fr !important; }
    }
  </style>

  <Tooltip />
</body>
</html>
